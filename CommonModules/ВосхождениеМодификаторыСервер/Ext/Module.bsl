// Применяет модификатор ПокернаяПерчатка.
// Если в руке одновременно находятся карты Единички, Тройки и Пятёрки,
// все три разыгрываются мгновенно и бесплатно.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ПрименитьМодификатор_ПокернаяПерчатка(Форма) Экспорт
	Если НЕ Форма.ЭтоПокернаяПерчаткаРазыгрывает
		И ВосхождениеКлиентСервер.МодификаторАктивен(Форма, ПредопределенноеЗначение("Справочник.Модификаторы.ПокернаяПерчатка")) Тогда
		// Инициализация.
		КартаЕдинички = Справочники.Карты.Единички;
		КартаТройки = Справочники.Карты.Тройки;
		КартаПятерки = Справочники.Карты.Пятерки;
		СтрокаЕдинички = Форма.НайтиСтрокуКартыВРуке(КартаЕдинички);
		СтрокаТройки = Форма.НайтиСтрокуКартыВРуке(КартаТройки);
		СтрокаПятерки = Форма.НайтиСтрокуКартыВРуке(КартаПятерки);
		Если СтрокаЕдинички <> Неопределено И СтрокаТройки <> Неопределено И СтрокаПятерки <> Неопределено Тогда
			// Розыгрыш всех трёх карт бесплатно.
			Форма.ЭтоПокернаяПерчаткаРазыгрывает = Истина;
			Форма.РазыгратьКартуБесплатно(СтрокаЕдинички);
			Форма.РазыгратьКартуБесплатно(СтрокаТройки);
			Форма.РазыгратьКартуБесплатно(СтрокаПятерки);
			Форма.ЭтоПокернаяПерчаткаРазыгрывает = Ложь;
		Иначе
			// Комбинация не собрана.
		КонецЕсли;
	Иначе
		// Модификатор не активен или уже разыгрывается.
	КонецЕсли;
КонецПроцедуры		// ПрименитьМодификатор_ПокернаяПерчатка()

