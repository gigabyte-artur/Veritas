Процедура ПрименитьМодификатор_ШипастыйБраслет(Форма) Экспорт
	ВидПараметраСила = Перечисления.ВидыПараметровИгроков.Сила;
	Форма.УвеличитьПараметрИгрока(ВидПараметраСила, 1);
КонецПроцедуры // ПрименитьМодификатор_ШипастыйБраслет()

// Осуществляет применение модификатора ЦепкийКрюк.
// При нанесении урона игроком по щиту противника, игроку увеличивается параметр Щит в размере 20% от нанесенного урона по щиту.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  УронПоЩитуВход - Число - урон, нанесенный по щиту противника.
//
Процедура ПрименитьМодификатор_ЦепкийКрюк(Форма, УронПоЩитуВход) Экспорт
	// Рассчитываем увеличение щита: 20% от урона по щиту противника
	УвеличениеЩита = Цел(УронПоЩитуВход * 0.20);
	МодификаторЦепкийКрюк = Справочники.Модификаторы.ЦепкийКрюк;
	Если УвеличениеЩита > 0 Тогда
		Форма.УвеличитьЩитИгрока(УвеличениеЩита);
		ВосхождениеКлиентСервер.ДобавитьДействиеМодификатораВЖурналБоя(Форма, МодификаторЦепкийКрюк, УвеличениеЩита);
	Иначе
		// Нет очков увеличения щита. Ничего не делаем.
	КонецЕсли;
КонецПроцедуры		// ПрименитьМодификатор_ЦепкийКрюк()

// Возвращает модифицированную сумму золота под действием модификатора ВесыФортуны:
// 67% шанс удвоить сумму, 33% шанс обнулить.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//   СуммаВход - Число - исходная сумма золота.
//
// Возвращаемое значение:
//  Число — модифицированная сумма золота.
//
Функция ПрименитьМодификатор_ВесыФортуны(Форма, Гсч, СуммаВход) Экспорт
	// Инициализация.
	РезультатФункции = СуммаВход;
	МодификаторВесыФортуны = ПредопределенноеЗначение("Справочник.Модификаторы.ВесыФортуны");
	// Проверка модификатора.
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, МодификаторВесыФортуны) Тогда
		Шанс = Гсч.СлучайноеЧисло(1, 100);
		Если Шанс <= 67 Тогда
			РезультатФункции = СуммаВход * 2;
		Иначе
			РезультатФункции = 0;
		КонецЕсли;
		ВосхождениеКлиентСервер.ДобавитьДействиеМодификатораВЖурналБоя(Форма, МодификаторВесыФортуны, РезультатФункции);
	Иначе
		// Модификатор не активен.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПрименитьМодификатор_ВесыФортуны()

// Возвращает добавку к золоту от модификатора ДырявыйКошель: случайное значение от -15 до +30.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
// Возвращаемое значение:
//  Число — случайное значение от -15 до +30 если модификатор активен, иначе 0.
//
Функция ПрименитьМодификатор_ДырявыйКошель(Форма, Гсч) Экспорт
	// Инициализация.
	РезультатФункции = 0;
	МодификаторДырявыйКошель = Справочники.Модификаторы.ДырявыйКошель;
	// Проверка модификатора.
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, МодификаторДырявыйКошель) Тогда
		РезультатФункции = Гсч.СлучайноеЧисло(-15, 30);
		ВосхождениеКлиентСервер.ДобавитьДействиеМодификатораВЖурналБоя(Форма, МодификаторДырявыйКошель, РезультатФункции);
	Иначе
		// Модификатор не активен.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПрименитьМодификатор_ДырявыйКошель()

// Осуществляет применение модификатора НеразменныйГрош.
// Начисляет игроку 3 золота при получении награды за серию из трёх правильных ответов.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ПрименитьМодификатор_НеразменныйГрош(Форма) Экспорт
	// Инициализация.
	МодификаторНеразменныйГрош = Справочники.Модификаторы.НеразменныйГрош;
	ВидПараметраЗолото = Перечисления.ВидыПараметровИгроков.Золото;
	// Начисление золота.
	Форма.УвеличитьПараметрИгрока(ВидПараметраЗолото, 3);
	ВосхождениеКлиентСервер.ДобавитьДействиеМодификатораВЖурналБоя(Форма, МодификаторНеразменныйГрош, 3);
КонецПроцедуры		// ПрименитьМодификатор_НеразменныйГрош()

#КонецОбласти
