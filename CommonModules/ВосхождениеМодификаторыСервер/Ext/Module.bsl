// Осуществляет применение модификатора ЛетучаяМышь.
// При нанесении урона игроком игрок излечивает себе здоровье в размере 10% от нанесенного урона.
// Если урон меньше 10, то восстанавливается 1 единица здоровья
// с вероятностью УронВход / 10.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//  УронВход - Число - урон, нанесенный игроком по здоровью противника.
//
Процедура ПрименитьМодификатор_ЛетучаяМышь(Форма, Гсч, УронВход) Экспорт
	// Инициализация.
	МодификаторЛетучаяМышь = Справочники.Модификаторы.ЛетучаяМышь;
	// Проверка размера урона.
	Если УронВход < 10 Тогда
		// Восстанавливаем 1 здоровье с вероятностью УронВход / 10.
		ШансВосстановления = УронВход * 10;
		СлучайноеЧисло = Гсч.СлучайноеЧисло(0, 99);
		Если СлучайноеЧисло < ШансВосстановления Тогда
			Форма.ВосстановитьЗдоровьеИгрока(1);
			ВосхождениеКлиентСервер.ДобавитьДействиеМодификатораВЖурналБоя(Форма, МодификаторЛетучаяМышь, 1);
		Иначе
			// Вероятность не сработала. Восстановления нет.
		КонецЕсли;
	Иначе
		// Рассчитываем восстановление здоровья: 10% от нанесенного урона.
		Восстановление = УронВход * 0.10;
		Если Восстановление > 0 Тогда
			Форма.ВосстановитьЗдоровьеИгрока(Восстановление);
			ВосхождениеКлиентСервер.ДобавитьДействиеМодификатораВЖурналБоя(Форма, МодификаторЛетучаяМышь, Восстановление);
		Иначе
			// Нет очков восстановления. Ничего не делаем.
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры		// ПрименитьМодификатор_ЛетучаяМышь()

// Осуществляет применение модификатора ВолчийКлык.
// При правильном ответе увеличивает параметр Ярость на 1.
// При неправильном ответе устанавливает Ярость в 0.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	ЭтоВерныйОтвет - Булево - признак правильного ответа.
//
Процедура ПрименитьМодификатор_ВолчийКлык(Форма, ЭтоВерныйОтвет) Экспорт
	ВидПараметраЯрость = Перечисления.ВидыПараметровИгроков.Ярость;
	МодификаторВолчийКлык = Справочники.Модификаторы.ВолчийКлык;
	Если ЭтоВерныйОтвет Тогда
		Форма.УвеличитьПараметрИгрока(ВидПараметраЯрость, 1);
		ВосхождениеКлиентСервер.ДобавитьДействиеМодификатораВЖурналБоя(Форма, МодификаторВолчийКлык, 1);
	Иначе
		Форма.УстановитьПараметрИгрока(ВидПараметраЯрость, 0);
		ВосхождениеКлиентСервер.ДобавитьДействиеМодификатораВЖурналБоя(Форма, МодификаторВолчийКлык, 0);
	КонецЕсли;
КонецПроцедуры		// ПрименитьМодификатор_ВолчийКлык()

// Осуществляет применение модификатора ШипастыйБраслет.
// При неправильном ответе увеличивает параметр Сила игрока на 1.
//
// Параметры:
