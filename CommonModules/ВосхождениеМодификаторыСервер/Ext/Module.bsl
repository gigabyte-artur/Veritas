// Осуществляет применение модификатора ЗолотоеЯйцо.
// В конце боя игрок получает 5% от всего золота (округление вниз).
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ПрименитьМодификатор_ЗолотоеЯйцо(Форма) Экспорт
	// Инициализация.
	ВидПараметраЗолото = Перечисления.ВидыПараметровИгроков.Золото;
	ТекущееЗолото = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЗолото);
	БонусЗолота = Цел(ТекущееЗолото * 5 / 100);
	Если БонусЗолота > 0 Тогда
		Форма.ПолучитьЗолото(БонусЗолота);
	Иначе
		// Недостаточно золота для бонуса.
	КонецЕсли;
КонецПроцедуры		// ПрименитьМодификатор_ЗолотоеЯйцо()

