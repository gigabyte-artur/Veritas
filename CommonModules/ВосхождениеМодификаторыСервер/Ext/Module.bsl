	Гсч = Новый ГенераторСлучайныхЧисел;
	Шанс = Гсч.СлучайноеЧисло(1, 100);
	МодификаторГарпун = Справочники.Модификаторы.Гарпун;
	Если Шанс <= 30 Тогда
		Если Форма.СтопкаСброса.Количество() > 0 Тогда
			МассивПодходящих = Новый Массив;
			Для Каждого СтрокаСброса Из Форма.СтопкаСброса Цикл
				Если СтрокаСброса.Карта.Стоимость >= 2 Тогда
					МассивПодходящих.Добавить(СтрокаСброса);
				Иначе
					// Стоимость карты меньше 2. Пропускаем.
				КонецЕсли;
			КонецЦикла;
			Если МассивПодходящих.Количество() > 0 Тогда
				Индекс = Гсч.СлучайноеЧисло(0, МассивПодходящих.Количество() - 1);
				ВыбраннаяСтрока = МассивПодходящих[Индекс];
				ВосхождениеКлиентСервер.ПереместиКартуИзСтопки(ВыбраннаяСтрока.ИдентификаторКарты, "СтопкаСброса", "РукаИгрока", Форма);
				ВосхождениеКлиентСервер.ДобавитьДействиеМодификатораВЖурналБоя(Форма, МодификаторГарпун, 1);
			Иначе
				// Нет подходящих карт в стопке сброса.
			КонецЕсли;
