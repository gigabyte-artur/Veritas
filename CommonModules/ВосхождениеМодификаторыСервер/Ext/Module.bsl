#Область СлужебныеМетодыМодификаторов

// Добавляет модификаторы по умолчанию в таблицу Модификаторы.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура ЗагрузитьМодификаторыПоУмолчанию(Форма, Гсч) Экспорт
	Форма.Модификаторы.Очистить();
	// Загрузим один положительный и один отрицательный модификатор.
	ПоложительныйМодификатор = Справочники.Модификаторы.ВернутьМодификатор(Истина, Гсч);
	Если ЗначениеЗаполнено(ПоложительныйМодификатор) Тогда
		НоваяСтрока = Форма.Модификаторы.Добавить();
		НоваяСтрока.Модификатор = ПоложительныйМодификатор;
	Иначе
		// Положительный модификатор не найден.
	КонецЕсли;
	ОтрицательныйМодификатор = Справочники.Модификаторы.ВернутьМодификатор(Ложь, Гсч);
	Если ЗначениеЗаполнено(ОтрицательныйМодификатор) Тогда
		НоваяСтрока = Форма.Модификаторы.Добавить();
		НоваяСтрока.Модификатор = ОтрицательныйМодификатор;
	Иначе
		// Отрицательный модификатор не найден.
	КонецЕсли;
КонецПроцедуры		// ЗагрузитьМодификаторыПоУмолчанию()

// Возвращает случайный текст ответа из другого сборника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//	ТекущийСборникВход - СправочникСсылка.Сборники - сборник текущего вопроса.
//	ПравильныйТекстВход - Строка - текст правильного ответа текущего вопроса.
//
// Возвращаемое значение:
//	Строка - текст ответа из другого сборника, или пустая строка.
//
Функция ПолучитьОтветИзДругогоСборника(Форма, Гсч, ТекущийСборникВход, ПравильныйТекстВход) Экспорт
	РезультатФункции = "";
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаданияОтветыЗаданий.ТекстОтвета КАК ТекстОтвета
	|ИЗ
	|	Справочник.Задания.ОтветыЗаданий КАК ЗаданияОтветыЗаданий
	|ГДЕ
	|	ЗаданияОтветыЗаданий.Ссылка.Владелец <> &ТекущийСборник
	|	И ЗаданияОтветыЗаданий.ТекстОтвета <> &ПравильныйТекст
	|	И НЕ ЗаданияОтветыЗаданий.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("ТекущийСборник", ТекущийСборникВход);
	Запрос.УстановитьПараметр("ПравильныйТекст", ПравильныйТекстВход);
	РезультатЗапроса = Запрос.Выполнить();
	ВыгрузкаОтветов = РезультатЗапроса.Выгрузить();
	Если ВыгрузкаОтветов.Количество() > 0 Тогда
		Индекс = Гсч.СлучайноеЧисло(0, ВыгрузкаОтветов.Количество() - 1);
		РезультатФункции = ВыгрузкаОтветов[Индекс].ТекстОтвета;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПолучитьОтветИзДругогоСборника()

// Осуществляет применение модификатора МодификаторВход.
// 
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	МодификаторВход - СправочникСсылка.Модификаторы - модификатор для применения.
//	ЕстьДлительностьВход - Булево - признак наличия длительности.
//	ОставшаясяДлительностьВход - Число - оставшаяся длительность.
//
Процедура ПрименитьВыбранныйМодификатор(Форма, МодификаторВход, ЕстьДлительностьВход, ОставшаясяДлительностьВход) Экспорт
	Если МодификаторВход = Справочники.Модификаторы.Интуиция Тогда
		Форма.ПрименитьМодификатор_Интуиция();
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.МентальныйЩит Тогда
		Форма.ПрименитьМодификатор_МентальныйЩит();
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.ВырваннаяСтраница Тогда
		Форма.ПрименитьМодификатор_ВырваннаяСтраница();
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.Поплавок Тогда
		Форма.ПрименитьМодификатор_Поплавок();
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.Гарпун Тогда
		Форма.ПрименитьМодификатор_Гарпун();
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.Страховка Тогда
		// Страховка применяется при неверном ответе напрямую в ОбработкаНеправильногоОтвета.
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.Маятник Тогда
		// Маятник применяется при загрузке следующего задания напрямую в СледующееЗадание_Сервер.
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.ПотертыйСапог Тогда
		// ПотертыйСапог применяется при загрузке следующего задания напрямую в СледующееЗадание_Сервер.
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.Перекус Тогда
		Форма.ПрименитьМодификатор_Перекус();
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.КожаныеПластины Тогда
		Форма.ПрименитьМодификатор_КожаныеПластины();
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.Кольчуга Тогда
		Форма.ПрименитьМодификатор_Кольчуга();
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.Подсечка Тогда
		Форма.ПрименитьМодификатор_Подсечка();
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.Туман Тогда
		Форма.ПрименитьМодификатор_Туман();
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.ЛетучаяМышь Тогда
		// Модификатор ЛетучаяМышь применяется при атаке игрока с передачей урона
		// Вызов осуществляется напрямую из процедуры АтакаИгрока
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.ЦепкийКрюк Тогда
		// Модификатор ЦепкийКрюк применяется при атаке игрока по щиту противника
		// Вызов осуществляется напрямую из процедуры АтакаИгрока
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.ПокернаяПерчатка Тогда
		// Модификатор ПокернаяПерчатка применяется при доборе карты.
		// Вызов осуществляется напрямую из процедуры ДобратьКартуВРуку.
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.СтирательнаяРезинка Тогда
		Форма.ПрименитьМодификатор_СтирательнаяРезинка();
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.ПереплетныйНож Тогда
		Форма.ПрименитьМодификатор_ПереплетныйНож();
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.КоронаМидаса Тогда
		Форма.ПрименитьМодификатор_КоронаМидаса();
	ИначеЕсли МодификаторВход = Справочники.Модификаторы.ЗолотоеЯйцо Тогда
		Форма.ПрименитьМодификатор_ЗолотоеЯйцо();
	Иначе
		Сообщить("Неизвестный модификатор: " + МодификаторВход);
		// Неизвестный модификатор.
	КонецЕсли;	
КонецПроцедуры		// ПрименитьВыбранныйМодификатор()

// Применяет модификатор МодификаторВход, если он присутствует в таблице Модификаторы.
// 
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	МодификаторВход - СправочникСсылка.Модификаторы - модификатор для применения.
//
Процедура ПрименитьМодификаторПриНаличии(Форма, МодификаторВход) Экспорт
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Модификатор", МодификаторВход);
	НайденныеСтроки = Форма.Модификаторы.НайтиСтроки(СтруктураПоиска);
	Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
		ТекЕстьДлительность			 = ТекНайденныеСтроки.ЕстьДлительность;
		ТекОставшаясяДлительность	 = ТекНайденныеСтроки.ОставшаясяДлительность;
		Форма.ПрименитьВыбранныйМодификатор(МодификаторВход, ТекЕстьДлительность, ТекОставшаясяДлительность);		
	КонецЦикла;	
КонецПроцедуры		// ПрименитьМодификаторПриНаличии()

// Применяет модификаторы для наступившего события СобытиеВход.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	СобытиеВход - Строка - имя события.
//
Процедура ПрименитьМодификаторыПриСобытии(Форма, СобытиеВход) Экспорт
	Если ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины) Тогда
		Если СобытиеВход = ВосхождениеКлиентСервер.ПредставлениеСобытияФормы_ПриЗагрузкеЗадания() Тогда
			Форма.ПрименитьМодификаторПриНаличии(Справочники.Модификаторы.Интуиция);
			Форма.ПрименитьМодификаторПриНаличии(Справочники.Модификаторы.МентальныйЩит);
			Форма.ПрименитьМодификаторПриНаличии(Справочники.Модификаторы.ВырваннаяСтраница);
		ИначеЕсли СобытиеВход = ВосхождениеКлиентСервер.ПредставлениеСобытияФормы_ПриНачалеБоя() Тогда
			Форма.ПрименитьМодификаторПриНаличии(Справочники.Модификаторы.Перекус);
		ИначеЕсли СобытиеВход = ВосхождениеКлиентСервер.ПредставлениеСобытияФормы_ПриНеправильномОтвете() Тогда
			Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, Справочники.Модификаторы.ВолчийКлык) Тогда
				Форма.ПрименитьМодификатор_ВолчийКлык(Ложь);
			Иначе
				// Модификатор ВолчийКлык не активен.
			КонецЕсли;
			Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, Справочники.Модификаторы.ШипастыйБраслет) Тогда
				Форма.ПрименитьМодификатор_ШипастыйБраслет();
			Иначе
				// Модификатор ШипастыйБраслет не активен.
			КонецЕсли;
		ИначеЕсли СобытиеВход = ВосхождениеКлиентСервер.ПредставлениеСобытияФормы_ПриПолученииНаградыЗаСерию() Тогда
			Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, Справочники.Модификаторы.НеразменныйГрош) Тогда
				Форма.ПрименитьМодификатор_НеразменныйГрош();
			Иначе
				// Модификатор НеразменныйГрош не активен.
			КонецЕсли;
		ИначеЕсли СобытиеВход = ВосхождениеКлиентСервер.ПредставлениеСобытияФормы_ПриСбросеКарты() Тогда
			Форма.ПрименитьМодификаторПриНаличии(Справочники.Модификаторы.СтирательнаяРезинка);
			Форма.ПрименитьМодификаторПриНаличии(Справочники.Модификаторы.ПереплетныйНож);
		ИначеЕсли СобытиеВход = ВосхождениеКлиентСервер.ПредставлениеСобытияФормы_ПриКонцеБоя() Тогда
			Форма.ПрименитьМодификаторПриНаличии(Справочники.Модификаторы.КоронаМидаса);
			Форма.ПрименитьМодификаторПриНаличии(Справочники.Модификаторы.ЗолотоеЯйцо);
		Иначе
			// Неизвестное событие. Ничего не делаем.
		КонецЕсли;
	Иначе
		// Не используем модификаторы для других режимов викторины.
	КонецЕсли;
КонецПроцедуры		 // ПрименитьМодификаторы()

#КонецОбласти

#Область ПрименениеМодификаторов

// Осуществляет применение модификатора Интуиция.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура ПрименитьМодификатор_Интуиция(Форма, Гсч) Экспорт
	МассивНеверных = Новый Массив;
	МодификаторИнтуиция = Справочники.Модификаторы.Интуиция;
	ЗначениеНайдено = Ложь;
	Если ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины) Тогда
		КоличествоОтветов = 4;
		Форма.Сложность = Перечисления.СложностиСборников.ЧетыреОтвета;
	ИначеЕсли Форма.Сборник.Сложность = Перечисления.СложностиСборников.ШестьОтветов Тогда
		КоличествоОтветов = 6;
		Форма.Сложность = Перечисления.СложностиСборников.ШестьОтветов;
	Иначе
		КоличествоОтветов = 4;
		Форма.Сложность = Перечисления.СложностиСборников.ЧетыреОтвета;
	КонецЕсли;
	Пока НЕ ЗначениеНайдено Цикл
		НомерОтвета = Гсч.СлучайноеЧисло(1, КоличествоОтветов);
		Если НомерОтвета <> Форма.НомерПравильногоОтвета Тогда
			ПреобразованныйНомер = ОбщегоНазначенияКлиентСервер.ПреобразоватьНомерПравильногоОтвета(НомерОтвета, Форма.Сложность);
			МассивНеверных.Добавить(ПреобразованныйНомер);
			ЗначениеНайдено = Истина;
			ВосхождениеКлиентСервер.ДобавитьДействиеМодификатораВЖурналБоя(Форма, МодификаторИнтуиция, 1);
		Иначе
			// Выполняем поиск далее.
		КонецЕсли;
	КонецЦикла;
	ВосхождениеКлиентСервер.УбратьНеверныеОтветы(МассивНеверных, Форма);
	Форма.НеверныеВариантыУбраны = Истина;
	ВосхождениеКлиентСервер.УправлениеВидимостью(Форма);
КонецПроцедуры		// ПрименитьМодификатор_Интуиция()

// Осуществляет применение модификатора МентальныйЩит.
// Даёт игроку 1 единицу параметра МентальныйЩит.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ПрименитьМодификатор_МентальныйЩит(Форма) Экспорт
	ВидПараметраМентальныйЩит = Перечисления.ВидыПараметровИгроков.МентальныйЩит;
	МодификаторМентальныйЩит = Справочники.Модификаторы.МентальныйЩит;
	ТекущееЗначение = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраМентальныйЩит);
	НовоеЗначение = ТекущееЗначение + 1;
	Форма.УстановитьПараметрИгрока(ВидПараметраМентальныйЩит, НовоеЗначение);
	ВосхождениеКлиентСервер.ДобавитьДействиеМодификатораВЖурналБоя(Форма, МодификаторМентальныйЩит, 1);
КонецПроцедуры		// ПрименитьМодификатор_МентальныйЩит()

// Осуществляет применение модификатора ВырваннаяСтраница.
// Заменяет один неверный ответ на ответ из другого сборника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура ПрименитьМодификатор_ВырваннаяСтраница(Форма, Гсч) Экспорт
	МодификаторВырваннаяСтраница = Справочники.Модификаторы.ВырваннаяСтраница;
	Если НЕ ВосхождениеКлиентСервер.МодификаторАктивен(Форма, МодификаторВырваннаяСтраница) Тогда
		Возврат;
	КонецЕсли;
	// Инициализация.
	Если ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины) Тогда
		КоличествоОтветов = 4;
		ТекущаяСложность = Перечисления.СложностиСборников.ЧетыреОтвета;
	ИначеЕсли Форма.Сборник.Сложность = Перечисления.СложностиСборников.ШестьОтветов Тогда
		КоличествоОтветов = 6;
		ТекущаяСложность = Перечисления.СложностиСборников.ШестьОтветов;
	Иначе
		КоличествоОтветов = 4;
		ТекущаяСложность = Перечисления.СложностиСборников.ЧетыреОтвета;
	КонецЕсли;
	// Выбор случайного неверного ответа.
	ЗначениеНайдено = Ложь;
	Пока НЕ ЗначениеНайдено Цикл
		НомерОтвета = Гсч.СлучайноеЧисло(1, КоличествоОтветов);
		Если НомерОтвета <> Форма.НомерПравильногоОтвета Тогда
			НомерКнопки = ОбщегоНазначенияКлиентСервер.ПреобразоватьНомерПравильногоОтвета(НомерОтвета, ТекущаяСложность);
			ЗначениеНайдено = Истина;
		Иначе
			// Выполняем поиск далее.
		КонецЕсли;
	КонецЦикла;
	// Получение ответа из другого сборника.
	НовыйТекстОтвета = Форма.ПолучитьОтветИзДругогоСборника(Форма.Сборник, Форма.ПравильныйОтвет);
	Если НЕ ЗначениеЗаполнено(НовыйТекстОтвета) Тогда
		Возврат;
	КонецЕсли;
	// Замена текста неверного ответа.
	Форма.Элементы["ВыбратьВариант" + Строка(НомерКнопки)].Заголовок = НовыйТекстОтвета;
	ВосхождениеКлиентСервер.ДобавитьДействиеМодификатораВЖурналБоя(Форма, МодификаторВырваннаяСтраница, 1);
КонецПроцедуры		// ПрименитьМодификатор_ВырваннаяСтраница()

// Осуществляет применение модификатора Поплавок.
// При правильном ответе с вероятностью 20% возвращает из стопки сброса
// случайную карту со стоимостью 1 или больше в руку игрока.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура ПрименитьМодификатор_Поплавок(Форма, Гсч) Экспорт
	Гсч = Новый ГенераторСлучайныхЧисел;
	Шанс = Гсч.СлучайноеЧисло(1, 100);
	МодификаторПоплавок = Справочники.Модификаторы.Поплавок;
	Если Шанс <= 20 Тогда
		Если Форма.СтопкаСброса.Количество() > 0 Тогда
			МассивПодходящих = Новый Массив;
			Для Каждого СтрокаСброса Из Форма.СтопкаСброса Цикл
				Если СтрокаСброса.Карта.Стоимость >= 1 Тогда
					МассивПодходящих.Добавить(СтрокаСброса);
				Иначе
					// Стоимость карты меньше 1. Пропускаем.
				КонецЕсли;
			КонецЦикла;
			Если МассивПодходящих.Количество() > 0 Тогда
				Индекс = Гсч.СлучайноеЧисло(0, МассивПодходящих.Количество() - 1);
				ВыбраннаяСтрока = МассивПодходящих[Индекс];
				ВосхождениеКлиентСервер.ПереместиКартуИзСтопки(ВыбраннаяСтрока.ИдентификаторКарты, "СтопкаСброса", "РукаИгрока", Форма);
				ВосхождениеКлиентСервер.ДобавитьДействиеМодификатораВЖурналБоя(Форма, МодификаторПоплавок, 1);
			Иначе
				// Нет подходящих карт в стопке сброса.
			КонецЕсли;
		Иначе
			// Стопка сброса пуста.
		КонецЕсли;
	Иначе
		// Шанс не выпал.
	КонецЕсли;
КонецПроцедуры		// ПрименитьМодификатор_Поплавок()

// Осуществляет применение модификатора Гарпун.
// При правильном ответе с вероятностью 30% возвращает из стопки сброса
// случайную карту со стоимостью 2 или больше в руку игрока.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
