//  ИдентификаторКартыВход - УникальныйИдентификатор - идентификатор карты в таблице РукаИгрока.
//
Процедура ДействиеКарты_ЛовкостьРук(Форма, КартаВход, ИдентификаторКартыВход) Экспорт
	// Перемещаем две карты из СтопкаДобора в РукаИгрока
	Форма.ДобратьВРукуКарты(2);
КонецПроцедуры		// ДействиеКарты_ЛовкостьРук()

// Обрабатывает карту "Озарение".
// Увеличивает параметр игрока Энергия на 2 единицы.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  КартаВход - СправочникСсылка.Карты - ссылка на карту.
//  ИдентификаторКартыВход - УникальныйИдентификатор - идентификатор карты в таблице РукаИгрока.
//
Процедура ДействиеКарты_Озарение(Форма, КартаВход, ИдентификаторКартыВход) Экспорт
	УвеличениеЭнергии = 2;
	ВидПараметраЭнергия = Перечисления.ВидыПараметровИгроков.Энергия;
