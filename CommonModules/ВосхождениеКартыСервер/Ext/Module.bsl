	// Инициализация.
	ВидПараметраЗолото = Перечисления.ВидыПараметровИгроков.Золото;
	МаксимальныйБонус = 100;
	// Расчёт бонуса в 30% от текущего золота.
	ЗолотоИгрока = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЗолото);
	Бонус = Цел(ЗолотоИгрока * 0.3);
	Если Бонус > МаксимальныйБонус Тогда
		Бонус = МаксимальныйБонус;
	Иначе
		// Бонус в пределах лимита.
	КонецЕсли;
	// Начисление бонуса.
	Форма.УвеличитьПараметрИгрока(ВидПараметраЗолото, Бонус);
