КонецПроцедуры		// ДействиеКарты_Укрытие()

// Обрабатывает карту "Алебарда".
// Оставляет у противника половину его текущего здоровья, округление в большую сторону.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  КартаВход - СправочникСсылка.Карты - ссылка на карту.
//  ИдентификаторКартыВход - УникальныйИдентификатор - идентификатор карты в таблице РукаИгрока.
//
Процедура ДействиеКарты_Алебарда(Форма, КартаВход, ИдентификаторКартыВход) Экспорт
	ВидПараметраТекущееЗдоровье = Перечисления.ВидыПараметровИгроков.ТекущееЗдоровье;
	Форма.ТекущееЗдоровьеПротивника = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраТекущееЗдоровье);
	НовоеЗдоровье = Цел(Форма.ТекущееЗдоровьеПротивника / 2);
	Если НовоеЗдоровье <> Форма.ТекущееЗдоровьеПротивника / 2 Тогда
		НовоеЗдоровье = Цел(Форма.ТекущееЗдоровьеПротивника / 2) + 1;
	Иначе
		// Оставляем значение.
	КонецЕсли;
	Форма.УстановитьПараметрПротивника(ВидПараметраТекущееЗдоровье, НовоеЗдоровье);
КонецПроцедуры		// ДействиеКарты_Алебарда()

// Действие карты Укрепление: проверяет, есть ли у игрока щит, если есть - игрок берёт одну карту, если нет - получает 3 щита.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  КартаВход - СправочникСсылка.Карты - ссылка на карту.
//  ИдентификаторКартыВход - УникальныйИдентификатор - идентификатор карты в таблице РукаИгрока.
//
Процедура ДействиеКарты_Укрепление(Форма, КартаВход, ИдентификаторКартыВход) Экспорт
	ВидПараметраЩит = Перечисления.ВидыПараметровИгроков.Щит;
	ТекущийЩит = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЩит);
	Если ТекущийЩит > 0 Тогда
		// Щит активен - получает 2 щита и берёт карту
		Форма.УвеличитьЩитИгрока(2);
		Форма.ДобратьКартуВРуку();
	Иначе
		// Щит неактивен - получает 3 щита
		Форма.УвеличитьЩитИгрока(3);
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_Укрепление()

// Выполняет действие карты ЩитИМеч.
// Наносит 5 единиц урона противнику и накладывает 3 единицы щита на игрока.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентифкаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_ЩитИМеч(Форма, КартаВход, ИдентифкаторКартыВход) Экспорт
	// Наносим 5 единиц урона противнику
	Форма.НанестиУронПротивнику(5);
	// Накладываем 3 единицы щита на игрока
	Форма.УвеличитьЩитИгрока(3);
КонецПроцедуры		// ДействиеКарты_ЩитИМеч()

// Выполняет действие карты ОбходнойПуть.
// Перебрасывает текущее задание на случайное.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентифкаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_ОбходнойПуть(Форма, КартаВход, ИдентифкаторКартыВход) Экспорт
	ПустойСборник = ПредопределенноеЗначение("Справочник.Сборники.ПустаяСсылка");
	Форма.НеверныеВариантыУбраны = Ложь;
	Форма.Элементы.ВыбратьВариант1.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант2.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант3.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант4.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант5.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант6.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант1.ЦветФона = Новый Цвет();
	Форма.Элементы.ВыбратьВариант2.ЦветФона = Новый Цвет();
	Форма.Элементы.ВыбратьВариант3.ЦветФона = Новый Цвет();
	Форма.Элементы.ВыбратьВариант4.ЦветФона = Новый Цвет();
	Форма.Элементы.ВыбратьВариант5.ЦветФона = Новый Цвет();
	Форма.Элементы.ВыбратьВариант6.ЦветФона = Новый Цвет();
	РезультатСмены = Форма.СледующееЗадание_Сервер(ПустойСборник, Форма.РежимВикторины);	
	Форма.Сборник = РезультатСмены.Сборник;
	Форма.АдресКартинки = РезультатСмены.АдресКартинки;
	Форма.КоличествоЗаданных = Форма.КоличествоЗаданных + 1;
	Форма.ОтветДан = Ложь;
	Форма.Заголовок = Строка(Форма.Сборник);
КонецПроцедуры		// ДействиеКарты_ОбходнойПуть()

// Выполняет действие карты Вдохновение.
// Игрок берёт 1 карту из стопки добора в руку.
// Если взятая карта стоит 0 - игрок берёт ещё одну карту.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентифкаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Вдохновение(Форма, КартаВход, ИдентифкаторКартыВход) Экспорт
	// Берём первую карту из стопки добора
	Если Форма.СтопкаДобора.Количество() > 0 Тогда
		ПерваяКарта = Форма.СтопкаДобора[0];
		ИдентификаторКарты = ПерваяКарта.ИдентификаторКарты;
		ВосхождениеКлиентСервер.ПереместиКартуИзСтопки(ИдентификаторКарты, "СтопкаДобора", "РукаИгрока", Форма);
		// Проверяем стоимость взятой карты
		Если ПерваяКарта.Карта.Стоимость = 0 Тогда
			// Если карта стоит 0 - берём ещё одну
			Форма.ДобратьКартуВРуку();
		КонецЕсли;
	Иначе
		// Стопка добора пуста.
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_Вдохновение()

// Выполняет действие карты Исчезновение.
// Игрок сбрасывает все карты из руки в стопку сброса,
// затем берёт из стопки добора такое же количество карт.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентифкаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Исчезновение(Форма, КартаВход, ИдентифкаторКартыВход) Экспорт
	// Подсчитываем количество карт в руке
	КоличествоКартВРуке = Форма.РукаИгрока.Количество();
	Если КоличествоКартВРуке > 0 Тогда
		// Сбрасываем все карты из руки в стопку сброса
		Пока Форма.РукаИгрока.Количество() > 0 Цикл
			КартаСтрока = Форма.РукаИгрока[0];
			ИдентификаторКарты = КартаСтрока.ИдентификаторКарты;
			ВосхождениеКлиентСервер.ПереместиКартуИзСтопки(ИдентификаторКарты, "РукаИгрока", "СтопкаСброса", Форма);
		КонецЦикла;
		// Берём из стопки добора такое же количество карт
		Форма.ДобратьВРукуКарты(КоличествоКартВРуке);
	Иначе
		// В руке нет карт - ничего не делаем
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_Исчезновение()

// Выполняет действие карты ПриродныйТоксин.
// Накладывает на противника 4 яда.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//  ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
