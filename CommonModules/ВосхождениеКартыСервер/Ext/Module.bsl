	ВидПараметраЯд = Перечисления.ВидыПараметровИгроков.Яд;
	Форма.УвеличитьПараметрПротивника(ВидПараметраЯд, 4);
КонецПроцедуры		// ДействиеКарты_ПриродныйТоксин()

// Выполняет действие карты ПчелиноеЖало.
// Накладывает на противника 1 яда и игрок берёт 1 карту.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//  ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_ПчелиноеЖало(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	ВидПараметраЯд = Перечисления.ВидыПараметровИгроков.Яд;
	Форма.УвеличитьПараметрПротивника(ВидПараметраЯд, 1);
	// Игрок берёт 1 карту из стопки добора в руку
	Форма.ДобратьКартуВРуку();
КонецПроцедуры		// ДействиеКарты_ПчелиноеЖало()

// Выполняет действие карты СинтетическийТоксин.
// Накладывает на противника 6 яда.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//  ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_СинтетическийТоксин(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	ВидПараметраЯд = Перечисления.ВидыПараметровИгроков.Яд;
	Форма.УвеличитьПараметрПротивника(ВидПараметраЯд, 6);
КонецПроцедуры		// ДействиеКарты_СинтетическийТоксин()

// Выполняет действие карты Скорпион.
// Накладывает на противника 5 яда, накладывает на игрока 3 яда.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//  ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Скорпион(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	ВидПараметраЯд = Перечисления.ВидыПараметровИгроков.Яд;
	Форма.УвеличитьПараметрПротивника(ВидПараметраЯд, 5);
	Форма.УвеличитьПараметрИгрока(ВидПараметраЯд, 3);
КонецПроцедуры		// ДействиеКарты_Скорпион()

// Выполняет действие карты БыстраяДетонация.
// Наносит противнику утроенный урон от яда, после чего убирает весь яд с противника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//  ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_БыстраяДетонация(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	ВидПараметраЯд = Перечисления.ВидыПараметровИгроков.Яд;
	ЗначениеЯда = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраЯд);
	Если ЗначениеЯда > 0 Тогда
		Форма.НанестиУронПротивнику(ЗначениеЯда * 3);
		Форма.УдалитьПараметрПротивника(ВидПараметраЯд);
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_БыстраяДетонация()

// Выполняет действие карты СтеклянныйЩит.
// Добавляет игроку 1 единицу параметра СтеклянныйЩит.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//  ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_СтеклянныйЩит(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	ВидПараметраСтеклянныйЩит = Перечисления.ВидыПараметровИгроков.СтеклянныйЩит;
	Форма.УвеличитьПараметрИгрока(ВидПараметраСтеклянныйЩит, 1);
КонецПроцедуры		// ДействиеКарты_СтеклянныйЩит()

// Выполняет действие карты Тройка.
// Последовательно выполняет действия:
// 1. Игрок излечивает 3 здоровья;
// 2. Игрок получает 3 щита;
// 3. Игрок наносит 3 урона противнику;
// 4. Игрок добирает 3 карты из таблицы СтопкаДобора в таблицу РукаИгрока.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентифкаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Тройка(Форма, КартаВход, ИдентифкаторКартыВход) Экспорт
	// 1. Игрок излечивает 3 здоровья
	Форма.ВосстановитьЗдоровьеИгрока(3);
	// 2. Игрок получает 3 щита
	Форма.УвеличитьЩитИгрока(3);
	// 3. Игрок наносит 3 урона противнику
	Форма.НанестиУронПротивнику(3);
