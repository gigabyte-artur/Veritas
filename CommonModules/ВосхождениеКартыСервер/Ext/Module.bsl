Процедура ДействиеКарты_ГравитационныйКоллапс(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Инициализация.
	ВидПараметраЩит = Перечисления.ВидыПараметровИгроков.Щит;
	БазовыйУрон = 20;
	// Нанесение базового урона.
	Форма.НанестиУронПротивнику(БазовыйУрон);
	// Обработка щита противника.
	ЩитПротивника = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраЩит);
	Если ЩитПротивника > 0 Тогда
		ДополнительныйУрон = Цел(ЩитПротивника / 2);
		Форма.УдалитьПараметрПротивника(ВидПараметраЩит);
		Форма.НанестиУронПротивнику(ДополнительныйУрон);
	Иначе
		// Щит у противника отсутствует.
	КонецЕсли;
