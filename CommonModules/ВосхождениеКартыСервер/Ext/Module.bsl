#Область СлужебныеМетодыКарт

// Перемещает карту из стопки добора в руку. Если карт нет - перемешивает сброс в добор.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ДобратьКартуВРуку(Форма) Экспорт
	Если Форма.СтопкаДобора.Количество() > 0 Тогда
		КартаДляПеремещения = Форма.СтопкаДобора[0];
		ИдентификаторПеремещаемойКарты = КартаДляПеремещения.ИдентификаторКарты;
		ВосхождениеКлиентСервер.ПереместиКартуИзСтопки(ИдентификаторПеремещаемойКарты, "СтопкаДобора", "РукаИгрока", Форма);
	ИначеЕсли Форма.СтопкаСброса.Количество() > 0 Тогда
		Форма.ПеремешатьСбросВДобор();
		КартаДляПеремещения = Форма.СтопкаДобора[0];
		ИдентификаторПеремещаемойКарты = КартаДляПеремещения.ИдентификаторКарты;
		ВосхождениеКлиентСервер.ПереместиКартуИзСтопки(ИдентификаторПеремещаемойКарты, "СтопкаДобора", "РукаИгрока", Форма);
	Иначе
		// Обе стопки пусты. Нечего добирать.
	КонецЕсли;
	// Проверка модификатора ПокернаяПерчатка после добора карты.
	Форма.ПрименитьМодификатор_ПокернаяПерчатка();
КонецПроцедуры		// ДобратьКартуВРуку()

// Несколько раз добирает карты из стопки добора в руку.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	КоличествоВход - Число - количество добавляемых карт.
//
Процедура ДобратьВРукуКарты(Форма, КоличествоВход) Экспорт
	Для Счетчик = 1 По КоличествоВход Цикл
		Форма.ДобратьКартуВРуку();
	КонецЦикла;
КонецПроцедуры		// ДобратьВРукуКарты()

// Возвращает строку руки игрока с картой КартаВход.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	КартаВход - СправочникСсылка.Карты - карта для поиска.
//
// Возвращаемое значение:
//	СтрокаТаблицыЗначений - строка руки с картой, или Неопределено.
//
Функция НайтиСтрокуКартыВРуке(Форма, КартаВход) Экспорт
	РезультатФункции = Неопределено;
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Карта", КартаВход);
	НайденныеСтроки = Форма.РукаИгрока.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		РезультатФункции = НайденныеСтроки[0];
	Иначе
		// Карта в руке не найдена.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// НайтиСтрокуКартыВРуке()

// Разыгрывает карту из руки без затраты энергии и перемещает её в сброс.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	СтрокаКартыВход - СтрокаТаблицыЗначений - строка руки с разыгрываемой картой.
//
Процедура РазыгратьКартуБесплатно(Форма, СтрокаКартыВход) Экспорт
	Карта = СтрокаКартыВход.Карта;
	ИдентификаторКарты = СтрокаКартыВход.ИдентификаторКарты;
	Если Карта = Справочники.Карты.Единички Тогда
		Форма.ДействиеКарты_Единички(Карта, ИдентификаторКарты);
	ИначеЕсли Карта = Справочники.Карты.Тройки Тогда
		Форма.ДействиеКарты_Тройка(Карта, ИдентификаторКарты);
	ИначеЕсли Карта = Справочники.Карты.Пятерки Тогда
		Форма.ДействиеКарты_Пятерка(Карта, ИдентификаторКарты);
	Иначе
		// Другие карты модификатором не разыгрываются.
	КонецЕсли;
	ВосхождениеКлиентСервер.ПереместиКартуИзСтопки(ИдентификаторКарты, "РукаИгрока", "СтопкаСброса", Форма);
КонецПроцедуры		// РазыгратьКартуБесплатно()

// Удаляет карту из всех стопок колоды (рука, добор, сброс) на время текущего боя.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  КартаВход - СправочникСсылка.Карты - Карта, которую требуется изгнать.
//
Процедура ИзгнатьКарту(Форма, КартаВход) Экспорт
	// Инициализация.
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Карта", КартаВход);
	// Удаление карты из руки.
	НайденныеСтроки = Форма.РукаИгрока.НайтиСтроки(СтруктураПоиска);
	Пока НайденныеСтроки.Количество() > 0 Цикл
		Форма.РукаИгрока.Удалить(НайденныеСтроки[0]);
		НайденныеСтроки = Форма.РукаИгрока.НайтиСтроки(СтруктураПоиска);
	КонецЦикла;
	// Удаление карты из стопки добора.
	НайденныеСтроки = Форма.СтопкаДобора.НайтиСтроки(СтруктураПоиска);
	Пока НайденныеСтроки.Количество() > 0 Цикл
		Форма.СтопкаДобора.Удалить(НайденныеСтроки[0]);
		НайденныеСтроки = Форма.СтопкаДобора.НайтиСтроки(СтруктураПоиска);
	КонецЦикла;
	// Удаление карты из стопки сброса.
	НайденныеСтроки = Форма.СтопкаСброса.НайтиСтроки(СтруктураПоиска);
	Пока НайденныеСтроки.Количество() > 0 Цикл
		Форма.СтопкаСброса.Удалить(НайденныеСтроки[0]);
		НайденныеСтроки = Форма.СтопкаСброса.НайтиСтроки(СтруктураПоиска);
	КонецЦикла;
КонецПроцедуры		// ИзгнатьКарту()

#КонецОбласти

#Область ДействияКарт

// Выполняет действие карты Защита.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентифкаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Защита(Форма, КартаВход, ИдентифкаторКартыВход) Экспорт
	ЗащитаКарты = 5;
	Форма.УвеличитьЩитИгрока(ЗащитаКарты);
КонецПроцедуры		// ДействиеКарты_Защита()

// Выполняет действие карты Единички.
// Последовательно выполняет действия:
// 1. Игрок излечивает 1 здоровья;
// 2. Игрок получает 1 щита;
// 3. Игрок наносит 1 урона противнику;
// 4. Игрок добирает 1 карту из таблицы СтопкаДобора в таблицу РукаИгрока.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентифкаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Единички(Форма, КартаВход, ИдентифкаторКартыВход) Экспорт
	// 1. Игрок излечивает 1 здоровья
	Форма.ВосстановитьЗдоровьеИгрока(1);
	// 2. Игрок получает 1 щита
	Форма.УвеличитьЩитИгрока(1);
	// 3. Игрок наносит 1 урона противнику
	Форма.НанестиУронПротивнику(1);
	// 4. Игрок добирает 1 карту из СтопкаДобора в РукаИгрока
	Форма.ДобратьКартуВРуку();
КонецПроцедуры		// ДействиеКарты_Единички()

// Выполняет действие карты Пасхалка.
// Случайно выбирает и выполняет одно из следующих действий:
// 1. Игрок излечивает 5 единиц здоровья;
// 2. Игрок получает 5 единиц щита;
// 3. Игрок наносит 8 урона противнику;
// 4. Игрок добирает 2 карты из таблицы СтопкаДобора в таблицу РукаИгрока.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентифкаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Пасхалка(Форма, Гсч, КартаВход, ИдентифкаторКартыВход) Экспорт
	// Случайный выбор действия от 0 до 3
	НомерДействия = Гсч.СлучайноеЧисло(0, 3);
	
	Если НомерДействия = 0 Тогда
		// 1. Игрок излечивает 5 единиц здоровья
		Форма.ВосстановитьЗдоровьеИгрока(5);
	ИначеЕсли НомерДействия = 1 Тогда
		// 2. Игрок получает 5 единиц щита
		Форма.УвеличитьЩитИгрока(5);
	ИначеЕсли НомерДействия = 2 Тогда
		// 3. Игрок наносит 8 урона противнику
		Форма.НанестиУронПротивнику(8);
	Иначе
		// 4. Игрок добирает 2 карты из СтопкаДобора в РукаИгрока
		Форма.ДобратьВРукуКарты(2);
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_Пасхалка()

// Выполняет действие карты Поправка.
// Снимает с игрока 1 негативный эффект.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентифкаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Поправка(Форма, Гсч, КартаВход, ИдентифкаторКартыВход) Экспорт
	// Получаем список отрицательных параметров из модуля менеджера перечисления ВидыПараметровИгроков
	ОтрицательныеПараметры = Перечисления.ВидыПараметровИгроков.ПолучитьОтрицательныеПараметры();
	// Формируем массив строк с отрицательными параметрами у игрока
	МассивОтрицательныхСтрок = Новый Массив;
	Для Каждого СтрокаПараметра Из Форма.ПараметрыИгрока Цикл
		Если ОтрицательныеПараметры.Найти(СтрокаПараметра.ВидПараметра) <> Неопределено Тогда
			МассивОтрицательныхСтрок.Добавить(СтрокаПараметра);
		КонецЕсли;
	КонецЦикла;
	// Удаляем 1 случайный отрицательный параметр (если есть)
	Если МассивОтрицательныхСтрок.Количество() > 0 Тогда
		Индекс = Гсч.СлучайноеЧисло(0, МассивОтрицательныхСтрок.Количество() - 1);
		СтрокаДляУдаления = МассивОтрицательныхСтрок[Индекс];
		Форма.УдалитьПараметрИгрока(СтрокаДляУдаления.ВидПараметра);
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_Поправка()

// Разыгрывает карту "Ложный маневр".
// Перемещает текущее действие противника на следующее по циклу.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_ЛожныйМаневр(Форма, КартаВход, ИдентификаторКартыВход) Экспорт
	Форма.ПереместитьДействиеПротивникаВпередПоЦиклу();
КонецПроцедуры		// ДействиеКарты_ЛожныйМаневр()

// Разыгрывает карту "Новый рассвет".
// Снимает все эффекты, кроме основных, с игрока и с противника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_НовыйРассвет(Форма, КартаВход, ИдентификаторКартыВход) Экспорт
	// Очищаем параметры игрока, кроме основных
	Форма.ОчиститьПараметрыКромеОсновных(Форма.ПараметрыИгрока);
	// Очищаем параметры противника, кроме основных
	Форма.ОчиститьПараметрыКромеОсновных(Форма.ПараметрыПротивника);
КонецПроцедуры		// ДействиеКарты_НовыйРассвет()

// Разыгрывает карту "Опровержение".
// Убирает 1 случайный положительный параметр из таблицы ПараметрыПротивника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Опровержение(Форма, Гсч, КартаВход, ИдентификаторКартыВход) Экспорт
	// Получаем список положительных параметров
	ПоложительныеПараметры = Перечисления.ВидыПараметровИгроков.ПолучитьПоложительныеПараметры();
	
	// Формируем массив строк с положительными параметрами у противника
	МассивПоложительныхСтрок = Новый Массив;
	Для Каждого СтрокаПараметра Из Форма.ПараметрыПротивника Цикл
		Если ПоложительныеПараметры.Найти(СтрокаПараметра.ВидПараметра) <> Неопределено Тогда
			МассивПоложительныхСтрок.Добавить(СтрокаПараметра);
		КонецЕсли;
	КонецЦикла;
	
	// Если есть положительные параметры, удаляем один случайный
	Если МассивПоложительныхСтрок.Количество() > 0 Тогда
		Индекс = Гсч.СлучайноеЧисло(0, МассивПоложительныхСтрок.Количество() - 1);
		СтрокаДляУдаления = МассивПоложительныхСтрок[Индекс];
		Форма.УдалитьПараметрПротивника(СтрокаДляУдаления.ВидПараметра);
	КонецЕсли;
КонецПроцедуры             // ДействиеКарты_Опровержение()

// Разыгрывает карту "Очищение".
// Удаляет 3 случайных отрицательных параметра игрока из таблицы ПараметрыИгрока.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Очищение(Форма, Гсч, КартаВход, ИдентификаторКартыВход) Экспорт
	// Получаем список отрицательных параметров
	ОтрицательныеПараметры = Перечисления.ВидыПараметровИгроков.ПолучитьОтрицательныеПараметры();
	// Формируем массив строк с отрицательными параметрами у игрока
	МассивОтрицательныхСтрок = Новый Массив;
	Для Каждого СтрокаПараметра Из Форма.ПараметрыИгрока Цикл
		Если ОтрицательныеПараметры.Найти(СтрокаПараметра.ВидПараметра) <> Неопределено Тогда
			МассивОтрицательныхСтрок.Добавить(СтрокаПараметра);
		КонецЕсли;
	КонецЦикла;
	// Удаляем до 3 случайных отрицательных параметров
	КоличествоДляУдаления = 3;
	Пока КоличествоДляУдаления > 0 И МассивОтрицательныхСтрок.Количество() > 0 Цикл
		Индекс = Гсч.СлучайноеЧисло(0, МассивОтрицательныхСтрок.Количество() - 1);
		СтрокаДляУдаления = МассивОтрицательныхСтрок[Индекс];
		Форма.УдалитьПараметрИгрока(СтрокаДляУдаления.ВидПараметра);
		МассивОтрицательныхСтрок.Удалить(Индекс);
		КоличествоДляУдаления = КоличествоДляУдаления - 1;
	КонецЦикла;
КонецПроцедуры		// ДействиеКарты_Очищение()

// Обработка карты "ЛовкостьРук".
// Перемещает две карты из таблицы СтопкаДобора в таблицу РукаИгрока.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
