// Выполняет действие карты ПраведныйГнев.
// Снимает 1 отрицательный эффект с игрока и наносит 5 урона противнику.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//	НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_ПраведныйГнев(Форма, Гсч, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Инициализация.
	ОтрицательныеПараметры = Перечисления.ВидыПараметровИгроков.ПолучитьОтрицательныеПараметры();
	// Снятие одного случайного отрицательного эффекта.
	МассивОтрицательныхСтрок = Новый Массив;
	Для Каждого СтрокаПараметра Из Форма.ПараметрыИгрока Цикл
		Если ОтрицательныеПараметры.Найти(СтрокаПараметра.ВидПараметра) <> Неопределено Тогда
			МассивОтрицательныхСтрок.Добавить(СтрокаПараметра);
		КонецЕсли;
	КонецЦикла;
	Если МассивОтрицательныхСтрок.Количество() > 0 Тогда
		Индекс = Гсч.СлучайноеЧисло(0, МассивОтрицательныхСтрок.Количество() - 1);
		СтрокаДляУдаления = МассивОтрицательныхСтрок[Индекс];
		Форма.УдалитьПараметрИгрока(СтрокаДляУдаления.ВидПараметра);
	Иначе
		// Отрицательные эффекты отсутствуют.
	КонецЕсли;
	// Нанесение 5 урона противнику.
	Форма.НанестиУронПротивнику(5);
КонецПроцедуры		// ДействиеКарты_ПраведныйГнев()

// Выполняет действие карты СдвигГраней.
// Заменяет текущее задание на случайное из того же сборника без смены этапа.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
