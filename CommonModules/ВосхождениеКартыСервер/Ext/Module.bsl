// Выполняет действие карты ПереработкаДуш.
// Сбрасывает до двух случайных карт из руки и восстанавливает 4 здоровья.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//	НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_ПереработкаДуш(Форма, Гсч, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Инициализация.
	КоличествоДляСброса = 2;
	// Сброс до двух случайных карт из руки.
	Пока КоличествоДляСброса > 0 И Форма.РукаИгрока.Количество() > 0 Цикл
		Индекс = Гсч.СлучайноеЧисло(0, Форма.РукаИгрока.Количество() - 1);
		СтрокаКарты = Форма.РукаИгрока[Индекс];
		ИдентификаторКарты = СтрокаКарты.ИдентификаторКарты;
		ВосхождениеКлиентСервер.ПереместиКартуИзСтопки(ИдентификаторКарты, "РукаИгрока", "СтопкаСброса", Форма);
		КоличествоДляСброса = КоличествоДляСброса - 1;
	КонецЦикла;
	// Восстановление 4 здоровья.
	Форма.ВосстановитьЗдоровьеИгрока(4);
КонецПроцедуры		// ДействиеКарты_ПереработкаДуш()

// Выполняет действие карты СжечьМосты.
// Сбрасывает все карты из руки и наносит противнику 4 урона за каждую сброшенную карту.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_СжечьМосты(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Инициализация.
	УронЗаКарту = 4;
	КоличествоСброшенных = Форма.РукаИгрока.Количество();
	// Сброс всех карт из руки в стопку сброса.
	Пока Форма.РукаИгрока.Количество() > 0 Цикл
		СтрокаКарты = Форма.РукаИгрока[0];
		ИдентификаторКарты = СтрокаКарты.ИдентификаторКарты;
		ВосхождениеКлиентСервер.ПереместиКартуИзСтопки(ИдентификаторКарты, "РукаИгрока", "СтопкаСброса", Форма);
	КонецЦикла;
	// Нанесение урона противнику за каждую сброшенную карту.
	Если КоличествоСброшенных > 0 Тогда
		Форма.НанестиУронПротивнику(УронЗаКарту * КоличествоСброшенных);
	Иначе
		// Карт в руке не было.
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_СжечьМосты()

// Выполняет действие карты ЩитИстины.
// Снимает 1 отрицательный эффект с игрока и накладывает 3 щита.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//	НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_ЩитИстины(Форма, Гсч, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Инициализация.
	ОтрицательныеПараметры = Перечисления.ВидыПараметровИгроков.ПолучитьОтрицательныеПараметры();
	// Снятие одного случайного отрицательного эффекта.
	МассивОтрицательныхСтрок = Новый Массив;
	Для Каждого СтрокаПараметра Из Форма.ПараметрыИгрока Цикл
		Если ОтрицательныеПараметры.Найти(СтрокаПараметра.ВидПараметра) <> Неопределено Тогда
			МассивОтрицательныхСтрок.Добавить(СтрокаПараметра);
		КонецЕсли;
	КонецЦикла;
	Если МассивОтрицательныхСтрок.Количество() > 0 Тогда
		Индекс = Гсч.СлучайноеЧисло(0, МассивОтрицательныхСтрок.Количество() - 1);
		СтрокаДляУдаления = МассивОтрицательныхСтрок[Индекс];
		Форма.УдалитьПараметрИгрока(СтрокаДляУдаления.ВидПараметра);
	Иначе
		// Отрицательные эффекты отсутствуют.
	КонецЕсли;
	// Наложение 3 щита.
	Форма.УвеличитьЩитИгрока(3);
КонецПроцедуры		// ДействиеКарты_ЩитИстины()

#КонецОбласти

