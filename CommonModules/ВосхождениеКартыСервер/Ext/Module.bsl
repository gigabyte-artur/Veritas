	// Инициализация.
	Форма.НеверныеВариантыУбраны = Ложь;
	// Сброс блокировок и цветов вариантов ответа.
	Форма.Элементы.ВыбратьВариант1.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант2.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант3.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант4.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант5.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант6.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант1.ЦветФона = Новый Цвет();
	Форма.Элементы.ВыбратьВариант2.ЦветФона = Новый Цвет();
	Форма.Элементы.ВыбратьВариант3.ЦветФона = Новый Цвет();
	Форма.Элементы.ВыбратьВариант4.ЦветФона = Новый Цвет();
	Форма.Элементы.ВыбратьВариант5.ЦветФона = Новый Цвет();
	Форма.Элементы.ВыбратьВариант6.ЦветФона = Новый Цвет();
	// Загрузка случайного задания из текущего сборника.
	РезультатСмены = Форма.ПолучитьДанныеЗаданияПоСборнику(Форма.Сборник);
	Форма.Сборник = РезультатСмены.Сборник;
	Форма.АдресКартинки = РезультатСмены.АдресКартинки;
	Форма.КоличествоЗаданных = Форма.КоличествоЗаданных + 1;
	Форма.ОтветДан = Ложь;
	Форма.Заголовок = Строка(Форма.Сборник);
КонецПроцедуры		// ДействиеКарты_СдвигГраней()

// Выполняет действие карты ТемнаяСделка.
// Наносит 8 урона противнику и накладывает случайный отрицательный эффект на игрока.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//	НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
