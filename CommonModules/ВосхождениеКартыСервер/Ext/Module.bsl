Процедура ДействиеКарты_ТемнаяСделка(Форма, Гсч, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Инициализация.
	ОтрицательныеПараметры = Перечисления.ВидыПараметровИгроков.ПолучитьОтрицательныеПараметры();
	// Нанесение 8 урона противнику.
	Форма.НанестиУронПротивнику(8);
	// Наложение случайного отрицательного эффекта на игрока.
	Если ОтрицательныеПараметры.Количество() > 0 Тогда
		Индекс = Гсч.СлучайноеЧисло(0, ОтрицательныеПараметры.Количество() - 1);
		СлучайныйДебафф = ОтрицательныеПараметры[Индекс];
		Форма.УвеличитьПараметрИгрока(СлучайныйДебафф, 1);
	Иначе
		// Список отрицательных эффектов пуст.
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_ТемнаяСделка()

