#Область Карты

// Возвращает соответствие карт их данным.
// Ключ — ссылка на карту, значение — структура с полем Стоимость.
//
// Параметры:
//  МассивКартВход - Массив - массив ссылок типа СправочникСсылка.Карты.
//
// Возвращаемое значение:
//  Соответствие - карта → Структура (Стоимость).
//
Функция ПолучитьДанныеКарт(МассивКартВход) Экспорт
	РезультатФункции = Новый Соответствие;
	Если МассивКартВход = Неопределено ИЛИ МассивКартВход.Количество() = 0 Тогда
		Возврат РезультатФункции;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Карты.Ссылка,
	|	Карты.Стоимость
	|ИЗ
	|	Справочник.Карты КАК Карты
	|ГДЕ
	|	Карты.Ссылка В (&МассивКарт)";
	Запрос.УстановитьПараметр("МассивКарт", МассивКартВход);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеКарты = Новый Структура;
		ДанныеКарты.Вставить("Стоимость", Выборка.Стоимость);
		РезультатФункции.Вставить(Выборка.Ссылка, ДанныеКарты);
	КонецЦикла;
	Возврат РезультатФункции;
КонецФункции		 // ПолучитьДанныеКарт()

// Возвращает стоимость указанной карты.
//
// Параметры:
//  КартаВход - СправочникСсылка.Карты - карта, стоимость которой требуется определить.
//
// Возвращаемое значение:
//  Число - стоимость карты в энергии; 0 если карта не найдена.
//
Функция ПолучитьСтоимостьКарты(КартаВход) Экспорт
	МассивОднойКарты = Новый Массив;
	МассивОднойКарты.Добавить(КартаВход);
	ДанныеКарты = ПолучитьДанныеКарт(МассивОднойКарты);
	СтруктураКарты = ДанныеКарты.Получить(КартаВход);
	Если СтруктураКарты <> Неопределено Тогда
		Возврат СтруктураКарты.Стоимость;
	КонецЕсли;
	Возврат 0;
КонецФункции

#КонецОбласти
