#Область Карты

// Возвращает соответствие карт их данным.
// Ключ — ссылка на карту, значение — структура с полем Стоимость.
//
// Параметры:
//  МассивКартВход - Массив - массив ссылок типа СправочникСсылка.Карты.
//
// Возвращаемое значение:
//  Соответствие - карта → Структура (Стоимость).
//
Функция ПолучитьДанныеКарт(МассивКартВход) Экспорт
	РезультатФункции = Новый Соответствие;
	Если МассивКартВход <> Неопределено И МассивКартВход.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Карты.Ссылка,
		|	Карты.Стоимость
		|ИЗ
		|	Справочник.Карты КАК Карты
		|ГДЕ
		|	Карты.Ссылка В (&МассивКарт)";
		Запрос.УстановитьПараметр("МассивКарт", МассивКартВход);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ДанныеКарты = Новый Структура;
			ДанныеКарты.Вставить("Стоимость", Выборка.Стоимость);
			РезультатФункции.Вставить(Выборка.Ссылка, ДанныеКарты);
		КонецЦикла;
	Иначе
		// Массив карт пуст или не задан. Возвращается пустое соответствие.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		 // ПолучитьДанныеКарт()

// Возвращает стоимость указанной карты.
//
// Параметры:
//  КартаВход - СправочникСсылка.Карты - карта, стоимость которой требуется определить.
//
// Возвращаемое значение:
//  Число - стоимость карты в энергии; 0 если карта не найдена.
//
Функция ПолучитьСтоимостьКарты(КартаВход) Экспорт
	РезультатФункции = 0;
	МассивОднойКарты = Новый Массив;
	МассивОднойКарты.Добавить(КартаВход);
	ДанныеКарты = ПолучитьДанныеКарт(МассивОднойКарты);
	СтруктураКарты = ДанныеКарты.Получить(КартаВход);
	Если СтруктураКарты <> Неопределено Тогда
		РезультатФункции = СтруктураКарты.Стоимость;
	Иначе
		// Карта не найдена. Стоимость остается равной 0.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции

// Перемешивает таблицу-стопку карт ТаблицаИзм.
//
// Параметры:
//	ТаблицаИзм - ТаблицаФормы - Таблица, которую нужно перемешать.
//
Процедура ПеремешатьСтопку(ТаблицаИзм) Экспорт
	Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	ВременнаяТаблица = ТаблицаИзм.Выгрузить();
	ВременнаяТаблица.Колонки.Добавить("НомерКарты");
	Для Каждого ТекВременнаяТаблица Из ВременнаяТаблица Цикл
		ТекВременнаяТаблица.НомерКарты = ГСЧ.СлучайноеЧисло(0, 9999);
	КонецЦикла;
	ВременнаяТаблица.Сортировать("НомерКарты возр");
	ТаблицаИзм.Очистить();
	ТаблицаИзм.Загрузить(ВременнаяТаблица);
КонецПроцедуры		// ПеремешатьСтопку()

#КонецОбласти

#Область Викторина

// Возвращает структуру данных для задания ЗаданиеВход.
//
// Параметры:
//  СборникВход - СправочникСсылка.Сборники - сборник, которому принадлежит задание.
//  РежимВикториныВход - ПеречислениеСсылка.РежимыВикторины - текущий режим.
//  ЗаданиеВход - СправочникСсылка.Задания - задание, для которого генерируются варианты.
//
// Возвращаемое значение:
//  Структура - с ключами НомерПравильного (Число) и МассивОтветов (Массив).
//
Функция ПолучитьВариантыОтветов(СборникВход, РежимВикториныВход, ЗаданиеВход) Экспорт
	// Инициализация.
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("НомерПравильного", 0);
	РезультатФункции.Вставить("МассивОтветов", Новый Массив);
	Гсч = Новый ГенераторСлучайныхЧисел();
	// Определение количества ответов.
	ВыгрузкаОтветов = ЗаданиеВход.ОтветыЗаданий.Выгрузить();
	ЭтоРежимВосхождение = (РежимВикториныВход = Перечисления.РежимыВикторины.Восхождение);
	Если ЭтоРежимВосхождение Тогда
		КоличествоОтветов = 4;
	Иначе
		КоличествоОтветов = 6;
		Если СборникВход.Сложность = Перечисления.СложностиСборников.ШестьОтветов Тогда
			КоличествоОтветов = 6;
		ИначеЕсли СборникВход.Сложность = Перечисления.СложностиСборников.ЧетыреОтвета Тогда
			КоличествоОтветов = 4;
		Иначе
			КоличествоОтветов = 6;
		КонецЕсли;
	КонецЕсли;
	// Поиск правильного ответа.
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Правильность", Истина);
	НайденныеСтроки = ВыгрузкаОтветов.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() = 1 Тогда
		ПравильныйОтветСтрока = НайденныеСтроки[0];
		ПравильныйОтветТекст = ПравильныйОтветСтрока.ТекстОтвета;
		// Добавление неправильных ответов.
		МассивНеправильных = Новый Массив;
		ТекСборник = ЗаданиеВход.Владелец;
		Если ТекСборник.БратьОтветыИзТекущегоСборника Тогда
			// Ответы берутся только из текущего вопроса.
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ЗаданияОтветыЗаданий.ТекстОтвета,
			|	ЗаданияОтветыЗаданий.Правильность
			|ИЗ
			|	Справочник.Задания.ОтветыЗаданий КАК ЗаданияОтветыЗаданий
			|ГДЕ
			|	ЗаданияОтветыЗаданий.Ссылка = &Ссылка
			|	И НЕ ЗаданияОтветыЗаданий.Ссылка.ПометкаУдаления
			|	И НЕ ЗаданияОтветыЗаданий.Правильность";
			Запрос.УстановитьПараметр("Ссылка", ЗаданиеВход);
			РезультатЗапроса = Запрос.Выполнить();
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				МассивНеправильных.Добавить(ВыборкаДетальныеЗаписи.ТекстОтвета);
			КонецЦикла;
		Иначе
			// Ответы берутся из всех вопросов.
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ЗаданияОтветыЗаданий.ТекстОтвета
			|ИЗ
			|	Справочник.Задания.ОтветыЗаданий КАК ЗаданияОтветыЗаданий
			|ГДЕ
			|	ЗаданияОтветыЗаданий.ТекстОтвета <> &ТекстОтвета
			|	И НЕ ЗаданияОтветыЗаданий.Ссылка.ПометкаУдаления
			|	И ЗаданияОтветыЗаданий.Ссылка.Владелец = &Владелец";
			Запрос.УстановитьПараметр("Владелец", ЗаданиеВход.Владелец);
			Запрос.УстановитьПараметр("ТекстОтвета", ПравильныйОтветТекст);
			РезультатЗапроса = Запрос.Выполнить();
			ВыгрузкаНеправильных = РезультатЗапроса.Выгрузить();
			МассивВыгрузка = ВыгрузкаНеправильных.ВыгрузитьКолонку("ТекстОтвета");
			ВсегоНеправильных = МассивВыгрузка.Количество();
			ВерхняяГраница = 1;
			Если МассивВыгрузка.Количество() >= (КоличествоОтветов - 1) Тогда
				ВерхняяГраница = (КоличествоОтветов - 1);
			Иначе
				ВерхняяГраница = МассивВыгрузка.Количество();
			КонецЕсли;
			Для Счетчик = 1 По ВерхняяГраница Цикл
				НомерОтвета = Гсч.СлучайноеЧисло(0, ВсегоНеправильных-1);
				МассивНеправильных.Добавить(МассивВыгрузка[НомерОтвета]);
			КонецЦикла;
		КонецЕсли;
		МассивНеправильных.Добавить(ПравильныйОтветТекст);
		// Перемешивание итогового массива и формирование результата.
		МассивНеправильных = ОбщегоНазначенияКлиентСервер.СмешатьМассив(МассивНеправильных, Гсч);
		ПравильныйОтветНомер = МассивНеправильных.Найти(ПравильныйОтветТекст);
		Если ПравильныйОтветНомер <> Неопределено Тогда
			РезультатФункции.Вставить("НомерПравильного", ПравильныйОтветНомер + 1);
			РезультатФункции.Вставить("МассивОтветов", МассивНеправильных);
		Иначе
			РезультатФункции.Вставить("НомерПравильного", 0);
			РезультатФункции.Вставить("МассивОтветов", Новый Массив);
		КонецЕсли;
	Иначе
		// Не удалось однозначно определить правильный ответ.
		РезультатФункции.Вставить("НомерПравильного", 0);
		РезультатФункции.Вставить("МассивОтветов", Новый Массив);
	КонецЕсли;
	// Вывод результата.
	Возврат РезультатФункции;
КонецФункции		// ПолучитьВариантыОтветов()

#КонецОбласти

#Область Персонажи

// Возвращает массив стартовых модификаторов для указанного персонажа.
//
// Параметры:
//  ПерсонажВход - СправочникСсылка.Персонажи - персонаж, для которого требуется получить модификаторы.
//
// Возвращаемое значение:
//  Массив - массив ссылок типа СправочникСсылка.Модификаторы.
//
Функция ПолучитьСтартовыеМодификаторыПерсонажа(ПерсонажВход) Экспорт
	РезультатФункции = Новый Массив;
	Если ПерсонажВход = Справочники.Персонажи.Профессор Тогда
		РезультатФункции.Добавить(Справочники.Модификаторы.Фолиант);
	ИначеЕсли ПерсонажВход = Справочники.Персонажи.Дуэлянт Тогда
		РезультатФункции.Добавить(Справочники.Модификаторы.Рапира);
	ИначеЕсли ПерсонажВход = Справочники.Персонажи.Архивариус Тогда
		РезультатФункции.Добавить(Справочники.Модификаторы.Гонг);
	ИначеЕсли ПерсонажВход = Справочники.Персонажи.Алхимик Тогда
		РезультатФункции.Добавить(Справочники.Модификаторы.БурлящаяРеторта);
	ИначеЕсли ПерсонажВход = Справочники.Персонажи.Софист Тогда
		РезультатФункции.Добавить(Справочники.Модификаторы.НеразменныйГрош);
	ИначеЕсли ПерсонажВход = Справочники.Персонажи.Еретик Тогда
		РезультатФункции.Добавить(Справочники.Модификаторы.ШипастыйБраслет);
	ИначеЕсли ПерсонажВход = Справочники.Персонажи.Оратор Тогда
		РезультатФункции.Добавить(Справочники.Модификаторы.МраморнаяТрибуна);
	Иначе
		// Для персонажа не предусмотрен стартовый модификатор.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		 // ПолучитьСтартовыеМодификаторыПерсонажа()

// Возвращает стартовую колоду для указанного персонажа.
// Если персонаж не выбран или не определён — возвращается базовая колода
// (Защита ×3, Удар ×3, Адреналин ×1).
//
// Параметры:
//  ПерсонажВход - СправочникСсылка.Персонажи - персонаж, для которого требуется получить колоду.
//
// Возвращаемое значение:
//  Массив - массив ссылок типа СправочникСсылка.Карты.
//
Функция ПолучитьСтартовуюКолодуПерсонажа(ПерсонажВход) Экспорт
	РезультатФункции = Новый Массив;
	Если ПерсонажВход = Справочники.Персонажи.Профессор Тогда
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Удар, 3);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Защита, 1);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.УсиленнаяЗащита, 2);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Адреналин, 1);
	ИначеЕсли ПерсонажВход = Справочники.Персонажи.Дуэлянт Тогда
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Удар, 1);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Лезвие, 1);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.ШепотИзБездны, 1);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Защита, 3);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Адреналин, 1);
	ИначеЕсли ПерсонажВход = Справочники.Персонажи.Архивариус Тогда
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.АдаптивнаяТактика, 1);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Удар, 2);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Защита, 2);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Черновик, 1);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Адреналин, 1);
	ИначеЕсли ПерсонажВход = Справочники.Персонажи.Алхимик Тогда
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Удар, 1);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.ПриродныйТоксин, 2);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Защита, 3);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Адреналин, 1);
	ИначеЕсли ПерсонажВход = Справочники.Персонажи.Софист Тогда
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Удар, 2);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.ГрязныйКонтракт, 1);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.ЧистыйКонтракт, 1);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Защита, 2);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Адреналин, 1);
	ИначеЕсли ПерсонажВход = Справочники.Персонажи.Еретик Тогда
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Удар, 2);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Реванш, 1);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Закалка, 1);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Защита, 2);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Адреналин, 1);
	ИначеЕсли ПерсонажВход = Справочники.Персонажи.Оратор Тогда
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Удар, 3);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Защита, 1);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.ОбходнойПуть, 1);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.МаякНаГоризонте, 1);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Адреналин, 1);
	Иначе
		// Персонаж не выбран или не определён — используется базовая колода.
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Защита, 3);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Удар, 3);
		ДобавитьКартыВКолоду(РезультатФункции, Справочники.Карты.Адреналин, 1);
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		 // ПолучитьСтартовуюКолодуПерсонажа()

// Добавляет в массив МассивКолодыИзм карту КартаВход в количестве КоличествоВход.
//
// Параметры:
//  МассивКолодыИзм - Массив - массив, в который добавляются карты.
//  КартаВход - СправочникСсылка.Карты - карта для добавления.
//  КоличествоВход - Число - количество добавляемых карт.
//
Процедура ДобавитьКартыВКолоду(МассивКолодыИзм, КартаВход, КоличествоВход)
	Для Счетчик = 1 По КоличествоВход Цикл
		МассивКолодыИзм.Добавить(КартаВход);
	КонецЦикла;
КонецПроцедуры		 // ДобавитьКартыВКолоду()

#КонецОбласти

#Область Модификаторы

// Возвращает случайный модификатор с заданными параметрами.
//
// Параметры:
//   ТолькоПоложительныеВход - Булево - Истина для положительных, Ложь для отрицательных.
//   ИсключаемыеВход         - Массив - модификаторы, которые нужно исключить из выбора.
//
// Возвращаемое значение:
//   СправочникСсылка.Модификаторы - ссылка на выбранный модификатор или пустая ссылка.
//
Функция ВернутьМодификатор(ТолькоПоложительныеВход, ИсключаемыеВход = Неопределено) Экспорт
	ГСЧ = Новый ГенераторСлучайныхЧисел;
	Если ИсключаемыеВход = Неопределено Тогда
		РезультатФункции = Справочники.Модификаторы.ВернутьМодификатор(ТолькоПоложительныеВход, ГСЧ);
	Иначе
		РезультатФункции = Справочники.Модификаторы.ВернутьМодификатор(ТолькоПоложительныеВход, ГСЧ, ИсключаемыеВход);
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ВернутьМодификатор()

#КонецОбласти

#Область СлучайныеСобытия

// Возвращает случайное событие из справочника СлучайныеСобытия.
//
// Возвращаемое значение:
//  СправочникСсылка.СлучайныеСобытия - случайное событие; пустая ссылка, если событий нет.
//
Функция ПолучитьСлучайноеСобытие() Экспорт
	// Инициализация.
	Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	РезультатФункции = ПредопределенноеЗначение("Справочник.СлучайныеСобытия.ПустаяСсылка");
	// Получение списка событий.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СлучайныеСобытия.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СлучайныеСобытия КАК СлучайныеСобытия";
	РезультатЗапроса = Запрос.Выполнить();
	ВыгрузкаСобытий = РезультатЗапроса.Выгрузить();
	МассивСобытий = ВыгрузкаСобытий.ВыгрузитьКолонку("Ссылка");
	// Выбор случайного события.
	Если МассивСобытий.Количество() > 0 Тогда
		Индекс = Гсч.СлучайноеЧисло(0, МассивСобытий.Количество() - 1);
		РезультатФункции = МассивСобытий[Индекс];
	Иначе
		// В справочнике нет событий. Возвращается пустая ссылка.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПолучитьСлучайноеСобытие()

// Возвращает награды выбранного варианта случайного события.
//
// Параметры:
//  СобытиеВход       - СправочникСсылка.СлучайныеСобытия - выбранное событие.
//  НомерВариантаВход - Число - номер выбранного варианта события.
//
// Возвращаемое значение:
//  Массив - награды варианта; элементы - структуры с ключами ВариантНаграды,
//           Направление, СпособРасчета, МинимальноеЗначение, МаксимальноеЗначение,
//           СсылкаНаграды.
//
Функция ПолучитьНаградыСобытия(СобытиеВход, НомерВариантаВход) Экспорт
	// Инициализация.
	РезультатФункции = Новый Массив;
	// Чтение наград варианта события из справочника.
	Если ЗначениеЗаполнено(СобытиеВход) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	НаградыВыбора.ВариантНаграды КАК ВариантНаграды,
			|	НаградыВыбора.Направление КАК Направление,
			|	НаградыВыбора.СпособРасчета КАК СпособРасчета,
			|	НаградыВыбора.МинимальноеЗначение КАК МинимальноеЗначение,
			|	НаградыВыбора.МаксимальноеЗначение КАК МаксимальноеЗначение,
			|	НаградыВыбора.СсылкаНаграды КАК СсылкаНаграды
			|ИЗ
			|	Справочник.СлучайныеСобытия.НаградыВыбора КАК НаградыВыбора
			|ГДЕ
			|	НаградыВыбора.Ссылка = &Событие
			|	И НаградыВыбора.НомерВарианта = &НомерВарианта";
		Запрос.УстановитьПараметр("Событие", СобытиеВход);
		Запрос.УстановитьПараметр("НомерВарианта", НомерВариантаВход);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяНаграда = Новый Структура;
			НоваяНаграда.Вставить("ВариантНаграды", Выборка.ВариантНаграды);
			НоваяНаграда.Вставить("Направление", Выборка.Направление);
			НоваяНаграда.Вставить("СпособРасчета", Выборка.СпособРасчета);
			НоваяНаграда.Вставить("МинимальноеЗначение", Выборка.МинимальноеЗначение);
			НоваяНаграда.Вставить("МаксимальноеЗначение", Выборка.МаксимальноеЗначение);
			НоваяНаграда.Вставить("СсылкаНаграды", Выборка.СсылкаНаграды);
			РезультатФункции.Добавить(НоваяНаграда);
		КонецЦикла;
	Иначе
		// Событие не задано. Наград нет.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПолучитьНаградыСобытия()

#КонецОбласти

