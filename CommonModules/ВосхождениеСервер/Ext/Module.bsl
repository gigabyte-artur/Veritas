#Область Награды

// Возвращает массив из 3 случайных неповторяемых карт для выбора награды.
//
// Параметры:
//  ПротивникВход - СправочникСсылка.Противники - побежденный противник.
//
// Возвращаемое значение:
//  Массив - массив ссылок на карты (СправочникСсылка.Карты).
//
Функция ПолучитьКартыВыборНаграды(ПротивникВход) Экспорт
	Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	// Получаем все доступные карты
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Карты.Ссылка
		|ИЗ
		|	Справочник.Карты КАК Карты
		|ГДЕ
		|	НЕ Карты.ПометкаУдаления
		|	И Карты.Открыта";
	РезультатЗапроса = Запрос.Выполнить();
	ВыгрузкаКарт = РезультатЗапроса.Выгрузить();
	МассивВсеКарты = ВыгрузкаКарт.ВыгрузитьКолонку("Ссылка");
	// Перемешиваем массив карт
	МассивВсеКарты = ОбщегоНазначенияКлиентСервер.СмешатьМассив(МассивВсеКарты, Гсч);
	// Выбираем первые 3 карты (или меньше, если карт меньше 3)
	МассивРезультат = Новый Массив;
	КоличествоКарт = Мин(3, МассивВсеКарты.Количество());
	Для Индекс = 0 По КоличествоКарт - 1 Цикл
		МассивРезультат.Добавить(МассивВсеКарты[Индекс]);
	КонецЦикла;
	Возврат МассивРезультат;
КонецФункции		// ПолучитьКартыВыборНаграды()

#КонецОбласти

