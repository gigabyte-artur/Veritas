// Выполняет действие карты Желание.
// Выбирает одно полезное действие исходя из игровой ситуации:
// - HP < 30%: щит 10
// - HP < 40%: лечение 6
// - Есть дебафф: снять 1 случайный дебафф
// - Яд противника > 0: наложить 5 яда
// - В руке < 3 карт: добрать 3 карты
// - Золото < 100: получить 12 золота
// - Иначе: нанести 15 урона противнику
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//	НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Желание(Форма, Гсч, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Инициализация.
	ВидПараметраТекущееЗдоровье			 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
	ВидПараметраМаксимальноеЗдоровье	 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.МаксимальноеЗдоровье");
	ВидПараметраЯд						 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Яд");
	ВидПараметраЗолото					 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Золото");
	// Получение текущих значений.
	ВосхождениеКлиентСервер.УстановитьТекущееЗдоровьеИгрока(Форма, ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраТекущееЗдоровье));
	Форма.МаксимальноеЗдоровьеИгрока = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраМаксимальноеЗдоровье);
	ПроцентЗдоровьяИгрока = 100;
	Если Форма.МаксимальноеЗдоровьеИгрока > 0 Тогда
		ПроцентЗдоровьяИгрока = (Форма.ТекущееЗдоровьеИгрока / Форма.МаксимальноеЗдоровьеИгрока) * 100;
	КонецЕсли;
	Если ПроцентЗдоровьяИгрока < 30 Тогда
		// HP < 30%: щит 10.
		Форма.УвеличитьЩитИгрока(10);
	ИначеЕсли ПроцентЗдоровьяИгрока < 40 Тогда
		// HP < 40%: лечение 6.
		Форма.ВосстановитьЗдоровьеИгрока(6);
	Иначе
		// Проверка наличия дебаффов.
		ОтрицательныеПараметры = Форма.ПолучитьОтрицательныеПараметры();
		МассивАктивныхДебаффов = Новый Массив;
		Для Каждого СтрокаПараметра Из Форма.ПараметрыИгрока Цикл
			Если ОтрицательныеПараметры.Найти(СтрокаПараметра.ВидПараметра) <> Неопределено Тогда
				МассивАктивныхДебаффов.Добавить(СтрокаПараметра.ВидПараметра);
			КонецЕсли;
		КонецЦикла;
		Если МассивАктивныхДебаффов.Количество() > 0 Тогда
			// Снять случайный дебафф.
			Индекс = Гсч.СлучайноеЧисло(0, МассивАктивныхДебаффов.Количество() - 1);
			СлучайныйДебафф = МассивАктивныхДебаффов[Индекс];
			Форма.УстановитьПараметрИгрока(СлучайныйДебафф, 0);
		Иначе
			ЯдПротивника = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраЯд);
			Если ЯдПротивника > 0 Тогда
				// Наложить 5 яда противнику.
				Форма.УвеличитьПараметрПротивника(ВидПараметраЯд, 5);
			ИначеЕсли Форма.РукаИгрока.Количество() < 3 Тогда
				// Добрать 3 карты.
				Форма.ДобратьВРукуКарты(3);
			Иначе
				ЗолотоИгрока = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЗолото);
				Если ЗолотоИгрока < 100 Тогда
					// Получить 12 золота.
					Форма.ПолучитьЗолото(12);
				Иначе
					// Нанести 15 урона противнику.
					Форма.НанестиУронПротивнику(15);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_Желание()

// Выполняет действие карты БумажнаяБроня.
// Сбрасывает 1 случайную карту из руки и увеличивает Стеклянный щит игрока на 1.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//  ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_БумажнаяБроня(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Инициализация.
	ВидПараметраСтеклянныйЩит = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.СтеклянныйЩит");
	// Сбрасываем 1 случайную карту из руки в стопку сброса
	ИдентификаторСбрасываемойКарты = ВосхождениеКлиент.ПолучитьСлучайнуюКартуВРуке(Форма, ИдентификаторКартыВход);
	Если ЗначениеЗаполнено(ИдентификаторСбрасываемойКарты) Тогда
		Форма.СброситьКартуПринудительно(ИдентификаторСбрасываемойКарты);
	Иначе
		// Нет карт в руке — сбрасывать нечего.
	КонецЕсли;
	// Увеличиваем Стеклянный щит на 1
	Форма.УвеличитьПараметрИгрока(ВидПараметраСтеклянныйЩит, 1);
КонецПроцедуры		// ДействиеКарты_БумажнаяБроня()

// Выполняет действие карты Черновик.
// Игрок сбрасывает случайную карту из руки и получает 8 щитов.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//  ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Черновик(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Сбрасываем случайную карту из руки в стопку сброса
	ИдентификаторСбрасываемойКарты = ВосхождениеКлиент.ПолучитьСлучайнуюКартуВРуке(Форма, ИдентификаторКартыВход);
	Если ЗначениеЗаполнено(ИдентификаторСбрасываемойКарты) Тогда
		Форма.СброситьКартуПринудительно(ИдентификаторСбрасываемойКарты);
	Иначе
		// Нет карт в руке — сбрасывать нечего.
	КонецЕсли;
	// Увеличиваем щит на 8
	Форма.УвеличитьЩитИгрока(8);
КонецПроцедуры		// ДействиеКарты_Черновик()

// Обрабатывает эффекты карт при принудительном сбросе.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  НайденнаяКарта - СправочникСсылка.Карты - Сбрасываемая карта.
//  ИдентификаторКартыВход - Строка - Идентификатор сбрасываемой карты.
//
Процедура ОбработатьДействияКартПриСбросе(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	Если НайденнаяКарта = ПредопределенноеЗначение("Справочник.Карты.АдаптивнаяТактика") Тогда
		Форма.ПриСбросеКарты_АдаптивнаяТактика(НайденнаяКарта, ИдентификаторКартыВход);
	ИначеЕсли НайденнаяКарта = ПредопределенноеЗначение("Справочник.Карты.Конденсатор") Тогда
		Форма.ПриСбросеКарты_Конденсатор(НайденнаяКарта, ИдентификаторКартыВход);
	ИначеЕсли НайденнаяКарта = ПредопределенноеЗначение("Справочник.Карты.КонцентрированныйАргумент") Тогда
		Форма.ПриСбросеКарты_КонцентрированныйАргумент(НайденнаяКарта, ИдентификаторКартыВход);
	ИначеЕсли НайденнаяКарта = ПредопределенноеЗначение("Справочник.Карты.ПаническаяАтака") Тогда
		Форма.ПриСбросеКарты_ПаническаяАтака(НайденнаяКарта, ИдентификаторКартыВход);
	ИначеЕсли НайденнаяКарта = ПредопределенноеЗначение("Справочник.Карты.Перераспределение") Тогда
		Форма.ПриСбросеКарты_Перераспределение(НайденнаяКарта, ИдентификаторКартыВход);
	ИначеЕсли НайденнаяКарта = ПредопределенноеЗначение("Справочник.Карты.ТоксичныеЧернила") Тогда
		Форма.ПриСбросеКарты_ТоксичныеЧернила(НайденнаяКарта, ИдентификаторКартыВход);
	Иначе
		// Карта не имеет эффекта при сбросе.
	КонецЕсли;
КонецПроцедуры		// ОбработатьДействияКартПриСбросе()

// Принудительно сбрасывает указанную карту из руки игрока в стопку сброса.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  ИдентификаторКартыВход - Строка - Идентификатор карты, которую требуется сбросить.
//
Процедура СброситьКартуПринудительно(Форма, ИдентификаторКартыВход) Экспорт
	Если ВосхождениеКлиентСервер.ПереместиКартуИзСтопки(ИдентификаторКартыВход, "РукаИгрока", "СтопкаСброса", Форма) Тогда
		НайденнаяКарта = ВосхождениеКлиент.ПолучитьКартуПоИдентификатору(Форма, ИдентификаторКартыВход);
		Форма.ОбработатьДействияКартПриСбросе(НайденнаяКарта, ИдентификаторКартыВход);
		// Применяем серверные модификаторы, срабатывающие при сбросе карты.
		Форма.ПрименитьМодификаторыПриСобытии(ВосхождениеКлиентСервер.ПредставлениеСобытияФормы_ПриСбросеКарты());
		// Применяем клиентский модификатор ВторичнаяПереработка.
		Форма.ПрименитьМодификатор_ВторичнаяПереработка();
	КонецЕсли;
КонецПроцедуры		// СброситьКартуПринудительно()

// Выполняет действие карты СвежийВзгляд.
// Игрок берет 3 карты из стопки добора в руку и сбрасывает 1 случайную карту из руки в стопку сброса.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//  НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//  ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_СвежийВзгляд(Форма, Гсч, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Игрок берет 3 карты из стопки добора в руку
	Форма.ДобратьВРукуКарты(3);

	// Сбрасывает 1 случайную карту из руки в стопку сброса
	Если Форма.РукаИгрока.Количество() > 0 Тогда
		Индекс = Гсч.СлучайноеЧисло(0, Форма.РукаИгрока.Количество() - 1);
		ВыбраннаяКартаСтрока = Форма.РукаИгрока[Индекс];
		ИдентификаторКарты = ВыбраннаяКартаСтрока.ИдентификаторКарты;
		ВосхождениеКлиентСервер.ПереместиКартуИзСтопки(ИдентификаторКарты, "РукаИгрока", "СтопкаСброса", Форма);
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_СвежийВзгляд()

// Выполняет действие карты Самородок.
// Игрок получает 15 золота.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Самородок(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	Форма.ПолучитьЗолото(15);
КонецПроцедуры		// ДействиеКарты_Самородок()

// Выполняет действие карты Замена.
// Игрок берет 2 карты из стопки добора в руку и сбрасывает 1 случайную карту из руки в стопку сброса.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//  НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//  ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Замена(Форма, Гсч, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Игрок берет 2 карты из стопки добора в руку
	Форма.ДобратьВРукуКарты(2);

	// Сбрасывает 1 случайную карту из руки в стопку сброса
	Если Форма.РукаИгрока.Количество() > 0 Тогда
		Индекс = Гсч.СлучайноеЧисло(0, Форма.РукаИгрока.Количество() - 1);
		ВыбраннаяКартаСтрока = Форма.РукаИгрока[Индекс];
		ИдентификаторКарты = ВыбраннаяКартаСтрока.ИдентификаторКарты;
		ВосхождениеКлиентСервер.ПереместиКартуИзСтопки(ИдентификаторКарты, "РукаИгрока", "СтопкаСброса", Форма);
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_Замена()

// Выполняет действие карты Приют.
// Игрок получает 5 щита. Если у игрока больше 11 щита, игрок берет 1 карту 
// (дополнительно) из стопки добора в руку.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//  ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Приют(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	ТекущийЩит = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Щит"));
	// Игрок получает 5 щита
	Форма.УвеличитьЩитИгрока(5);
	// Если у игрока больше 11 щита, игрок берет 1 карту из стопки добора в руку
	Если ТекущийЩит > 11 Тогда
		Форма.ДобратьКартуВРуку();
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_Приют()

// Обсуществляет розыгрыш карты КартаВход.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	КартаВход - СправочникСсылка.Карты - Карта, которую нужно разыграть.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура РазыгратьКарту(Форма, ИдентификаторКартыВход) Экспорт
	// Инициализация.
	НайденнаяКарта = ПредопределенноеЗначение("Справочник.Карты.ПустаяСсылка");
	СобытиеРазыгранаКарта = ПредопределенноеЗначение("Перечисление.СобытияБоя.РазыгранаКарта");
	ВидПараметраЭнергия = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Энергия");
	// Поиск карты по идентификатору в таблице.
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИдентификаторКарты", ИдентификаторКартыВход);
	НайденныеСтроки = Форма.РукаИгрока.НайтиСтроки(СтруктураПоиска);
	Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
		НайденнаяКарта = ТекНайденныеСтроки.Карта;
	КонецЦикла;
	Если ЗначениеЗаполнено(НайденнаяКарта) Тогда
		// Проверка энергии.
		ЭнергияИгрока = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЭнергия);
		СтоимостьКарты = Форма.ПолучитьСтоимостьКарты(НайденнаяКарта);
		Если ЭнергияИгрока >= СтоимостьКарты Тогда
			// Розыгрыш карты.
			Форма.УвеличитьПараметрИгрока(ВидПараметраЭнергия, -СтоимостьКарты);
			Форма.ДействиеВыбраннойКарты(НайденнаяКарта, ИдентификаторКартыВход);
			Если СтоимостьКарты = 0 И ВосхождениеКлиент.ПрименитьМодификатор_ИзумрудныйГеккон(Форма) Тогда
				// Карта остаётся в руке благодаря ИзумрудномуГеккону.
			Иначе
				ВосхождениеКлиентСервер.ПереместиКартуИзСтопки(ИдентификаторКартыВход, "РукаИгрока", "СтопкаСброса", Форма);
			КонецЕсли;
			// Запись в журнал боя.
			ВосхождениеКлиентСервер.ДобавитьЗаписьВЖурналБоя(Форма, СобытиеРазыгранаКарта, НайденнаяКарта);
			// Отображение на форме.
			Форма.ОтобразитьСостояниеИгрока();
			Форма.ОтобразитьСостояниеПротивника();
		Иначе
			ПоказатьПредупреждение(, НСтр("ru = 'Недостаточно энергии для розыгрыша этой карты.'"), 5);
		КонецЕсли;
	Иначе
		Сообщить("Карта " + Строка(ИдентификаторКартыВход) + " не найдена.");
	КонецЕсли;
КонецПроцедуры		// РазыгратьКарту()

// Выполняет действие карты Фокус.
// Меняет местами стопки сброса и добора, после чего игрок берёт одну карту из стопки добора.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//  ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Фокус(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Сохраняем карты из обеих стопок в массивы структур
	МассивСтопкаСброса = Новый Массив;
	Для Каждого ТекСтрока Из Форма.СтопкаСброса Цикл
		СтруктураКарты = Новый Структура;
		СтруктураКарты.Вставить("Карта", ТекСтрока.Карта);
		СтруктураКарты.Вставить("ИдентификаторКарты", ТекСтрока.ИдентификаторКарты);
		МассивСтопкаСброса.Добавить(СтруктураКарты);
	КонецЦикла;
	МассивСтопкаДобора = Новый Массив;
	Для Каждого ТекСтрока Из Форма.СтопкаДобора Цикл
		СтруктураКарты = Новый Структура;
		СтруктураКарты.Вставить("Карта", ТекСтрока.Карта);
		СтруктураКарты.Вставить("ИдентификаторКарты", ТекСтрока.ИдентификаторКарты);
		МассивСтопкаДобора.Добавить(СтруктураКарты);
	КонецЦикла;
	// Очищаем обе стопки
	Форма.СтопкаСброса.Очистить();
	Форма.СтопкаДобора.Очистить();
	// Заполняем стопку добора картами из бывшей стопки сброса
	Для Каждого ТекКарта Из МассивСтопкаСброса Цикл
		НоваяСтрока = Форма.СтопкаДобора.Добавить();
		НоваяСтрока.Карта = ТекКарта.Карта;
		НоваяСтрока.ИдентификаторКарты = ТекКарта.ИдентификаторКарты;
	КонецЦикла;
	// Заполняем стопку сброса картами из бывшей стопки добора
	Для Каждого ТекКарта Из МассивСтопкаДобора Цикл
		НоваяСтрока = Форма.СтопкаСброса.Добавить();
		НоваяСтрока.Карта = ТекКарта.Карта;
		НоваяСтрока.ИдентификаторКарты = ТекКарта.ИдентификаторКарты;
	КонецЦикла;
	// Игрок берёт одну карту из стопки добора
	Форма.ДобратьКартуВРуку();
КонецПроцедуры		// ДействиеКарты_Фокус()

// Выполняет действие карты УсиленнаяЗащита.
// Игрок получает 7 единиц щита с учётом модификаторов.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_УсиленнаяЗащита(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	Форма.УвеличитьЩитИгрока(7);
КонецПроцедуры		// ДействиеКарты_УсиленнаяЗащита()

// Выполняет действие карты УсиленныйУдар.
// Наносит противнику 11 единиц урона.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_УсиленныйУдар(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	УронКарты = 11;
	Форма.УронПротивникуПоКоличеству(УронКарты);
КонецПроцедуры		// ДействиеКарты_УсиленныйУдар()

// Выполняет действие карты ЧитКод.
// Мгновенная победа — наносит противнику урон, равный сумме его текущего здоровья и щита.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_ЧитКод(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Инициализация.
	ВидЗдоровья = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
	ВидЩита = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Щит");
	// Поиск текущего здоровья противника.
	СтруктураПоискаЗдоровье = Новый Структура;
	СтруктураПоискаЗдоровье.Вставить("ВидПараметра", ВидЗдоровья);
	НайденныеСтрокиЗдоровье = Форма.ПараметрыПротивника.НайтиСтроки(СтруктураПоискаЗдоровье);
	Если НайденныеСтрокиЗдоровье.Количество() > 0 Тогда
		ЗдоровьеПротивника = НайденныеСтрокиЗдоровье[0].ЗначениеПараметра;
	Иначе
		ЗдоровьеПротивника = 0;
	КонецЕсли;
	// Поиск щита противника.
	СтруктураПоискаЩит = Новый Структура;
	СтруктураПоискаЩит.Вставить("ВидПараметра", ВидЩита);
	НайденныеСтрокиЩит = Форма.ПараметрыПротивника.НайтиСтроки(СтруктураПоискаЩит);
	Если НайденныеСтрокиЩит.Количество() > 0 Тогда
		ЩитПротивника = НайденныеСтрокиЩит[0].ЗначениеПараметра;
	Иначе
		ЩитПротивника = 0;
	КонецЕсли;
	// Нанесение суммарного урона.
	УронКарты = ЗдоровьеПротивника + ЩитПротивника;
	Форма.УронПротивникуПоКоличеству(УронКарты);
КонецПроцедуры		// ДействиеКарты_ЧитКод()

// Выполняет действие карты Зазеркалье.
// Разыгрывает все карты в руке стоимостью 0 дважды, после чего отправляет их в сброс.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//  ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Зазеркалье(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Собираем идентификаторы всех карт в руке стоимостью 0 (кроме самой разыгрываемой)
	МассивКартДляРозыгрыша = Новый Массив;
	Для Каждого ТекСтрока Из Форма.РукаИгрока Цикл
		Если ТекСтрока.ИдентификаторКарты <> ИдентификаторКартыВход
			И ТекСтрока.Карта.Стоимость = 0 Тогда
			СтруктураКарты = Новый Структура;
			СтруктураКарты.Вставить("Карта", ТекСтрока.Карта);
			СтруктураКарты.Вставить("ИдентификаторКарты", ТекСтрока.ИдентификаторКарты);
			МассивКартДляРозыгрыша.Добавить(СтруктураКарты);
		КонецЕсли;
	КонецЦикла;
	// Разыгрываем каждую найденную карту дважды
	Для Каждого ТекСтруктура Из МассивКартДляРозыгрыша Цикл
		// Первый розыгрыш: применяем эффект (карта остаётся в руке)
		Форма.ДействиеВыбраннойКарты(ТекСтруктура.Карта, ТекСтруктура.ИдентификаторКарты);
		// Второй розыгрыш + сброс + обновление UI через РазыгратьКарту
		Форма.РазыгратьКарту(ТекСтруктура.ИдентификаторКарты);
	КонецЦикла;
КонецПроцедуры		// ДействиеКарты_Зазеркалье()

// Разыгрывает карту "Весы жизни".
// Случайно: вылечить 4 здоровья или получить 4 щитов.
// Если здоровье меньше половины, шанс лечения увеличивается в 1.5 раза.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//  НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//  ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_ВесыЖизни(Форма, Гсч, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	ШансЛечения = 50;
	ТекущееЗдоровье = Форма.ТекущееЗдоровьеИгрока;
	МаксимальноеЗдоровье = ВосхождениеКлиентСервер.ПолучитьМаксимальноеЗдоровьеИгрока(Форма);
	Если МаксимальноеЗдоровье > 0 И ТекущееЗдоровье < МаксимальноеЗдоровье / 2 Тогда
		ШансЛечения = 50 * 1.5;
	КонецЕсли;
	Случайное = Гсч.СлучайноеЧисло(1, 100);
	Если Случайное <= ШансЛечения Тогда
		Форма.ВосстановитьЗдоровьеИгрока(4);
	Иначе
		Форма.УвеличитьЩитИгрока(4);
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_ВесыЖизни()

// Выполняет действие карты ПереоценкаЦенностей.
// Мгновенно разыгрывает самую дорогую карту из руки без затраты энергии.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_ПереоценкаЦенностей(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Поиск самой дорогой карты в руке, кроме разыгрываемой.
	СтрокаКарты = ВосхождениеКлиент.НайтиСамуюДорогуюКартуВРуке(Форма, ИдентификаторКартыВход);
	Если СтрокаКарты <> Неопределено Тогда
		// Мгновенный розыгрыш без затрат энергии.
		Форма.ДействиеВыбраннойКарты(СтрокаКарты.Карта, СтрокаКарты.ИдентификаторКарты);
		// Отправка разыгранной карты в сброс.
		ВосхождениеКлиентСервер.ПереместиКартуИзСтопки(СтрокаКарты.ИдентификаторКарты, "РукаИгрока", "СтопкаСброса", Форма);
	Иначе
		// В руке нет других карт.
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_ПереоценкаЦенностей()

// Выполняет действие карты ШепотИзБездны.
// Накладывает на игрока параметр ШепотИзБездны и наносит игроку 2 урона.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_ШепотИзБездны(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Инициализация.
	ВидПараметраШепотИзБездны = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ШепотИзБездны");
	// Накладываем на игрока параметр ШепотИзБездны.
	Форма.УвеличитьПараметрИгрока(ВидПараметраШепотИзБездны, 1);
	// Наносим игроку 2 урона.
	Форма.НанестиУронИгроку(2);
КонецПроцедуры		// ДействиеКарты_ШепотИзБездны()

// Выполняет эффект карты КонцентрированныйАргумент при принудительном сбросе.
// Наносит противнику 10 урона единовременно.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  НайденнаяКарта - СправочникСсылка.Карты - Карта, которую сбрасываем.
//  ИдентификаторКартыВход - Строка - Идентификатор сбрасываемой карты.
//
Процедура ПриСбросеКарты_КонцентрированныйАргумент(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	Форма.УронПротивникуПоКоличеству(10);
КонецПроцедуры		// ПриСбросеКарты_КонцентрированныйАргумент()

// Выполняет эффект карты ПаническаяАтака при принудительном сбросе.
// Игрок добирает 3 карты и получает 3 урона.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  НайденнаяКарта - СправочникСсылка.Карты - Карта, которую сбрасываем.
//  ИдентификаторКартыВход - Строка - Идентификатор сбрасываемой карты.
//
Процедура ПриСбросеКарты_ПаническаяАтака(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Добор трёх карт в руку.
	Форма.ДобратьВРукуКарты(3);
	// Нанесение 3 урона игроку.
	Форма.НанестиУронИгроку(3);
КонецПроцедуры		// ПриСбросеКарты_ПаническаяАтака()

#КонецОбласти

#Область СохранениеЗагрузка

//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ПроверитьСохранениеВосхождения(Форма) Экспорт
	СтруктураСохранения = Форма.ПолучитьСтруктуруСохранения(Форма.ТекПользователь);
	СохранениеНайдено = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураСохранения, "СохранениеНайдено", Ложь);
	ХранилищеСохранения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураСохранения, "ХранилищеСохранения", Неопределено);
	Если СохранениеНайдено Тогда
		СтруктураДополнительныхПараметов = Новый Структура;
		СтруктураДополнительныхПараметов.Вставить("ХранилищеСохранения", ХранилищеСохранения);
		Оповещение = Новый ОписаниеОповещения("ПодтверждениеЗагрузкаСохранения_Завершение", Форма, СтруктураДополнительныхПараметов);
		ТекстВопроса = НСтр("ru = 'Загрузить последнее сохранение?'");
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
	Иначе
		// Выполняем стандартную загрузку.
	КонецЕсли;
КонецПроцедуры

// Сохраняет результаты восхождения.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура СохранитьВосхождение(Форма) Экспорт
	Форма.СохранитьВосхождение_Сервер();
КонецПроцедуры		// СохранитьВосхождение()

//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ПодтверждениеЗагрузкаСохранения_Завершение(Форма, Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		Попытка
			ХранилищеСохранения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, "ХранилищеСохранения", Неопределено);
			Форма.ЗагрузитьХранилищеСохранения(ХранилищеСохранения);
			// Повторное сохранение после загрузки.
			Форма.СохранитьВосхождение();
		Исключение
			ТекстСообщения = НСтр("ru = 'При попытке загрузить сохранение возникла ошибка: %ОписаниеОшибки%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
			Сообщить(ТекстСообщения);
		КонецПопытки;
	Иначе
		// Пользователь отказался. Ничего не делаем.
	КонецЕсли;
КонецПроцедуры		// ПодтверждениеЗагрузкаСохранения_Завершение()

#КонецОбласти

#Область ОбновлениеИнтерфейсаБоя

// Обновляет прогресс-бар здоровья противника на клиенте по реквизиту ТекущееЗдоровьеПротивника.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ОбновитьПолосуЗдоровьяПротивникаНаКлиенте(Форма) Экспорт
	Если Форма.МаксимальноеЗдоровьеПротивника > 0 Тогда
		Форма.ПрогрессЗдоровьяПротивникаПроценты = (Форма.ТекущееЗдоровьеПротивника / Форма.МаксимальноеЗдоровьеПротивника) * 100;
		ЗаполнениеВраг = Цел(Форма.ПрогрессЗдоровьяПротивникаПроценты / 100 * 20);
		ТекстБараВраг = "";
		Для Сч = 1 По 20 Цикл
			ТекстБараВраг = ТекстБараВраг + ?(Сч <= ЗаполнениеВраг, "█", "░");
		КонецЦикла;
		Форма.Элементы.HUD_БарЗдоровьяПротивника.Заголовок = ТекстБараВраг;
		Форма.Элементы.HUD_БарЗдоровьяПротивника.ЦветТекста = WebЦвета.ТемноКрасный;
	КонецЕсли;
КонецПроцедуры		// ОбновитьПолосуЗдоровьяПротивникаНаКлиенте()

// Обновляет полосу здоровья игрока на клиенте (только UI, без серверного вызова).
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ОбновитьПолосуЗдоровьяИгрокаНаКлиенте(Форма) Экспорт
	Если Форма.МаксимальноеЗдоровьеИгрока > 0 Тогда
		Форма.ПрогрессЗдоровьяИгрокаПроценты = (Форма.ТекущееЗдоровьеИгрока / Форма.МаксимальноеЗдоровьеИгрока) * 100;
		ЗаполнениеИгрок = Цел(Форма.ПрогрессЗдоровьяИгрокаПроценты / 100 * 20);
		ТекстБараИгрок = "";
		Для Сч = 1 По 20 Цикл
			ТекстБараИгрок = ТекстБараИгрок + ?(Сч <= ЗаполнениеИгрок, "█", "░");
		КонецЦикла;
		Форма.Элементы.HUD_БарЗдоровьяИгрока.Заголовок = ТекстБараИгрок;
		Если Форма.ТекущееЗдоровьеИгрока < Форма.МаксимальноеЗдоровьеИгрока * 0.3 Тогда
			Форма.Элементы.HUD_БарЗдоровьяИгрока.ЦветТекста = WebЦвета.Красный;
		Иначе
			Форма.Элементы.HUD_БарЗдоровьяИгрока.ЦветТекста = WebЦвета.ЗеленыйЛес;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры		// ОбновитьПолосуЗдоровьяИгрокаНаКлиенте()

// Обновляет кнопки-слоты карт в руке игрока, переиспользуя
// предопределённые элементы КартаСлот1..10.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ОбновитьРукуКарт(Форма) Экспорт
	// Инициализация.
	ВидПараметраЭнергия = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Энергия");
	ЭнергияИгрока = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЭнергия);
	МассивСлотов = Новый Массив;
	МассивСлотов.Добавить("КартаСлот1");
	МассивСлотов.Добавить("КартаСлот2");
	МассивСлотов.Добавить("КартаСлот3");
	МассивСлотов.Добавить("КартаСлот4");
	МассивСлотов.Добавить("КартаСлот5");
	МассивСлотов.Добавить("КартаСлот6");
	МассивСлотов.Добавить("КартаСлот7");
	МассивСлотов.Добавить("КартаСлот8");
	МассивСлотов.Добавить("КартаСлот9");
	МассивСлотов.Добавить("КартаСлот10");
	// Скрываем все слоты, потом покажем нужные.
	Для Каждого ИмяСлота Из МассивСлотов Цикл
		Форма.Элементы[ИмяСлота].Видимость = Ложь;
	КонецЦикла;
	// Заполняем слоты по количеству карт в руке.
	Индекс = 0;
	// Пакетное получение стоимости всех карт одной пачкой.
	МассивСсылокКарт = Новый Массив;
	Для Каждого КартаИзРуки Из Форма.РукаИгрока Цикл
		МассивСсылокКарт.Добавить(КартаИзРуки.Карта);
	КонецЦикла;
	ДанныеКарт = Форма.ПолучитьДанныеКарт(МассивСсылокКарт);
	Для Каждого КартаИзРуки Из Форма.РукаИгрока Цикл
		Если Индекс >= МассивСлотов.Количество() Тогда
			Прервать;
		КонецЕсли;
		ИмяСлота = МассивСлотов[Индекс];
		Элемент = Форма.Элементы[ИмяСлота];
		Элемент.Видимость = Истина;
		СтруктураКарты = ДанныеКарт.Получить(КартаИзРуки.Карта);
		Стоимость = 0;
		Если СтруктураКарты = Неопределено Тогда
			Стоимость = 0;
		Иначе
			Стоимость = СтруктураКарты.Стоимость;
		КонецЕсли;
		Элемент.Заголовок = "⚡" + Строка(Стоимость) + " " + Строка(КартаИзРуки.Карта);
		Элемент.Доступность = (ЭнергияИгрока >= Стоимость);
		//// Цвет рамки в зависимости от типа карты (Атака/Защита/Навык).
		//Попытка
		//	ТипКарты = КартаИзРуки.Карта.ТипКарты;
		//	Если ТипКарты = ПредопределенноеЗначение("Перечисление.ТипыКарт.Атака") Тогда
		//		Элемент.УстановитьОформление(Новый Оформление(, WebЦвета.ТемноКрасный));
		//	ИначеЕсли ТипКарты = ПредопределенноеЗначение("Перечисление.ТипыКарт.Защита") Тогда
		//		Элемент.УстановитьОформление(Новый Оформление(, WebЦвета.ТемноСиний));
		//	ИначеЕсли ТипКарты = ПредопределенноеЗначение("Перечисление.ТипыКарт.Навык") Тогда
		//		Элемент.УстановитьОформление(Новый Оформление(, WebЦвета.ТемноЗеленый));
		//	Иначе
		//		// Неизвестный тип. Оставляем без цвета.
		//	КонецЕсли;
		//Исключение
		//	// Ошибка определения типа. Пропускаем оформление.
		//КонецПопытки;
		Индекс = Индекс + 1;
	КонецЦикла;
КонецПроцедуры		// ОбновитьРукуКарт()

#КонецОбласти

#Область СерияОтветов

//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура НаградаСерии_Завершение(Форма, ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		Награда = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВыбранноеЗначение, "Награда", Неопределено);
		Размер  = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВыбранноеЗначение, "Размер", Неопределено);
		Если Награда = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Золото") Тогда
			// Золото.
			Форма.УвеличитьПараметрИгрока(ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Золото"), Размер);
		ИначеЕсли Награда = ПредопределенноеЗначение("Справочник.Карты.ПустаяСсылка") Тогда
			// Добор карт.
			Форма.ДобратьВРукуКарты(Размер);
		ИначеЕсли Награда = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.Атака") Тогда
			// Атака.
			Форма.УронПротивникуПоКоличеству(Размер);
		ИначеЕсли Награда = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Энергия") Тогда
			// Энергия.
			Форма.УвеличитьПараметрИгрока(ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Энергия"), Размер);
		ИначеЕсли Награда = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Щит") Тогда
			// Щит.
			Форма.УвеличитьЩитИгрока(Размер);
		Иначе
			Сообщить("Неизвестный тип награды: " + Награда);
		КонецЕсли;
		Форма.ПрименитьМодификаторыПриСобытии(ВосхождениеКлиентСервер.ПредставлениеСобытияФормы_ПриПолученииНаградыЗаСерию());
		Форма.ОтобразитьСледующееЗадание(Форма.Сборник);
		Форма.ОтобразитьСостояниеИгрока();
		Форма.ОтобразитьСостояниеПротивника();
	Иначе
        // Пользователь отказался. Ничего не делаем.
	КонецЕсли;
КонецПроцедуры		// НаградаСерии_Заверешние()

// Увеличивает Заряд серии на 1, при необходимости выполняет связанные действия.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура УвеличитьЗарядСерии(Форма) Экспорт
	// Инициализация.
	ВидПараметраЭнергия = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Энергия");
	ВидПараметраТекущееЗдоровье = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
	ВидПараметраМаксимальноеЗдоровье = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.МаксимальноеЗдоровье");
	Если Форма.ЗарядСерии < 2 Тогда
		// Серия не собранна. Увеличиваем заряд.
		Форма.ЗарядСерии = Форма.ЗарядСерии + 1;
		Форма.ОтобразитьСледующееЗадание(Форма.Сборник);
		Форма.ОтобразитьСостояниеИгрока();
		Форма.ОтобразитьСостояниеПротивника();
	Иначе
		// Обнуляем заряд серии.
		Форма.ЗарядСерии = 0;
		// Считывание данных формы.
		СписокМодификаторов = Новый СписокЗначений;
		Для Каждого СтрокаМодификатора Из Форма.Модификаторы Цикл
			СписокМодификаторов.Добавить(СтрокаМодификатора.Модификатор);
		КонецЦикла;
		СписокКартИгрока = Новый СписокЗначений;
		Для Каждого ТекСтрока Из Форма.РукаИгрока Цикл
			СтруктураКарты = Новый Структура;
			СтруктураКарты.Вставить("Карта", ТекСтрока.Карта);
			СтруктураКарты.Вставить("ИдентификаторКарты", ТекСтрока.ИдентификаторКарты);
			СписокКартИгрока.Добавить(СтруктураКарты);
		КонецЦикла;
		// Заполнение параметров новой формы.
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЭнергияИгрока",					 ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЭнергия));
		ПараметрыФормы.Вставить("ЗдоровьеПротивника",				 ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраТекущееЗдоровье));
		ПараметрыФормы.Вставить("МаксимальноеЗдоровьеПротивника",	 ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраМаксимальноеЗдоровье));
		ПараметрыФормы.Вставить("Модификаторы",						 СписокМодификаторов);
		ПараметрыФормы.Вставить("КартыИгрока",						 СписокКартИгрока);
		// Открытие формы награды за серию.
		ОписаниеОповещенияЗакрытие = Новый ОписаниеОповещения("НаградаСерии_Завершение", ЭтотОбъект);
		ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаНаградаСерии", ПараметрыФормы, Форма, , , , ОписаниеОповещенияЗакрытие, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
