#Область ВыборВидаЭтапа

// Удаляет первый найденный экземпляр карты из всех стопок игрока.
// Последовательно ищет в СтопкаДобора, РукаИгрока, СтопкаСброса
// и удаляет первое совпадение по полю Карта.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  КартаДляУдаленияВход - СправочникСсылка.Карты - ссылка на карту для удаления.
//
Процедура УдалитьОднуКартуИзСтопок(Форма, КартаДляУдаленияВход) Экспорт
	ВсегоКарт = Форма.СтопкаДобора.Количество() + Форма.РукаИгрока.Количество() + Форма.СтопкаСброса.Количество();
	Если ВсегоКарт <= 5 Тогда
		Сообщить("Нельзя удалить карту: у вас должно быть больше 5 карт.");
		Возврат;
	КонецЕсли;
	СтруктураПоиска = Новый Структура("Карта", КартаДляУдаленияВход);
	НайденныеСтроки = Форма.СтопкаДобора.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Форма.СтопкаДобора.Удалить(НайденныеСтроки[0]);
		Возврат;
	КонецЕсли;
	НайденныеСтроки = Форма.РукаИгрока.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Форма.РукаИгрока.Удалить(НайденныеСтроки[0]);
		Возврат;
	КонецЕсли;
	НайденныеСтроки = Форма.СтопкаСброса.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Форма.СтопкаСброса.Удалить(НайденныеСтроки[0]);
	КонецЕсли;
КонецПроцедуры		// УдалитьОднуКартуИзСтопок()

// Обработка этапа "Отдых".
// Восстанавливает игроку 30% от максимального здоровья, но не больше максимального.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура Отдых(Форма) Экспорт
	// Обработка этапа "Отдых"
	ВидПараметраМаксимальноеЗдоровье	 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.МаксимальноеЗдоровье");
	ВидПараметраТекущееЗдоровье			 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
	МаксимальноеЗдоровье	 = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраМаксимальноеЗдоровье);
	ТекущееЗдоровьеДо		 = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраТекущееЗдоровье);
	Восстановление = Цел(МаксимальноеЗдоровье * 0.3);
	// Открываем форму отдыха с параметрами восстановления
	ОписаниеОповещения = Новый ОписаниеОповещения("Отдых_Завершение", Форма);
	СтруктураПараметровФормы = Новый Структура;
	СтруктураПараметровФормы.Вставить("ВосстановленноеЗдоровье",	 Восстановление);
	СтруктураПараметровФормы.Вставить("ТекущееЗдоровье",			 ТекущееЗдоровьеДо);
	// Собираем карты игрока для передачи в форму отдыха
	СписокКартИгрока = Новый СписокЗначений;
	Для Каждого ТекСтрока Из Форма.СтопкаДобора Цикл
		СписокКартИгрока.Добавить(ТекСтрока.Карта);
	КонецЦикла;
	Для Каждого ТекСтрока Из Форма.РукаИгрока Цикл
		СписокКартИгрока.Добавить(ТекСтрока.Карта);
	КонецЦикла;
	Для Каждого ТекСтрока Из Форма.СтопкаСброса Цикл
		СписокКартИгрока.Добавить(ТекСтрока.Карта);
	КонецЦикла;
	СтруктураПараметровФормы.Вставить("КартыИгрока", СписокКартИгрока);
	ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаОтдыха", 
		СтруктураПараметровФормы, Форма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры		// Отдых()

// Обрабатывает этап "Сокровище".
// Получает случайный положительный модификатор, исключая имеющиеся и неоткрытые,
// и открывает форму получения модификатора.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ОбработатьЭтапСокровище(Форма) Экспорт
	Результат = ПредопределенноеЗначение("Справочник.Модификаторы.ПустаяСсылка");
	// Формируем массив текущих модификаторов игрока для исключения
	ИсключаемыеМодификаторы = Новый Массив;
	Для Каждого СтрокаМодификатора Из Форма.Модификаторы Цикл
		ИсключаемыеМодификаторы.Добавить(СтрокаМодификатора.Модификатор);
	КонецЦикла;
	// Добавляем все неоткрытые модификаторы в исключения
	МассивНеоткрытых = Форма.ПолучитьНеоткрытыеМодификаторы();
	Для Каждого НеоткрытыйМодификатор Из МассивНеоткрытых Цикл
		ИсключаемыеМодификаторы.Добавить(НеоткрытыйМодификатор);
	КонецЦикла;
	// Получаем случайный положительный модификатор, исключая имеющиеся
	НовыйМодификатор = Форма.ВернутьМодификатор(Истина, ИсключаемыеМодификаторы);
	Если ЗначениеЗаполнено(НовыйМодификатор) Тогда
		// Добавляем новый модификатор в таблицу модификаторов игрока
		НоваяСтрока = Форма.Модификаторы.Добавить();
		НоваяСтрока.Модификатор = НовыйМодификатор;
		НоваяСтрока.ЕстьДлительность = Ложь;
		НоваяСтрока.ОставшаясяДлительность = 0;
		Результат = НовыйМодификатор;
	Иначе
		// Не удалось найти подходящий модификатор (возможно все уже получены)
	КонецЕсли;
	// Открываем форму получения модификатора с параметром полученного модификатора
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПолученияМодификатора_Завершение", Форма);
	СтруктураПараметровФормы = Новый Структура("Модификатор", Результат);
	ОткрытьФорму("Справочник.Модификаторы.Форма.ФормаПолученияМодификатора",
		СтруктураПараметровФормы, Форма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры		// ОбработатьЭтапСокровище()

// Удаляет карты из стопок игрока по списку идентификаторов.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  УдаленныеКартыВход - СписокЗначений - список удалённых карт, где Значение элемента — строка
//                                         идентификатора карты для удаления.
//
Процедура ОбработатьУдаленныеКарты(Форма, УдаленныеКартыВход) Экспорт
	Для Каждого ТекУдаленнаяКарта Из УдаленныеКартыВход Цикл
		ИдентификаторУдаляемойКарты = ТекУдаленнаяКарта.Значение;
		СтруктураПоиска = Новый Структура("ИдентификаторКарты", ИдентификаторУдаляемойКарты);
		НайденныеСтроки = Форма.СтопкаДобора.НайтиСтроки(СтруктураПоиска);
		Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
			Форма.СтопкаДобора.Удалить(ТекНайденныеСтроки);
		КонецЦикла;
		НайденныеСтроки = Форма.РукаИгрока.НайтиСтроки(СтруктураПоиска);
		Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
			Форма.РукаИгрока.Удалить(ТекНайденныеСтроки);
		КонецЦикла;
		НайденныеСтроки = Форма.СтопкаСброса.НайтиСтроки(СтруктураПоиска);
		Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
			Форма.СтопкаСброса.Удалить(ТекНайденныеСтроки);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Удаляет из всех стопок карты с пустой ссылкой или Неопределено.
// Проверяет колонку Карта в СтопкаДобора, РукаИгрока и СтопкаСброса.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура УдалитьНезаполненныеКартыИзСтопок(Форма) Экспорт
	УдалитьНезаполненныеКартыИзТаблицы(Форма.СтопкаДобора);
	УдалитьНезаполненныеКартыИзТаблицы(Форма.РукаИгрока);
	УдалитьНезаполненныеКартыИзТаблицы(Форма.СтопкаСброса);
КонецПроцедуры		// УдалитьНезаполненныеКартыИзСтопок()

// Удаляет из таблицы строки, у которых не заполнено значение в колонке Карта.
// Обход в обратном порядке для безопасного удаления.
//
// Параметры:
//  ТаблицаВход - ТаблицаЗначений - таблица для очистки.
//
Процедура УдалитьНезаполненныеКартыИзТаблицы(ТаблицаВход) Экспорт
	Индекс = ТаблицаВход.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если НЕ ЗначениеЗаполнено(ТаблицаВход[Индекс].Карта) Тогда
			ТаблицаВход.Удалить(ТаблицаВход[Индекс]);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
КонецПроцедуры		// УдалитьНезаполненныеКартыИзТаблицы()

// Обрабатывает этап "Торговец".
// Открывает форму торговца с передачей текущего золота и модификаторов игрока.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ОбработатьЭтапТорговец(Форма) Экспорт
	ВидПараметраЗолото = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Золото");
	ТекущееЗолото = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЗолото);
	// Получаем текущие модификаторы игрока в виде массива
	СписокМодификаторов = Новый СписокЗначений;
	Для Каждого СтрокаМодификатора Из Форма.Модификаторы Цикл
		СписокМодификаторов.Добавить(СтрокаМодификатора.Модификатор);
	КонецЦикла;
	// Получаем все карты игрока из стопок
	МассивКартИгрока = Новый Массив;
	Для Каждого ТекСтрока Из Форма.СтопкаДобора Цикл
		СтруктураКарты = Новый Структура;
		СтруктураКарты.Вставить("Карта",			 ТекСтрока.Карта);
		СтруктураКарты.Вставить("ИдентификаторКарты", ТекСтрока.ИдентификаторКарты);
		МассивКартИгрока.Добавить(СтруктураКарты);
	КонецЦикла;
	Для Каждого ТекСтрока Из Форма.РукаИгрока Цикл
		СтруктураКарты = Новый Структура;
		СтруктураКарты.Вставить("Карта",			 ТекСтрока.Карта);
		СтруктураКарты.Вставить("ИдентификаторКарты", ТекСтрока.ИдентификаторКарты);
		МассивКартИгрока.Добавить(СтруктураКарты);
	КонецЦикла;
	Для Каждого ТекСтрока Из Форма.СтопкаСброса Цикл
		СтруктураКарты = Новый Структура;
		СтруктураКарты.Вставить("Карта",			 ТекСтрока.Карта);
		СтруктураКарты.Вставить("ИдентификаторКарты", ТекСтрока.ИдентификаторКарты);
		МассивКартИгрока.Добавить(СтруктураКарты);
	КонецЦикла;
	ПараметрыФормыТорговца = Новый Структура;
	ПараметрыФормыТорговца.Вставить("Золото",		 ТекущееЗолото);
	ПараметрыФормыТорговца.Вставить("Модификаторы",	 СписокМодификаторов);
	ПараметрыФормыТорговца.Вставить("КартыИгрока",	 МассивКартИгрока);
	ОписаниеОЗакрытииТорговца = Новый ОписаниеОповещения("ОткрытьТорговца_ПослеЗакрытия", Форма);
	ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаТорговца", ПараметрыФормыТорговца, Форма, , , , ОписаниеОЗакрытииТорговца, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры		// ОбработатьЭтапТорговец()

// Обрабатывает этап "ВратаСпешки".
// Позволяет пропустить 4 этапа (увеличивает реквизит формы НомерЭтапа на 4).
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ОбработатьЭтапВратаСпешки(Форма) Экспорт
	Форма.НомерЭтапа = Форма.НомерЭтапа + 4;
КонецПроцедуры		// ОбработатьЭтапВратаСпешки()

// Обрабатывает этап "КолесоСудьбы".
// Открывает форму колеса судьбы с передачей текущих параметров игрока.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ОбработатьЭтапКолесоСудьбы(Форма) Экспорт
	ВидПараметраЗолото   = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Золото");
	ВидПараметраЗдоровье = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
	ВидПараметраЩит      = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Щит");
	ВидПараметраЭнергия  = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Энергия");
	ТекЗолото   = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЗолото);
	ТекЗдоровье = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЗдоровье);
	ТекЩит      = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЩит);
	ТекЭнергия  = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЭнергия);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекущееЗдоровье",     ТекЗдоровье);
	ПараметрыФормы.Вставить("МаксимальноеЗдоровье", ВосхождениеКлиентСервер.ПолучитьМаксимальноеЗдоровьеИгрока(Форма));
	ПараметрыФормы.Вставить("Золото",              ТекЗолото);
	ПараметрыФормы.Вставить("Щит",                 ТекЩит);
	ПараметрыФормы.Вставить("Энергия",             ТекЭнергия);
	ОписаниеОЗакрытии = Новый ОписаниеОповещения("КолесоСудьбы_Завершение", Форма);
	ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаКолесоСудьбы", ПараметрыФормы, Форма, , , , ОписаниеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры		// ОбработатьЭтапКолесоСудьбы()

// Обрабатывает этап "Головоломка".
// Открывает головоломку, выбранную при выборе этапа, либо случайную.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  ВыбранноеЗначениеВход - Структура - данные выбранного этапа (в том числе ВидГоловоломки).
//
Процедура ОбработатьЭтапГоловоломка(Форма, ВыбранноеЗначениеВход) Экспорт
	Головоломка = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВыбранноеЗначениеВход, "ВидГоловоломки", Неопределено);
	Если ЗначениеЗаполнено(Головоломка) Тогда
		// Используем головоломку, закреплённую за выбранным этапом.
	Иначе
		// Головоломка не передана. Выбираем случайную.
		Головоломка = ПолучитьСлучайнуюГоловоломку();
	КонецЕсли;
	Если Головоломка = ПредопределенноеЗначение("Перечисление.ВидыГоловоломок.Меморикс") Тогда
		ОписаниеОЗакрытии = Новый ОписаниеОповещения("Меморикс_Завершение", Форма);
		ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаМеморикс", , Форма, , , , ОписаниеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли Головоломка = ПредопределенноеЗначение("Перечисление.ВидыГоловоломок.Пятнашки") Тогда
		ОписаниеОЗакрытии = Новый ОписаниеОповещения("Пятнашки_Завершение", Форма);
		ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаПятнашки", , Форма, , , , ОписаниеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли Головоломка = ПредопределенноеЗначение("Перечисление.ВидыГоловоломок.ТаблицаШульте") Тогда
		ОписаниеОЗакрытии = Новый ОписаниеОповещения("ТаблицаШульте_Завершение", Форма);
		ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаТаблицаШульте", , Форма, , , , ОписаниеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли Головоломка = ПредопределенноеЗначение("Перечисление.ВидыГоловоломок.Wordle") Тогда
		ОписаниеОЗакрытии = Новый ОписаниеОповещения("Wordle_Завершение", Форма);
		ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаWordle", , Форма, , , , ОписаниеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли Головоломка = ПредопределенноеЗначение("Перечисление.ВидыГоловоломок.Виселица") Тогда
		ОписаниеОЗакрытии = Новый ОписаниеОповещения("Виселица_Завершение", Форма);
		ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаВиселица", , Форма, , , , ОписаниеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		// Неизвестная головоломка. Переходим к выбору следующего этапа.
		ВыбратьСледующийЭтап(Форма);
	КонецЕсли;
КонецПроцедуры		// ОбработатьЭтапГоловоломка()

// Обрабатывает этап "Случайное событие".
// Открывает форму события с переданным или случайным событием из справочника СлучайныеСобытия.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  СобытиеВход - СправочникСсылка.СлучайныеСобытия, Неопределено - событие для отображения;
//                Неопределено для выбора случайного события.
//
Процедура ОбработатьЭтапСлучайноеСобытие(Форма, СобытиеВход = Неопределено) Экспорт
	// Инициализация.
	ПустоеСобытие = ПредопределенноеЗначение("Справочник.СлучайныеСобытия.ПустаяСсылка");
	ВыбранноеСобытие = СобытиеВход;
	// Определение отображаемого события.
	Если ЗначениеЗаполнено(ВыбранноеСобытие) Тогда
		// Используется событие, переданное наградой.
	Иначе
		ВыбранноеСобытие = Форма.ПолучитьСлучайноеСобытие();
	КонецЕсли;
	// Открытие формы случайного события.
	Если ВыбранноеСобытие <> ПустоеСобытие Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("СлучайноеСобытие", ВыбранноеСобытие);
		ОписаниеОЗакрытии = Новый ОписаниеОповещения("СлучайноеСобытие_Завершение", Форма);
		ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаСлучайноеСобытие", ПараметрыФормы, Форма, , , , ОписаниеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		// В справочнике нет событий. Этап пропускается.
		ВыбратьСледующийЭтап(Форма);
	КонецЕсли;
КонецПроцедуры		// ОбработатьЭтапСлучайноеСобытие()

// Добавляет награду-карту в колоду игрока.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  ВеличинаВход      - Число - количество добавляемых карт.
//  СсылкаНаградыВход - СправочникСсылка.Карты - карта для добавления.
//
Процедура ДобавитьНаградуКартуСобытия(Форма, ВеличинаВход, СсылкаНаградыВход) Экспорт
	// Инициализация.
	КоличествоКарт = Цел(ВеличинаВход);
	// Добавление карт в колоду игрока.
	Если ЗначениеЗаполнено(СсылкаНаградыВход) И КоличествоКарт > 0 Тогда
		Для Сч = 1 По КоличествоКарт Цикл
			НоваяСтрока = Форма.КолодаИгрока.Добавить();
			НоваяСтрока.Карта = СсылкаНаградыВход;
			НоваяСтрока.ИдентификаторКарты = Строка(Новый УникальныйИдентификатор());
		КонецЦикла;
	Иначе
		// Карта не задана или количество карт не положительное. Награда не выдаётся.
	КонецЕсли;
КонецПроцедуры		// ДобавитьНаградуКартуСобытия()

// Добавляет награду-модификатор игроку, если такого модификатора ещё нет.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  СсылкаНаградыВход - СправочникСсылка.Модификаторы - модификатор для добавления.
//
Процедура ДобавитьНаградуМодификаторСобытия(Форма, СсылкаНаградыВход) Экспорт
	// Инициализация.
	ЭтоЕстьМодификатор = Ложь;
	// Проверка наличия модификатора у игрока.
	Если ЗначениеЗаполнено(СсылкаНаградыВход) Тогда
		ЭтоЕстьМодификатор = ВосхождениеКлиентСервер.МодификаторАктивен(Форма, СсылкаНаградыВход);
	Иначе
		// Модификатор не задан.
	КонецЕсли;
	// Добавление модификатора в таблицу.
	Если ЗначениеЗаполнено(СсылкаНаградыВход) И Не ЭтоЕстьМодификатор Тогда
		НоваяСтрока = Форма.Модификаторы.Добавить();
		НоваяСтрока.Модификатор = СсылкаНаградыВход;
		НоваяСтрока.ЕстьДлительность = Ложь;
		НоваяСтрока.ОставшаясяДлительность = 0;
	Иначе
		// Модификатор уже есть или не задан. Действий не требуется.
	КонецЕсли;
КонецПроцедуры		// ДобавитьНаградуМодификаторСобытия()

// Рассчитывает величину награды случайного события по способу расчёта.
//
// Параметры:
//  СпособРасчетаВход - ПеречислениеСсылка.СпособыРасчетаНаград - способ расчёта награды.
//  МинимальноеВход   - Число - минимальное значение награды.
//  МаксимальноеВход  - Число - максимальное значение награды.
//
// Возвращаемое значение:
//  Число - рассчитанная величина награды.
//
Функция РассчитатьВеличинуНаграды(СпособРасчетаВход, МинимальноеВход, МаксимальноеВход) Экспорт
	// Инициализация.
	РезультатФункции = МинимальноеВход;
	// Расчёт значения по способу.
	Если СпособРасчетаВход = ПредопределенноеЗначение("Перечисление.СпособыРасчетаНаград.Случайный") Тогда
		Минимум = Цел(МинимальноеВход);
		Максимум = Цел(МаксимальноеВход);
		Если Максимум < Минимум Тогда
			Максимум = Минимум;
		Иначе
			// Границы диапазона корректны.
		КонецЕсли;
		Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
		РезультатФункции = Гсч.СлучайноеЧисло(Минимум, Максимум);
	Иначе
		// Фиксированный или процентный способ. Величина равна минимальному значению.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// РассчитатьВеличинуНаграды()

// Формирует описание этапа перехода по награде события.
//
// Параметры:
//  ВидЭтапаВход - ПеречислениеСсылка.ВидыЭтаповВосхождения - вид этапа перехода.
//  ЗначениеВход - Произвольный - значение для этапа перехода.
//
// Возвращаемое значение:
//  Структура - описание этапа перехода с ключами ВидЭтапа, Значение.
//
Функция ОписаниеЭтапаНаградыСобытия(ВидЭтапаВход, ЗначениеВход) Экспорт
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("ВидЭтапа", ВидЭтапаВход);
	РезультатФункции.Вставить("Значение", ЗначениеВход);
	Возврат РезультатФункции;
КонецФункции		// ОписаниеЭтапаНаградыСобытия()

// Возвращает случайную головоломку с равными вероятностями из доступных.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ВидыГоловоломок - выбранная головоломка.
//
Функция ПолучитьСлучайнуюГоловоломку() Экспорт
	МассивГоловоломок = Новый Массив;
	МассивГоловоломок.Добавить(ПредопределенноеЗначение("Перечисление.ВидыГоловоломок.Меморикс"));
	МассивГоловоломок.Добавить(ПредопределенноеЗначение("Перечисление.ВидыГоловоломок.Пятнашки"));
	МассивГоловоломок.Добавить(ПредопределенноеЗначение("Перечисление.ВидыГоловоломок.ТаблицаШульте"));
	МассивГоловоломок.Добавить(ПредопределенноеЗначение("Перечисление.ВидыГоловоломок.Wordle"));
	МассивГоловоломок.Добавить(ПредопределенноеЗначение("Перечисление.ВидыГоловоломок.Виселица"));
	Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	Индекс = Гсч.СлучайноеЧисло(0, МассивГоловоломок.Количество() - 1);
	Возврат МассивГоловоломок[Индекс];
КонецФункции		// ПолучитьСлучайнуюГоловоломку()

// Вызывает форму выбора следующего этапа.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ВыбратьСледующийЭтап(Форма) Экспорт
	НовоеЗолото					 = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Золото"));
	НовоеМаксимальноеЗдоровье	 = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.МаксимальноеЗдоровье"));
	НовоеТекущееЗдоровье		 = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье")); 
	ПараметрыФормыВыбораЭтапа = Новый Структура;
	ПараметрыФормыВыбораЭтапа.Вставить("НомерЭтапа",			 Форма.НомерЭтапа);
	ПараметрыФормыВыбораЭтапа.Вставить("ВсегоЭтапов",			 Форма.ВсегоЭтапов);
	ПараметрыФормыВыбораЭтапа.Вставить("ПредыдущийПротивник",	 Форма.Противник);
	ПараметрыФормыВыбораЭтапа.Вставить("ПредыдущийВидЭтапа",	 Форма.ВидЭтапа);
	ПараметрыФормыВыбораЭтапа.Вставить("Золото",				 НовоеЗолото);
	ПараметрыФормыВыбораЭтапа.Вставить("МаксимальноеЗдоровье",	 НовоеМаксимальноеЗдоровье);
	ПараметрыФормыВыбораЭтапа.Вставить("ТекущееЗдоровье",		 НовоеТекущееЗдоровье);
	ОписаниеОЗакрытии = Новый ОписаниеОповещения("ВыборЭтапа_Завершение", Форма);
	ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаВыбораЭтапа", ПараметрыФормыВыбораЭтапа, Форма, , , , ОписаниеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры		// ВыбратьСледующийЭтап()

//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура Отдых_Завершение(Форма, Результат, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(Результат) = Тип("СправочникСсылка.Карты") Тогда
		ВосхождениеКлиент.УдалитьОднуКартуИзСтопок(Форма, Результат);
	ИначеЕсли ТипЗнч(Результат) = Тип("Число") Тогда
		Форма.ВосстановитьЗдоровьеИгрока(Результат);
		ПодключитьОбработчикОжидания("СброситьПодсветкуЗдоровьяИгрока", 1, Истина);
	КонецЕсли;
	// После отдыха снова вызываем выбор этапа
	ВосхождениеКлиент.ВыбратьСледующийЭтап(Форма);
КонецПроцедуры		// Отдых_Завершение()

//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ВыборЭтапа_Завершение(Форма, ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		// Вызываем метод для обработки выбранного вида этапа
		Форма.ОбработатьВыбранныйВидЭтапа(ВыбранноеЗначение);
	Иначе
		// Форма выбора этапа закрыта без выбора. Загружаем случайного противника.
		Форма.ИнициализироватьПротивника();
		ВосхождениеКлиент.ИзменитьЦветПротивника(Форма);
	КонецЕсли;
КонецПроцедуры		// ВыборЭтапа_Завершение()

//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ОткрытьТорговца_ПослеЗакрытия(Форма, ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	ВидПараметраЗолото = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Золото");
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		// Обработка структуры закрытия формы торговца
		Если ВыбранноеЗначение.Свойство("Золото") Тогда
			Золото = ВыбранноеЗначение.Золото;
			Форма.УстановитьПараметрИгрока(ВидПараметраЗолото, Золото);
		Иначе
			// Нет параметра Золото. Не изменяем текущее золото.
		КонецЕсли;
		// Обработка купленных модификаторов
		Если ВыбранноеЗначение.Свойство("КупленныеМодификаторы") Тогда
			СписокКупленныхМодификаторов = ВыбранноеЗначение.КупленныеМодификаторы;
			Для Каждого ТекСписокКупленныхМодификаторов Из СписокКупленныхМодификаторов Цикл
				// Проверяем, есть ли уже такой модификатор в таблице
				ТекМодификатор = ТекСписокКупленныхМодификаторов.Значение;
				СтруктураПоиска = Новый Структура;
				СтруктураПоиска.Вставить("Модификатор", ТекМодификатор);
				НайденныеСтроки = Форма.Модификаторы.НайтиСтроки(СтруктураПоиска);
				Если НайденныеСтроки.Количество() = 0 Тогда
					// Добавляем новый модификатор в таблицу
					НоваяСтрока = Форма.Модификаторы.Добавить();
					НоваяСтрока.Модификатор				 = ТекМодификатор;
					НоваяСтрока.ЕстьДлительность		 = Ложь;
					НоваяСтрока.ОставшаясяДлительность	 = 0;
				Иначе
					// У игрока уже есть такой модификатор.
				КонецЕсли;
			КонецЦикла;
		Иначе
			// Нет купленных модификаторов.
		КонецЕсли;
		// Обработка купленных карт
		Если ВыбранноеЗначение.Свойство("КупленныеКарты") Тогда
			СписокКупленныхКарт = ВыбранноеЗначение.КупленныеКарты;
			Для Каждого ТекСписокКупленныхКарт Из СписокКупленныхКарт Цикл
				ТекКарта = ТекСписокКупленныхКарт.Значение;
				НоваяСтрока = Форма.КолодаИгрока.Добавить();
				НоваяСтрока.Карта = ТекКарта;
				НоваяСтрока.ИдентификаторКарты = Строка(Новый УникальныйИдентификатор());
			КонецЦикла;
		Иначе
			// Нет купленных карт.
		КонецЕсли;
		// Обработка удалённых карт
		Если ВыбранноеЗначение.Свойство("УдаленныеКарты") Тогда
			ВосхождениеКлиент.ОбработатьУдаленныеКарты(Форма, ВыбранноеЗначение.УдаленныеКарты);
		Иначе
			// Нет удалённых карт.
		КонецЕсли;
		// Откроем форму выбора этапа.
		ВосхождениеКлиент.ВыбратьСледующийЭтап(Форма);
	Иначе
		ВосхождениеКлиент.ВыбратьСледующийЭтап(Форма);
	КонецЕсли;
КонецПроцедуры		// ОткрытьТорговца_ПослеЗакрытия()

// Обработчик закрытия формы Колеса Судьбы.
// Применяет накопленные награды к параметрам игрока.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура КолесоСудьбы_Завершение(Форма, ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ВидПараметраЗолото   = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Золото");
		ВидПараметраЗдоровье = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
		ВидПараметраЩит      = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Щит");
		ВидПараметраЭнергия  = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Энергия");
		
		Если ВыбранноеЗначение.Свойство("Золото") Тогда
			Форма.УвеличитьПараметрИгрока(ВидПараметраЗолото, ВыбранноеЗначение.Золото);
		КонецЕсли;
		Если ВыбранноеЗначение.Свойство("Здоровье") Тогда
			ДельтаЗдоровья = ВыбранноеЗначение.Здоровье;
			Если ДельтаЗдоровья > 0 Тогда
				Форма.ВосстановитьЗдоровьеИгрока(ДельтаЗдоровья);
				ПодключитьОбработчикОжидания("СброситьПодсветкуЗдоровьяИгрока", 1, Истина);
			ИначеЕсли ДельтаЗдоровья < 0 Тогда
				Форма.НанестиУронИгроку(-ДельтаЗдоровья);
			КонецЕсли;
		КонецЕсли;
		Если ВыбранноеЗначение.Свойство("Щит") И ВыбранноеЗначение.Щит > 0 Тогда
			Форма.УвеличитьЩитИгрока(ВыбранноеЗначение.Щит);
			ПодключитьОбработчикОжидания("СброситьПодсветкуЩитаИгрока", 1, Истина);
		КонецЕсли;
		Если ВыбранноеЗначение.Свойство("Энергия") Тогда
			Форма.УвеличитьПараметрИгрока(ВидПараметраЭнергия, ВыбранноеЗначение.Энергия);
		КонецЕсли;
		Если ВыбранноеЗначение.Свойство("Карты") И ВыбранноеЗначение.Карты > 0 Тогда
			Для Сч = 1 По ВыбранноеЗначение.Карты Цикл
				Форма.ДобратьКартуВРуку();
			КонецЦикла;
			ВосхождениеКлиент.ОбновитьРукуКарт(Форма);
		КонецЕсли;
	КонецЕсли;
	ВосхождениеКлиент.ВыбратьСледующийЭтап(Форма);
КонецПроцедуры		// КолесоСудьбы_Завершение()

