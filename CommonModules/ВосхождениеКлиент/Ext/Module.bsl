#Область ОтветыВикторины

// Добавляет в стек ДатыОтветов текущую дату
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ДобавитьТекущуюДатуВСтек(Форма) Экспорт
	РазмерСтекаДат = 20;
	ТекДата = ТекущаяДата();
	НовыйСписокДаты = Новый СписокЗначений;
	НовыйСписокДаты.Добавить(ТекДата);
	Если Форма.ДатыОтветов.Количество() < РазмерСтекаДат Тогда
		Для Каждого ТекДатыОтветов Из Форма.ДатыОтветов Цикл
			НовыйСписокДаты.Добавить(ТекДатыОтветов.Значение);
		КонецЦикла;	
	Иначе
		Для Счетчик = 0 По РазмерСтекаДат - 2 Цикл
			ТекДатыОтветов = Форма.ДатыОтветов.Получить(Счетчик);
			НовыйСписокДаты.Добавить(ТекДатыОтветов.Значение);
		КонецЦикла;
	КонецЕсли;
	МассивДат = НовыйСписокДаты.ВыгрузитьЗначения();
	Форма.ДатыОтветов.ЗагрузитьЗначения(МассивДат);
КонецПроцедуры		// ДобавитьТекущуюДатуВСтек()

// Определяет, достигнут ли конец раунда при включенном режиме.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Функция ДостигнутКонецРаунда(Форма) Экспорт
	РезультатФункции = Ложь;
	ЭтоРежимИспытание = (Форма.РежимВикторины = ПредопределенноеЗначение("Перечисление.РежимыВикторины.Испытание"));
	ДостигнутПределЗаданных = (Форма.КоличествоЗаданных >= Форма.КоличествоЗаданийВРаунде);
	РезультатФункции = (ЭтоРежимИспытание И ДостигнутПределЗаданных);
	Возврат РезультатФункции;
КонецФункции		// ДостигнутКонецРаунда()

// Изменяет фон у команды ответа сборника СборникВход с номером 
// НомерОтветаВход.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ПодсветитьПравильныйОтвет(Форма, НомерОтветаВход, СборникВход) Экспорт
	ВыбранныйЭлемент = Неопределено;
	Форма.Сложность = ПредопределенноеЗначение("Перечисление.СложностиСборников.ШестьОтветов");
	Если ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины) Тогда
		Форма.Сложность = ПредопределенноеЗначение("Перечисление.СложностиСборников.ЧетыреОтвета");
	Иначе	
		Форма.Сложность = ОбщегоНазначенияВызовСервера.ПолучитьЗначениеРеквизита(СборникВход, "Сложность");
	КонецЕсли;
	Если Форма.Сложность = ПредопределенноеЗначение("Перечисление.СложностиСборников.ШестьОтветов") Тогда
		Если НомерОтветаВход = 1 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант1;
		ИначеЕсли НомерОтветаВход = 2 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант2;
		ИначеЕсли НомерОтветаВход = 3 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант3;
		ИначеЕсли НомерОтветаВход = 4 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант4;
		ИначеЕсли НомерОтветаВход = 5 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант5;
		ИначеЕсли НомерОтветаВход = 6 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант6;
		Иначе
			ВыбранныйЭлемент = Неопределено;
		КонецЕсли;
	ИначеЕсли Форма.Сложность = ПредопределенноеЗначение("Перечисление.СложностиСборников.ЧетыреОтвета") Тогда
		Если НомерОтветаВход = 1 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант1;
		ИначеЕсли НомерОтветаВход = 2 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант2;
		ИначеЕсли НомерОтветаВход = 3 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант4;
		ИначеЕсли НомерОтветаВход = 4 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант5;
		Иначе
			ВыбранныйЭлемент = Неопределено;
		КонецЕсли;
	Иначе
		ВыбранныйЭлемент = Неопределено;
	КонецЕсли;
	Если ВыбранныйЭлемент <> Неопределено Тогда
		ВыбранныйЭлемент.ЦветФона = WebЦвета.СветлоНебесноГолубой;
	Иначе
		Сообщить(НСтр("ru = 'Не удалось определить элемент для подсветки правильного ответа'"));
	КонецЕсли;
КонецПроцедуры		// ПодсветитьПравильныйОтвет()

// Устанавливает достижения, привязанные к выбору правильного ответа.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ОбработатьДостиженияВыборОтвета(Форма) Экспорт
	ДостижениеСтоОтветов(Форма, Форма.КоличествоЗаданных);
	ДостижениеТридцатьБезОшибок(Форма, Форма.КоличествоВерных);
	ДостижениеСерияДвадцатьПравильных(Форма, Форма.СерияПравильных);
	ДостижениеДвадцатьВопросовЗаШестьдесятСекунд(Форма, Форма.ДатыОтветов.ВыгрузитьЗначения());
КонецПроцедуры		// ОбработатьДостиженияВыборОтвета()

// Отображает предупреждение с текстом правильного ответа.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ПоказатьПредупреждениеПравильныйОтчет(Форма) Экспорт
	ТекстОтвета = "";
	Для Каждого ТекНомераОтветов Из Форма.НомераОтветов Цикл
		Если ТекНомераОтветов.НомерОтвета = Форма.НомерПравильногоОтвета Тогда
			ТекстОтвета = ТекНомераОтветов.ТекстОтвета;
			Прервать;
		Иначе
			// Выполняем поиск далее.
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(ТекстОтвета) Тогда
		ПоказатьПредупреждение(, "Правильный ответ: " + ТекстОтвета, 15);
	Иначе
		ПоказатьПредупреждение(, "Правильный ответ №" + Строка(Форма.НомерПравильногоОтвета), 15);
	КонецЕсли;
КонецПроцедуры		// ПоказатьПредупреждениеПравильныйОтчет()

// Добавляет текущее задание в таблицу вопросов к повторению, если его там ещё нет.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ДобавитьЗаданиеВТаблицуПовтора(Форма) Экспорт
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Вопрос", Форма.ВыбранноеЗадание);
	НайденныеСтроки = Форма.ВопросыКПовторениям.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() = 0 Тогда
		НоваяСтрока = Форма.ВопросыКПовторениям.Добавить();
		НоваяСтрока.Вопрос = Форма.ВыбранноеЗадание;
	Иначе
		// Вопрос уже присутствует.
	КонецЕсли;
КонецПроцедуры		// ДобавитьЗаданиеВТаблицуПовтора()

#КонецОбласти

#Область ДействияИгрока

// Возвращает признак победы над противником (здоровье <= 0).
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//
// Возвращаемое значение:
//  Булево - Истина, если противник побежден, Ложь в противном случае.
//
Функция ПротивникБылПобежден(Форма) Экспорт
	ВидПараметра = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
	ТекущееЗдоровье = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметра);
	Возврат ТекущееЗдоровье <= 0;
КонецФункции		// ПротивникБылПобежден()

// Открывает форму получения наград за сражение с протвиником ПротивникаВход.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//	ПротивникаВход - СправочникСсылка.Противники - Побежденный противник.
//
Процедура ОткрытьПолучениеНаград(Форма, ПротивникаВход) Экспорт
	// Получаем размер награды золотом
	РазмерНаграды = ПолучитьРазмерНаградыЗолото(Форма, ПротивникаВход);
	// Получаем массив из 3 случайных неповторяемых карт для выбора награды
	МассивКарт = Форма.ПолучитьКартыВыборНаграды(ПротивникаВход);
	// Преобразуем массив карт в список значений
	СписокКарт = Новый СписокЗначений;
	Для Каждого Карта Из МассивКарт Цикл
		СписокКарт.Добавить(Карта);
	КонецЦикла;
	// Получаем текущее золото игрока
	ВидПараметраЗолото = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Золото");
	ТекущееЗолото = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЗолото);
	// Создаем структуру параметров формы
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПолученноеЗолото",	 РазмерНаграды);
	ПараметрыФормы.Вставить("ПредлагаемыеКарты", СписокКарт);
	ПараметрыФормы.Вставить("Противник",		 Форма.Противник);
	ПараметрыФормы.Вставить("ТекущееЗолото",	 ТекущееЗолото);
	// Создаем описание оповещения для открытия формы получения наград
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПолученияНаград_Завершение", Форма);
	// Открываем форму получения наград
	ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаПолученияНаград", ПараметрыФормы, Форма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры		// ОткрытьПолучениеНаград()

// Возвращает размер награды золотом за победу над противником.
// Минимальная награда: База + Цел(НомерЭтапа / 5), максимальная — вдвое больше.
// Итоговая награда выбирается случайно между минимальной и максимальной.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  ПротивникВход - СправочникСсылка.Противники - побежденный противник.
//
// Возвращаемое значение:
//  Число - размер награды золотом.
//
Функция ПолучитьРазмерНаградыЗолото(Форма, ПротивникВход) Экспорт
	// Инициализация.
	БазоваяНаграда = 20;
	// Минимальная сумма награды: База + Цел(НомерЭтапа / 3).
	МинимальнаяСумма = БазоваяНаграда + Цел(Форма.НомерЭтапа / 3);
	// Максимальная сумма награды: 2 × минимальная сумма.
	МаксимальнаяСумма = 2 * МинимальнаяСумма;
	// Итоговая награда: случайное число между минимальной и максимальной суммой.
	Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	РазмерНаграды = Гсч.СлучайноеЧисло(МинимальнаяСумма, МаксимальнаяСумма);
	Возврат РазмерНаграды;
КонецФункции		// ПолучитьРазмерНаградыЗолото()

// Проверяет, пройден ли последний этап восхождения.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//
// Возвращаемое значение:
//  Булево - Истина, если последний этап пройден, Ложь в противном случае.
//
Функция ПройденПоследнийЭтап(Форма) Экспорт
	Возврат Форма.НомерЭтапа > Форма.ВсегоЭтапов;
КонецФункции		// ПройденПоследнийЭтап()

// Обрабатывает побег противника из боя.
// Бой завершается, игрок переходит на следующий этап, но не получает награды за бой.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ОбработатьПобегПротивника(Форма) Экспорт
	Сообщить("Противник сбежал из боя!");
	Форма.ПротивникСбежал = Истина;
КонецПроцедуры		// ОбработатьПобегПротивника()

#КонецОбласти

#Область ДействияПротивника

// Выполняет вибрацию на мобильном устройстве.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура Вибрация(Форма, Длина = 400) Экспорт
	Если Форма.ТихийРежим Тогда
		// Тихий режим включён — не воспроизводим вибрацию и звук.
	Иначе
		// Тактильный отклик на мобильном устройстве.
		Попытка
			#Если МобильноеПриложениеКлиент Тогда
				МассивВибрация = Новый Массив;
				МассивВибрация.Добавить(Длина);
				СредстваМультимедиа.ВоспроизвестиЗвуковоеОповещение(, Истина);
			#Иначе
				// Платформа не поддерживает вибрацию (Desktop).
			#КонецЕсли
		Исключение
			// Платформа не поддерживает вибрацию (Desktop).
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры		// Вибрация()

// Возвращает базовый урон противника в зависимости от номера этапа.
// Этапы  1-9: 2 урона.
// Этапы 10-19: 3 урона.
// Этапы 20-29: 4 урона.
// Этап 30: 5 урона.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//
// Возвращаемое значение:
//  Число - базовый урон противника.
//
Функция ПолучитьБазовыйУронПротивника(Форма) Экспорт
	Если Форма.НомерЭтапа >= 30 Тогда
		Возврат 5;
	ИначеЕсли Форма.НомерЭтапа >= 20 Тогда
		Возврат 4;
	ИначеЕсли Форма.НомерЭтапа >= 10 Тогда
		Возврат 3;
	Иначе
		Возврат 2;
	КонецЕсли;
КонецФункции		// ПолучитьБазовыйУронПротивника()

// Возвращает признак победы над игроком (здоровье <= 0).
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//
// Возвращаемое значение:
//  Булево - Истина, если игрок побежден, Ложь в противном случае.
//
Функция ИгрокБылПобежден(Форма) Экспорт
	ВидПараметра = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
	ТекущееЗдоровье = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметра);
	Возврат ТекущееЗдоровье <= 0;
КонецФункции		// ИгрокБылПобежден()

// Открывает форму поражения в режиме Восхождение при окончательном поражении игрока.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ПоказатьПоражениеВосхождение(Форма) Экспорт
	Если ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины) Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("НомерЭтапа", Форма.НомерЭтапа);
		ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаПораженияВосхождение", ПараметрыФормы, Форма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры		// ПоказатьПоражениеВосхождение()

#КонецОбласти

#Область Карты

// Выполняет действие карты МаякНаГоризонте.
// Блокирует один случайный неправильный ответ в текущем задании.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_МаякНаГоризонте(Форма, КартаВход, ИдентификаторКартыВход) Экспорт
	// Инициализация.
	МассивНеверных = Новый Массив;
	ЗначениеНайдено = Ложь;
	РежимВосхождение = ПредопределенноеЗначение("Перечисление.РежимыВикторины.Восхождение");
	СложностьЧетыреОтвета = ПредопределенноеЗначение("Перечисление.СложностиСборников.ЧетыреОтвета");
	СложностьШестьОтветов = ПредопределенноеЗначение("Перечисление.СложностиСборников.ШестьОтветов");
	// Определение количества ответов.
	Если ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины) Тогда
		КоличествоОтветов = 4;
		Форма.Сложность = СложностьЧетыреОтвета;
	Иначе	
		Если Форма.Сборник.Сложность = СложностьШестьОтветов Тогда
			КоличествоОтветов = 6;
			Форма.Сложность = СложностьШестьОтветов;
		Иначе
			КоличествоОтветов = 4;
			Форма.Сложность = СложностьЧетыреОтвета;
		КонецЕсли;
	КонецЕсли;
	// Поиск случайного неправильного ответа.
	Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	Пока НЕ ЗначениеНайдено Цикл
		НомерОтвета = Гсч.СлучайноеЧисло(1, КоличествоОтветов);
		Если НомерОтвета <> Форма.НомерПравильногоОтвета Тогда
			ПреобразованныйНомер = ОбщегоНазначенияКлиентСервер.ПреобразоватьНомерПравильногоОтвета(НомерОтвета, Форма.Сложность);
			МассивНеверных.Добавить(ПреобразованныйНомер);
			ЗначениеНайдено = Истина;
		Иначе
			// Выполняем поиск далее.
		КонецЕсли;
	КонецЦикла;
	// Применение блокировки.
	ВосхождениеКлиентСервер.УбратьНеверныеОтветы(МассивНеверных, Форма);
	Форма.НеверныеВариантыУбраны = Истина;
	ВосхождениеКлиентСервер.УправлениеВидимостью(Форма);
КонецПроцедуры		// ДействиеКарты_МаякНаГоризонте()

// Возвращает карту по её идентификатору из стопок добора, руки игрока и сброса.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  ИдентификаторКартыВход - Строка - Идентификатор карты для поиска.
//
// Возвращаемое значение:
//  СправочникСсылка.Карты - найденная карта или пустая ссылка.
//
Функция ПолучитьКартуПоИдентификатору(Форма, ИдентификаторКартыВход) Экспорт
	РезультатФункции = ПредопределенноеЗначение("Справочник.Карты.ПустаяСсылка");
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИдентификаторКарты", ИдентификаторКартыВход);
	НайденныеСтроки = Форма.РукаИгрока.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() = 0 Тогда
		НайденныеСтроки = Форма.СтопкаДобора.НайтиСтроки(СтруктураПоиска);
	КонецЕсли;
	Если НайденныеСтроки.Количество() = 0 Тогда
		НайденныеСтроки = Форма.СтопкаСброса.НайтиСтроки(СтруктураПоиска);
	КонецЕсли;
	Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
		РезультатФункции = ТекНайденныеСтроки.Карта;
	КонецЦикла;
	Возврат РезультатФункции;
КонецФункции		// ПолучитьКартуПоИдентификатору()

// Возвращает идентификатор случайной карты из руки игрока.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  ИсключаемыйИдентификаторВход - Строка - Идентификатор карты, которую требуется исключить из выбора.
//
// Возвращаемое значение:
//  Строка - Идентификатор случайной карты, или пустая строка если подходящих карт нет.
//
Функция ПолучитьСлучайнуюКартуВРуке(Форма, ИсключаемыйИдентификаторВход = "") Экспорт
	РезультатФункции = "";
	Если Форма.РукаИгрока.Количество() > 0 Тогда
		Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
		Индекс = Гсч.СлучайноеЧисло(0, Форма.РукаИгрока.Количество() - 1);
		ВыбраннаяКартаСтрока = Форма.РукаИгрока[Индекс];
		Если ЗначениеЗаполнено(ИсключаемыйИдентификаторВход) И Форма.РукаИгрока.Количество() > 1 Тогда
			Пока ВыбраннаяКартаСтрока.ИдентификаторКарты = ИсключаемыйИдентификаторВход Цикл
				Индекс = Гсч.СлучайноеЧисло(0, Форма.РукаИгрока.Количество() - 1);
				ВыбраннаяКартаСтрока = Форма.РукаИгрока[Индекс];
			КонецЦикла;
		КонецЕсли;
		РезультатФункции = ВыбраннаяКартаСтрока.ИдентификаторКарты;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПолучитьСлучайнуюКартуВРуке()

// Возвращает строку таблицы РукаИгрока с самой дорогой картой.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  ИсключаемыйИдентификаторВход - Строка - Идентификатор карты, которую требуется исключить из поиска.
//
// Возвращаемое значение:
//  СтрокаТаблицыФормы - строка таблицы РукаИгрока с самой дорогой картой, или Неопределено.
//
Функция НайтиСамуюДорогуюКартуВРуке(Форма, ИсключаемыйИдентификаторВход = "") Экспорт
	// Инициализация.
	РезультатФункции = Неопределено;
	МаксимальнаяСтоимость = -1;
	// Поиск карты с максимальной стоимостью.
	Для Каждого ТекСтрока Из Форма.РукаИгрока Цикл
		Если ТекСтрока.ИдентификаторКарты <> ИсключаемыйИдентификаторВход Тогда
			Если ТекСтрока.Карта.Стоимость > МаксимальнаяСтоимость Тогда
				МаксимальнаяСтоимость = ТекСтрока.Карта.Стоимость;
				РезультатФункции = ТекСтрока;
			Иначе
				// Карта не дороже текущей максимальной.
			КонецЕсли;
		Иначе
			// Исключаемая карта пропускается.
		КонецЕсли;
	КонецЦикла;
	Возврат РезультатФункции;
КонецФункции		// НайтиСамуюДорогуюКартуВРуке()

// Меняет цвет заголовка противника в зависимости от сложности.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ИзменитьЦветПротивника(Форма) Экспорт
	Если Форма.СложностьПротивника = ПредопределенноеЗначение("Перечисление.СложностиПротивников.Начальная") Тогда
		Форма.Элементы.HUD_ИмяПротивника.ЦветТекстаЗаголовка = WebЦвета.ЗеленыйЛес;
	ИначеЕсли Форма.СложностьПротивника = ПредопределенноеЗначение("Перечисление.СложностиПротивников.Обычная") Тогда
		Форма.Элементы.HUD_ИмяПротивника.ЦветТекстаЗаголовка = WebЦвета.Синий;
	ИначеЕсли Форма.СложностьПротивника = ПредопределенноеЗначение("Перечисление.СложностиПротивников.Элитная") Тогда
		Форма.Элементы.HUD_ИмяПротивника.ЦветТекстаЗаголовка = WebЦвета.Красный;
	ИначеЕсли Форма.СложностьПротивника = ПредопределенноеЗначение("Перечисление.СложностиПротивников.Босс") Тогда
		Форма.Элементы.HUD_ИмяПротивника.ЦветТекстаЗаголовка = WebЦвета.Фиолетовый;
	Иначе
		Форма.Элементы.HUD_ИмяПротивника.ЦветТекстаЗаголовка = WebЦвета.Синий;
	КонецЕсли;
КонецПроцедуры		// ИзменитьЦветПротивника()

// Выполняет действие карты Обман.
// Выводит текст правильного ответа текущего задания в консоль сообщений.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//	НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Обман(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Инициализация.
	ТекстОтвета = "";
	// Поиск текста правильного ответа.
	Для Каждого ТекНомераОтветов Из Форма.НомераОтветов Цикл
		Если ТекНомераОтветов.НомерОтвета = Форма.НомерПравильногоОтвета Тогда
			ТекстОтвета = ТекНомераОтветов.ТекстОтвета;
			Прервать;
		Иначе
			// Продолжаем поиск.
		КонецЕсли;
	КонецЦикла;
	// Вывод правильного ответа.
	Если ЗначениеЗаполнено(ТекстОтвета) Тогда
		Сообщить(НСтр("ru = 'Правильный ответ: '") + ТекстОтвета);
	Иначе
		Сообщить(НСтр("ru = 'Правильный ответ №'") + Строка(Форма.НомерПравильногоОтвета));
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_Обман()

#КонецОбласти

#Область СохранениеЗагрузка

//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ПроверитьСохранениеВосхождения(Форма) Экспорт
	СтруктураСохранения = Форма.ПолучитьСтруктуруСохранения(Форма.ТекПользователь);
	СохранениеНайдено = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураСохранения, "СохранениеНайдено", Ложь);
	ХранилищеСохранения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураСохранения, "ХранилищеСохранения", Неопределено);
	Если СохранениеНайдено Тогда
		СтруктураДополнительныхПараметов = Новый Структура;
		СтруктураДополнительныхПараметов.Вставить("ХранилищеСохранения", ХранилищеСохранения);
		Оповещение = Новый ОписаниеОповещения("ПодтверждениеЗагрузкаСохранения_Завершение", Форма, СтруктураДополнительныхПараметов);
		ТекстВопроса = НСтр("ru = 'Загрузить последнее сохранение?'");
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
	Иначе
		// Выполняем стандартную загрузку.
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеИнтерфейсаБоя

// Обновляет прогресс-бар здоровья противника на клиенте по реквизиту ТекущееЗдоровьеПротивника.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ОбновитьПолосуЗдоровьяПротивникаНаКлиенте(Форма) Экспорт
	Если Форма.МаксимальноеЗдоровьеПротивника > 0 Тогда
		Форма.ПрогрессЗдоровьяПротивникаПроценты = (Форма.ТекущееЗдоровьеПротивника / Форма.МаксимальноеЗдоровьеПротивника) * 100;
		ЗаполнениеВраг = Цел(Форма.ПрогрессЗдоровьяПротивникаПроценты / 100 * 20);
		ТекстБараВраг = "";
		Для Сч = 1 По 20 Цикл
			ТекстБараВраг = ТекстБараВраг + ?(Сч <= ЗаполнениеВраг, "█", "░");
		КонецЦикла;
		Форма.Элементы.HUD_БарЗдоровьяПротивника.Заголовок = ТекстБараВраг;
		Форма.Элементы.HUD_БарЗдоровьяПротивника.ЦветТекста = WebЦвета.ТемноКрасный;
	КонецЕсли;
КонецПроцедуры		// ОбновитьПолосуЗдоровьяПротивникаНаКлиенте()

// Обновляет полосу здоровья игрока на клиенте (только UI, без серверного вызова).
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ОбновитьПолосуЗдоровьяИгрокаНаКлиенте(Форма) Экспорт
	Если Форма.МаксимальноеЗдоровьеИгрока > 0 Тогда
		Форма.ПрогрессЗдоровьяИгрокаПроценты = (Форма.ТекущееЗдоровьеИгрока / Форма.МаксимальноеЗдоровьеИгрока) * 100;
		ЗаполнениеИгрок = Цел(Форма.ПрогрессЗдоровьяИгрокаПроценты / 100 * 20);
		ТекстБараИгрок = "";
		Для Сч = 1 По 20 Цикл
			ТекстБараИгрок = ТекстБараИгрок + ?(Сч <= ЗаполнениеИгрок, "█", "░");
		КонецЦикла;
		Форма.Элементы.HUD_БарЗдоровьяИгрока.Заголовок = ТекстБараИгрок;
		Если Форма.ТекущееЗдоровьеИгрока < Форма.МаксимальноеЗдоровьеИгрока * 0.3 Тогда
			Форма.Элементы.HUD_БарЗдоровьяИгрока.ЦветТекста = WebЦвета.Красный;
		Иначе
			Форма.Элементы.HUD_БарЗдоровьяИгрока.ЦветТекста = WebЦвета.ЗеленыйЛес;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры		// ОбновитьПолосуЗдоровьяИгрокаНаКлиенте()

// Обновляет кнопки-слоты карт в руке игрока, переиспользуя
// предопределённые элементы КартаСлот1..10.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ОбновитьРукуКарт(Форма) Экспорт
	// Инициализация.
	ВидПараметраЭнергия = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Энергия");
	ЭнергияИгрока = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЭнергия);
	МассивСлотов = Новый Массив;
	МассивСлотов.Добавить("КартаСлот1");
	МассивСлотов.Добавить("КартаСлот2");
	МассивСлотов.Добавить("КартаСлот3");
	МассивСлотов.Добавить("КартаСлот4");
	МассивСлотов.Добавить("КартаСлот5");
	МассивСлотов.Добавить("КартаСлот6");
	МассивСлотов.Добавить("КартаСлот7");
	МассивСлотов.Добавить("КартаСлот8");
	МассивСлотов.Добавить("КартаСлот9");
	МассивСлотов.Добавить("КартаСлот10");
	// Скрываем все слоты, потом покажем нужные.
	Для Каждого ИмяСлота Из МассивСлотов Цикл
		Форма.Элементы[ИмяСлота].Видимость = Ложь;
	КонецЦикла;
	// Заполняем слоты по количеству карт в руке.
	Индекс = 0;
	// Пакетное получение стоимости всех карт одной пачкой.
	МассивСсылокКарт = Новый Массив;
	Для Каждого КартаИзРуки Из Форма.РукаИгрока Цикл
		МассивСсылокКарт.Добавить(КартаИзРуки.Карта);
	КонецЦикла;
	ДанныеКарт = Форма.ПолучитьДанныеКарт(МассивСсылокКарт);
	Для Каждого КартаИзРуки Из Форма.РукаИгрока Цикл
		Если Индекс >= МассивСлотов.Количество() Тогда
			Прервать;
		КонецЕсли;
		ИмяСлота = МассивСлотов[Индекс];
		Элемент = Форма.Элементы[ИмяСлота];
		Элемент.Видимость = Истина;
		СтруктураКарты = ДанныеКарт.Получить(КартаИзРуки.Карта);
		Стоимость = 0;
		Если СтруктураКарты = Неопределено Тогда
			Стоимость = 0;
		Иначе
			Стоимость = СтруктураКарты.Стоимость;
		КонецЕсли;
		Элемент.Заголовок = "⚡" + Строка(Стоимость) + " " + Строка(КартаИзРуки.Карта);
		Элемент.Доступность = (ЭнергияИгрока >= Стоимость);
		//// Цвет рамки в зависимости от типа карты (Атака/Защита/Навык).
		//Попытка
		//	ТипКарты = КартаИзРуки.Карта.ТипКарты;
		//	Если ТипКарты = ПредопределенноеЗначение("Перечисление.ТипыКарт.Атака") Тогда
		//		Элемент.УстановитьОформление(Новый Оформление(, WebЦвета.ТемноКрасный));
		//	ИначеЕсли ТипКарты = ПредопределенноеЗначение("Перечисление.ТипыКарт.Защита") Тогда
		//		Элемент.УстановитьОформление(Новый Оформление(, WebЦвета.ТемноСиний));
		//	ИначеЕсли ТипКарты = ПредопределенноеЗначение("Перечисление.ТипыКарт.Навык") Тогда
		//		Элемент.УстановитьОформление(Новый Оформление(, WebЦвета.ТемноЗеленый));
		//	Иначе
		//		// Неизвестный тип. Оставляем без цвета.
		//	КонецЕсли;
		//Исключение
		//	// Ошибка определения типа. Пропускаем оформление.
		//КонецПопытки;
		Индекс = Индекс + 1;
	КонецЦикла;
КонецПроцедуры		// ОбновитьРукуКарт()

#КонецОбласти
