// Возвращает Истина, если модификатор ИзумрудныйГеккон сохраняет карту в руке (20% шанс).
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//
// Возвращаемое значение:
//  Булево — Истина если карта остаётся в руке, Ложь если сбрасывается.
//
Функция ПрименитьМодификатор_ИзумрудныйГеккон(Форма) Экспорт
	// Инициализация.
	РезультатФункции = Ложь;
	МодификаторИзумрудныйГеккон = ПредопределенноеЗначение("Справочник.Модификаторы.ИзумрудныйГеккон");
	// Проверка модификатора.
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, МодификаторИзумрудныйГеккон) Тогда
		Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
		Шанс = Гсч.СлучайноеЧисло(1, 100);
		Если Шанс <= 20 Тогда
			РезультатФункции = Истина;
			ВосхождениеКлиентСервер.ДобавитьДействиеМодификатораВЖурналБоя(Форма, МодификаторИзумрудныйГеккон, 1);
		Иначе
			// Шанс не сработал.
		КонецЕсли;
	Иначе
		// Модификатор не активен.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПрименитьМодификатор_ИзумрудныйГеккон()

