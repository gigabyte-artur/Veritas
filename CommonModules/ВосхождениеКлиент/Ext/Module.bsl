Процедура ДействиеКарты_Реванш(Форма, КартаВход, ИдентификаторКартыВход) Экспорт
	// Инициализация.
	ВидПараметраПолученоУрона = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгры.ПолученоУрона");
	МаксимальныйУрон = 15;
	// Основные действия.
	ПолученныйУрон = ВосхождениеКлиент.ПолучитьЗначениеПараметраИгры(Форма, ВидПараметраПолученоУрона);
	УронКарты = ПолученныйУрон;
	Если УронКарты > МаксимальныйУрон Тогда
		УронКарты = МаксимальныйУрон;
	Иначе
		// Урон в пределах лимита.
	КонецЕсли;
	Форма.УронПротивникуПоКоличеству(УронКарты);
КонецПроцедуры		// ДействиеКарты_Реванш()

