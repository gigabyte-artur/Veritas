// Обрабатывает выбранный вид этапа из структуры результата формы выбора этапа.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  ВыбранноеЗначение - Структура - структура с данными выбранного этапа
//                      (ВидЭтапа, Противник).
//
Процедура ОбработатьВыбранныйВидЭтапа(Форма, ВыбранноеЗначение) Экспорт
	Форма.НомерЭтапа	 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВыбранноеЗначение, "НомерЭтапа", 0);
	Форма.ВидЭтапа	 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВыбранноеЗначение, "ВидЭтапа", Неопределено);
	ВидПараметраЗолото = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Золото");
	// Проверка на завершение восхождения.
	Если ВосхождениеКлиент.ПройденПоследнийЭтап(Форма) Тогда
		ВосхождениеКлиент.ЗавершитьВосхождение(Форма);
	Иначе	
		Если Форма.ВидЭтапа = ПредопределенноеЗначение("Перечисление.ВидыЭтаповВосхождения.Противник") Тогда
			Форма.ОбработатьЭтапПротивник(ВыбранноеЗначение);
		ИначеЕсли Форма.ВидЭтапа = ПредопределенноеЗначение("Перечисление.ВидыЭтаповВосхождения.Отдых") Тогда
			// Обработка этапа "Отдых"
			ВосхождениеКлиент.Отдых(Форма);
		ИначеЕсли Форма.ВидЭтапа = ПредопределенноеЗначение("Перечисление.ВидыЭтаповВосхождения.Сокровище") Тогда
			ВосхождениеКлиент.ОбработатьЭтапСокровище(Форма);
		ИначеЕсли Форма.ВидЭтапа = ПредопределенноеЗначение("Перечисление.ВидыЭтаповВосхождения.Торговец") Тогда
			// Обработка этапа "Торговец"
			ВосхождениеКлиент.ОбработатьЭтапТорговец(Форма);
		ИначеЕсли Форма.ВидЭтапа = ПредопределенноеЗначение("Перечисление.ВидыЭтаповВосхождения.ВратаСпешки") Тогда
			// Обработка этапа "ВратаСпешки": позволяет пропустить 4 этапа
			ВосхождениеКлиент.ОбработатьЭтапВратаСпешки(Форма);
			// После пропуска этапов снова вызываем выбор этапа
			ВосхождениеКлиент.ВыбратьСледующийЭтап(Форма);
		ИначеЕсли Форма.ВидЭтапа = ПредопределенноеЗначение("Перечисление.ВидыЭтаповВосхождения.КолесоСудьбы") Тогда
			ВосхождениеКлиент.ОбработатьЭтапКолесоСудьбы(Форма);
		ИначеЕсли Форма.ВидЭтапа = ПредопределенноеЗначение("Перечисление.ВидыЭтаповВосхождения.Головоломка") Тогда
			ВосхождениеКлиент.ОбработатьЭтапГоловоломка(Форма, ВыбранноеЗначение);
		ИначеЕсли Форма.ВидЭтапа = ПредопределенноеЗначение("Перечисление.ВидыЭтаповВосхождения.СлучайноеСобытие") Тогда
			ВосхождениеКлиент.ОбработатьЭтапСлучайноеСобытие(Форма);
		Иначе
			// Неизвестный вид этапа. Загружаем случайного противника.
			Форма.ИнициализироватьПротивника();
			ВосхождениеКлиент.ИзменитьЦветПротивника(Форма);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры		// ОбработатьВыбранныйВидЭтапа()

// Обрабатывает этап "Противник".
// Инициализирует стопки, энергию, противника и применяет модификаторы.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//   ВыбранноеЗначениеВход - Структура - значение выбранного этапа.
//
Процедура ОбработатьЭтапПротивник(Форма, Гсч, ВыбранноеЗначениеВход) Экспорт
	ПустойПротивник = ПредопределенноеЗначение("Справочник.Противники.ПустаяСсылка");
	ВыбранныйПротивник = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВыбранноеЗначениеВход, "Противник", ПустойПротивник);
	// Инициализируем стопки.
	Форма.СтопкаДобора.Очистить();
	Форма.РукаИгрока.Очистить();
	Форма.СтопкаСброса.Очистить();
	// Очищаем журнал боя.
	Форма.ЖурналБоя.Очистить();
	Форма.ОчиститьПараметрыИгрокаКромеБазовых();
	// Инициализируем параметры игры.
	ВосхождениеКлиент.ИнициализироватьПараметрыИгры(Форма);
	// Инициализация колоды игрока
	Форма.ИнициализироватьСтопкуДобораИгрока();
	Форма.ПеремешатьСтопкуДобора_Сервер();
	// Доберём руку.
	Форма.ДобратьРуку();
	// Удаляем из всех стопок карты с пустой ссылкой.
	ВосхождениеКлиент.УдалитьНезаполненныеКартыИзСтопок(Форма);
	// Инициализируем энергию игрока.
	Форма.ИнициализироватьЭнергиюИгрока();
	Форма.ЗарядСерии = 0;
	// Устанавливаем выбранного противника и инициализируем его.
	Форма.ИнициализироватьПротивника(ВыбранныйПротивник);
	ВосхождениеКлиент.ИзменитьЦветПротивника(Форма);
	// Применяем модификатор "Стальные наручи": даёт 10 единиц щита при входе на этап с противником
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, ПредопределенноеЗначение("Справочник.Модификаторы.СтальныеНаручи")) Тогда
		Форма.УвеличитьЩитИгрока(10);
	КонецЕсли;
	// Применяем модификатор "ЗаводнаяПерчатка": в начале боя игрок бесплатно разыгрывает 1 случайную карту из руки
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, ПредопределенноеЗначение("Справочник.Модификаторы.ЗаводнаяПерчатка"))
		И Форма.РукаИгрока.Количество() > 0 Тогда
		Индекс = Гсч.СлучайноеЧисло(0, Форма.РукаИгрока.Количество() - 1);
		ВыбраннаяСтрока = Форма.РукаИгрока[Индекс];
		Форма.РазыгратьКарту(ВыбраннаяСтрока.ИдентификаторКарты);
	КонецЕсли;
	// Применяем событийные модификаторы начала боя.
	Форма.ПрименитьМодификаторыПриСобытии(ВосхождениеКлиентСервер.ПредставлениеСобытияФормы_ПриНачалеБоя());
	// Обновим руку карт на интерфейсе.
	ВосхождениеКлиент.ОбновитьРукуКарт(Форма);
	// Отобразим задание из выбранного сборника.
	Если ЗначениеЗаполнено(Форма.Сборник) Тогда
		Форма.ОтобразитьСледующееЗадание(Форма.Сборник);
	Иначе
		// Сборник не выбран.
	КонецЕсли;
КонецПроцедуры		// ОбработатьЭтапПротивник()

// Продолжает восхождение после закрытия формы случайного события.
// Применяет награды выбранного варианта события и переходит к следующему этапу.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Результат               - Произвольный - результат закрытия формы случайного события.
//  ДополнительныеПараметры - Произвольный - дополнительные параметры оповещения.
//
Процедура СлучайноеСобытие_Завершение(Форма, Результат, ДополнительныеПараметры) Экспорт
	// Инициализация.
	ПустоеСобытие = ПредопределенноеЗначение("Справочник.СлучайныеСобытия.ПустаяСсылка");
	ЭтапСобытия = Неопределено;
	ЭтоЕстьРезультат = (ТипЗнч(Результат) = Тип("Структура"));
	// Применение наград выбранного варианта события.
	Если ЭтоЕстьРезультат Тогда
		Событие = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат, "СлучайноеСобытие", ПустоеСобытие);
		НомерВарианта = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат, "НомерВарианта", 0);
		НаградыСобытия = Форма.ПолучитьНаградыСобытия(Событие, НомерВарианта);
		ЭтапСобытия = Форма.ПрименитьНаградыСобытия(НаградыСобытия);
	Иначе
		// Вариант не выбран. Награды не применяются.
	КонецЕсли;
	// Переход к следующему этапу или к этапу из награды события.
	Если Не Форма.ПоражениеВосхождение Тогда
		Форма.ПерейтиПослеСлучайногоСобытия(ЭтапСобытия);
	Иначе
		// Игрок побеждён наградой события. Восхождение завершено.
	КонецЕсли;
КонецПроцедуры		// СлучайноеСобытие_Завершение()

// Применяет награды выбранного варианта случайного события к игроку.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  НаградыВход - Массив - награды варианта; элементы - структуры с ключами
//                ВариантНаграды, Направление, СпособРасчета, МинимальноеЗначение,
//                МаксимальноеЗначение, СсылкаНаграды.
//
// Возвращаемое значение:
//  Структура, Неопределено - описание этапа перехода из награды;
//                Неопределено, если переход не требуется.
//
Функция ПрименитьНаградыСобытия(Форма, НаградыВход) Экспорт
	// Инициализация.
	РезультатФункции = Неопределено;
	// Применение наград по очереди.
	Для Каждого ТекНаграда Из НаградыВход Цикл
		ЭтапНаграды = Форма.ПрименитьНаградуСобытия(ТекНаграда);
		ЭтоЕстьПереход = (ЭтапНаграды <> Неопределено);
		Если ЭтоЕстьПереход И РезультатФункции = Неопределено Тогда
			РезультатФункции = ЭтапНаграды;
		Иначе
			// Переходный этап уже назначен или награда перехода не задаёт.
		КонецЕсли;
	КонецЦикла;
	Возврат РезультатФункции;
КонецФункции		// ПрименитьНаградыСобытия()

// Применяет одну награду случайного события к игроку.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  НаградаВход - Структура - награда с ключами ВариантНаграды, Направление,
//                СпособРасчета, МинимальноеЗначение, МаксимальноеЗначение, СсылкаНаграды.
//
// Возвращаемое значение:
//  Структура, Неопределено - описание этапа перехода (награды Бой, Головоломка,
//                СлучайноеСобытие); Неопределено, если переход не требуется.
//
Функция ПрименитьНаградуСобытия(Форма, НаградаВход) Экспорт
	// Инициализация.
	РезультатФункции = Неопределено;
	ВариантНаграды = НаградаВход.ВариантНаграды;
	СпособРасчета = НаградаВход.СпособРасчета;
	СсылкаНаграды = НаградаВход.СсылкаНаграды;
	ЭтоПоложительное = НаградаВход.Направление;
	Величина = ВосхождениеКлиент.РассчитатьВеличинуНаграды(СпособРасчета, НаградаВход.МинимальноеЗначение, НаградаВход.МаксимальноеЗначение);
	ВидЭтапаПротивник = ПредопределенноеЗначение("Перечисление.ВидыЭтаповВосхождения.Противник");
	ВидЭтапаГоловоломка = ПредопределенноеЗначение("Перечисление.ВидыЭтаповВосхождения.Головоломка");
	ВидЭтапаСлучайноеСобытие = ПредопределенноеЗначение("Перечисление.ВидыЭтаповВосхождения.СлучайноеСобытие");
	// Применение награды по её виду.
	ОбработаноЧислом = Форма.ПрименитьЧисловуюНаградуСобытия(ВариантНаграды, СпособРасчета, Величина, ЭтоПоложительное);
	Если ОбработаноЧислом Тогда
		// Числовая награда применена.
	ИначеЕсли ВариантНаграды = ПредопределенноеЗначение("Перечисление.ВариантыНаград.Карта") Тогда
		ВосхождениеКлиент.ДобавитьНаградуКартуСобытия(Форма, Величина, СсылкаНаграды);
	ИначеЕсли ВариантНаграды = ПредопределенноеЗначение("Перечисление.ВариантыНаград.Модификатор") Тогда
		ВосхождениеКлиент.ДобавитьНаградуМодификаторСобытия(Форма, СсылкаНаграды);
	ИначеЕсли ВариантНаграды = ПредопределенноеЗначение("Перечисление.ВариантыНаград.Бой") Тогда
		РезультатФункции = ВосхождениеКлиент.ОписаниеЭтапаНаградыСобытия(ВидЭтапаПротивник, СсылкаНаграды);
	ИначеЕсли ВариантНаграды = ПредопределенноеЗначение("Перечисление.ВариантыНаград.Головоломка") Тогда
		РезультатФункции = ВосхождениеКлиент.ОписаниеЭтапаНаградыСобытия(ВидЭтапаГоловоломка, СсылкаНаграды);
	ИначеЕсли ВариантНаграды = ПредопределенноеЗначение("Перечисление.ВариантыНаград.СлучайноеСобытие") Тогда
		РезультатФункции = ВосхождениеКлиент.ОписаниеЭтапаНаградыСобытия(ВидЭтапаСлучайноеСобытие, СсылкаНаграды);
	Иначе
		// Награда "Ничего" или неизвестный вид. Действий не требуется.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПрименитьНаградуСобытия()

// Применяет числовую или статусную награду события к параметрам игрока.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  ВариантНаградыВход   - ПеречислениеСсылка.ВариантыНаград - вид награды.
//  СпособРасчетаВход    - ПеречислениеСсылка.СпособыРасчетаНаград - способ расчёта награды.
//  ВеличинаВход         - Число - рассчитанная величина награды.
//  ЭтоПоложительноеВход - Булево - Истина для награды, Ложь для штрафа.
//
// Возвращаемое значение:
//  Булево - Истина, если награда является числовой и применена.
//
Функция ПрименитьЧисловуюНаградуСобытия(Форма, ВариантНаградыВход, СпособРасчетаВход, ВеличинаВход, ЭтоПоложительноеВход) Экспорт
	// Инициализация.
	РезультатФункции = Истина;
	ВидПараметраЗолото = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Золото");
	// Применение награды по её виду.
	Если ВариантНаградыВход = ПредопределенноеЗначение("Перечисление.ВариантыНаград.Золото") Тогда
		СуммаЗолота = ВеличинаВход;
		Если Не ЭтоПоложительноеВход Тогда
			СуммаЗолота = -ВеличинаВход;
		Иначе
			// Золото увеличивается.
		КонецЕсли;
		Форма.УвеличитьПараметрИгрока(ВидПараметраЗолото, СуммаЗолота);
	ИначеЕсли ВариантНаградыВход = ПредопределенноеЗначение("Перечисление.ВариантыНаград.Здоровье") Тогда
		Если ЭтоПоложительноеВход Тогда
			Форма.ВосстановитьЗдоровьеИгрока(ВеличинаВход);
			ПодключитьОбработчикОжидания("СброситьПодсветкуЗдоровьяИгрока", 1, Истина);
		Иначе
			Форма.НанестиУронИгроку(ВеличинаВход);
		КонецЕсли;
	ИначеЕсли ВариантНаградыВход = ПредопределенноеЗначение("Перечисление.ВариантыНаград.Лечение") Тогда
		ВеличинаЛечения = ВеличинаВход;
		Если СпособРасчетаВход = ПредопределенноеЗначение("Перечисление.СпособыРасчетаНаград.Процент") Тогда
			МаксимальноеЗдоровье = ВосхождениеКлиентСервер.ПолучитьМаксимальноеЗдоровьеИгрока(Форма);
			ВеличинаЛечения = Цел(МаксимальноеЗдоровье * ВеличинаВход / 100);
		Иначе
			// Фиксированное лечение.
		КонецЕсли;
		Форма.ВосстановитьЗдоровьеИгрока(ВеличинаЛечения);
		ПодключитьОбработчикОжидания("СброситьПодсветкуЗдоровьяИгрока", 1, Истина);
	ИначеЕсли ВариантНаградыВход = ПредопределенноеЗначение("Перечисление.ВариантыНаград.Урон") Тогда
		Форма.НанестиУронИгроку(ВеличинаВход);
	ИначеЕсли ВариантНаградыВход = ПредопределенноеЗначение("Перечисление.ВариантыНаград.МаксимальноеЗдоровье") Тогда
		Форма.ИзменитьМаксимальноеЗдоровьеИгрокаСобытия(ВеличинаВход, ЭтоПоложительноеВход);
	Иначе
		// Вид награды не относится к числовым.
		РезультатФункции = Ложь;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПрименитьЧисловуюНаградуСобытия()

// Изменяет максимальное здоровье игрока при награде события.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  ВеличинаВход         - Число - величина изменения максимального здоровья.
//  ЭтоПоложительноеВход - Булево - Истина для увеличения, Ложь для уменьшения.
//
Процедура ИзменитьМаксимальноеЗдоровьеИгрокаСобытия(Форма, ВеличинаВход, ЭтоПоложительноеВход) Экспорт
	// Инициализация.
	ВидПараметраМаксимальноеЗдоровье = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.МаксимальноеЗдоровье");
	ВидПараметраТекущееЗдоровье = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
	// Расчёт нового максимального здоровья.
	ТекущееМаксимальное = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраМаксимальноеЗдоровье);
	НовоеМаксимальное = ТекущееМаксимальное + ВеличинаВход;
	Если Не ЭтоПоложительноеВход Тогда
		НовоеМаксимальное = ТекущееМаксимальное - ВеличинаВход;
	Иначе
		// Максимальное здоровье увеличивается.
	КонецЕсли;
	Если НовоеМаксимальное < 1 Тогда
		НовоеМаксимальное = 1;
	Иначе
		// Значение в допустимых границах.
	КонецЕсли;
	Форма.УстановитьПараметрИгрока(ВидПараметраМаксимальноеЗдоровье, НовоеМаксимальное);
	// Ограничение текущего здоровья новым максимумом.
	ТекущееЗдоровье = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраТекущееЗдоровье);
	Если ТекущееЗдоровье > НовоеМаксимальное Тогда
		Форма.УстановитьПараметрИгрока(ВидПараметраТекущееЗдоровье, НовоеМаксимальное);
	Иначе
		// Текущее здоровье не превышает максимум.
	КонецЕсли;
	Форма.ОтобразитьСостояниеИгрока();
КонецПроцедуры		// ИзменитьМаксимальноеЗдоровьеИгрокаСобытия()

// Переходит к следующему этапу восхождения или к этапу, заданному наградой события.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  ЭтапСобытияВход - Структура, Неопределено - описание этапа перехода из награды.
//
Процедура ПерейтиПослеСлучайногоСобытия(Форма, ЭтапСобытияВход) Экспорт
	// Инициализация.
	ЭтоЕстьПереход = (ТипЗнч(ЭтапСобытияВход) = Тип("Структура"));
	// Переход к этапу из награды или к обычному следующему этапу.
	Если ЭтоЕстьПереход Тогда
		ВидЭтапаПерехода = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЭтапСобытияВход, "ВидЭтапа", Неопределено);
		ЗначениеПерехода = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЭтапСобытияВход, "Значение", Неопределено);
		Если ВидЭтапаПерехода = ПредопределенноеЗначение("Перечисление.ВидыЭтаповВосхождения.Противник") Тогда
			ПараметрыБоя = Новый Структура;
			ПараметрыБоя.Вставить("Противник", ЗначениеПерехода);
			Форма.ОбработатьЭтапПротивник(ПараметрыБоя);
		ИначеЕсли ВидЭтапаПерехода = ПредопределенноеЗначение("Перечисление.ВидыЭтаповВосхождения.Головоломка") Тогда
			ПараметрыГоловоломки = Новый Структура;
			ПараметрыГоловоломки.Вставить("ВидГоловоломки", ЗначениеПерехода);
			ВосхождениеКлиент.ОбработатьЭтапГоловоломка(Форма, ПараметрыГоловоломки);
		ИначеЕсли ВидЭтапаПерехода = ПредопределенноеЗначение("Перечисление.ВидыЭтаповВосхождения.СлучайноеСобытие") Тогда
			ВосхождениеКлиент.ОбработатьЭтапСлучайноеСобытие(Форма, ЗначениеПерехода);
		Иначе
			// Неизвестный вид этапа перехода. Переходим к выбору следующего этапа.
			ВосхождениеКлиент.ВыбратьСледующийЭтап(Форма);
		КонецЕсли;
	Иначе
		ВосхождениеКлиент.ВыбратьСледующийЭтап(Форма);
	КонецЕсли;
КонецПроцедуры		// ПерейтиПослеСлучайногоСобытия()

#КонецОбласти

#Область Модификаторы

// Осуществляет применение модификатора Страховка.
// Возвращает Истина, если Страховка сработала (20% шанс).
//
// Возвращаемое значение:
//  Булево - Истина, если неверный ответ не засчитан.
//
Функция ПрименитьМодификатор_Страховка() Экспорт
	Гсч = Новый ГенераторСлучайныхЧисел;
	Шанс = Гсч.СлучайноеЧисло(1, 100);
	Возврат Шанс <= 20;
КонецФункции		// ПрименитьМодификатор_Страховка()

// Возвращает добавку к урону от модификатора МраморнаяТрибуна:
// каждый верный ответ подряд, начиная со второго, даёт +1 к урону.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//
// Возвращаемое значение:
//  Число — добавка к урону (0 или больше).
//
Функция ПрименитьМодификатор_МраморнаяТрибуна(Форма) Экспорт
	// Инициализация.
	РезультатФункции = 0;
	МодификаторМраморнаяТрибуна = ПредопределенноеЗначение("Справочник.Модификаторы.МраморнаяТрибуна");
	ВидПараметраВерныхПодряд = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгры.ВерныхОтветовПодряд");
	// Проверка модификатора.
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, МодификаторМраморнаяТрибуна) Тогда
		ВерныхПодряд = ПолучитьЗначениеПараметраИгры(Форма, ВидПараметраВерныхПодряд);
		РезультатФункции = Макс(ВерныхПодряд - 1, 0);
		ВосхождениеКлиентСервер.ДобавитьДействиеМодификатораВЖурналБоя(Форма, МодификаторМраморнаяТрибуна, РезультатФункции);
	Иначе
		// Модификатор не активен.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПрименитьМодификатор_МраморнаяТрибуна()

