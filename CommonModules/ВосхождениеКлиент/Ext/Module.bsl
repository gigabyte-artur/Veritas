// Выполняет действие карты Эхо.
// Выбирает случайную карту из стопки сброса игрока и разыгрывает её действие
// без перемещения выбранной карты из стопки сброса и без затраты энергии.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентифкаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Эхо(Форма, Гсч, КартаВход, ИдентифкаторКартыВход) Экспорт
	Если Форма.СтопкаСброса.Количество() > 0 Тогда
		Индекс = Гсч.СлучайноеЧисло(0, Форма.СтопкаСброса.Количество() - 1);
		ВыбраннаяКартаСтрока = Форма.СтопкаСброса[Индекс];
		ВыбраннаяКарта = ВыбраннаяКартаСтрока.Карта;
		ИдентификаторВыбраннойКарты = ВыбраннаяКартаСтрока.ИдентификаторКарты;
		Если ЗначениеЗаполнено(ВыбраннаяКарта) Тогда
			Если ВыбраннаяКарта <> ПредопределенноеЗначение("Справочник.Карты.Эхо") Тогда
				Форма.ДействиеВыбраннойКарты(ВыбраннаяКарта, ИдентифкаторКартыВход);
			Иначе
				// Не разыгрываем повторно.
			КонецЕсли;
			Форма.ОтобразитьСостояниеИгрока();
			Форма.ОтобразитьСостояниеПротивника();
		КонецЕсли;
	Иначе
		// Стпока сброса пуста.
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_Эхо()

// Выполняет действие карты Перегонка.
// Игрок сбрасывает 1 карту (если она есть в руке) и получает 1 единицу энергии.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентифкаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Перегонка(Форма, Гсч, КартаВход, ИдентифкаторКартыВход) Экспорт
	Если Форма.РукаИгрока.Количество() > 0 Тогда
		// Выбираем случайную карту из руки для сброса
		ИндексСлучайнойКарты = ?(Форма.РукаИгрока.Количество() = 1, 0, Гсч.СлучайноеЧисло(0, Форма.РукаИгрока.Количество() - 1));
		КартаСтрока = Форма.РукаИгрока[ИндексСлучайнойКарты];
		ИдентификаторКарты = КартаСтрока.ИдентификаторКарты;
		ВосхождениеКлиентСервер.ПереместиКартуИзСтопки(ИдентификаторКарты, "РукаИгрока", "СтопкаСброса", Форма);
		// Увеличиваем энергию игрока на 1
		ВидПараметраЭнергия = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Энергия");
		Форма.УвеличитьПараметрИгрока(ВидПараметраЭнергия, 1);
	Иначе
		// В руке нет карт - ничего не делаем
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_Перегонка()

// Выполняет действие карты Передышка.
// Даёт игроку 3 единицы щита. Если у игрока 10 единиц щита или больше, игрок берёт 1 карту.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентифкаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Передышка(Форма, КартаВход, ИдентифкаторКартыВход) Экспорт
	// Получаем текущее значение щита ДО увеличения
	ВидПараметраЩит = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Щит");
	ТекущийЩит = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЩит);
	// Даём игроку 3 единицы щита
	Форма.УвеличитьЩитИгрока(3);
	// Проверяем, было ли у игрока 10 или больше щита до увеличения
	Если ТекущийЩит >= 10 Тогда
		// Игрок берёт 1 карту из стопки добора
		Форма.ДобратьКартуВРуку();
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_Передышка()

// Выполняет действие карты Гамбит.
// Наносит игроку 3 урона и противник меняет действие на следующее.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//  ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Гамбит(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Наносим игроку 3 урона
	Форма.НанестиУронИгроку(3);
	// Противник меняет действие на следующее
	Форма.ПереместитьДействиеПротивникаВпередПоЦиклу();
КонецПроцедуры		// ДействиеКарты_Гамбит()

