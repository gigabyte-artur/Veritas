//
Процедура ДействиеКарты_БросокМонетки(Форма, Гсч, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	Случайное = Гсч.СлучайноеЧисло(1, 100);
	Если Случайное <= 50 Тогда
		Форма.УвеличитьПараметрИгрока(ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Энергия"), 3);
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_БросокМонетки()

// Разыгрывает карту "Долг".
// Игрок получает 15 золота и случайный негативный эффект.
//
// Параметры:
