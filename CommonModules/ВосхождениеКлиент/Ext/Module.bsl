// Возвращает значение параметра игры по его виду.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  ВидПараметраВход - ПеречислениеСсылка.ВидыПараметровИгроков - вид параметра.
//
// Возвращаемое значение:
//  Число - значение параметра; 0 если параметр не найден.
//
Функция ПолучитьЗначениеПараметраИгры(Форма, ВидПараметраВход) Экспорт
	РезультатФункции = 0;
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ВидПараметра", ВидПараметраВход);
	НайденныеСтроки = Форма.ПараметрыИгры.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		РезультатФункции = НайденныеСтроки[0].ЗначениеПараметра;
	Иначе
		// Параметр не найден — возвращаем значение по умолчанию.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПолучитьЗначениеПараметраИгры()

// Инициализирует таблицу параметров игры — очищает все строки.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
