// Осуществляет розыгрыш карты Адреналин.
// Карта выполняет сразу 3 действия:
// 1. Наносит 1 урон игроку;
// 2. Сбрасывает все карты из стопки РукаИгрока в стопку СтопкаСброса;
// 3. Добирает из стопки СтопкаДобора в стопку РукаИгрока пока в стопке РукаИгрока меньше 5 карт;
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентифкаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Адреналин(Форма, КартаВход, ИдентифкаторКартыВход) Экспорт
	// 1. Наносим 1 урон игроку
	Форма.НанестиУронИгроку(1);
	
	// 2. Сбрасываем все карты из РукаИгрока в СтопкаСброса
	Пока Форма.РукаИгрока.Количество() > 0 Цикл
		ПерваяКарта = Форма.РукаИгрока[0];
		ИдентификаторКарты = ПерваяКарта.ИдентификаторКарты;
		ВосхождениеКлиентСервер.ПереместиКартуИзСтопки(ИдентификаторКарты, "РукаИгрока", "СтопкаСброса", Форма);
	КонецЦикла;
	
	// 3. Добираем карты из СтопкаДобора в РукаИгрока пока в руке меньше 5 карт
	Форма.ДобратьРуку();
КонецПроцедуры		// ДействиеКарты_Адреналин()

// Разыгрывает карту "Без прикрас".
// Снимает все положительные параметры с противника и наносит игроку по 2 единицы урона за каждый снятый параметр.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентифкаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_БезПрикрас(Форма, КартаВход, ИдентифкаторКартыВход) Экспорт
	// Получаем массив положительных параметров
	ПоложительныеПараметры = Форма.ПолучитьПоложительныеПараметры();
	// Размер урона за каждый снятый параметр
	РазмерУрона = 2;
	// Проходим по всем положительным параметрам и снимаем их с противника
	Для Каждого ВидПараметра Из ПоложительныеПараметры Цикл
		ЗначениеПараметра = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметра);
		Если ЗначениеПараметра > 0 Тогда
			Форма.УдалитьПараметрПротивника(ВидПараметра);
			// Наносим игроку урон за каждый снятый параметр
			Форма.НанестиУронИгроку(РазмерУрона);
		Иначе
			// Не требуется снимать параметр.
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры		// ДействиеКарты_БезПрикрас()

// Действие карты Закалка: наносит 6 урона игроку, даёт игроку 12 щита.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  КартаВход - СправочникСсылка.Карты - ссылка на карту.
//  ИдентификаторКартыВход - УникальныйИдентификатор - идентификатор карты в таблице РукаИгрока.
//
Процедура ДействиеКарты_Закалка(Форма, КартаВход, ИдентификаторКартыВход) Экспорт
	// Наносим 6 урона игроку
	Форма.НанестиУронИгроку(6);
	
	// Даём игроку 12 щита
	Форма.УвеличитьЩитИгрока(12);
КонецПроцедуры		// ДействиеКарты_Закалка()

// Выполняет действие карты ОпасныйПируэт.
// Наносит 12 урона противнику и 5 урона игроку.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_ОпасныйПируэт(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	Форма.НанестиУронПротивнику(12);
	Форма.НанестиУронИгроку(5);
КонецПроцедуры		// ДействиеКарты_ОпасныйПируэт()

