// Возвращает значение параметра игры по его виду.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  ВидПараметраВход - ПеречислениеСсылка.ВидыПараметровИгроков - вид параметра.
//
// Возвращаемое значение:
//  Число - значение параметра; 0 если параметр не найден.
//
Функция ПолучитьЗначениеПараметраИгры(Форма, ВидПараметраВход) Экспорт
	РезультатФункции = 0;
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ВидПараметра", ВидПараметраВход);
	НайденныеСтроки = Форма.ПараметрыИгры.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		РезультатФункции = НайденныеСтроки[0].ЗначениеПараметра;
	Иначе
		// Параметр не найден — возвращаем значение по умолчанию.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПолучитьЗначениеПараметраИгры()

// Инициализирует таблицу параметров игры — очищает все строки.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ИнициализироватьПараметрыИгры(Форма) Экспорт
	Форма.ПараметрыИгры.Очистить();
КонецПроцедуры		// ИнициализироватьПараметрыИгры()

// Удаляет параметр игры по его виду.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  ВидПараметраВход - ПеречислениеСсылка.ВидыПараметровИгроков - вид параметра для удаления.
//
Процедура УдалитьПараметрИгры(Форма, ВидПараметраВход) Экспорт
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ВидПараметра", ВидПараметраВход);
	НайденныеСтроки = Форма.ПараметрыИгры.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Форма.ПараметрыИгры.Удалить(НайденныеСтроки[0]);
	Иначе
		// Параметр не найден — удалять нечего.
	КонецЕсли;
КонецПроцедуры		// УдалитьПараметрИгры()

// Увеличивает значение параметра игры на указанную дельту.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  ВидПараметраВход - ПеречислениеСсылка.ВидыПараметровИгроков - вид параметра.
//  ДельтаВход - Число - величина, на которую увеличивается параметр.
//
Процедура УвеличитьПараметрИгры(Форма, ВидПараметраВход, ДельтаВход) Экспорт
	ТекущееЗначение = ПолучитьЗначениеПараметраИгры(Форма, ВидПараметраВход);
	НовоеЗначение = ТекущееЗначение + ДельтаВход;
	ВосхождениеКлиентСервер.УстановитьПараметрИгры(Форма, ВидПараметраВход, НовоеЗначение);
КонецПроцедуры		// УвеличитьПараметрИгры()

//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура НастройкиВикторины_Завершение(Форма, ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		Форма.ТекПользователь		 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВыбранноеЗначение, "Пользователь", ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка"));
		НовыйСборник		 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВыбранноеЗначение, "Сборник", ПредопределенноеЗначение("Справочник.Сборники.ПустаяСсылка"));
		Форма.РежимВикторины		 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВыбранноеЗначение, "РежимВикторины", ПредопределенноеЗначение("Перечисление.РежимыВикторины.ОдинСборникБезОстановки"));
		Форма.ВыбранныеСборники	 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВыбранноеЗначение, "ВыбранныеСборники", Новый СписокЗначений);
		Если НовыйСборник <> Форма.Сборник Тогда
			Форма.Сборник = НовыйСборник;
			ВосхождениеКлиентСервер.УправлениеВидимостью(Форма);
			Форма.КоличествоВерных = 0;
			Форма.КоличествоЗаданных = 0;
			Форма.ОтобразитьСледующееЗадание(Форма.Сборник);
		Иначе
			// Сборник не изменился. Не отображаем новый вопрос.
		КонецЕсли;
	Иначе
		// Не изменяем значения настроек.
	КонецЕсли;
КонецПроцедуры		// НастройкиВикторины_Завершение()

#КонецОбласти

#Область РежимВосхождение

// Завершает восхождение при прохождении последнего этапа.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ЗавершитьВосхождение(Форма) Экспорт
	Форма.Доступность = Ложь;
	// Очищаем сохранение восхождения для текущего пользователя
	Форма.ОчиститьСохранениеПользователя_Сервер(Форма.ТекПользователь);
	ДостижениеЗавершеноВосхождение(Форма);
	ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаУспешноеВосхождение", , Форма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры		// ЗавершитьВосхождение()

// Выполняет проверку победы над противником и поражения игрока.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Функция ПроверитьПобеды(Форма) Экспорт
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("ПротивникПобежден",	 ПротивникБылПобежден(Форма));
	РезультатФункции.Вставить("ИгрокПобежден",		 ИгрокБылПобежден(Форма));
	Возврат РезультатФункции;
КонецФункции		// ПроверитьПобеды()

// Осуществляет обработку верного ответа для режима викторины Восхождение.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ОбработатьВерныйОтветВосхождение(Форма) Экспорт
	Форма.ДействияИгрока();
	Форма.УвеличитьЗарядСерии();
КонецПроцедуры		// ОбработатьВерныйОтветВосхождение()

// Уменьшает значения уменьшаемых параметров игрока на 1 за ход.
// Использует функцию перечисления ВидыПараметровИгроков.ПолучитьУменьшаемыеПараметрыИгроков().
// При достижении значения параметра "Бомба" 0 или ниже - наносится урон игроку.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура УменьшитьПараметрыИгроков(Форма) Экспорт
	// Инициализация
	МодификаторАнтидот = ПредопределенноеЗначение("Справочник.Модификаторы.Антидот");
	ВидПараметраБомба	 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Бомба");
	ВидПараметраГорение	 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Горение");
	ВидПараметраЯд		 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Яд");
	УменьшаемыеПараметры = Форма.ПолучитьУменьшаемыеПараметрыИгроков();
	// Обход уменьшаемых параметров.
	Для каждого ВидПараметра Из УменьшаемыеПараметры Цикл
		ЗначениеПараметра = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметра);
		Если ЗначениеПараметра > 0 Тогда
			// Если активен модификатор Антидот, параметр Яда уменьшается на 2
			Если ВидПараметра = ВидПараметраЯд
				И ВосхождениеКлиентСервер.МодификаторАктивен(Форма, МодификаторАнтидот) Тогда
				НовоеЗначение = ЗначениеПараметра - 2;
			Иначе
				НовоеЗначение = ЗначениеПараметра - 1;
			КонецЕсли;
			// Проверка параметра "Яд": наносим урон до уменьшения значения
			Если ВидПараметра = ВидПараметраЯд Тогда
				Форма.НанестиУронИгроку(ЗначениеПараметра);
			КонецЕсли;
			Если НовоеЗначение <= 0 Тогда
				Форма.УдалитьПараметрИгрока(ВидПараметра);
			Иначе
				Форма.УстановитьПараметрИгрока(ВидПараметра, НовоеЗначение);
			КонецЕсли;
			// Проверка параметра "Бомба": если значение стало 0 или ниже - наносим урон
			Если ВидПараметра = ВидПараметраБомба Тогда
				Форма.ПроверитьБомбу(НовоеЗначение);
			Иначе
				// Параметр не бомба, просто уменьшаем
			КонецЕсли;
		Иначе
			// Значение параметра уже 0 или меньше, пропускаем
		КонецЕсли;
	КонецЦикла;
	// Проверка параметра "Горение": если яд активен, наносим урон от Горения.
	ЗначениеГорение = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраГорение);
	Если ЗначениеГорение > 0 Тогда
		Форма.НанестиУронИгрокуОтГорения();
	КонецЕсли;
КонецПроцедуры		// УменьшитьПараметрыИгроков()

// Перезапускает восхождение без возврата к настройкам.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ПерезапуститьВосхождение(Форма) Экспорт
	// Инициализация.
	ВидПараметраПолученоУрона = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгры.ПолученоУрона");
	ВидПараметраВерныхПодряд = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгры.ВерныхОтветовПодряд");
	// Основные действия.
	Форма.Доступность = Истина;
	Форма.ПерезапуститьВосхождение_Сервер();
	ВосхождениеКлиентСервер.УстановитьПараметрИгры(Форма, ВидПараметраПолученоУрона, 0);
	ВосхождениеКлиентСервер.УстановитьПараметрИгры(Форма, ВидПараметраВерныхПодряд, 0);
	ВосхождениеКлиент.ИзменитьЦветПротивника(Форма);
	Форма.ОтобразитьСледующееЗадание(Форма.Сборник);
КонецПроцедуры		// ПерезапуститьВосхождение()

#КонецОбласти

#Область Достижения

// Устанавливает достижение Сто вопросов отвечено.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ДостижениеСтоОтветов(Форма, КоличествоЗаданныхВход) Экспорт
	Если ДостиженияКлиентСервер.ЕстьДостижениеСтоОтветов(КоличествоЗаданныхВход) Тогда
		//ТекПользователь = ОбщегоНазначенияВызовСервера.ТекущийПользователь();
		ОбщегоНазначенияВызовСервера.ПроверитьИВыдатьДостижениеПользователю(Форма.ТекПользователь, ПредопределенноеЗначение("Перечисление.Достижения.СтоВопросовСыграно"));
	Иначе
		// Критерий не пройден. Не добавляем достижение.
	КонецЕсли;
КонецПроцедуры		// ДостижениеСтоОтветов()

// Устанавливает достижение Тридцать правильных ответов.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ДостижениеТридцатьБезОшибок(Форма, КоличествоВерныхВход) Экспорт
	Если КоличествоВерныхВход >= 30 Тогда
		Форма.ТекПользователь = ОбщегоНазначенияВызовСервера.ТекущийПользователь();
		ВыбранноеДостижение = ПредопределенноеЗначение("Перечисление.Достижения.ТридцатьВопросовБезОшибок");
		ОбщегоНазначенияВызовСервера.ПроверитьИВыдатьДостижениеПользователю(Форма.ТекПользователь, ВыбранноеДостижение);
	Иначе
		// Критерий не пройден. Не добаляем достижение.
	КонецЕсли;
КонецПроцедуры		// ДостижениеТридцатьБезОшибок()

// Устанавливает достижение Серия двадцать.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ДостижениеСерияДвадцатьПравильных(Форма, СерияВерныхВход) Экспорт
	Если СерияВерныхВход >= 20 Тогда
		Форма.ТекПользователь = ОбщегоНазначенияВызовСервера.ТекущийПользователь();
		ВыбранноеДостижение = ПредопределенноеЗначение("Перечисление.Достижения.СерияДвадцатьПравильных");
		ОбщегоНазначенияВызовСервера.ПроверитьИВыдатьДостижениеПользователю(Форма.ТекПользователь, ВыбранноеДостижение);
	Иначе
		// Критерий не пройден. Не добаляем достижение.
	КонецЕсли;
КонецПроцедуры		// ДостижениеСерияДвадцатьПравильных()

// Устанавливает достижение Двадцать вопросов за шестьдесят секунд.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ДостижениеДвадцатьВопросовЗаШестьдесятСекунд(Форма, МассивДатВыход) Экспорт
	Если ДостиженияКлиентСервер.ЕстьДостижениеДвадцатьВопросовЗаШестьдесятСекунд(МассивДатВыход) Тогда
		Форма.ТекПользователь = ОбщегоНазначенияВызовСервера.ТекущийПользователь();  
		ВыбранноеДостижение = ПредопределенноеЗначение("Перечисление.Достижения.ДвадцатьВопросовЗаШестьдесятСекунд");
		ОбщегоНазначенияВызовСервера.ПроверитьИВыдатьДостижениеПользователю(Форма.ТекПользователь, ВыбранноеДостижение);
	Иначе
		// Критерий не пройден. Не добаляем достижение.
	КонецЕсли;
КонецПроцедуры		// ДостижениеДвадцатьВопросовЗаШестьдесятСекунд()

// Устанавливает достижение Завершено восхождение.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ДостижениеЗавершеноВосхождение(Форма) Экспорт
	Форма.ТекПользователь = ОбщегоНазначенияВызовСервера.ТекущийПользователь();
	ВыбранноеДостижение = ПредопределенноеЗначение("Перечисление.Достижения.ЗавершениеВосхождения");
	ОбщегоНазначенияВызовСервера.ПроверитьИВыдатьДостижениеПользователю(Форма.ТекПользователь, ВыбранноеДостижение);
КонецПроцедуры		// ДостижениеЗавершеноВосхождение()

#КонецОбласти

#Область ОтветыВикторины

// Добавляет в стек ДатыОтветов текущую дату
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ДобавитьТекущуюДатуВСтек(Форма) Экспорт
	РазмерСтекаДат = 20;
	ТекДата = ТекущаяДата();
	НовыйСписокДаты = Новый СписокЗначений;
	НовыйСписокДаты.Добавить(ТекДата);
	Если Форма.ДатыОтветов.Количество() < РазмерСтекаДат Тогда
		Для Каждого ТекДатыОтветов Из Форма.ДатыОтветов Цикл
			НовыйСписокДаты.Добавить(ТекДатыОтветов.Значение);
		КонецЦикла;	
	Иначе
		Для Счетчик = 0 По РазмерСтекаДат - 2 Цикл
			ТекДатыОтветов = Форма.ДатыОтветов.Получить(Счетчик);
			НовыйСписокДаты.Добавить(ТекДатыОтветов.Значение);
		КонецЦикла;
	КонецЕсли;
	МассивДат = НовыйСписокДаты.ВыгрузитьЗначения();
	Форма.ДатыОтветов.ЗагрузитьЗначения(МассивДат);
КонецПроцедуры		// ДобавитьТекущуюДатуВСтек()

// Определяет, достигнут ли конец раунда при включенном режиме.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Функция ДостигнутКонецРаунда(Форма) Экспорт
	РезультатФункции = Ложь;
	ЭтоРежимИспытание = (Форма.РежимВикторины = ПредопределенноеЗначение("Перечисление.РежимыВикторины.Испытание"));
	ДостигнутПределЗаданных = (Форма.КоличествоЗаданных >= Форма.КоличествоЗаданийВРаунде);
	РезультатФункции = (ЭтоРежимИспытание И ДостигнутПределЗаданных);
	Возврат РезультатФункции;
КонецФункции		// ДостигнутКонецРаунда()

// Изменяет фон у команды ответа сборника СборникВход с номером 
// НомерОтветаВход.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ПодсветитьПравильныйОтвет(Форма, НомерОтветаВход, СборникВход) Экспорт
	ВыбранныйЭлемент = Неопределено;
	Форма.Сложность = ПредопределенноеЗначение("Перечисление.СложностиСборников.ШестьОтветов");
	Если ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины) Тогда
		Форма.Сложность = ПредопределенноеЗначение("Перечисление.СложностиСборников.ЧетыреОтвета");
	Иначе	
		Форма.Сложность = ОбщегоНазначенияВызовСервера.ПолучитьЗначениеРеквизита(СборникВход, "Сложность");
	КонецЕсли;
	Если Форма.Сложность = ПредопределенноеЗначение("Перечисление.СложностиСборников.ШестьОтветов") Тогда
		Если НомерОтветаВход = 1 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант1;
		ИначеЕсли НомерОтветаВход = 2 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант2;
		ИначеЕсли НомерОтветаВход = 3 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант3;
		ИначеЕсли НомерОтветаВход = 4 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант4;
		ИначеЕсли НомерОтветаВход = 5 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант5;
		ИначеЕсли НомерОтветаВход = 6 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант6;
		Иначе
			ВыбранныйЭлемент = Неопределено;
		КонецЕсли;
	ИначеЕсли Форма.Сложность = ПредопределенноеЗначение("Перечисление.СложностиСборников.ЧетыреОтвета") Тогда
		Если НомерОтветаВход = 1 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант1;
		ИначеЕсли НомерОтветаВход = 2 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант2;
		ИначеЕсли НомерОтветаВход = 3 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант4;
		ИначеЕсли НомерОтветаВход = 4 Тогда
			ВыбранныйЭлемент = Форма.Элементы.ВыбратьВариант5;
		Иначе
			ВыбранныйЭлемент = Неопределено;
		КонецЕсли;
	Иначе
		ВыбранныйЭлемент = Неопределено;
	КонецЕсли;
	Если ВыбранныйЭлемент <> Неопределено Тогда
		ВыбранныйЭлемент.ЦветФона = WebЦвета.СветлоНебесноГолубой;
	Иначе
		Сообщить(НСтр("ru = 'Не удалось определить элемент для подсветки правильного ответа'"));
	КонецЕсли;
КонецПроцедуры		// ПодсветитьПравильныйОтвет()

// Устанавливает достижения, привязанные к выбору правильного ответа.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ОбработатьДостиженияВыборОтвета(Форма) Экспорт
	ДостижениеСтоОтветов(Форма, Форма.КоличествоЗаданных);
	ДостижениеТридцатьБезОшибок(Форма, Форма.КоличествоВерных);
	ДостижениеСерияДвадцатьПравильных(Форма, Форма.СерияПравильных);
	ДостижениеДвадцатьВопросовЗаШестьдесятСекунд(Форма, Форма.ДатыОтветов.ВыгрузитьЗначения());
КонецПроцедуры		// ОбработатьДостиженияВыборОтвета()

// Отображает предупреждение с текстом правильного ответа.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ПоказатьПредупреждениеПравильныйОтчет(Форма) Экспорт
	ТекстОтвета = "";
	Для Каждого ТекНомераОтветов Из Форма.НомераОтветов Цикл
		Если ТекНомераОтветов.НомерОтвета = Форма.НомерПравильногоОтвета Тогда
			ТекстОтвета = ТекНомераОтветов.ТекстОтвета;
			Прервать;
		Иначе
			// Выполняем поиск далее.
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(ТекстОтвета) Тогда
		ПоказатьПредупреждение(, "Правильный ответ: " + ТекстОтвета, 15);
	Иначе
		ПоказатьПредупреждение(, "Правильный ответ №" + Строка(Форма.НомерПравильногоОтвета), 15);
	КонецЕсли;
КонецПроцедуры		// ПоказатьПредупреждениеПравильныйОтчет()

// Добавляет текущее задание в таблицу вопросов к повторению, если его там ещё нет.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ДобавитьЗаданиеВТаблицуПовтора(Форма) Экспорт
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Вопрос", Форма.ВыбранноеЗадание);
	НайденныеСтроки = Форма.ВопросыКПовторениям.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() = 0 Тогда
		НоваяСтрока = Форма.ВопросыКПовторениям.Добавить();
		НоваяСтрока.Вопрос = Форма.ВыбранноеЗадание;
	Иначе
		// Вопрос уже присутствует.
	КонецЕсли;
КонецПроцедуры		// ДобавитьЗаданиеВТаблицуПовтора()

// Получает и выводит следующее задание на форму.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ОтобразитьСледующееЗадание(Форма, СборникВход) Экспорт
	Форма.НеверныеВариантыУбраны = Ложь;
	Форма.Элементы.ВыбратьВариант1.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант2.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант3.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант4.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант5.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант6.Доступность = Истина;
	Форма.Элементы.ВыбратьВариант1.ЦветФона = Новый Цвет();
	Форма.Элементы.ВыбратьВариант2.ЦветФона = Новый Цвет();
	Форма.Элементы.ВыбратьВариант3.ЦветФона = Новый Цвет();
	Форма.Элементы.ВыбратьВариант4.ЦветФона = Новый Цвет();
	Форма.Элементы.ВыбратьВариант5.ЦветФона = Новый Цвет();
	Форма.Элементы.ВыбратьВариант6.ЦветФона = Новый Цвет();
	РезультатСмены = Форма.СледующееЗадание_Сервер(СборникВход, Форма.РежимВикторины);	
	Форма.Сборник = РезультатСмены.Сборник;
	Форма.АдресКартинки = РезультатСмены.АдресКартинки;
	Форма.КоличествоЗаданных = Форма.КоличествоЗаданных + 1;
	Форма.ОтветДан = Ложь;
	Форма.Заголовок = Строка(Форма.Сборник);
	ВосхождениеКлиент.ДобавитьТекущуюДатуВСтек(Форма);
	Форма.ОбновитьИнтерфейсБоя();
	ВосхождениеКлиент.ОбновитьРукуКарт(Форма);
КонецПроцедуры

// Выполняет удаление половины неправильных ответов на вопрос.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ОбработкаУбратьНевернуюПоловину(Форма) Экспорт
	МассивНеверных = Форма.ПолучитьМассивНеправильныхОтветовКУдалению(Форма.НомерПравильногоОтвета, Форма.Сборник);
	ВосхождениеКлиентСервер.УбратьНеверныеОтветы(МассивНеверных, Форма);
	Форма.НеверныеВариантыУбраны = Истина;
	ВосхождениеКлиентСервер.УправлениеВидимостью(Форма);
КонецПроцедуры		// ОбработкаУбратьНевернуюПоловину()

// Фиксирует ответ пользователя номер НомерОтветаВход.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура ВыбратьВариантОтвета(Форма, Гсч, НомерОтветаВход) Экспорт
	// Инициализация.
	ВероятностьПодсказки = 11;
	НовыйНомерПравильногоОтвета = ОбщегоНазначенияКлиентСервер.ПреобразоватьНомерПравильногоОтвета(Форма.НомерПравильногоОтвета, Форма.Сложность);
	ЭтоВерныйОтвет = (НомерОтветаВход = НовыйНомерПравильногоОтвета);
	НовыйОпыт = 0;
	МодификаторВолчийКлык	 = ПредопределенноеЗначение("Справочник.Модификаторы.ВолчийКлык");
	МодификаторПоплавок		 = ПредопределенноеЗначение("Справочник.Модификаторы.Поплавок");
	МодификаторГарпун		 = ПредопределенноеЗначение("Справочник.Модификаторы.Гарпун");
	// Обработка ответа.
	Если ЭтоВерныйОтвет Тогда
		Если ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины) Тогда
			Форма.БылВерныйОтвет = Истина;
			Форма.ОбработатьВерныйОтветВосхождение();
		Иначе
			Форма.ОтобразитьСледующееЗадание(Форма.Сборник);
		КонецЕсли;	
		Если НЕ Форма.ОтветДан Тогда
			Форма.КоличествоВерных = Форма.КоличествоВерных + 1;
			Форма.СерияПравильных = Форма.СерияПравильных + 1;
			ВосхождениеКлиент.УвеличитьПараметрИгры(Форма, ПредопределенноеЗначение("Перечисление.ВидыПараметровИгры.ВерныхОтветовПодряд"), 1);
			// Проверка модификатора БурлящаяРеторта: каждый 3-й верный ответ подряд даёт +1 энергию.
			Если ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины) Тогда
				МодификаторБурлящаяРеторта = ПредопределенноеЗначение("Справочник.Модификаторы.БурлящаяРеторта");
				Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, МодификаторБурлящаяРеторта) Тогда
					ВерныхПодряд = ВосхождениеКлиент.ПолучитьЗначениеПараметраИгры(Форма, ПредопределенноеЗначение("Перечисление.ВидыПараметровИгры.ВерныхОтветовПодряд"));
					Если ВерныхПодряд % 3 = 0 Тогда
						Форма.УвеличитьПараметрИгрока(ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Энергия"), 1);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			НовыйОпыт = 3;
			// Применяем модификатор "ВолчийКлык" при правильном ответе.
			Если ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины) Тогда
				Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, МодификаторВолчийКлык) Тогда
					Форма.ПрименитьМодификатор_ВолчийКлык(Истина);
				Иначе
					// Нет модификатора, не увеличиваем Ярость.
				КонецЕсли;
				Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, МодификаторПоплавок) Тогда
					Форма.ПрименитьМодификатор_Поплавок();
				Иначе
					// Нет модификатора Поплавок.
				КонецЕсли;
				Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, МодификаторГарпун) Тогда
					Форма.ПрименитьМодификатор_Гарпун();
				Иначе
					// Нет модификатора Гарпун.
				КонецЕсли;
			Иначе
				// Не требуется применения модифкаторов для прочих режимов.
			КонецЕсли;	
		Иначе
			// Не увеличиваем количество верных ответов.
		КонецЕсли;
	Иначе
		Если НЕ ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины) Тогда
			СтруктураПараметров = Новый Структура;
			ВыбранноеЧисло = Гсч.СлучайноеЧисло(1, 100);
			Если (ВыбранноеЧисло < ВероятностьПодсказки) Тогда
				ТекстВопроса = НСтр("ru = 'Ответ неверный. Хотите использовать подсказку?'");
				Режим = РежимДиалогаВопрос.ДаНет;
				Оповещение = Новый ОписаниеОповещения("ПодтверждениеИспользованиеПодсказкиЗавершение", Форма, СтруктураПараметров);
				ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
			Иначе                       
				Форма.ОбработкаНеправильногоОтвета();
			КонецЕсли;
		Иначе
			// Для восхождения всегда обрабатываем неверный.
			Форма.ОбработкаНеправильногоОтвета();
		КонецЕсли;
	КонецЕсли;
	ВосхождениеКлиент.ОбработатьДостиженияВыборОтвета(Форма);
	Форма.ПрименитьМодификатор_ФишкаКазино(ЭтоВерныйОтвет);
	Форма.НачислитьОпыт(НовыйОпыт, Форма.ТекПользователь);
	Форма.ЗаписатьОтветВРезультаты(Форма.Сборник, Форма.ТекПользователь, ЭтоВерныйОтвет);
КонецПроцедуры		// ВыбратьВариантОтвета()

//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура НачатьЗадание(Форма) Экспорт
	Если ВосхождениеКлиент.ДостигнутКонецРаунда(Форма) Тогда
		Сообщить("Задано " + Строка(Форма.КоличествоЗаданных) + " вопросов. Верно отвечено: " + Строка(Форма.КоличествоВерных));
		Форма.ОтобразитьСледующееЗадание(Форма.Сборник);
	Иначе
		Форма.ОтобразитьСледующееЗадание(Форма.Сборник);
	КонецЕсли;
	Форма.УменьшитьПараметрыИгроков();
	Форма.УменьшитьПараметрыПротивников();
КонецПроцедуры

// Обработчик оповещения о закрытии формы действий противника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ПослеЗакрытияФормыДействийПротивника(Форма, Результат, ДополнительныеПараметры) Экспорт
	Форма.ОтобразитьСледующееЗадание(Форма.Сборник);
КонецПроцедуры

// Вызывается при окончании обработки неправильного ответа.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ОбработкаНеправильногоОтвета(Форма) Экспорт
	// Инициализация.
	МодификаторСтраховка = ПредопределенноеЗначение("Справочник.Модификаторы.Страховка");
	// Проверка ответа.
	Если НЕ Форма.ОтветДан Тогда
		// Отобразим правильный ответ пользователю и подстветим его.
		ВосхождениеКлиент.ПоказатьПредупреждениеПравильныйОтчет(Форма);
		ВосхождениеКлиент.ПодсветитьПравильныйОтвет(Форма, Форма.НомерПравильногоОтвета, Форма.Сборник);
		// Режим Восхождение.
		Если ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины) Тогда
			// Отмечаем неверный ответ и запоминаем задание для повтора модификатором Маятник.
			Форма.БылНеверныйОтвет = Истина;
			Форма.ПредыдущееЗадание = Форма.ВыбранноеЗадание;
			Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, МодификаторСтраховка) И ВосхождениеКлиент.ПрименитьМодификатор_Страховка() Тогда
				ТекстСообщения = НСтр("ru = 'Ответ неверный, но Страховка защитила вас от последствий'");
				ПоказатьПредупреждение(, ТекстСообщения, 15);
			Иначе
				Форма.ПротивникСбежал = Ложь;
				Если НЕ Форма.ПротивникСбежал Тогда
					// Действия противника.
					Форма.ПроверитьПоражениеИгрока();
					СтруктураДействия = Форма.ДействияПротивника();
					ВариантДействия = СтруктураДействия.ВариантДействия;
					ПараметрыФормыДействияПротивника = Форма.ПолучитьПараметрыОткрытияФормыПротивника(ВариантДействия);
					Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияФормыДействийПротивника", Форма);
					РежимОткрытияБлокировкаВладельца = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
					ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаДействияПротивника", ПараметрыФормыДействияПротивника, Форма, , , , Оповещение, РежимОткрытияБлокировкаВладельца);
				Иначе
					ВосхождениеКлиент.ВыбратьСледующийЭтап(Форма);
				КонецЕсли;
			КонецЕсли;
		Иначе
			// Подсветим правильный ответ.
			Форма.ОтветДан = Истина;
			Форма.СерияПравильных = 0;
			ВосхождениеКлиентСервер.УстановитьПараметрИгры(Форма, ПредопределенноеЗначение("Перечисление.ВидыПараметровИгры.ВерныхОтветовПодряд"), 0);
			// Добавим задание в таблицу к повтору.
			ВосхождениеКлиент.ДобавитьЗаданиеВТаблицуПовтора(Форма);
		КонецЕсли;
		// Начисление опыта.
		НовыйОпыт = 1;
		Форма.НачислитьОпыт(НовыйОпыт, Форма.ТекПользователь);
	Иначе
		// Не требуется действий.
	КонецЕсли;
	// Модификаторы.
	Форма.ПрименитьМодификаторыПриСобытии(ВосхождениеКлиентСервер.ПредставлениеСобытияФормы_ПриНеправильномОтвете());
КонецПроцедуры		// ОбработкаНеправильногоОтвета()

//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ПодтверждениеИспользованиеПодсказкиЗавершение(Форма, Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		Форма.ОбработкаУбратьНевернуюПоловину();
	Иначе
		Форма.ОбработкаНеправильногоОтвета();
	КонецЕсли;
КонецПроцедуры		// ПодтверждениеИспользованиеПодсказкиЗавершение()

#КонецОбласти

#Область ДействияИгрока

// Возвращает признак победы над противником (здоровье <= 0).
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//
// Возвращаемое значение:
//  Булево - Истина, если противник побежден, Ложь в противном случае.
//
Функция ПротивникБылПобежден(Форма) Экспорт
	ВидПараметра = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
	ТекущееЗдоровье = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметра);
	Возврат ТекущееЗдоровье <= 0;
КонецФункции		// ПротивникБылПобежден()

// Открывает форму получения наград за сражение с протвиником ПротивникаВход.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//	ПротивникаВход - СправочникСсылка.Противники - Побежденный противник.
//
Процедура ОткрытьПолучениеНаград(Форма, ПротивникаВход) Экспорт
	// Получаем размер награды золотом
	РазмерНаграды = ПолучитьРазмерНаградыЗолото(Форма, ПротивникаВход);
	// Получаем массив из 3 случайных неповторяемых карт для выбора награды
	МассивКарт = Форма.ПолучитьКартыВыборНаграды(ПротивникаВход);
	// Преобразуем массив карт в список значений
	СписокКарт = Новый СписокЗначений;
	Для Каждого Карта Из МассивКарт Цикл
		СписокКарт.Добавить(Карта);
	КонецЦикла;
	// Получаем текущее золото игрока
	ВидПараметраЗолото = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Золото");
	ТекущееЗолото = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЗолото);
	// Создаем структуру параметров формы
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПолученноеЗолото",	 РазмерНаграды);
	ПараметрыФормы.Вставить("ПредлагаемыеКарты", СписокКарт);
	ПараметрыФормы.Вставить("Противник",		 Форма.Противник);
	ПараметрыФормы.Вставить("ТекущееЗолото",	 ТекущееЗолото);
	// Создаем описание оповещения для открытия формы получения наград
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПолученияНаград_Завершение", Форма);
	// Открываем форму получения наград
	ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаПолученияНаград", ПараметрыФормы, Форма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры		// ОткрытьПолучениеНаград()

// Возвращает размер награды золотом за победу над противником.
// Минимальная награда: База + Цел(НомерЭтапа / 5), максимальная — вдвое больше.
// Итоговая награда выбирается случайно между минимальной и максимальной.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  ПротивникВход - СправочникСсылка.Противники - побежденный противник.
//
// Возвращаемое значение:
//  Число - размер награды золотом.
//
Функция ПолучитьРазмерНаградыЗолото(Форма, ПротивникВход) Экспорт
	// Инициализация.
	БазоваяНаграда = 20;
	// Минимальная сумма награды: База + Цел(НомерЭтапа / 3).
	МинимальнаяСумма = БазоваяНаграда + Цел(Форма.НомерЭтапа / 3);
	// Максимальная сумма награды: 2 × минимальная сумма.
	МаксимальнаяСумма = 2 * МинимальнаяСумма;
	// Итоговая награда: случайное число между минимальной и максимальной суммой.
	Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	РазмерНаграды = Гсч.СлучайноеЧисло(МинимальнаяСумма, МаксимальнаяСумма);
	Возврат РазмерНаграды;
КонецФункции		// ПолучитьРазмерНаградыЗолото()

// Проверяет, пройден ли последний этап восхождения.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//
// Возвращаемое значение:
//  Булево - Истина, если последний этап пройден, Ложь в противном случае.
//
Функция ПройденПоследнийЭтап(Форма) Экспорт
	Возврат Форма.НомерЭтапа > Форма.ВсегоЭтапов;
КонецФункции		// ПройденПоследнийЭтап()

// Обрабатывает побег противника из боя.
// Бой завершается, игрок переходит на следующий этап, но не получает награды за бой.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ОбработатьПобегПротивника(Форма) Экспорт
	Сообщить("Противник сбежал из боя!");
	Форма.ПротивникСбежал = Истина;
КонецПроцедуры		// ОбработатьПобегПротивника()

// Возвращает размер урона, наносимого игроком.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
// 
Функция ПолучитьРазмерУронаИгрока(Форма) Экспорт
	// Инициализация.
	ВидПараметраЯрость = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Ярость");
	ВидПараметраСила = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Сила");
	БазовыйУрон = 5;
	// Добавляем бонус от параметра Сила игрока
	РезультатФункции = БазовыйУрон;
	ЗначениеСилы = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраСила);
	РезультатФункции = РезультатФункции + ЗначениеСилы;
	// Применяем параметр Ярость: увеличение урона на 5% за каждую единицу Ярости
	ЗначениеЯрости = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЯрость);
	Если ЗначениеЯрости > 0 Тогда
		КоэффициентЯрости = 1 + (ЗначениеЯрости * 0.05);
		РезультатФункции = РезультатФункции * КоэффициентЯрости;
	Иначе
		// Нет Ярости.
	КонецЕсли;
	// Применяем модификатор "Заточка": увеличение урона на 1
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, ПредопределенноеЗначение("Справочник.Модификаторы.Заточка")) Тогда
		РезультатФункции = РезультатФункции + 1;
	Иначе
		// Нет заточки.
	КонецЕсли;
	// Применяем модификатор "Рапира".
	РезультатФункции = РезультатФункции + ВосхождениеКлиент.ПрименитьМодификатор_Рапира(Форма);
	// Проверяем наличие проклятия у игрока
	Если ВосхождениеКлиентСервер.ЕстьПроклятиеУИгрока(Форма) Тогда
		// Уменьшаем урон на 25%
		РезультатФункции = РезультатФункции * 0.75;
	Иначе
		// Проклятия нет, урон не уменьшаем.
	КонецЕсли;
	// Применяем модификатор "ШлемБерсерка": каждые 10% недостающего здоровья увеличивают урон на 5%
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, ПредопределенноеЗначение("Справочник.Модификаторы.ШлемБерсерка")) Тогда
		ВидПараметраТекущееЗдоровье = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
		ТекущееЗдоровье = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраТекущееЗдоровье);
		МаксимальноеЗдоровье = ВосхождениеКлиентСервер.ПолучитьМаксимальноеЗдоровьеИгрока(Форма);
		НедостающиеПроценты = (МаксимальноеЗдоровье - ТекущееЗдоровье) / МаксимальноеЗдоровье * 100;
		КоличествоДесятков = Цел(НедостающиеПроценты / 10);
		Если КоличествоДесятков > 0 Тогда
			РезультатФункции = РезультатФункции * (1 + КоличествоДесятков * 0.05);
		КонецЕсли;
	КонецЕсли;
	// Применяем модификатор "МраморнаяТрибуна".
	РезультатФункции = РезультатФункции + ВосхождениеКлиент.ПрименитьМодификатор_МраморнаяТрибуна(Форма);
	// Применяем параметр ШепотИзБездны: урон увеличивается в 2 раза, параметр уменьшается на 1.
	ВидПараметраШепотИзБездны = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ШепотИзБездны");
	ЗначениеШепотаИзБездны = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраШепотИзБездны);
	Если ЗначениеШепотаИзБездны > 0 Тогда
		РезультатФункции = РезультатФункции * 2;
		Форма.УвеличитьПараметрИгрока(ВидПараметраШепотИзБездны, -1);
	Иначе
		// Параметр ШепотИзБездны отсутствует.
	КонецЕсли;
	// Округлим до целых.
	РезультатФункции = Цел(РезультатФункции);
	Возврат РезультатФункции;
КонецФункции		// ПолучитьРазмерУронаИгрока()

// наносит урон противнику по количеству, отрабатывая все модификаторы.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	УронВход - Число - Размер наносимого урона.
//
Процедура УронПротивникуПоКоличеству(Форма, УронВход) Экспорт
	// Вызываем метод нанесения урона противнику с анимацией.
	РезультатУрона = Форма.ПлавныйУронПротивнику(УронВход);
	РезультатУрона = Форма.НанестиУронПротивнику(УронВход);
	УронПоЩиту = РезультатУрона.УронПоЩиту;
	УронПоЗдоровью = РезультатУрона.УронПоЗдоровью;
	// Применяем модификатор "ЛетучаяМышь": излечение 10% от нанесенного урона
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, ПредопределенноеЗначение("Справочник.Модификаторы.ЛетучаяМышь")) Тогда
		Форма.ПрименитьМодификатор_ЛетучаяМышь(УронПоЗдоровью);
	КонецЕсли;
	// Применяем модификатор "ЦепкийКрюк": увеличение щита на 20% от урона по щиту
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, ПредопределенноеЗначение("Справочник.Модификаторы.ЦепкийКрюк")) Тогда
		Форма.ПрименитьМодификатор_ЦепкийКрюк(УронПоЩиту);
	КонецЕсли;
	РезультатПроверки = ВосхождениеКлиент.ПроверитьПобеды(Форма);
	ПротивникПобежден	 = РезультатПроверки.ПротивникПобежден;
	ИгрокПобежден		 = РезультатПроверки.ИгрокПобежден;
	Если ИгрокПобежден Тогда
		// Проверяем поражение игрока с учетом модификатора "Туман"
		Форма.ПроверитьПоражениеИгрока();
	Иначе
		Если ПротивникПобежден Тогда
			Форма.ОбработатьПобедуНадПротивником();
		Иначе
			// Не требуется обработка победы над противником, т.к. не побежден.
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры		// УронПротивникуПоКоличеству()

// Выполняет атаку игрока по противнику.
// Уменьшает текущее здоровье противника на величину урона игрока.
// Если у противника есть щит, урон сначала поглощается щитом.
// При активном модификаторе "ЛетучаяМышь" игрок излечивает 5% от нанесенного урона.
// При активном модификаторе "ЦепкийКрюк" игроку увеличивается щит на 20% от урона по щиту противника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура АтакаИгрока(Форма, Гсч) Экспорт
	// Инициализация.
	СобытиеАтакаИгрока = ПредопределенноеЗначение("Перечисление.СобытияБоя.АтакаИгрока");
	Урон = Форма.ПолучитьРазмерУронаИгрока();
	Форма.УронПротивникуПоКоличеству(Урон);
	// Запись в журнал боя.
	ВосхождениеКлиентСервер.ДобавитьЗаписьВЖурналБоя(Форма, СобытиеАтакаИгрока, Форма.Противник, Урон);
	// Применяем модификатор "ЯдовитыеКлинки": добавляет противнику 1 яда при атаке
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, ПредопределенноеЗначение("Справочник.Модификаторы.ЯдовитыеКлинки")) Тогда
		Форма.УвеличитьПараметрПротивника(ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Яд"), 1);
	КонецЕсли;
	// Применяем модификатор "ПарныеКлинки": 10% шанс на вторую атаку
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, ПредопределенноеЗначение("Справочник.Модификаторы.ПарныеКлинки")) Тогда
		ШансВторойАтаки = Гсч.СлучайноеЧисло(1, 100);
		Если ШансВторойАтаки <= 10 Тогда
			// Проводим вторую атаку
			Форма.АтакаИгрока();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры		// АтакаИгрока()

// Обработчик оповещения после получения наград.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Результат - произвольный - результат работы формы получения наград.
//  ДополнительныеПараметры - Структура - дополнительные параметры.
//
Процедура ПослеПолученияНаград_Завершение(Форма, Результат, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		// Увеличение золота.
		ВидПараметраЗолото = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Золото");
		НовоеЗолото = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат, "Золото", 0);
		Форма.УвеличитьПараметрИгрока(ВидПараметраЗолото, НовоеЗолото);
		// Добавление карты.
		НоваяКарта = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат, "Карта", ПредопределенноеЗначение("Справочник.Карты.ПустаяСсылка"));
		НоваяСтрока = Форма.КолодаИгрока.Добавить();
		НоваяСтрока.Карта = НоваяКарта;
		НоваяСтрока.ИдентификаторКарты = Строка(Новый УникальныйИдентификатор);
		// Переход к следующему этапу.
		ВосхождениеКлиент.ВыбратьСледующийЭтап(Форма);
	Иначе
		// Неизвестный вариант. Ничего не делаем.
	КонецЕсли;
КонецПроцедуры		// ПослеПолученияНаград()

// Выполняет действия при победе над противником.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ОбработатьПобедуНадПротивником(Форма) Экспорт
	// Для режима Восхождение открываем форму выбора этапа
	Если ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины) Тогда
		Если ВосхождениеКлиент.ПройденПоследнийЭтап(Форма) Тогда
			// Последний этап пройден, завершаем восхождение
			ВосхождениеКлиент.ЗавершитьВосхождение(Форма);
		Иначе
			Форма.ОчиститьПараметрыИгрокаКромеБазовых();
			// Выдаем награды за победу.
			ВосхождениеКлиент.ОткрытьПолучениеНаград(Форма, Форма.Противник);
		КонецЕсли;
	Иначе
		Форма.ИнициализироватьПротивника();
		ВосхождениеКлиент.ИзменитьЦветПротивника(Форма);
	КонецЕсли;

	// Применяем модификаторы конца боя.
	Форма.ПрименитьМодификаторыПриСобытии(ВосхождениеКлиентСервер.ПредставлениеСобытияФормы_ПриКонцеБоя());
КонецПроцедуры		// ОбработатьПобедуНадПротивником()

// Выполняет действия игрока после успешного ответа.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ДействияИгрока(Форма) Экспорт
	Форма.АтакаИгрока();
КонецПроцедуры		// ДействияИгрока()

// Проверяет, достаточно ли у игрока золота, и при наличии списывает указанную сумму.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	Сумма - Число - количество золота для списания.
//
// Возвращаемое значение:
//	Булево - Истина, если золото успешно списано; Ложь, если недостаточно.
//
Функция ЗаплатитьЗолото(Форма, Сумма) Экспорт
	СуммаКОплате = Сумма;
	МодификаторШляпаСкупердяя = ПредопределенноеЗначение("Справочник.Модификаторы.ШляпаСкупердяя");
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, МодификаторШляпаСкупердяя) И СуммаКОплате > 1 Тогда
		СуммаКОплате = СуммаКОплате - 1;
	КонецЕсли;
	ВидПараметраЗолото = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Золото");
	ЗолотоИгрока = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЗолото);
	Если ЗолотоИгрока >= СуммаКОплате Тогда
		Форма.УвеличитьПараметрИгрока(ВидПараметраЗолото, -СуммаКОплате);
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции		// ЗаплатитьЗолото()

#КонецОбласти

#Область ДействияПротивника

// Выполняет вибрацию на мобильном устройстве.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура Вибрация(Форма, Длина = 400) Экспорт
	Если Форма.ТихийРежим Тогда
		// Тихий режим включён — не воспроизводим вибрацию и звук.
	Иначе
		// Тактильный отклик на мобильном устройстве.
		Попытка
			#Если МобильноеПриложениеКлиент Тогда
				МассивВибрация = Новый Массив;
				МассивВибрация.Добавить(Длина);
				СредстваМультимедиа.ВоспроизвестиЗвуковоеОповещение(, Истина);
			#Иначе
				// Платформа не поддерживает вибрацию (Desktop).
			#КонецЕсли
		Исключение
			// Платформа не поддерживает вибрацию (Desktop).
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры		// Вибрация()

// Возвращает базовый урон противника в зависимости от номера этапа.
// Этапы  1-9: 2 урона.
// Этапы 10-19: 3 урона.
// Этапы 20-29: 4 урона.
// Этап 30: 5 урона.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//
// Возвращаемое значение:
//  Число - базовый урон противника.
//
Функция ПолучитьБазовыйУронПротивника(Форма) Экспорт
	Если Форма.НомерЭтапа >= 30 Тогда
		Возврат 5;
	ИначеЕсли Форма.НомерЭтапа >= 20 Тогда
		Возврат 4;
	ИначеЕсли Форма.НомерЭтапа >= 10 Тогда
		Возврат 3;
	Иначе
		Возврат 2;
	КонецЕсли;
КонецФункции		// ПолучитьБазовыйУронПротивника()

// Возвращает признак победы над игроком (здоровье <= 0).
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//
// Возвращаемое значение:
//  Булево - Истина, если игрок побежден, Ложь в противном случае.
//
Функция ИгрокБылПобежден(Форма) Экспорт
	ВидПараметра = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
	ТекущееЗдоровье = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметра);
	Возврат ТекущееЗдоровье <= 0;
КонецФункции		// ИгрокБылПобежден()

// Открывает форму поражения в режиме Восхождение при окончательном поражении игрока.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ПоказатьПоражениеВосхождение(Форма) Экспорт
	Если ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины) Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("НомерЭтапа", Форма.НомерЭтапа);
		ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаПораженияВосхождение", ПараметрыФормы, Форма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры		// ПоказатьПоражениеВосхождение()

// Выполняет атаку противника по игроку.
// Уменьшает текущее здоровье игрока на величину урона противника.
// Если активен модификатор "Кожаные пластины", урон уменьшается на 1.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура АтакаПротивника(Форма) Экспорт
	Форма.НанестиУронПротивником();
КонецПроцедуры		// АтакаПротивника()

// Выполняет действие противника Вампиризм.
// Противник наносит урон от минимальной до максимальной силы текущего действия,
// после чего излечивает себе 25% от нанесённого игроку урона, но не более своего максимального здоровья.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура Вампиризм(Форма, Гсч) Экспорт
	// Инициализация.
	ВидПараметраТекущееЗдоровье = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
	ВидПараметраМаксимальноеЗдоровье = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.МаксимальноеЗдоровье");
	// Получаем текущее действие противника из таблицы ЦиклДействийПротивника
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИдентификаторСтроки", Форма.ИдентификаторТекущегоДействияПротивника);
	НайденныеСтроки = Форма.ЦиклДействийПротивника.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		МинСила = НайденныеСтроки[0].МинимальнаяСила;
		МаксСила = НайденныеСтроки[0].МаксимальнаяСила;
		// Генерируем случайное значение урона в диапазоне от МинимальнаяСила до МаксимальнаяСила
		РазмерУрона = Гсч.СлучайноеЧисло(МинСила, МаксСила);
		РазмерУрона = Цел(РазмерУрона * ВосхождениеКлиентСервер.ПолучитьКоэффициентСложностиПротивника(Форма.НомерЭтапа));
	Иначе
		// Значение по умолчанию, если действие не найдено
		РазмерУрона = 5;
	КонецЕсли;
	// Наносим урон игроку
	Форма.НанестиУронИгроку(РазмерУрона);
	// Вычисляем лечение для противника (25% от нанесённого урона)
	РазмерЛечения = Цел(РазмерУрона * 0.25);
	// Получаем текущее и максимальное здоровье противника
	ТекущееЗдоровье = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраТекущееЗдоровье);
	МаксимальноеЗдоровье = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраМаксимальноеЗдоровье);
	// Вычисляем недостающее здоровье
	НедостающееЗдоровье = МаксимальноеЗдоровье - ТекущееЗдоровье;
	// Лечение не может превышать недостающее здоровье
	ФактическоеЛечение = Мин(РазмерЛечения, НедостающееЗдоровье);
	// Восстанавливаем здоровье противника
	НовоеЗдоровье = ТекущееЗдоровье + ФактическоеЛечение;
	Форма.УстановитьПараметрПротивника(ВидПараметраТекущееЗдоровье, НовоеЗдоровье);
КонецПроцедуры		// Вампиризм()

// Наносит урон игроку от противника.
// Учитывает модификатор "Кожаные пластины", который уменьшает урон на 1.
// Учитывает модификатор "Щит отражения", который возвращает 10% от урона противнику.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура НанестиУронПротивником(Форма, УронВход = 0) Экспорт
	Если ЗначениеЗаполнено(УронВход) Тогда
		Урон = УронВход;
		Урон = Форма.ПрименитьМодификаторыУронаПротивника(Урон);
	Иначе	
		Урон = Форма.ПолучитьРазмерУронаПротивника();
	КонецЕсли;
	Форма.НанестиУронИгроку(Урон);
	// Обработка модификатора "Щит отражения": 10% от урона возвращается противнику
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, ПредопределенноеЗначение("Справочник.Модификаторы.ЩитОтражения")) Тогда
		ОтраженныйУрон = Цел(Урон * 0.1);
		Если ОтраженныйУрон > 0 Тогда
			Форма.ПлавныйУронПротивнику(ОтраженныйУрон);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры		// НанестиУронПротивником()

// Поглощает урон защитой игрока (стеклянный щит, обычный щит).
// Учитывает модификатор "МифриловоеПокрытие".
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//  УронВход - Число - входящий урон.
//
// Возвращаемое значение:
//  Число - остаточный урон, прошедший сквозь защиту (0 если весь поглощён).
//
Функция ПоглотитьУронЗащитойИгрока(Форма, Гсч, УронВход) Экспорт
	ВидПараметраЩит				 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Щит");
	ВидПараметраСтеклянныйЩит	 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.СтеклянныйЩит");
	МодификаторМифриловоеПокрытие	 = ПредопределенноеЗначение("Справочник.Модификаторы.МифриловоеПокрытие");
	ОстаточныйУрон = УронВход;
	// Обработка Стеклянного щита: полностью отменяет урон по игроку и снимается
	ЗначениеСтеклянногоЩита = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраСтеклянныйЩит);
	Если ЗначениеСтеклянногоЩита > 0 Тогда
		// Модификатор "МифриловоеПокрытие": 30% шанс, что стеклянный щит не получит урона
		Если НЕ (ВосхождениеКлиентСервер.МодификаторАктивен(Форма, МодификаторМифриловоеПокрытие)
			И Гсч.СлучайноеЧисло(0, 99) < 30) Тогда
			Форма.УстановитьПараметрИгрока(ВидПараметраСтеклянныйЩит, ЗначениеСтеклянногоЩита - 1);
		КонецЕсли;
		ОстаточныйУрон = 0;
	Иначе
		// Обработка щита игрока: урон сначала приходится по щиту
		ВосхождениеКлиент.Вибрация(Форма, 200);
		ЗначениеЩита = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЩит);
		Если ЗначениеЩита > 0 Тогда
			Если ЗначениеЩита >= ОстаточныйУрон Тогда
				НовоеЗначениеЩита = ЗначениеЩита - ОстаточныйУрон;
				// Модификатор "МифриловоеПокрытие": 30% шанс, что щит не получит урона
				Если НЕ (ВосхождениеКлиентСервер.МодификаторАктивен(Форма, МодификаторМифриловоеПокрытие)
					И Гсч.СлучайноеЧисло(0, 99) < 30) Тогда
					Форма.УстановитьПараметрИгрока(ВидПараметраЩит, НовоеЗначениеЩита);
					Форма.ПодсветитьЩитИгрока();
				КонецЕсли;
				ОстаточныйУрон = 0;
			Иначе
				// Модификатор "МифриловоеПокрытие": 30% шанс, что щит не получит урона
				Если НЕ (ВосхождениеКлиентСервер.МодификаторАктивен(Форма, МодификаторМифриловоеПокрытие)
					И Гсч.СлучайноеЧисло(0, 99) < 30) Тогда
					Форма.УстановитьПараметрИгрока(ВидПараметраЩит, 0);
					Форма.ПодсветитьЩитИгрока();
				КонецЕсли;
				ОстаточныйУрон = ОстаточныйУрон - ЗначениеЩита;
			КонецЕсли;
		Иначе
			// Щита нет, урон наносится по здоровью.
		КонецЕсли;
	КонецЕсли;
	Возврат ОстаточныйУрон;
КонецФункции		// ПоглотитьУронЗащитойИгрока()

// Наносит урон игроку.
// Урон сначала поглощается защитой (стеклянный щит, щит),
// затем применяется по здоровью с учётом модификаторов и плавной анимацией.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  УронВход - Число - количество наносимого урона.
//
Процедура НанестиУронИгроку(Форма, УронВход) Экспорт
	ОстаточныйУрон = Форма.ПоглотитьУронЗащитойИгрока(УронВход);
	Если ОстаточныйУрон > 0 Тогда
		Форма.ПрименитьУронПоЗдоровьюИгрока(ОстаточныйУрон);
	КонецЕсли;
	Форма.ОтобразитьСостояниеИгрока();
	// Проверяем поражение игрока после нанесения урона (для обработки модификатора "Туман")
	Форма.ПроверитьПоражениеИгрока();
КонецПроцедуры		// НанестиУронИгроку()

// Наносит урон игроку от взрыва бомбы (без учета модификаторов).
// Урон выбирается случайным образом между МинимальнаяСила и МаксимальнаяСила
// для того действия противника, в результате которого на игрока наложен параметр Бомба.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура НанестиУронИгрокуОтБомбы(Форма, Гсч) Экспорт
	// Получаем идентификатор действия противника из строки параметра "Бомба"
	ВидПараметраБомба = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Бомба");
	ИдентификаторДействия = "";
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ВидПараметра", ВидПараметраБомба);
	НайденныеСтроки = Форма.ПараметрыИгрока.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		ИдентификаторДействия = НайденныеСтроки[0].ИдентификаторДействияПротивника;
	КонецЕсли;
	// Получаем МинимальнаяСила и МаксимальнаяСила из таблицы ЦиклДействийПротивника
	МинСила		 = 5; // Значение по умолчанию
	МаксСила	 = 5;
	Если ЗначениеЗаполнено(ИдентификаторДействия) Тогда
		СтруктураПоискаДействия = Новый Структура;
		СтруктураПоискаДействия.Вставить("ИдентификаторСтроки", ИдентификаторДействия);
		НайденныеДействия = Форма.ЦиклДействийПротивника.НайтиСтроки(СтруктураПоискаДействия);
		Если НайденныеДействия.Количество() > 0 Тогда
			МинСила		 = НайденныеДействия[0].МинимальнаяСила;
			МаксСила	 = НайденныеДействия[0].МаксимальнаяСила;
		Иначе
			// Оставляем значения по умолчанию.
		КонецЕсли;
	КонецЕсли;
	// Генерируем случайный урон в диапазоне от МинСила до МаксСила.
	УронОтБомбы = Гсч.СлучайноеЧисло(МинСила, МаксСила);
	// Применяем урон по здоровью через метод НанестиУронИгроку()
	Форма.НанестиУронИгроку(УронОтБомбы);
КонецПроцедуры		// НанестиУронИгрокуОтБомбы()

// Наносит урон игроку от горения.
// Урон определяется случайным значением от минимальной до максимальной силы соответствующего действия из цикла противника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура НанестиУронИгрокуОтГорения(Форма, Гсч) Экспорт
	// Получаем идентификатор действия противника из строки параметра "Горение"
	ВидПараметраГорение = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Горение");
	ИдентификаторДействия = "";
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ВидПараметра", ВидПараметраГорение);
	НайденныеСтроки = Форма.ПараметрыИгрока.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		ИдентификаторДействия = НайденныеСтроки[0].ИдентификаторДействияПротивника;
	КонецЕсли;
	// Получаем МинимальнаяСила и МаксимальнаяСила из таблицы ЦиклДействийПротивника
	МинСила		 = 5; // Значение по умолчанию
	МаксСила	 = 5;
	Если ЗначениеЗаполнено(ИдентификаторДействия) Тогда
		СтруктураПоискаДействия = Новый Структура;
		СтруктураПоискаДействия.Вставить("ИдентификаторСтроки", ИдентификаторДействия);
		НайденныеДействия = Форма.ЦиклДействийПротивника.НайтиСтроки(СтруктураПоискаДействия);
		Если НайденныеДействия.Количество() > 0 Тогда
			МинСила		 = НайденныеДействия[0].МинимальнаяСила;
			МаксСила	 = НайденныеДействия[0].МаксимальнаяСила;
		Иначе
			// Оставляем значения по умолчанию.
		КонецЕсли;
	КонецЕсли;
	// Генерируем случайный урон в диапазоне от МинСила до МаксСила.
	УронОтЯда = Гсч.СлучайноеЧисло(МинСила, МаксСила);
	// Применяем урон по здоровью через метод НанестиУронИгроку()
	Форма.НанестиУронИгроку(УронОтЯда);
КонецПроцедуры		// НанестиУронИгрокуОтГорения()

// Проверяет параметр "Бомба" и наносит урон, если значение <= 0.
// 
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  ЗначениеБомбы - Число - текущее значение параметра "Бомба".
//
Процедура ПроверитьБомбу(Форма, ЗначениеБомбы) Экспорт
	Если ЗначениеБомбы <= 0 Тогда
		Форма.НанестиУронИгрокуОтБомбы();
	Иначе
		// Бомба продолжает тикать. Ничего не происходит.
	КонецЕсли;
КонецПроцедуры		// ПроверитьБомбу()

// Выполняет атаку противника "Удар на удачу".
// Имеет 50% шанс промаха. При попадании наносит урон как обычная атака.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура УдарНаУдачу(Форма, Гсч, УронВход = 0) Экспорт
	// Генерируем случайное число от 0 до 99
	Шанс = Гсч.СлучайноеЧисло(0, 99);
	Если Шанс < 50 Тогда
		// Попадание (50% шанс)
		Форма.НанестиУронПротивником(УронВход);
	Иначе
		// Промах (50% шанс)
		// Урон не наносится
	КонецЕсли;
КонецПроцедуры// УдарНаУдачу()

// Выполняет действия противника после неуспешного ответа.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Функция ДействияПротивника(Форма) Экспорт
	// Инициализация.
	РезультатФункции = Новый Структура;
	ПустойВариантДействия = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.ПустаяСсылка");
	РезультатФункции.Вставить("ВариантДействия", ПустойВариантДействия);
	СобытиеДействиеПротивника = ПредопределенноеЗначение("Перечисление.СобытияБоя.ДействиеПротивника");
	СобытиеБазовыйУронПротивника = ПредопределенноеЗначение("Перечисление.СобытияБоя.БазовыйУронПротивника");
	// Получение текущего действия противника
	ТекущееДействие = Форма.ПолучитьТекущееДействиеПротивника();
	// Подсветка намерения при действии противника.
	Форма.ПодсветитьНамерениеПротивника();
	// Обработка выбранного действия
	Форма.ОбработатьВыбранноеДействиеПротивника(ТекущееДействие);
	// Запись в журнал боя.
	ВосхождениеКлиентСервер.ДобавитьЗаписьВЖурналБоя(Форма, СобытиеДействиеПротивника, ТекущееДействие);
	// Нанесение базового урона противника по этапу.
	БазовыйУрон = ВосхождениеКлиент.ПолучитьБазовыйУронПротивника(Форма);
	БазовыйУрон = Макс(БазовыйУрон - ВосхождениеКлиент.ПрименитьМодификатор_Фолиант(Форма), 0);
	Форма.НанестиУронИгроку(БазовыйУрон);
	// Запись в журнал боя.
	ВосхождениеКлиентСервер.ДобавитьЗаписьВЖурналБоя(Форма, СобытиеБазовыйУронПротивника, Форма.Противник, БазовыйУрон);
	// Перемещение к следующему действию по циклу
	Форма.ПереместитьДействиеПротивникаВпередПоЦиклу();
	// Вывод состояний.
	Форма.ОтобразитьСостояниеИгрока();
	Форма.ОтобразитьСостояниеПротивника();
	ВосхождениеКлиент.ПроверитьПобеды(Форма);
	РезультатФункции.Вставить("ВариантДействия", ТекущееДействие);
	Возврат РезультатФункции;
КонецФункции		// ДействияПротивника()

// Обрабатывает выбранное действие противника.
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  ВидДействияВход - ПеречислениеСсылка.ВариантыДействийПротивников - вид действия противника.
//
Процедура ОбработатьВыбранноеДействиеПротивника(Форма, ВидДействияВход) Экспорт
	// Инициализация.
	ВариантДействияАтака             = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.Атака");
	ВариантДействияНаложитьЩит       = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.НаложитьЩит");
	ВариантДействияНаложитьПроклятие = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.НаложитьПроклятие");
	ВариантДействияУдарНаУдачу       = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.УдарНаУдачу");
	ВариантДействияАктивироватьБомбу   = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.АктивироватьБомбу");
	ВариантДействияУвеличитьСилу       = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.УвеличитьСилу");
	ВариантДействияНаложитьНеуклюжесть = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.НаложитьНеуклюжесть");
	ВариантДействияЛечение             = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.Лечение");
	ВариантДействияСон                 = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.Сон");
	ВариантДействияВампиризм           = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.Вампиризм");
	ВариантДействияУкрастьЗолото       = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.УкрастьЗолото");
	ВариантДействияСбежатьИзБоя        = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.СбежатьИзБоя");
	ВариантДействияСломатьЩит	       = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.СломатьЩит");
	ВариантДействияПоджечь	      	     = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.Поджечь");
	ВариантДействияОтравить          	 = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.Отравить");
	ВариантДействияЗаблокироватьЛечение  = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.ЗаблокироватьЛечение");
	ВариантДействияНаложитьЛедянойЩит    = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.НаложитьЛедянойЩит");
	ВариантДействияОчищение              = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.Очищение");
	ВариантДействияОпровержение          = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.Опровержение");
	ВариантДействияАдаптивныйИнтеллект   = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.АдаптивныйИнтеллект");
	ВидПараметраГорение		 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Горение");
	ВидПараметраБомба		 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Бомба");
	ВидПараметраПроклятие	 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Проклятие");
	ВидПараметраЩит			 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Щит");
	ВидПараметраЯд			 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Яд");
	// Проверка ментального щита.
	ВидПараметраМентальныйЩит = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.МентальныйЩит");
	ЗначениеМентальногоЩита = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраМентальныйЩит);
	Если ЗначениеМентальногоЩита > 0 Тогда
		НовоеЗначение = ЗначениеМентальногоЩита - 1;
		Форма.УстановитьПараметрИгрока(ВидПараметраМентальныйЩит, НовоеЗначение);
		Возврат;
	Иначе
		// Ментальный щит отсутствует. Действие противника выполняется.
	КонецЕсли;
	// Проверка вида действия: если атака - выполнять атаку
	Если ЗначениеЗаполнено(ВидДействияВход) Тогда
		Если ВидДействияВход = ВариантДействияАтака Тогда
			Форма.АтакаПротивника();
		ИначеЕсли ВидДействияВход = ВариантДействияНаложитьЩит Тогда
			// Противник накладывает на себя щит
			ЗначениеЩита = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраЩит);
			НовоеЗначениеЩита = ЗначениеЩита + Форма.ПолучитьЗначениеЩитаПротивника();
			Форма.УстановитьПараметрПротивника(ВидПараметраЩит, НовоеЗначениеЩита);
		ИначеЕсли ВидДействияВход = ВариантДействияНаложитьПроклятие Тогда
			// Противник накладывает проклятие на игрока на 2 хода
			Форма.УвеличитьПараметрИгрока(ВидПараметраПроклятие, 2, Форма.ИдентификаторТекущегоДействияПротивника);
		ИначеЕсли ВидДействияВход = ВариантДействияУдарНаУдачу Тогда
			// Противник наносит удар на удачу с 50% шансом промаха
			Форма.УдарНаУдачу();
		ИначеЕсли ВидДействияВход = ВариантДействияАктивироватьБомбу Тогда
			// Противник активирует бомбу на игроке (устанавливает значение 3)
			Форма.УвеличитьПараметрИгрока(ВидПараметраБомба, 3, Форма.ИдентификаторТекущегоДействияПротивника);
		ИначеЕсли ВидДействияВход = ВариантДействияУвеличитьСилу Тогда
			Форма.ОбработатьУвеличениеСилыПротивника();
		ИначеЕсли ВидДействияВход = ВариантДействияНаложитьНеуклюжесть Тогда
			Форма.ОбработатьУвеличениеНеуклюжестиПротивником();
		ИначеЕсли ВидДействияВход = ВариантДействияЛечение Тогда
			// Противник излечивает себя
			Форма.ЛечениеПротивника();
		ИначеЕсли ВидДействияВход = ВариантДействияВампиризм Тогда
			// Противник наносит урон игроку и излечивает себе 25% от нанесённого урона
			Форма.Вампиризм();
		ИначеЕсли ВидДействияВход = ВариантДействияСон Тогда
			// Противник просто пропускает текущий ход (спит)
			Форма.ОбработатьСон();
		ИначеЕсли ВидДействияВход = ВариантДействияУкрастьЗолото Тогда
			// Противник крадет золото у игрока
			Форма.УкрастьЗолото();
		ИначеЕсли ВидДействияВход = ВариантДействияСбежатьИзБоя Тогда
			// Противник сбегает из боя: бой завершается, игрок переходит на следующий этап без наград
			ВосхождениеКлиент.ОбработатьПобегПротивника(Форма);
		ИначеЕсли ВидДействияВход = ВариантДействияСломатьЩит Тогда
			// Противник ломает щит игрока
			Форма.СломатьЩит();
		ИначеЕсли ВидДействияВход = ВариантДействияПоджечь Тогда
			// Противник поджигает игрока: увеличивает параметр Горение на случайное значение от МинимальнаяСила до МаксимальнаяСила
			Форма.ОбработатьПоджечь();
		ИначеЕсли ВидДействияВход = ВариантДействияОтравить Тогда
			// Противник отравляет игрока: увеличивает параметр Яд на 3 единицы
			Форма.УвеличитьПараметрИгрока(ВидПараметраЯд, 3, Форма.ИдентификаторТекущегоДействияПротивника);
		ИначеЕсли ВидДействияВход = ВариантДействияЗаблокироватьЛечение Тогда
			// Противник блокирует лечение игроку
			Форма.ОбработатьБлокировкаЛечения();
		ИначеЕсли ВидДействияВход = ВариантДействияНаложитьЛедянойЩит Тогда
			// Противник накладывает ледяной щит на себя.
			Форма.ОбработатьНаложитьЛедянойЩит();
		ИначеЕсли ВидДействияВход = ВариантДействияОчищение Тогда
			// Противник снимает с себя случайный отрицательный эффект
			Форма.ОбработатьОчищениеПротивника();
		ИначеЕсли ВидДействияВход = ВариантДействияОпровержение Тогда
			// Противник снимает с игрока 1 случайный положительный параметр
			Форма.ОбработатьОпровержение();
		ИначеЕсли ВидДействияВход = ВариантДействияАдаптивныйИнтеллект Тогда
			Форма.ОбработатьАдаптивныйИнтеллект();
		КонецЕсли;				
	Иначе
		// Действие не найдено, выполняем атаку по умолчанию
		Форма.АтакаПротивника();
	КонецЕсли;
КонецПроцедуры		// ОбработатьВыбранноеДействиеПротивника()

// Обрабатывает действие противника "АдаптивныйИнтеллект".
// Выбирает действие в зависимости от текущей боевой ситуации:
// - Здоровье противника < 20%%: лечение 5-10
// - Щит игрока > 20: сломать щит
// - У игрока 2+ положительных эффекта: опровержение
// - Здоровье игрока < 30%%: удар на удачу 10-20
// - Нет отрицательных эффектов на игроке: поджечь
// - Сила противника < 5: увеличить силу
// - Иначе: атака 7-15
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура ОбработатьАдаптивныйИнтеллект(Форма, Гсч) Экспорт
	// Инициализация.
	ВидПараметраТекущееЗдоровье			 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
	ВидПараметраМаксимальноеЗдоровье	 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.МаксимальноеЗдоровье");
	ВидПараметраЩит						 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Щит");
	ВидПараметраСила					 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Сила");
	ВидПараметраГорение					 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Горение");
	// Получение текущих значений.
	Форма.ТекущееЗдоровьеПротивника		 = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраТекущееЗдоровье);
	Форма.МаксимальноеЗдоровьеПротивника	 = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраМаксимальноеЗдоровье);
	ВосхождениеКлиентСервер.УстановитьТекущееЗдоровьеИгрока(Форма, ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраТекущееЗдоровье));
	Форма.МаксимальноеЗдоровьеИгрока	 = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраМаксимальноеЗдоровье);
	ТекущийЩитИгрока = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЩит);
	ТекущаяСилаПротивника = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраСила);
	// Подсчёт положительных параметров игрока.
	ПоложительныеПараметры = Форма.ПолучитьПоложительныеПараметры();
	КоличествоПоложительных = 0;
	Для Каждого СтрокаПараметра Из Форма.ПараметрыИгрока Цикл
		Если ПоложительныеПараметры.Найти(СтрокаПараметра.ВидПараметра) <> Неопределено Тогда
			КоличествоПоложительных = КоличествоПоложительных + 1;
		КонецЕсли;
	КонецЦикла;
	// Подсчёт отрицательных параметров игрока.
	ОтрицательныеПараметры = Форма.ПолучитьОтрицательныеПараметры();
	ЕстьОтрицательные = Ложь;
	Для Каждого СтрокаПараметра Из Форма.ПараметрыИгрока Цикл
		Если ОтрицательныеПараметры.Найти(СтрокаПараметра.ВидПараметра) <> Неопределено Тогда
			ЕстьОтрицательные = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	// Подсчет параметров игрока и противника.
	ПроцентЗдоровьяПротивника = 100;
	Если Форма.МаксимальноеЗдоровьеПротивника > 0 Тогда
		ПроцентЗдоровьяПротивника = (Форма.ТекущееЗдоровьеПротивника / Форма.МаксимальноеЗдоровьеПротивника) * 100;
	КонецЕсли;
	ПроцентЗдоровьяИгрока = 100;
	Если Форма.МаксимальноеЗдоровьеИгрока > 0 Тогда
		ПроцентЗдоровьяИгрока = (Форма.ТекущееЗдоровьеИгрока / Форма.МаксимальноеЗдоровьеИгрока) * 100;
	КонецЕсли;
	// Выбор действия по приоритету.
	Если ПроцентЗдоровьяПротивника < 20 Тогда
		// Лечение.
		РазмерЛечения = Гсч.СлучайноеЧисло(5, 10);
		РазмерЛечения = Цел(РазмерЛечения * ВосхождениеКлиентСервер.ПолучитьКоэффициентСложностиПротивника(Форма.НомерЭтапа));
		Форма.ЛечениеПротивника(РазмерЛечения);
	ИначеЕсли ТекущийЩитИгрока > 20 Тогда
		// Сломать щит.
		Форма.СломатьЩит();
	ИначеЕсли КоличествоПоложительных >= 2 Тогда
		// Опровержение.
		Форма.ОбработатьОпровержение();
	ИначеЕсли ПроцентЗдоровьяИгрока < 30 Тогда
		// Удар на удачу.
		РазмерУрона = Гсч.СлучайноеЧисло(10, 20);
		РазмерУрона = Цел(РазмерУрона * ВосхождениеКлиентСервер.ПолучитьКоэффициентСложностиПротивника(Форма.НомерЭтапа));
		Форма.УдарНаУдачу(РазмерУрона);
	ИначеЕсли НЕ ЕстьОтрицательные Тогда
		// Наложить горение.
		СилаГорения = Гсч.СлучайноеЧисло(3, 5);
		СилаГорения = Цел(СилаГорения * ВосхождениеКлиентСервер.ПолучитьКоэффициентСложностиПротивника(Форма.НомерЭтапа));
		Форма.УвеличитьПараметрИгрока(ВидПараметраГорение, СилаГорения, Форма.ИдентификаторТекущегоДействияПротивника);
	ИначеЕсли ТекущаяСилаПротивника < 5 Тогда
		// Увеличить силу.
		Форма.ОбработатьУвеличениеСилыПротивника(1);
	Иначе
		// Атака.
		РазмерУрона = Гсч.СлучайноеЧисло(7, 15);
		РазмерУрона = Цел(РазмерУрона * ВосхождениеКлиентСервер.ПолучитьКоэффициентСложностиПротивника(Форма.НомерЭтапа));
		Форма.НанестиУронИгроку(РазмерУрона);
	КонецЕсли;
КонецПроцедуры		// ОбработатьАдаптивныйИнтеллект()

// Проверяет возможное поражение игрока. В случае поражения игра заканчивается.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ПроверитьПоражениеИгрока(Форма) Экспорт
	ВидПараметра = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
	ТекущееЗдоровье = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметра);
	Если ТекущееЗдоровье <= 0 Тогда
		// Проверяем наличие модификатора "Туман"
		Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, ПредопределенноеЗначение("Справочник.Модификаторы.Туман")) Тогда
			// Воскрешаем игрока с 50% от максимального здоровья
			МаксимальноеЗдоровье = ВосхождениеКлиентСервер.ПолучитьМаксимальноеЗдоровьеИгрока(Форма);
			НовоеЗдоровье = Цел(МаксимальноеЗдоровье * 0.5);
			Форма.ВоскрешениеИгрока(НовоеЗдоровье);
			// Удаляем модификатор "Туман" из таблицы модификаторов
			Форма.УдалитьМодификатор(ПредопределенноеЗначение("Справочник.Модификаторы.Туман"));
			Сообщить("Туман спас вас! Вы воскресли с 50% здоровья.");
		Иначе
			// Модификатор "Туман" не активен - игра заканчивается.
			Форма.ОчиститьСохранениеПользователя_Сервер(Форма.ТекПользователь);
			Форма.ПоражениеВосхождение = Истина;
			Форма.Доступность = Ложь;
			ВосхождениеКлиент.ПоказатьПоражениеВосхождение(Форма);
		КонецЕсли;
	Иначе
		// Игрок не побежден.
	КонецЕсли;
КонецПроцедуры		// ПроверитьПоражениеИгрока()

#КонецОбласти

#Область Карты

// Выполняет действие карты МаякНаГоризонте.
// Блокирует один случайный неправильный ответ в текущем задании.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//	КартаВход - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_МаякНаГоризонте(Форма, КартаВход, ИдентификаторКартыВход) Экспорт
	// Инициализация.
	МассивНеверных = Новый Массив;
	ЗначениеНайдено = Ложь;
	РежимВосхождение = ПредопределенноеЗначение("Перечисление.РежимыВикторины.Восхождение");
	СложностьЧетыреОтвета = ПредопределенноеЗначение("Перечисление.СложностиСборников.ЧетыреОтвета");
	СложностьШестьОтветов = ПредопределенноеЗначение("Перечисление.СложностиСборников.ШестьОтветов");
	// Определение количества ответов.
	Если ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины) Тогда
		КоличествоОтветов = 4;
		Форма.Сложность = СложностьЧетыреОтвета;
	Иначе	
		Если Форма.Сборник.Сложность = СложностьШестьОтветов Тогда
			КоличествоОтветов = 6;
			Форма.Сложность = СложностьШестьОтветов;
		Иначе
			КоличествоОтветов = 4;
			Форма.Сложность = СложностьЧетыреОтвета;
		КонецЕсли;
	КонецЕсли;
	// Поиск случайного неправильного ответа.
	Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	Пока НЕ ЗначениеНайдено Цикл
		НомерОтвета = Гсч.СлучайноеЧисло(1, КоличествоОтветов);
		Если НомерОтвета <> Форма.НомерПравильногоОтвета Тогда
			ПреобразованныйНомер = ОбщегоНазначенияКлиентСервер.ПреобразоватьНомерПравильногоОтвета(НомерОтвета, Форма.Сложность);
			МассивНеверных.Добавить(ПреобразованныйНомер);
			ЗначениеНайдено = Истина;
		Иначе
			// Выполняем поиск далее.
		КонецЕсли;
	КонецЦикла;
	// Применение блокировки.
	ВосхождениеКлиентСервер.УбратьНеверныеОтветы(МассивНеверных, Форма);
	Форма.НеверныеВариантыУбраны = Истина;
	ВосхождениеКлиентСервер.УправлениеВидимостью(Форма);
КонецПроцедуры		// ДействиеКарты_МаякНаГоризонте()

// Возвращает карту по её идентификатору из стопок добора, руки игрока и сброса.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  ИдентификаторКартыВход - Строка - Идентификатор карты для поиска.
//
// Возвращаемое значение:
//  СправочникСсылка.Карты - найденная карта или пустая ссылка.
//
Функция ПолучитьКартуПоИдентификатору(Форма, ИдентификаторКартыВход) Экспорт
	РезультатФункции = ПредопределенноеЗначение("Справочник.Карты.ПустаяСсылка");
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИдентификаторКарты", ИдентификаторКартыВход);
	НайденныеСтроки = Форма.РукаИгрока.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() = 0 Тогда
		НайденныеСтроки = Форма.СтопкаДобора.НайтиСтроки(СтруктураПоиска);
	КонецЕсли;
	Если НайденныеСтроки.Количество() = 0 Тогда
		НайденныеСтроки = Форма.СтопкаСброса.НайтиСтроки(СтруктураПоиска);
	КонецЕсли;
	Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
		РезультатФункции = ТекНайденныеСтроки.Карта;
	КонецЦикла;
	Возврат РезультатФункции;
КонецФункции		// ПолучитьКартуПоИдентификатору()

// Возвращает идентификатор случайной карты из руки игрока.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  ИсключаемыйИдентификаторВход - Строка - Идентификатор карты, которую требуется исключить из выбора.
//
// Возвращаемое значение:
//  Строка - Идентификатор случайной карты, или пустая строка если подходящих карт нет.
//
Функция ПолучитьСлучайнуюКартуВРуке(Форма, ИсключаемыйИдентификаторВход = "") Экспорт
	РезультатФункции = "";
	Если Форма.РукаИгрока.Количество() > 0 Тогда
		Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
		Индекс = Гсч.СлучайноеЧисло(0, Форма.РукаИгрока.Количество() - 1);
		ВыбраннаяКартаСтрока = Форма.РукаИгрока[Индекс];
		Если ЗначениеЗаполнено(ИсключаемыйИдентификаторВход) И Форма.РукаИгрока.Количество() > 1 Тогда
			Пока ВыбраннаяКартаСтрока.ИдентификаторКарты = ИсключаемыйИдентификаторВход Цикл
				Индекс = Гсч.СлучайноеЧисло(0, Форма.РукаИгрока.Количество() - 1);
				ВыбраннаяКартаСтрока = Форма.РукаИгрока[Индекс];
			КонецЦикла;
		КонецЕсли;
		РезультатФункции = ВыбраннаяКартаСтрока.ИдентификаторКарты;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПолучитьСлучайнуюКартуВРуке()

// Возвращает строку таблицы РукаИгрока с самой дорогой картой.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  ИсключаемыйИдентификаторВход - Строка - Идентификатор карты, которую требуется исключить из поиска.
//
// Возвращаемое значение:
//  СтрокаТаблицыФормы - строка таблицы РукаИгрока с самой дорогой картой, или Неопределено.
//
Функция НайтиСамуюДорогуюКартуВРуке(Форма, ИсключаемыйИдентификаторВход = "") Экспорт
	// Инициализация.
	РезультатФункции = Неопределено;
	МаксимальнаяСтоимость = -1;
	// Поиск карты с максимальной стоимостью.
	Для Каждого ТекСтрока Из Форма.РукаИгрока Цикл
		Если ТекСтрока.ИдентификаторКарты <> ИсключаемыйИдентификаторВход Тогда
			Если ТекСтрока.Карта.Стоимость > МаксимальнаяСтоимость Тогда
				МаксимальнаяСтоимость = ТекСтрока.Карта.Стоимость;
				РезультатФункции = ТекСтрока;
			Иначе
				// Карта не дороже текущей максимальной.
			КонецЕсли;
		Иначе
			// Исключаемая карта пропускается.
		КонецЕсли;
	КонецЦикла;
	Возврат РезультатФункции;
КонецФункции		// НайтиСамуюДорогуюКартуВРуке()

// Меняет цвет заголовка противника в зависимости от сложности.
//
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
Процедура ИзменитьЦветПротивника(Форма) Экспорт
	Если Форма.СложностьПротивника = ПредопределенноеЗначение("Перечисление.СложностиПротивников.Начальная") Тогда
		Форма.Элементы.HUD_ИмяПротивника.ЦветТекстаЗаголовка = WebЦвета.ЗеленыйЛес;
	ИначеЕсли Форма.СложностьПротивника = ПредопределенноеЗначение("Перечисление.СложностиПротивников.Обычная") Тогда
		Форма.Элементы.HUD_ИмяПротивника.ЦветТекстаЗаголовка = WebЦвета.Синий;
	ИначеЕсли Форма.СложностьПротивника = ПредопределенноеЗначение("Перечисление.СложностиПротивников.Элитная") Тогда
		Форма.Элементы.HUD_ИмяПротивника.ЦветТекстаЗаголовка = WebЦвета.Красный;
	ИначеЕсли Форма.СложностьПротивника = ПредопределенноеЗначение("Перечисление.СложностиПротивников.Босс") Тогда
		Форма.Элементы.HUD_ИмяПротивника.ЦветТекстаЗаголовка = WebЦвета.Фиолетовый;
	Иначе
		Форма.Элементы.HUD_ИмяПротивника.ЦветТекстаЗаголовка = WebЦвета.Синий;
	КонецЕсли;
КонецПроцедуры		// ИзменитьЦветПротивника()

// Выполняет действие карты Обман.
// Выводит текст правильного ответа текущего задания в консоль сообщений.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//	НайденнаяКарта - СправочникСсылка.Карты - Карта, которую разыгрываем.
//	ИдентификаторКартыВход - Строка - Идентификатор карты, которую разыгрываем.
//
Процедура ДействиеКарты_Обман(Форма, НайденнаяКарта, ИдентификаторКартыВход) Экспорт
	// Инициализация.
	ТекстОтвета = "";
	// Поиск текста правильного ответа.
	Для Каждого ТекНомераОтветов Из Форма.НомераОтветов Цикл
		Если ТекНомераОтветов.НомерОтвета = Форма.НомерПравильногоОтвета Тогда
			ТекстОтвета = ТекНомераОтветов.ТекстОтвета;
			Прервать;
		Иначе
			// Продолжаем поиск.
		КонецЕсли;
	КонецЦикла;
	// Вывод правильного ответа.
	Если ЗначениеЗаполнено(ТекстОтвета) Тогда
		Сообщить(НСтр("ru = 'Правильный ответ: '") + ТекстОтвета);
	Иначе
		Сообщить(НСтр("ru = 'Правильный ответ №'") + Строка(Форма.НомерПравильногоОтвета));
	КонецЕсли;
КонецПроцедуры		// ДействиеКарты_Обман()

