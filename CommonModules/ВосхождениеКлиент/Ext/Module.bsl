	Форма.ПолучитьЗолото(15);
	ОтрицательныеПараметры = Форма.ПолучитьОтрицательныеПараметры();
	Индекс = Гсч.СлучайноеЧисло(0, ОтрицательныеПараметры.Количество() - 1);
	Форма.УвеличитьПараметрИгрока(ОтрицательныеПараметры[Индекс], 1);
КонецПроцедуры		// ДействиеКарты_Долг()

