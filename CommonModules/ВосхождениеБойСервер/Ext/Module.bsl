#Область ПараметрыИгрока

// Устанавливает значение параметра игрока в таблице ПараметрыИгрока по виду параметра.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  ВидПараметраВход - ПеречислениеСсылка.ВидыПараметровИгроков - вид параметра для поиска.
//  ЗначениеПараметраВход - Число - значение параметра для установки.
//  ИдентификаторДействияПротивникаВход - Строка - идентификатор текущего действия противника (необязательный).
//
Процедура УстановитьПараметрИгрока(Форма, ВидПараметраВход, ЗначениеПараметраВход, ИдентификаторДействияПротивникаВход = "") Экспорт
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ВидПараметра", ВидПараметраВход);
	НайденныеСтроки = Форма.ПараметрыИгрока.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		НайденныеСтроки[0].ЗначениеПараметра = ЗначениеПараметраВход;
		Если ЗначениеЗаполнено(ИдентификаторДействияПротивникаВход) Тогда
			НайденныеСтроки[0].ИдентификаторДействияПротивника = ИдентификаторДействияПротивникаВход;
		Иначе
			// Идентификатор действия не передан. Прежний сохраняется.
		КонецЕсли;
	Иначе
		НоваяСтрока = Форма.ПараметрыИгрока.Добавить();
		НоваяСтрока.ВидПараметра = ВидПараметраВход;
		НоваяСтрока.ЗначениеПараметра = ЗначениеПараметраВход;
		Если ЗначениеЗаполнено(ИдентификаторДействияПротивникаВход) Тогда
			НоваяСтрока.ИдентификаторДействияПротивника = ИдентификаторДействияПротивникаВход;
		Иначе
			// Идентификатор действия не передан. Поле остаётся пустым.
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры		// УстановитьПараметрИгрока()

// Увеличивает значение параметра игрока на указанное приращение.
// Используется для увеличения параметров (например, Проклятие, Бомба, Неуклюжесть).
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  ВидПараметраВход - ПеречислениеСсылка.ВидыПараметровИгроков - вид параметра для увеличения.
//  ПриращениеВход - Число - значение, на которое увеличивается параметр.
//  ИдентификаторДействияПротивникаВход - Строка - идентификатор текущего действия противника (необязательный).
//
Процедура УвеличитьПараметрИгрока(Форма, ВидПараметраВход, ПриращениеВход, ИдентификаторДействияПротивникаВход = "") Экспорт
	ТекущееЗначение = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраВход);
	НовоеЗначение = ТекущееЗначение + ПриращениеВход;
	УстановитьПараметрИгрока(Форма, ВидПараметраВход, НовоеЗначение, ИдентификаторДействияПротивникаВход);
КонецПроцедуры		// УвеличитьПараметрИгрока()

// Удаляет параметр игрока по виду параметра.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  ВидПараметраВход - ПеречислениеСсылка.ВидыПараметровИгроков - вид удаляемого параметра.
//
Процедура УдалитьПараметрИгрока(Форма, ВидПараметраВход) Экспорт
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ВидПараметра", ВидПараметраВход);
	НайденныеСтроки = Форма.ПараметрыИгрока.НайтиСтроки(СтруктураПоиска);
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Форма.ПараметрыИгрока.Удалить(НайденнаяСтрока);
	КонецЦикла;
КонецПроцедуры		// УдалитьПараметрИгрока()

// Инициализирует энергию игрока.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
// 
Процедура ИнициализироватьЭнергиюИгрока(Форма) Экспорт
	ВидПараметраЭнергия = Перечисления.ВидыПараметровИгроков.Энергия;
	НачальнаяЭнергия = 2;
	УстановитьПараметрИгрока(Форма, ВидПараметраЭнергия, НачальнаяЭнергия);
КонецПроцедуры		// ИнициализироватьЭнергиюИгрока()

// Очищает все параметры игрока кроме текущего и макисмльаного здоровья.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ОчиститьПараметрыИгрокаКромеБазовых(Форма) Экспорт
	ВидПараметрТекущееЗдоровье		 = Перечисления.ВидыПараметровИгроков.ТекущееЗдоровье;
	ВидПараметрМаксимальноеЗдоровье	 = Перечисления.ВидыПараметровИгроков.МаксимальноеЗдоровье;
	ВидПараметрЗолото				 = Перечисления.ВидыПараметровИгроков.Золото;
	Для Каждого ТекПараметрыИгрока Из Форма.ПараметрыИгрока Цикл
		ТекВидПараметра = ТекПараметрыИгрока.ВидПараметра;
		ЭтоПропускаемыйПараметр = (ТекВидПараметра = ВидПараметрТекущееЗдоровье ИЛИ 
			ТекВидПараметра = ВидПараметрМаксимальноеЗдоровье ИЛИ ТекВидПараметра = ВидПараметрЗолото);
		Если ЭтоПропускаемыйПараметр Тогда
			Продолжить;
		Иначе
			// Параметр не базовый. Удаляем ниже.
		КонецЕсли;
		// Удаляем параметр
		УдалитьПараметрИгрока(Форма, ТекВидПараметра);
	КонецЦикла;
КонецПроцедуры		// ОчиститьПараметрыИгрокаКромеБазовых()

#КонецОбласти

#Область ЗдоровьеИЩитыИгрока

// Увеличивает параметр Щит игрока на величину УвеличениеЩитаВход единиц.
// Учитывает модификатор "Латный наплечник", который увеличивает получаемый щит на 1.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  УвеличениеЩитаВход - Число - величина увеличения щита.
//
Процедура УвеличитьЩитИгрока(Форма, УвеличениеЩитаВход) Экспорт
	// Применяем модификатор "Латный наплечник": увеличение щита на 1
	НовоеУвеличениеЩита = УвеличениеЩитаВход;
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, Справочники.Модификаторы.ЛатныйНаплечник) Тогда
		НовоеУвеличениеЩита = НовоеУвеличениеЩита + 1;
	Иначе
		// Оставляем величину изменения щита прежним.
	КонецЕсли;
	ВидПараметраЩит = Перечисления.ВидыПараметровИгроков.Щит;
	УвеличитьПараметрИгрока(Форма, ВидПараметраЩит, НовоеУвеличениеЩита);
	// Подсветка щита при восстановлении.
	Если НовоеУвеличениеЩита > 0 Тогда
		Форма.Элементы.HUD_ТекстЩита.ЦветФона = WebЦвета.СветлоЗеленый;
	Иначе
		// Щит не изменился.
	КонецЕсли;
КонецПроцедуры		// УвличитьЩитИгрока()

// Восстанавливает здоровье игрока на указанное значение, но не более максимального здоровья.
// Учитывает модификатор "Кровь гидры", который увеличивает восстановление на 30%.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  КоличествоВосстановления - Число - количество очков здоровья для восстановления.
//
Процедура ВосстановитьЗдоровьеИгрока(Форма, КоличествоВосстановления) Экспорт
	// Проверяем параметр БлокировкаЛечения
	ВидПараметраБлокировкаЛечения = Перечисления.ВидыПараметровИгроков.БлокировкаЛечения;
	ЗначениеБлокировкиЛечения = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраБлокировкаЛечения);
	// Если блокировка лечения активна, восстановление не происходит
	Если ЗначениеБлокировкиЛечения > 0 Тогда
		Возврат;
	Иначе
		// Блокировка лечения не активна. Продолжаем восстановление.
	КонецЕсли;
	// Копируем входное значение в новую переменную для модификации
	ФактическоеВосстановление = КоличествоВосстановления;
	// Применяем модификатор "Кровь гидры": увеличение восстановления на 30%
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, Справочники.Модификаторы.КровьГидры) Тогда
		ФактическоеВосстановление = ФактическоеВосстановление * 1.3;
		// Округляем до целых
		ФактическоеВосстановление = Цел(ФактическоеВосстановление);
	Иначе
		ФактическоеВосстановление = Цел(ФактическоеВосстановление);
	КонецЕсли;
	ВидПараметраТекущееЗдоровье = Перечисления.ВидыПараметровИгроков.ТекущееЗдоровье;
	ВидПараметраМаксимальноеЗдоровье = Перечисления.ВидыПараметровИгроков.МаксимальноеЗдоровье;
	ТекущееЗдоровье = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраТекущееЗдоровье);
	МаксимальноеЗдоровье = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраМаксимальноеЗдоровье);
	НовоеЗдоровье = Мин(ТекущееЗдоровье + ФактическоеВосстановление, МаксимальноеЗдоровье);
	// Применяем модификатор "КровянойКлапан": избыточное лечение обращается в щит.
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, Справочники.Модификаторы.КровянойКлапан) Тогда
		ИзбыточноеЛечение = (ТекущееЗдоровье + ФактическоеВосстановление) - МаксимальноеЗдоровье;
		Если ИзбыточноеЛечение > 0 Тогда
			УвеличитьЩитИгрока(Форма, ИзбыточноеЛечение);
		Иначе
			// Нет избыточного лечения.
		КонецЕсли;
	Иначе
		// Модификатор не активен.
	КонецЕсли;
	УстановитьПараметрИгрока(Форма, ВидПараметраТекущееЗдоровье, НовоеЗдоровье);
	ВосхождениеКлиентСервер.УстановитьТекущееЗдоровьеИгрока(Форма, НовоеЗдоровье);
	// Подсветка здоровья при восстановлении.
	Если НовоеЗдоровье > ТекущееЗдоровье Тогда
		Форма.Элементы.HUD_ТекстЗдоровьяИгрока.ЦветФона = WebЦвета.СветлоЗеленый;
	Иначе
		// Здоровье не изменилось.
	КонецЕсли;
КонецПроцедуры		// ВосстановитьЗдоровьеИгрока()

// Воскрешает игрока: очищает все параметры кроме базовых и устанавливает новое значение здоровья.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  КоличествоЗдоровья - Число - количество здоровья, которое остаётся у игрока после воскрешения.
//
Процедура ВоскрешениеИгрока(Форма, КоличествоЗдоровья) Экспорт
	// Очищаем все параметры игрока, кроме здоровья
	ОчиститьПараметрыИгрокаКромеБазовых(Форма);
	// Устанавливаем новое значение здоровья
	ВидПараметра = Перечисления.ВидыПараметровИгроков.ТекущееЗдоровье;
	УстановитьПараметрИгрока(Форма, ВидПараметра, КоличествоЗдоровья);
	ВосхождениеКлиентСервер.УстановитьТекущееЗдоровьеИгрока(Форма, КоличествоЗдоровья);
КонецПроцедуры		// ВоскрешениеИгрока()

// Уменьшает щит игрока на процент от текущего значения щита.
// Процент определяется случайным значением между МинимальнаяСила и МаксимальнаяСила
// текущего действия противника в цикле. Уменьшение происходит в меньшую сторону.
// Вызывается при действии противника "СломатьЩит".
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура СломатьЩит(Форма, Гсч) Экспорт
	// Получаем текущее действие противника из таблицы ЦиклДействийПротивника
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИдентификаторСтроки", Форма.ИдентификаторТекущегоДействияПротивника);
	НайденныеСтроки = Форма.ЦиклДействийПротивника.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		МинСила = НайденныеСтроки[0].МинимальнаяСила;
		МаксСила = НайденныеСтроки[0].МаксимальнаяСила;
		// Генерируем случайный процент поглощения в диапазоне от МинимальнаяСила до МаксимальнаяСила
		ПроцентПоглощения = Гсч.СлучайноеЧисло(МинСила, МаксСила);
		ПроцентПоглощения = Цел(ПроцентПоглощения * ВосхождениеКлиентСервер.ПолучитьКоэффициентСложностиПротивника(Форма.НомерЭтапа));
		ВидПараметраЩит = Перечисления.ВидыПараметровИгроков.Щит;
		ТекущийЩит = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЩит);
		// Уменьшаем щит на процент (округление в меньшую сторону)
		Уменьшение = Цел(ТекущийЩит * ПроцентПоглощения / 100);
		НовыйЩит = ТекущийЩит - Уменьшение;
		УстановитьПараметрИгрока(Форма, ВидПараметраЩит, НовыйЩит);
	Иначе
		// Текущее действие противника не найдено. Щит не изменяется.
	КонецЕсли;
КонецПроцедуры		// СломатьЩит()

#КонецОбласти

#Область ПараметрыПротивника

// Устанавливает значение параметра противника в таблице ПараметрыПротивника по виду параметра.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  ВидПараметраВход - ПеречислениеСсылка.ВидыПараметровИгроков - вид параметра для поиска.
//  ЗначениеПараметраВход - Число - значение параметра для установки.
//
Процедура УстановитьПараметрПротивника(Форма, ВидПараметраВход, ЗначениеПараметраВход) Экспорт
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ВидПараметра", ВидПараметраВход);
	НайденныеСтроки = Форма.ПараметрыПротивника.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		НайденныеСтроки[0].ЗначениеПараметра = ЗначениеПараметраВход;
	Иначе
		НоваяСтрока = Форма.ПараметрыПротивника.Добавить();
		НоваяСтрока.ВидПараметра = ВидПараметраВход;
		НоваяСтрока.ЗначениеПараметра = ЗначениеПараметраВход;
	КонецЕсли;
КонецПроцедуры		// УстановитьПараметрПротивника()

// Увеличивает параметр противника на величину ПриращениеВход.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  ВидПараметраВход - ПеречислениеСсылка.ВидыПараметровИгроков - вид параметра для увеличения.
//  ПриращениеВход - Число - величина приращения.
//
Процедура УвеличитьПараметрПротивника(Форма, ВидПараметраВход, ПриращениеВход) Экспорт
	ТекущееЗначение = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраВход);
	НовоеЗначение = ТекущееЗначение + ПриращениеВход;
	УстановитьПараметрПротивника(Форма, ВидПараметраВход, НовоеЗначение);
КонецПроцедуры		// УвеличитьПараметрПротивника()

// Удаляет параметр противника по виду параметра.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  ВидПараметраВход - ПеречислениеСсылка.ВидыПараметровИгроков - вид удаляемого параметра.
//
Процедура УдалитьПараметрПротивника(Форма, ВидПараметраВход) Экспорт
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ВидПараметра", ВидПараметраВход);
	НайденныеСтроки = Форма.ПараметрыПротивника.НайтиСтроки(СтруктураПоиска);
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Форма.ПараметрыПротивника.Удалить(НайденнаяСтрока);
	КонецЦикла;
КонецПроцедуры		// УдалитьПараметрПротивника()

// Уменьшает значения уменьшаемых параметров противника на 1 за ход.
// Использует функцию перечисления ВидыПараметровИгроков.ПолучитьУменьшаемыеПараметрыИгроков().
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура УменьшитьПараметрыПротивников(Форма) Экспорт
	УменьшаемыеПараметры = Перечисления.ВидыПараметровИгроков.ПолучитьУменьшаемыеПараметрыИгроков();
	Для каждого ВидПараметра Из УменьшаемыеПараметры Цикл
		// Обработка параметра ЛедянойЩит: добавляет щит на величину ледяного щита
		ВидПараметраЛедянойЩит = Перечисления.ВидыПараметровИгроков.ЛедянойЩит;
		ЗначениеЛедяногоЩита = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраЛедянойЩит);
		Если ЗначениеЛедяногоЩита > 0 Тогда
			// Добавляем противнику параметр Щит на величину ЛедяногоЩита
			ВидПараметраЩит = Перечисления.ВидыПараметровИгроков.Щит;
			ТекущийЩит = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраЩит);
			НовыйЩит = ТекущийЩит + ЗначениеЛедяногоЩита;
			УстановитьПараметрПротивника(Форма, ВидПараметраЩит, НовыйЩит);
		Иначе
			// Ледяной щит отсутствует.
		КонецЕсли;
		// Уменьшить параметры.
		ЗначениеПараметра = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметра);
		Если ЗначениеПараметра > 0 Тогда
			// Проверка параметра "Яд": наносим урон до уменьшения значения
			Если ВидПараметра = Перечисления.ВидыПараметровИгроков.Яд Тогда
				УронОтЯда = ЗначениеПараметра;
				Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, ПредопределенноеЗначение("Справочник.Модификаторы.Токсикология")) Тогда
					УронОтЯда = УронОтЯда + 2;
				Иначе
					// Модификатор Токсикология не активен.
				КонецЕсли;
				НанестиУронПротивнику(Форма, УронОтЯда);
			Иначе
				// Параметр не Яд. Урон не наносится.
			КонецЕсли;
			НовоеЗначение = ЗначениеПараметра - 1;
			Если НовоеЗначение <= 0 Тогда
				УдалитьПараметрПротивника(Форма, ВидПараметра);
			Иначе
				УстановитьПараметрПротивника(Форма, ВидПараметра, НовоеЗначение);
			КонецЕсли;
		Иначе
			// Параметр уже нулевой. Уменьшение не требуется.
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры		// УменьшитьПараметрыПротивников()

// Возвращает признак наличия проклятия у противника.
// Проверяет таблицу ПараметрыПротивника на наличие параметра Проклятие со значением больше 0.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
// Возвращаемое значение:
//  Булево - Истина, если проклятие активно, Ложь в противном случае.
//
Функция ЕстьПроклятиеУПротивника(Форма) Экспорт
	ВидПараметраПроклятие = Перечисления.ВидыПараметровИгроков.Проклятие;
	ЗначениеПроклятия = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраПроклятие);
	РезультатФункции = ЗначениеПроклятия > 0;
	Возврат РезультатФункции;
КонецФункции		// ЕстьПроклятиеУПротивника()

// Возвращает значение щита, которое противник накладывает на себя.
// Использует значения МинимальнаяСила и МаксимальнаяСила из таблицы ЦиклДействийПротивника
// для текущего действия противника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
// Возвращаемое значение:
//  Число - случайное значение щита в диапазоне от МинимальнаяСила до МаксимальнаяСила.
//
Функция ПолучитьЗначениеЩитаПротивника(Форма, Гсч) Экспорт
	// Получаем текущее действие противника из таблицы ЦиклДействийПротивника
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИдентификаторСтроки", Форма.ИдентификаторТекущегоДействияПротивника);
	НайденныеСтроки = Форма.ЦиклДействийПротивника.НайтиСтроки(СтруктураПоиска);
	РезультатФункции = 15; // Значение по умолчанию
	Если НайденныеСтроки.Количество() > 0 Тогда
		МинСила = НайденныеСтроки[0].МинимальнаяСила;
		МаксСила = НайденныеСтроки[0].МаксимальнаяСила;
		// Генерируем случайное значение щита в диапазоне от МинимальнаяСила до МаксимальнаяСила
		РезультатФункции = Гсч.СлучайноеЧисло(МинСила, МаксСила);
		РезультатФункции = Цел(РезультатФункции * ВосхождениеКлиентСервер.ПолучитьКоэффициентСложностиПротивника(Форма.НомерЭтапа));
	Иначе
		РезультатФункции = 15;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПолучитьЗначениеЩитаПротивника()

// Восстанавливает здоровье противника.
// Противник излечивает недостающее здоровью на величину от минимальной до максимальной силы текущего действия,
// но не более своего максимального здоровья.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//  РазмерЛеченияВход - Число - размер лечения; если 0, определяется случайным значением текущего действия.
//
Процедура ЛечениеПротивника(Форма, Гсч, РазмерЛеченияВход = 0) Экспорт
	Если РазмерЛеченияВход = 0 Тогда
		// Получаем текущее действие противника из таблицы ЦиклДействийПротивника
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("ИдентификаторСтроки", Форма.ИдентификаторТекущегоДействияПротивника);
		НайденныеСтроки = Форма.ЦиклДействийПротивника.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда
			МинСила = НайденныеСтроки[0].МинимальнаяСила;
			МаксСила = НайденныеСтроки[0].МаксимальнаяСила;
			// Генерируем случайное значение лечения в диапазоне от МинимальнаяСила до МаксимальнаяСила
			РазмерЛечения = Гсч.СлучайноеЧисло(МинСила, МаксСила);
			РазмерЛечения = Цел(РазмерЛечения * ВосхождениеКлиентСервер.ПолучитьКоэффициентСложностиПротивника(Форма.НомерЭтапа));
		Иначе
			// Значение по умолчанию, если действие не найдено
			РазмерЛечения = 5;
		КонецЕсли;
	Иначе
		РазмерЛечения = РазмерЛеченияВход;
	КонецЕсли;
	// Получаем текущее и максимальное здоровье противника
	ВидПараметраТекущееЗдоровье = Перечисления.ВидыПараметровИгроков.ТекущееЗдоровье;
	ВидПараметраМаксимальноеЗдоровье = Перечисления.ВидыПараметровИгроков.МаксимальноеЗдоровье;
	ТекущееЗдоровье = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраТекущееЗдоровье);
	МаксимальноеЗдоровье = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраМаксимальноеЗдоровье);
	// Вычисляем недостающее здоровье
	НедостающееЗдоровье = МаксимальноеЗдоровье - ТекущееЗдоровье;
	// Лечение не может превышать недостающее здоровье и не может быть больше максимального здоровья
	ФактическоеЛечение = Мин(РазмерЛечения, НедостающееЗдоровье);
	// Восстанавливаем здоровье противника
	НовоеЗдоровье = ТекущееЗдоровье + ФактическоеЛечение;
	УстановитьПараметрПротивника(Форма, ВидПараметраТекущееЗдоровье, НовоеЗдоровье);
КонецПроцедуры		// ЛечениеПротивника()

#КонецОбласти

#Область УронПротивнику

// Наносит урон противнику, учитывая его щит.
// Щит поглощает урон первым, остаток урона наносится по здоровью.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  КоличествоУрона - Число - количество урона, которое наносится противнику.
//
// Возвращаемое значение:
//  Структура - структура с полями:
//    - УронПоЩиту - Число - количество урона, поглощённое щитом.
//    - УронПоЗдоровью - Число - количество урона, нанесённое по здоровью.
//
Функция НанестиУронПротивнику(Форма, КоличествоУрона) Экспорт
	// Инициализация
	ВидПараметраЗдоровье = Перечисления.ВидыПараметровИгроков.ТекущееЗдоровье;
	ВидПараметраЩит = Перечисления.ВидыПараметровИгроков.Щит;
	// Рассчитываем весь урон.
	ЗначениеЩита = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраЩит);
	СтруктураУрона = ВосхождениеКлиентСервер.РассчитатьСтруктуруУронаПротивнику(КоличествоУрона, ЗначениеЩита);
	// Устанавливаем новый щит.
	УстановитьПараметрПротивника(Форма, ВидПараметраЩит, СтруктураУрона.НовоеЗначениеЩита);
	// Рассчитваем оставшееся здоровье и устанавливаем его.
	ТекущееЗдоровье = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраЗдоровье);
	НовоеЗдоровье = ТекущееЗдоровье - СтруктураУрона.УронПоЗдоровью;
	ПрименитьМодификатор_МайкаЛидера(Форма, СтруктураУрона.УронПоЗдоровью, ТекущееЗдоровье);
	Если НовоеЗдоровье < 0 Тогда
		НовоеЗдоровье = 0;
	Иначе
		// Здоровье противника неотрицательное.
	КонецЕсли;
	УстановитьПараметрПротивника(Форма, ВидПараметраЗдоровье, НовоеЗдоровье);
	// Формируем и возвращаем результат.
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("УронПоЩиту", СтруктураУрона.УронПоЩиту);
	РезультатФункции.Вставить("УронПоЗдоровью", СтруктураУрона.УронПоЗдоровью);
	Возврат РезультатФункции;
КонецФункции		// НанестиУронПротивнику()

// Возвращает размер урона, наносимого противником.
// Учитывает модификатор "Проклятие", который уменьшает урон на 25%.
// Увеличивает урон на величину параметра Сила противника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Функция ПолучитьРазмерУронаПротивника(Форма, Гсч) Экспорт
	// Получаем текущее действие противника из таблицы ЦиклДействийПротивника
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИдентификаторСтроки", Форма.ИдентификаторТекущегоДействияПротивника);
	НайденныеСтроки = Форма.ЦиклДействийПротивника.НайтиСтроки(СтруктураПоиска);
	РезультатФункции = 10; // Значение по умолчанию
	Если НайденныеСтроки.Количество() > 0 Тогда
		МинСила = НайденныеСтроки[0].МинимальнаяСила;
		МаксСила = НайденныеСтроки[0].МаксимальнаяСила;
		// Генерируем случайное значение урона в диапазоне от МинимальнаяСила до МаксимальнаяСила
		РезультатФункции = Гсч.СлучайноеЧисло(МинСила, МаксСила);
		РезультатФункции = Цел(РезультатФункции * ВосхождениеКлиентСервер.ПолучитьКоэффициентСложностиПротивника(Форма.НомерЭтапа));
	Иначе
		РезультатФункции = 10;
	КонецЕсли;
	// Добавляем действия модификаторов.
	РезультатФункции = ПрименитьМодификаторыУронаПротивника(Форма, РезультатФункции);
	Возврат РезультатФункции;
КонецФункции		// ПолучитьРазмерУронаПротивника()

// Применяет к урону противника НачальныйУронВход имеющиеся модификаторы. Возвращает полученный урон.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	НачальныйУронВход - Число - Начальный урон противника.
//
// Возвращаемое значение:
//	Число - Урон противника после применения модификаторов.
//
Функция ПрименитьМодификаторыУронаПротивника(Форма, НачальныйУронВход) Экспорт
	РезультатФункции = НачальныйУронВход;
	// Добавляем бонус от параметра Сила противника
	ВидПараметраСила = Перечисления.ВидыПараметровИгроков.Сила;
	ЗначениеСилы = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраСила);
	РезультатФункции = РезультатФункции + ЗначениеСилы;
	// Проверяем наличие проклятия у противника
	Если ЕстьПроклятиеУПротивника(Форма) Тогда
		// Уменьшаем урон на 25%
		РезультатФункции = РезультатФункции * 0.75;
		// Округляем до целых
		РезультатФункции = Цел(РезультатФункции);
	Иначе
		// Проклятия нет. Урон не уменьшается.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		 // ПрименитьМодификаторыУронаПротивника()

// Начисляет золото игроку за избыточный урон под действием модификатора МайкаЛидера.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//   УронПоЗдоровьюВход - Число - урон, нанесённый по здоровью противника.
//   ТекущееЗдоровьеВход - Число - текущее здоровье противника до нанесения урона.
//
Процедура ПрименитьМодификатор_МайкаЛидера(Форма, УронПоЗдоровьюВход, ТекущееЗдоровьеВход) Экспорт
	// Инициализация.
	МодификаторМайкаЛидера = Справочники.Модификаторы.МайкаЛидера;
	// Проверка модификатора.
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, МодификаторМайкаЛидера) Тогда
		ИзбыточныйУрон = УронПоЗдоровьюВход - ТекущееЗдоровьеВход;
		Если ИзбыточныйУрон > 0 Тогда
			ВидПараметраЗолото = Перечисления.ВидыПараметровИгроков.Золото;
			УвеличитьПараметрИгрока(Форма, ВидПараметраЗолото, ИзбыточныйУрон);
			ВосхождениеКлиентСервер.ДобавитьДействиеМодификатораВЖурналБоя(Форма, МодификаторМайкаЛидера, ИзбыточныйУрон);
		Иначе
			// Избыточного урона нет.
		КонецЕсли;
	Иначе
		// Модификатор не активен.
	КонецЕсли;
КонецПроцедуры		// ПрименитьМодификатор_МайкаЛидера()

#КонецОбласти

#Область СлужебныеМетоды

// Очищает таблицу параметров, оставляя только основные параметры.
//
// Параметры:
//  ТаблицаПараметров - ТаблицаЗначений - таблица параметров для очистки.
//
Процедура ОчиститьПараметрыКромеОсновных(ТаблицаПараметров) Экспорт
	ОсновныеПараметры = Перечисления.ВидыПараметровИгроков.ПолучитьОсновныеПараметры();
	// Копируем строки для удаления, чтобы избежать изменения коллекции во время итерации
	МассивДляУдаления = Новый Массив;
	Для Каждого ТекПараметр Из ТаблицаПараметров Цикл
		Если ОсновныеПараметры.Найти(ТекПараметр.ВидПараметра) = Неопределено Тогда
			МассивДляУдаления.Добавить(ТекПараметр);
		Иначе
			// Параметр основной. Сохраняется.
		КонецЕсли;
	КонецЦикла;
	// Удаляем неосновные параметры
	Для Каждого ТекПараметрИзМассива Из МассивДляУдаления Цикл
		ТаблицаПараметров.Удалить(ТекПараметрИзМассива);
	КонецЦикла;
КонецПроцедуры		// ОчиститьПараметрыКромеОсновных()

#КонецОбласти

#Область РежимВосхождение

// Устанавливает на форме реквизит СложностьПротивника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура СчитатьСложностьПротивника(Форма) Экспорт
	ЭтоЭлитнаяСложность = Обработки.ТестированиеЗнаний.ЭтоЭтапЭлитнойСложности(Форма.НомерЭтапа);
	Форма.СложностьПротивника = Перечисления.СложностиПротивников.Обычная;
	Если Форма.НомерЭтапа <= 5 Тогда
		Форма.СложностьПротивника = Перечисления.СложностиПротивников.Начальная;
	Иначе
		Если ЭтоЭлитнаяСложность Тогда
			Форма.СложностьПротивника = Перечисления.СложностиПротивников.Элитная;
		Иначе	
			Форма.СложностьПротивника = Перечисления.СложностиПротивников.Обычная;
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры		// СчитатьСложностьПротивника()

// Размещает случайного противника на форму.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура ЗагрузитьПротивника(Форма, Гсч) Экспорт
	Форма.СчитатьСложностьПротивника();
	Форма.Противник = Справочники.Противники.ПолучитьСлучайногоПротивника(Гсч, Форма.СложностьПротивника);
КонецПроцедуры		// ЗагрузитьПротивника()

// Загружает таблицу цикла действий противника в реквизит формы ЦиклДействийПротивника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ЗагрузитьЦиклДействийПротивника(Форма, Противник) Экспорт
	Форма.ЦиклДействийПротивника.Очистить();
	ТаблицаДействий = Справочники.Противники.ПолучитьТаблицуДействийЦикла(Противник);
	Для Каждого СтрокаДействия Из ТаблицаДействий Цикл
		НоваяСтрока = Форма.ЦиклДействийПротивника.Добавить();
		НоваяСтрока.ДействиеЦикла = СтрокаДействия.ДействиеЦикла;
		НоваяСтрока.МинимальнаяСила = СтрокаДействия.МинимальнаяСила;
		НоваяСтрока.МаксимальнаяСила = СтрокаДействия.МаксимальнаяСила;
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	КонецЦикла;
КонецПроцедуры		// ЗагрузитьЦиклДействийПротивника()

// Возвращает начальное значение здоровья игрока по умолчанию.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Функция НачальноеЗдоровьеИгрокаПоУмолчанию(Форма) Экспорт
	Возврат 100;
КонецФункции

// Осуществляет инициализацию игрока.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ИнициализироватьИгрока(Форма) Экспорт
	// Инициализация параметров игрока
	Форма.ПараметрыИгрока.Очистить();
	ВидПараметраТекущееЗдоровье = Перечисления.ВидыПараметровИгроков.ТекущееЗдоровье;
	ВидПараметраМаксимальноеЗдоровье = Перечисления.ВидыПараметровИгроков.МаксимальноеЗдоровье;
	ВидПараметраЩит = Перечисления.ВидыПараметровИгроков.Щит;
	ЗначениеЗдоровья = Форма.НачальноеЗдоровьеИгрокаПоУмолчанию();
	Форма.УстановитьПараметрИгрока(ВидПараметраТекущееЗдоровье, ЗначениеЗдоровья);
	Форма.УстановитьПараметрИгрока(ВидПараметраМаксимальноеЗдоровье, ЗначениеЗдоровья);
	// Инициализация щита игрока нулевым значением
	Форма.УстановитьПараметрИгрока(ВидПараметраЩит, 0);
	// Инициализация золота игрока значением 100
	ВидПараметраЗолото = Перечисления.ВидыПараметровИгроков.Золото;
	Форма.УстановитьПараметрИгрока(ВидПараметраЗолото, 200);
	// Считывание значений здоровья из таблицы параметров и размещение в реквизиты формы
	Форма.МаксимальноеЗдоровьеИгрока = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраМаксимальноеЗдоровье);
	ВосхождениеКлиентСервер.УстановитьТекущееЗдоровьеИгрока(Форма, ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраТекущееЗдоровье));
	// Инициализация колоды игрока
	Форма.ИнициализироватьПерсонажа();
	// Инициализация энергии.
	Форма.ИнициализироватьЭнергиюИгрока();
	// Инициализация стопки добора игрока
	Форма.ИнициализироватьСтопкуДобораИгрока();
	// Перемешивание стопки добора
	ВосхождениеСервер.ПеремешатьСтопку(Форма.СтопкаДобора);
	// Добор карт в руку
	Форма.ДобратьРуку();
КонецПроцедуры		// ИнициализироватьИгрока()

// Копирует все строки из таблицы КолодаИгрока в таблицу СтопкаДобора.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ИнициализироватьСтопкуДобораИгрока(Форма) Экспорт
	Форма.СтопкаДобора.Очистить();
	Для Каждого СтрокаКолоды Из Форма.КолодаИгрока Цикл
		НоваяСтрока = Форма.СтопкаДобора.Добавить();
		НоваяСтрока.Карта = СтрокаКолоды.Карта;
		НоваяСтрока.ИдентификаторКарты = СтрокаКолоды.ИдентификаторКарты;
	КонецЦикла;
КонецПроцедуры		// ИнициализироватьСтопкуДобораИгрока()

// Очищает список КолодаИгрока и заполняет его картами стартовой колоды выбранного персонажа.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ИнициализироватьКолодуИгрока(Форма) Экспорт
	// Инициализация.
	Форма.КолодаИгрока.Очистить();
	МассивКартКолоды = ВосхождениеСервер.ПолучитьСтартовуюКолодуПерсонажа(Форма.Персонаж);
	// Заполняем колоду игрока картами стартовой колоды персонажа.
	Для Каждого КартаКолоды Из МассивКартКолоды Цикл
		НоваяСтрока = Форма.КолодаИгрока.Добавить();
		НоваяСтрока.Карта = КартаКолоды;
		НоваяСтрока.ИдентификаторКарты = Строка(Новый УникальныйИдентификатор());
	КонецЦикла;
КонецПроцедуры		// ИнициализироватьКолодуИгрока()

// Инициализирует персонажа: колоду и модификаторы.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ИнициализироватьПерсонажа(Форма) Экспорт
	Форма.ИнициализироватьКолодуИгрока();
	Форма.ИнициализироватьМодификаторыПерсонажа();
КонецПроцедуры		// ИнициализироватьПерсонажа()

// Инициализирует стартовые модификаторы для выбранного персонажа.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ИнициализироватьМодификаторыПерсонажа(Форма) Экспорт
	МассивМодификаторов = ВосхождениеСервер.ПолучитьСтартовыеМодификаторыПерсонажа(Форма.Персонаж);
	Для Каждого Модификатор Из МассивМодификаторов Цикл
		НоваяСтрока = Форма.Модификаторы.Добавить();
		НоваяСтрока.Модификатор = Модификатор;
	КонецЦикла;
КонецПроцедуры		// ИнициализироватьМодификаторыПерсонажа()

// Добавляет в таблицу КолодаИгрока случайную карту из числа предопределенных карт в справочнике Карты.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура ДобавитьСлучайнуюКартуВКолоду(Форма, Гсч) Экспорт
	// Получаем массив всех предопределенных карт
	МассивКарт = Новый Массив;
	МассивКарт.Добавить(Справочники.Карты.Удар);
	МассивКарт.Добавить(Справочники.Карты.Защита);
	МассивКарт.Добавить(Справочники.Карты.Адреналин);
	МассивКарт.Добавить(Справочники.Карты.Лезвие);
	МассивКарт.Добавить(Справочники.Карты.Окоп);
	МассивКарт.Добавить(Справочники.Карты.Бинты);
	МассивКарт.Добавить(Справочники.Карты.Взрыв);
	МассивКарт.Добавить(Справочники.Карты.БезПрикрас);
	МассивКарт.Добавить(Справочники.Карты.ЛожныйМаневр);
	МассивКарт.Добавить(Справочники.Карты.НовыйРассвет);
	МассивКарт.Добавить(Справочники.Карты.Опровержение);
	МассивКарт.Добавить(Справочники.Карты.Очищение);
	
	// Выбираем случайную карту из массива
	НомерКарты = Гсч.СлучайноеЧисло(0, МассивКарт.Количество() - 1);
	ВыбраннаяКарта = МассивКарт[НомерКарты];
	
	// Добавляем карту в колоду игрока
	НоваяСтрока = Форма.КолодаИгрока.Добавить();
	НоваяСтрока.Карта = ВыбраннаяКарта;
	НоваяСтрока.ИдентификаторКарты = Строка(Новый УникальныйИдентификатор());
КонецПроцедуры		// ДобавитьСлучайнуюКартуВКолоду()

// Перемещает все карты из стопки СтопкаСброса в стопку СтопкаДобора,
// после чего перемешивает стопку СтопкаДобора.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ПеремешатьСбросВДобор(Форма) Экспорт
	// Перемещаем все карты из СтопкаСброса в СтопкаДобора
	Пока Форма.СтопкаСброса.Количество() > 0 Цикл
		ПерваяКарта = Форма.СтопкаСброса[0];
		ИдентификаторКарты = ПерваяКарта.ИдентификаторКарты;
		ВосхождениеКлиентСервер.ПереместиКартуИзСтопки(ИдентификаторКарты, "СтопкаСброса", "СтопкаДобора", Форма);
	КонецЦикла;
	// Перемешиваем стопку добора
	ВосхождениеСервер.ПеремешатьСтопку(Форма.СтопкаДобора);
	// Применение модификатора ДозорныйВорон: при перемешивании сброса в добор даёт 7 щита
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, Справочники.Модификаторы.ДозорныйВорон) Тогда
		Форма.УвеличитьЩитИгрока(7);
	Иначе
		// Модификатор не активен.
	КонецЕсли;
КонецПроцедуры		// ПеремешатьСбросВДобор()

// Добирает карты из стопки добора в руку игрока, пока в руке меньше 5 карт.
// При активном модификаторе Гонг добирает на 1 карту больше.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ДобратьРуку(Форма) Экспорт
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, Справочники.Модификаторы.Гонг) Тогда
		Форма.ДобратьВРукуКарты(6);
	Иначе
		Форма.ДобратьВРукуКарты(5);
	КонецЕсли;
КонецПроцедуры		// ДобратьРуку()

// Осуществляет инициализацию противника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  ПротивникВход - СправочникСсылка.Противники - противник для инициализации (необязательный).
//                  Если не задан (Неопределено), будет загружен случайный противник.
//
Процедура ИнициализироватьПротивника(Форма, ПротивникВход = Неопределено) Экспорт
	Форма.ПараметрыПротивника.Очистить();
	Если ПротивникВход = Неопределено Тогда
		Форма.ЗагрузитьПротивника();
	Иначе
		Форма.Противник = ПротивникВход;
	КонецЕсли;
	Форма.ЗагрузитьЦиклДействийПротивника(Форма.Противник);
	// Установка идентификатора текущего действия противника
	Если Форма.ЦиклДействийПротивника.Количество() > 0 Тогда
		Форма.ИдентификаторТекущегоДействияПротивника = Форма.ЦиклДействийПротивника[0].ИдентификаторСтроки;
		Форма.СледующееДействиеПротивника = Форма.ЦиклДействийПротивника[0].ДействиеЦикла;
	Иначе
		Сообщить("У противника " + Строка(Форма.Противник) + " не задан цикл действий");
		Форма.ИдентификаторТекущегоДействияПротивника = "";
		Форма.СледующееДействиеПротивника = "";
	КонецЕсли;
	// Инициализация параметров противника
	ВидПараметраТекущееЗдоровье = Перечисления.ВидыПараметровИгроков.ТекущееЗдоровье;
	ВидПараметраМаксимальноеЗдоровье = Перечисления.ВидыПараметровИгроков.МаксимальноеЗдоровье;
	ЗначениеЗдоровья = Форма.Противник.МаксимальноеЗдоровье;
	// Применение модификатора "Подсечка": уменьшение максимального здоровья на 10%
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, Справочники.Модификаторы.Подсечка) Тогда
		ЗначениеЗдоровья = Цел(ЗначениеЗдоровья * 0.9);
	Иначе
		// Оставляем здоровье противника.
	КонецЕсли;
	Форма.УстановитьПараметрПротивника(ВидПараметраТекущееЗдоровье, ЗначениеЗдоровья);
	Форма.УстановитьПараметрПротивника(ВидПараметраМаксимальноеЗдоровье, ЗначениеЗдоровья);
	// Считывание значений здоровья из таблицы параметров и размещение в реквизиты формы
	Форма.ТекущееЗдоровьеПротивника = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраТекущееЗдоровье);
	Форма.МаксимальноеЗдоровьеПротивника = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраМаксимальноеЗдоровье);
	// Применяем модификатор "ЯдовитыйСлед": противник получает 3 яда в начале боя
	Если ВосхождениеКлиентСервер.МодификаторАктивен(Форма, ПредопределенноеЗначение("Справочник.Модификаторы.ЯдовитыйСлед")) Тогда
		Форма.УвеличитьПараметрПротивника(Перечисления.ВидыПараметровИгроков.Яд, 3);
	КонецЕсли;
	Форма.СчитатьСложностьПротивника();
	// Добавляем запись о начале боя в журнал.
	СобытиеБойСПротивником = ПредопределенноеЗначение("Перечисление.СобытияБоя.БойСПротивником");
	ВосхождениеКлиентСервер.ДобавитьЗаписьВЖурналБоя(Форма, СобытиеБойСПротивником, Форма.Противник);
КонецПроцедуры		// ИнициализироватьПротивника()

// Осуществляет инициализацию нового восхождения.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ИнициализироватьРежимВосхождение(Форма) Экспорт
	Форма.ЗагрузитьМодификаторыПоУмолчанию();
	// Инициализация игрока
	Форма.ИнициализироватьИгрока();
	// Инициализация противника
	Форма.ИнициализироватьПротивника();
	// Инициализация реквизитов этапов
	Форма.НомерЭтапа = 1;
	Форма.ВсегоЭтапов = 30;
	Форма.ЗарядСерии = 0;
	Форма.ВидЭтапа = Перечисления.ВидыЭтаповВосхождения.Противник;
КонецПроцедуры		// ИнициализироватьРежимВосхождение()

//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ПерезапуститьВосхождение_Сервер(Форма) Экспорт
	Форма.ИнициализироватьРежимВосхождение();
КонецПроцедуры		// ПерезапуститьВосхождение_Сервер()

// Отображает текущее состояние противника в реквизитах формы.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ОтобразитьСостояниеПротивника(Форма) Экспорт
	ВидПараметраТекущееЗдоровье = Перечисления.ВидыПараметровИгроков.ТекущееЗдоровье;
	ВидПараметраМаксимальноеЗдоровье = Перечисления.ВидыПараметровИгроков.МаксимальноеЗдоровье;
	Если НЕ Форма.ЗапретИзмененияТекущегоЗдоровьяПротивника Тогда
		Форма.ТекущееЗдоровьеПротивника = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраТекущееЗдоровье);
	Иначе
		// Исполняется анимация.
	КонецЕсли;
	Форма.МаксимальноеЗдоровьеПротивника = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраМаксимальноеЗдоровье);
	Форма.ОбновитьИнтерфейсБоя();
КонецПроцедуры		// ОтобразитьСостояниеПротивника()

// Отображает текущее состояние игрока в реквизитах формы.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ОтобразитьСостояниеИгрока(Форма) Экспорт
	ВидПараметраТекущееЗдоровье = Перечисления.ВидыПараметровИгроков.ТекущееЗдоровье;
	ВидПараметраМаксимальноеЗдоровье = Перечисления.ВидыПараметровИгроков.МаксимальноеЗдоровье;
	Если НЕ Форма.ЗапретИзмененияТекущегоЗдоровьяИгрока Тогда
		ВосхождениеКлиентСервер.УстановитьТекущееЗдоровьеИгрока(Форма, ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраТекущееЗдоровье));
	Иначе
		// Исполняется анимация.
	КонецЕсли;
	Форма.МаксимальноеЗдоровьеИгрока = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраМаксимальноеЗдоровье);
	Форма.ОбновитьИнтерфейсБоя();
КонецПроцедуры		// ОтобразитьСостояниеИгрока()

#КонецОбласти

#Область ДействияИгрока

// Выдает награды за победу над противником.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  ПобежденныйПротивник - СправочникСсылка.Противники - побежденный противник.
//
Процедура ВыдатьНаградыЗаПобеду(Форма, ПобежденныйПротивник) Экспорт
	// Начисляем золото за победу
	Форма.НачислитьИгрокуЗолотоЗаПобеду(ПобежденныйПротивник);
	// Возвращаем похищенное золото
	Форма.ВернутьПохищенноеЗолото(ПобежденныйПротивник);
	// Добавляем случайную карту в колоду игрока
	Форма.ДобавитьСлучайнуюКартуВКолоду();
КонецПроцедуры		// ВыдатьНаградыЗаПобеду()

// Возвращает похищенное золото от противника игроку.
// Увеличивает параметр Золото игрока на величину параметра Золото противника,
// после чего параметр Золото противника обнуляется.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  ПобежденныйПротивник - СправочникСсылка.Противники - побежденный противник.
//
Процедура ВернутьПохищенноеЗолото(Форма, ПобежденныйПротивник) Экспорт
	ВидПараметраЗолото = Перечисления.ВидыПараметровИгроков.Золото;
	// Получаем значение золота противника
	ЗолотоПротивника = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраЗолото);
	Если ЗолотоПротивника > 0 Тогда
		// Увеличиваем золото игрока на величину золота противника
		Форма.УвеличитьПараметрИгрока(ВидПараметраЗолото, ЗолотоПротивника);
		// Обнуляем золото противника
		Форма.УстановитьПараметрПротивника(ВидПараметраЗолото, 0);
		Сообщить("Вы вернули " + Строка(ЗолотоПротивника) + " золотых монет, похищенных противником!");
	Иначе
		// Золото не было похиищено. Нечего возвращать.
	КонецЕсли;
КонецПроцедуры		// ВернутьПохищенноеЗолото()

// Начисляет игроку золото за победу над противником.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//  ПротивникВход - СправочникСсылка.Противники - побежденный противник.
//
Процедура НачислитьИгрокуЗолотоЗаПобеду(Форма, Гсч, ПротивникВход) Экспорт
	// Начисление игроку золота за победу над противником
	// Случайная величина от 20 до 40 единиц
	МинЗолото = 20;
	МаксЗолото = 40;
	НачисленоЗолота = Гсч.СлучайноеЧисло(МинЗолото, МаксЗолото);
	НачисленоЗолота = НачисленоЗолота + Форма.ПрименитьМодификатор_ДырявыйКошель();
	// Получаем текущее значение золота игрока и увеличиваем его
	ВидПараметраЗолото = Перечисления.ВидыПараметровИгроков.Золото;
	Форма.УвеличитьПараметрИгрока(ВидПараметраЗолото, НачисленоЗолота);
	Сообщить("Игрок получил " + Строка(НачисленоЗолота) + " золотых монет за победу!");
КонецПроцедуры		// НачислитьИгрокуЗолотоЗаПобеду()

// Увеличивает количество золота у игрока на указанную сумму.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	Сумма - Число - количество золота для начисления.
//
Процедура ПолучитьЗолото(Форма, Сумма) Экспорт
	ВидПараметраЗолото = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Золото");
	Сумма = Форма.ПрименитьМодификатор_ВесыФортуны(Сумма);
	Форма.УвеличитьПараметрИгрока(ВидПараметраЗолото, Сумма);
КонецПроцедуры		// ПолучитьЗолото()

#КонецОбласти

#Область ДействияПротивника

// Противник просто пропускает текущий ход (спит).
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ОбработатьСон(Форма) Экспорт
	// Пустая процедура - противник спит и ничего не делает в этот ход.
КонецПроцедуры		// ОбработатьСон()

// Выполняет действие противника УкрастьЗолото.
// Противник крадет случайное количество золота у игрока от МинимальнаяСила до МаксимальнаяСила текущего действия,
// но не более общего количества золота игрока.
// Похищенное золото добавляется к золоту противника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура УкрастьЗолото(Форма, Гсч) Экспорт
	// Получаем текущее действие противника из таблицы ЦиклДействийПротивника
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИдентификаторСтроки", Форма.ИдентификаторТекущегоДействияПротивника);
	НайденныеСтроки = Форма.ЦиклДействийПротивника.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		МинСила = НайденныеСтроки[0].МинимальнаяСила;
		МаксСила = НайденныеСтроки[0].МаксимальнаяСила;
		// Генерируем случайное значение украденного золота в диапазоне от МинимальнаяСила до МаксимальнаяСила
		РазмерКражи = Гсч.СлучайноеЧисло(МинСила, МаксСила);
		РазмерКражи = Цел(РазмерКражи * ВосхождениеКлиентСервер.ПолучитьКоэффициентСложностиПротивника(Форма.НомерЭтапа));
	Иначе
		// Значение по умолчанию, если действие не найдено
		РазмерКражи = 5;
	КонецЕсли;
	// Получаем текущее золото игрока
	ВидПараметраЗолото = Перечисления.ВидыПараметровИгроков.Золото;
	ЗолотоИгрока = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЗолото);
	// Количество похищенного золота не может быть больше общего количества золота игрока
	ФактическаяКража = Мин(РазмерКражи, ЗолотоИгрока);
	// Уменьшаем золото у игрока через метод УвеличитьПараметрИгрока с отрицательным значением
	Форма.УвеличитьПараметрИгрока(ВидПараметраЗолото, -ФактическаяКража);
	// Увеличиваем золото у противника
	ЗолотоПротивника = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраЗолото);
	НовоеЗолотоПротивника = ЗолотоПротивника + ФактическаяКража;
	Форма.УстановитьПараметрПротивника(ВидПараметраЗолото, НовоеЗолотоПротивника);
КонецПроцедуры		// УкрастьЗолото()

// Возвращает текущее действие противника из таблицы ЦиклДействийПротивника
// по идентификатору ИдентификаторТекущегоДействияПротивника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ВариантыДействийПротивников - ссылка на вариант действия, или пустая ссылка если не найдено.
//
Функция ПолучитьТекущееДействиеПротивника(Форма) Экспорт
	РезультатФункции = Перечисления.ВариантыДействийПротивников.ПустаяСсылка();
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИдентификаторСтроки", Форма.ИдентификаторТекущегоДействияПротивника);
	НайденныеСтроки = Форма.ЦиклДействийПротивника.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		РезультатФункции = НайденныеСтроки[0].ДействиеЦикла;
	Иначе
		Сообщить("Действие противника с идентификатором " + Форма.ИдентификаторТекущегоДействияПротивника + " не найдено");
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПолучитьТекущееДействиеПротивника()

// Перемещает действие противника вперед по циклу.
// Устанавливает идентификатор текущего действия на значение из следующей строки таблицы.
// Если достигнут конец таблицы - устанавливает значение из первой строки.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ПереместитьДействиеПротивникаВпередПоЦиклу(Форма) Экспорт
	Если Форма.ЦиклДействийПротивника.Количество() > 0 Тогда
		ТекущийИндекс = -1;
		Для Индекс = 0 По Форма.ЦиклДействийПротивника.Количество() - 1 Цикл
			Если Форма.ЦиклДействийПротивника[Индекс].ИдентификаторСтроки = Форма.ИдентификаторТекущегоДействияПротивника Тогда
				ТекущийИндекс = Индекс;
				Прервать;
			Иначе
				// Продолжаем поиск
			КонецЕсли;
		КонецЦикла;
		Если ТекущийИндекс >= 0 Тогда
			СледующийИндекс = ТекущийИндекс + 1;
			Если СледующийИндекс >= Форма.ЦиклДействийПротивника.Количество() Тогда
				СледующийИндекс = 0;
			Иначе
				// Индекс в пределах таблицы
			КонецЕсли;
			Форма.ИдентификаторТекущегоДействияПротивника	 = Форма.ЦиклДействийПротивника[СледующийИндекс].ИдентификаторСтроки;
			Форма.СледующееДействиеПротивника				 = Форма.ЦиклДействийПротивника[СледующийИндекс].ДействиеЦикла;
		Иначе
			// Текущее действие не найдено, сбрасываем на первое
			Форма.ИдентификаторТекущегоДействияПротивника	 = Форма.ЦиклДействийПротивника[0].ИдентификаторСтроки;
			Форма.СледующееДействиеПротивника				 = Форма.ЦиклДействийПротивника[0].ДействиеЦикла;
		КонецЕсли;
	Иначе
		// Таблица пуста, оставляем как есть
	КонецЕсли;
КонецПроцедуры		// ПереместитьДействиеПротивникаВпередПоЦиклу()

// Возвращает структуру параметров для открытия формы действия противника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  ВариантДействия - ПеречислениеСсылка.ВариантыДействийПротивников - вариант действия противника.
//
// Возвращаемое значение:
//  Структура - содержащая параметры: ВариантДействия, Противник, 
//  ТекущееЗдоровьеИгрока, МаксимальноеЗдоровьеИгрока, 
//  ТекущееЗдоровьеПротивника, МаксимальноеЗдоровьеПротивника.
//
Функция ПолучитьПараметрыОткрытияФормыПротивника(Форма, ВариантДействияВход) Экспорт
	Результат = Новый Структура;
	// Вариант действия противника
	Результат.Вставить("ВариантДействия",					 ВариантДействияВход);
	// Противник
	Результат.Вставить("Противник",							 Форма.Противник);
	// Здоровье игрока
	ВидПараметраТекущееЗдоровье = Перечисления.ВидыПараметровИгроков.ТекущееЗдоровье;
	ВидПараметраМаксимальноеЗдоровье = Перечисления.ВидыПараметровИгроков.МаксимальноеЗдоровье;
	ВосхождениеКлиентСервер.УстановитьТекущееЗдоровьеИгрока(Форма, ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраТекущееЗдоровье));
	Форма.МаксимальноеЗдоровьеИгрока = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраМаксимальноеЗдоровье);
	Результат.Вставить("ТекущееЗдоровьеИгрока",				 Форма.ТекущееЗдоровьеИгрока);
	Результат.Вставить("МаксимальноеЗдоровьеИгрока",		 Форма.МаксимальноеЗдоровьеИгрока);
	// Здоровье противника
	Форма.ТекущееЗдоровьеПротивника = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраТекущееЗдоровье);
	Форма.МаксимальноеЗдоровьеПротивника = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраМаксимальноеЗдоровье);
	Результат.Вставить("ТекущееЗдоровьеПротивника",			 Форма.ТекущееЗдоровьеПротивника);
	Результат.Вставить("МаксимальноеЗдоровьеПротивника",	 Форма.МаксимальноеЗдоровьеПротивника);
	Возврат Результат;
КонецФункции		// ПолучитьПараметрыОткрытияФормыПротивника()

// Обрабатывает действие противника "Увеличить силу".
// Увеличивает параметр Сила у противника на случайное значение между 
// МинимальнаяСила и МаксимальнаяСила из таблицы ЦиклДействийПротивника.
// Обрабатывает увеличение силы противника при действии "УвеличитьСилу".
// Использует значения МинимальнаяСила и МаксимальнаяСила из таблицы ЦиклДействийПротивника
// для текущего действия противника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//  РазмерПриращенияВход - Число - размер приращения силы; 0 - случайное значение из цикла действий противника.
//
Процедура ОбработатьУвеличениеСилыПротивника(Форма, Гсч, РазмерПриращенияВход = 0) Экспорт
	ВидПараметраСила = Перечисления.ВидыПараметровИгроков.Сила;
	Если РазмерПриращенияВход = 0 Тогда
		// Поиск строки в таблице ЦиклДействийПротивника по идентификатору текущего действия
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("ИдентификаторСтроки", Форма.ИдентификаторТекущегоДействияПротивника);
		НайденныеСтроки = Форма.ЦиклДействийПротивника.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда
			МинСила = НайденныеСтроки[0].МинимальнаяСила;
			МаксСила = НайденныеСтроки[0].МаксимальнаяСила;
			ПриращениеСилы = Гсч.СлучайноеЧисло(МинСила, МаксСила);
			ПриращениеСилы = Цел(ПриращениеСилы * ВосхождениеКлиентСервер.ПолучитьКоэффициентСложностиПротивника(Форма.НомерЭтапа));
		Иначе
			ПриращениеСилы = 1; // Значение по умолчанию
		КонецЕсли;
	Иначе
		ПриращениеСилы = РазмерПриращенияВход;
	КонецЕсли;
	ЗначениеСилы = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраСила);
	НовоеЗначениеСилы = ЗначениеСилы + ПриращениеСилы;
	Форма.УстановитьПараметрПротивника(ВидПараметраСила, НовоеЗначениеСилы);
КонецПроцедуры		// ОбработатьУвеличениеСилыПротивника()

// Обрабатывает увеличение неуклюжести игрока при действии противника "НаложитьНеуклюжесть".
// Использует значения МинимальнаяСила и МаксимальнаяСила из таблицы ЦиклДействийПротивника
// для текущего действия противника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура ОбработатьУвеличениеНеуклюжестиПротивником(Форма, Гсч) Экспорт
	ВидПараметраНеуклюжесть = Перечисления.ВидыПараметровИгроков.Неуклюжесть;
	// Поиск строки в таблице ЦиклДействийПротивника по идентификатору текущего действия
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИдентификаторСтроки", Форма.ИдентификаторТекущегоДействияПротивника);
	НайденныеСтроки = Форма.ЦиклДействийПротивника.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		МинСила = НайденныеСтроки[0].МинимальнаяСила;
		МаксСила = НайденныеСтроки[0].МаксимальнаяСила;
		ПриращениеНеуклюжести = Гсч.СлучайноеЧисло(МинСила, МаксСила);
		ПриращениеНеуклюжести = Цел(ПриращениеНеуклюжести * ВосхождениеКлиентСервер.ПолучитьКоэффициентСложностиПротивника(Форма.НомерЭтапа));
	Иначе
		ПриращениеНеуклюжести = 1; // Значение по умолчанию
	КонецЕсли;
	Форма.УвеличитьПараметрИгрока(ВидПараметраНеуклюжесть, ПриращениеНеуклюжести);
КонецПроцедуры		// ОбработатьУвеличениеНеуклюжестиПротивником()

// Обрабатывает действие противника "ЗаблокироватьЛечение".
// Увеличивает значение параметра игрока БлокировкаЛечения на случайное значение
// от МинимальнаяСила до МаксимальнаяСила текущего действия противника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура ОбработатьБлокировкаЛечения(Форма, Гсч) Экспорт
	// Получаем текущее действие противника из таблицы ЦиклДействийПротивника
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИдентификаторСтроки", Форма.ИдентификаторТекущегоДействияПротивника);
	НайденныеСтроки = Форма.ЦиклДействийПротивника.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		МинСила = НайденныеСтроки[0].МинимальнаяСила;
		МаксСила = НайденныеСтроки[0].МаксимальнаяСила;
		// Генерируем случайное значение силы блокировки лечения в диапазоне от МинимальнаяСила до МаксимальнаяСила
		СилаБлокировкиЛечения = Гсч.СлучайноеЧисло(МинСила, МаксСила);
		СилаБлокировкиЛечения = Цел(СилаБлокировкиЛечения * ВосхождениеКлиентСервер.ПолучитьКоэффициентСложностиПротивника(Форма.НомерЭтапа));
		ВидПараметраБлокировкаЛечения = Перечисления.ВидыПараметровИгроков.БлокировкаЛечения;
		// Увеличиваем параметр БлокировкаЛечения у игрока
		Форма.УвеличитьПараметрИгрока(ВидПараметраБлокировкаЛечения, СилаБлокировкиЛечения, Форма.ИдентификаторТекущегоДействияПротивника);
	КонецЕсли;
КонецПроцедуры          // ОбработатьБлокировкаЛечения()

// Обрабатывает действие противника "Поджечь".
// Увеличивает значение параметра игрока Горение на случайное значение
// от МинимальнаяСила до МаксимальнаяСила текущего действия противника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура ОбработатьПоджечь(Форма, Гсч) Экспорт
	// Получаем текущее действие противника из таблицы ЦиклДействийПротивника
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИдентификаторСтроки", Форма.ИдентификаторТекущегоДействияПротивника);
	НайденныеСтроки = Форма.ЦиклДействийПротивника.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		МинСила = НайденныеСтроки[0].МинимальнаяСила;
		МаксСила = НайденныеСтроки[0].МаксимальнаяСила;
		// Генерируем случайное значение силы горения в диапазоне от МинимальнаяСила до МаксимальнаяСила
		СилаГорения = Гсч.СлучайноеЧисло(МинСила, МаксСила);
		СилаГорения = Цел(СилаГорения * ВосхождениеКлиентСервер.ПолучитьКоэффициентСложностиПротивника(Форма.НомерЭтапа));
		ВидПараметраГорение = Перечисления.ВидыПараметровИгроков.Горение;
		// Увеличиваем параметр Горение у игрока
		Форма.УвеличитьПараметрИгрока(ВидПараметраГорение, СилаГорения, Форма.ИдентификаторТекущегоДействияПротивника);
	КонецЕсли;
КонецПроцедуры		// ОбработатьПоджечь()

// Обрабатывает действие противника "НаложитьЛедянойЩит".
// Увеличивает значение параметра противника ЛедянойЩит на случайное значение
// от МинимальнаяСила до МаксимальнаяСила текущего действия противника.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура ОбработатьНаложитьЛедянойЩит(Форма, Гсч) Экспорт
	// Получаем текущее действие противника из таблицы ЦиклДействийПротивника
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИдентификаторСтроки", Форма.ИдентификаторТекущегоДействияПротивника);
	НайденныеСтроки = Форма.ЦиклДействийПротивника.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		МинСила = НайденныеСтроки[0].МинимальнаяСила;
		МаксСила = НайденныеСтроки[0].МаксимальнаяСила;
		// Генерируем случайное значение силы ледяного щита в диапазоне от МинимальнаяСила до МаксимальнаяСила
		СилаЛедяногоЩита = Гсч.СлучайноеЧисло(МинСила, МаксСила);
		СилаЛедяногоЩита = Цел(СилаЛедяногоЩита * ВосхождениеКлиентСервер.ПолучитьКоэффициентСложностиПротивника(Форма.НомерЭтапа));
		ВидПараметраЛедянойЩит = Перечисления.ВидыПараметровИгроков.ЛедянойЩит;
		// Увеличиваем параметр ЛедянойЩит у противника
		Форма.УвеличитьПараметрПротивника(ВидПараметраЛедянойЩит, СилаЛедяногоЩита);
	КонецЕсли;
КонецПроцедуры		// ОбработатьНаложитьЛедянойЩит()

// Обрабатывает действие противника "Очищение".
// Противник снимает с себя случайный отрицательный эффект.
// Использует функцию ПолучитьОтрицательныеПараметры() из перечисления ВидыПараметровИгроков
// для получения списка отрицательных эффектов.
// Обрабатывает действие противника "Очищение".
// Снимает с противника 1 случайный отрицательный параметр.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура ОбработатьОчищениеПротивника(Форма, Гсч) Экспорт
	// Получаем список отрицательных параметров
	ОтрицательныеПараметры = Перечисления.ВидыПараметровИгроков.ПолучитьОтрицательныеПараметры();
	// Формируем массив строк с отрицательными параметрами у противника
	МассивОтрицательныхСтрок = Новый Массив;
	Для Каждого СтрокаПараметра Из Форма.ПараметрыПротивника Цикл
		Если ОтрицательныеПараметры.Найти(СтрокаПараметра.ВидПараметра) <> Неопределено Тогда
			МассивОтрицательныхСтрок.Добавить(СтрокаПараметра);
		КонецЕсли;
	КонецЦикла;
	// Удаляем один случайный отрицательный параметр
	Если МассивОтрицательныхСтрок.Количество() > 0 Тогда
		Индекс = Гсч.СлучайноеЧисло(0, МассивОтрицательныхСтрок.Количество() - 1);
		СтрокаДляУдаления = МассивОтрицательныхСтрок[Индекс];
		Форма.УдалитьПараметрПротивника(СтрокаДляУдаления.ВидПараметра);
	КонецЕсли;
КонецПроцедуры		// ОбработатьОчищениеПротивника()

// Обрабатывает действие противника "Опровержение".
// Снимает с игрока 1 случайный положительный параметр.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Процедура ОбработатьОпровержение(Форма, Гсч) Экспорт
	// Получаем список положительных параметров
	ПоложительныеПараметры = Перечисления.ВидыПараметровИгроков.ПолучитьПоложительныеПараметры();
	// Формируем массив строк с положительными параметрами у игрока
	МассивПоложительныхСтрок = Новый Массив;
	Для Каждого СтрокаПараметра Из Форма.ПараметрыИгрока Цикл
		Если ПоложительныеПараметры.Найти(СтрокаПараметра.ВидПараметра) <> Неопределено Тогда
			МассивПоложительныхСтрок.Добавить(СтрокаПараметра);
		КонецЕсли;
	КонецЦикла;
	// Если есть положительные параметры, удаляем один случайный
	Если МассивПоложительныхСтрок.Количество() > 0 Тогда
		Индекс = Гсч.СлучайноеЧисло(0, МассивПоложительныхСтрок.Количество() - 1);
		СтрокаДляУдаления = МассивПоложительныхСтрок[Индекс];
		Форма.УдалитьПараметрИгрока(СтрокаДляУдаления.ВидПараметра);
	КонецЕсли;
КонецПроцедуры		// ОбработатьОпровержение()

// Удаляет модификатор из таблицы Модификаторы.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  МодификаторВход - СправочникСсылка.Модификаторы - ссылка на модификатор, который будет удалён.
//
Процедура УдалитьМодификатор(Форма, МодификаторВход) Экспорт
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Модификатор", МодификаторВход);
	НайденныеСтроки = Форма.Модификаторы.НайтиСтроки(СтруктураПоиска);
	Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
		Форма.Модификаторы.Удалить(ТекНайденныеСтроки);
	КонецЦикла;
КонецПроцедуры		// УдалитьМодификатор()

#КонецОбласти

#Область ИнтерфейсБоя

// Обновляет весь игровой интерфейс боя: HUD, прогресс-бары, ресурсы, индикатор серии.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ОбновитьИнтерфейсБоя(Форма) Экспорт
	// Инициализация.
	ВидПараметраЩит = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Щит");
	ВидПараметраЭнергия = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Энергия");
	ВидПараметраТекущееЗдоровье = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
	ВидПараметраМаксимальноеЗдоровье = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.МаксимальноеЗдоровье");
	// Прогресс-бар здоровья игрока.
	Если Форма.МаксимальноеЗдоровьеИгрока > 0 Тогда
		Форма.ПрогрессЗдоровьяИгрокаПроценты = (Форма.ТекущееЗдоровьеИгрока / Форма.МаксимальноеЗдоровьеИгрока) * 100;
		ЗаполнениеИгрок = Цел(Форма.ПрогрессЗдоровьяИгрокаПроценты / 100 * 20);
		ТекстБараИгрок = "";
		Для Сч = 1 По 20 Цикл
			ТекстБараИгрок = ТекстБараИгрок + ?(Сч <= ЗаполнениеИгрок, "█", "░");
		КонецЦикла;
		Форма.Элементы.HUD_БарЗдоровьяИгрока.Заголовок = ТекстБараИгрок;
		Если Форма.ТекущееЗдоровьеИгрока < Форма.МаксимальноеЗдоровьеИгрока * 0.3 Тогда
			Форма.Элементы.HUD_БарЗдоровьяИгрока.ЦветТекста = WebЦвета.Красный;
		Иначе
			Форма.Элементы.HUD_БарЗдоровьяИгрока.ЦветТекста = WebЦвета.ЗеленыйЛес;
		КонецЕсли;
	Иначе
		// Максимальное здоровье не определено.
	КонецЕсли;
	// Прогресс-бар здоровья противника.
	Если Форма.МаксимальноеЗдоровьеПротивника > 0 Тогда
		Форма.ПрогрессЗдоровьяПротивникаПроценты = (Форма.ТекущееЗдоровьеПротивника / Форма.МаксимальноеЗдоровьеПротивника) * 100;
		ЗаполнениеВраг = Цел(Форма.ПрогрессЗдоровьяПротивникаПроценты / 100 * 20);
		ТекстБараВраг = "";
		Для Сч = 1 По 20 Цикл
			ТекстБараВраг = ТекстБараВраг + ?(Сч <= ЗаполнениеВраг, "█", "░");
		КонецЦикла;
		Форма.Элементы.HUD_БарЗдоровьяПротивника.Заголовок = ТекстБараВраг;
		Форма.Элементы.HUD_БарЗдоровьяПротивника.ЦветТекста = WebЦвета.ТемноКрасный;
	Иначе
		// Максимальное здоровье противника не определено.
	КонецЕсли;
	// Обновление текста щита и энергии игрока.
	ЗначениеЩита = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЩит);
	Форма.Элементы.HUD_ТекстЩита.Заголовок = Строка(ЗначениеЩита);
	ЗначениеЭнергии = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраЭнергия);
	Форма.Элементы.HUD_ТекстЭнергии.Заголовок = Строка(ЗначениеЭнергии);
	// Обновление текста щита противника.
	ЗначениеЩитаПротивника = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраЩит);
	Форма.Элементы.ДекорацияТекстЩитПротивника.Заголовок = Строка(ЗначениеЩитаПротивника);
	// Обновление индикатора серии.
	Форма.ОбновитьИндикаторСерии();
КонецПроцедуры		// ОбновитьИнтерфейсБоя()

// Обновляет 3 иконки индикатора серии по значению ЗарядСерии.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ОбновитьИндикаторСерии(Форма) Экспорт
	// Инициализация.
	КартинкаПусто = Новый Картинка;
	Попытка
		КартинкаПусто = БиблиотекаКартинок.ЗвездаСерая;
	Исключение
		КартинкаПусто = Неопределено;
	КонецПопытки;
	Попытка
		КартинкаЗаряд = БиблиотекаКартинок.Звезда;
	Исключение
		КартинкаЗаряд = Неопределено;
	КонецПопытки;
	// Установка картинок для каждой ячейки серии.
	Форма.Элементы.HUD_ЯчейкаСерии1.Картинка = ?(Форма.ЗарядСерии >= 1, КартинкаЗаряд, КартинкаПусто);
	Форма.Элементы.HUD_ЯчейкаСерии2.Картинка = ?(Форма.ЗарядСерии >= 2, КартинкаЗаряд, КартинкаПусто);
	Форма.Элементы.HUD_ЯчейкаСерии3.Картинка = ?(Форма.ЗарядСерии >= 3, КартинкаЗаряд, КартинкаПусто);
КонецПроцедуры		// ОбновитьИндикаторСерии()

#КонецОбласти
