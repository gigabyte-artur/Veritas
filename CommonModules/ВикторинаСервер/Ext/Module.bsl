// Возвращает предыдущее неверно отвеченное задание для повтора модификатором Маятник.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Функция ВернутьПредыдущееЗадание(Форма) Экспорт
	РезультатФункции = Новый Структура;
	Если ЗначениеЗаполнено(Форма.ПредыдущееЗадание) Тогда
		ПовторноеЗадание = Форма.ПредыдущееЗадание;
		Форма.ПредыдущееЗадание = Справочники.Задания.ПустаяСсылка();
		Форма.ЗагрузитьЗадание(ПовторноеЗадание);
		НовыйАдресКартинки = Форма.ВернутьАдресКартинки(ПовторноеЗадание);
		РезультатФункции.Вставить("Сборник", ПовторноеЗадание.Владелец);
		РезультатФункции.Вставить("Задание", ПовторноеЗадание);
		РезультатФункции.Вставить("АдресКартинки", НовыйАдресКартинки);
	Иначе
		РезультатФункции = Новый Структура;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		 // ВернутьПредыдущееЗадание()

// Возвращает случайное задание, заготовленное к повтору
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Функция ВернутьВопросКПовтору(Форма, Гсч) Экспорт
	РезультатФункции = Новый Структура;
	ВерхняяГраница = Форма.ВопросыКПовторениям.Количество();
	Если ВерхняяГраница > 0 Тогда
		ВыбранныйИндекс = Гсч.СлучайноеЧисло(0, ВерхняяГраница-1);
		СтрокаВопроса = Форма.ВопросыКПовторениям[ВыбранныйИндекс];
		НовоеЗадание = СтрокаВопроса.Вопрос;
		Форма.ЗагрузитьЗадание(НовоеЗадание);
		НовыйАдресКартинки = Форма.ВернутьАдресКартинки(НовоеЗадание);
		РезультатФункции.Вставить("Сборник", НовоеЗадание.Владелец);
		РезультатФункции.Вставить("Задание", НовоеЗадание);
		РезультатФункции.Вставить("АдресКартинки", НовыйАдресКартинки);
		Форма.ВопросыКПовторениям.Удалить(СтрокаВопроса);
	Иначе
		РезультатФункции = Новый Структура;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		 // ВернутьВопросКПовтору()

// Возвращает признак необходимости применить модификатор Маятник.
// Модификатор повторяет предыдущее неверно отвеченное задание с вероятностью 10%.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//	РежимВикториныВход - ПеречислениеСсылка.РежимыВикторины - текущий режим викторины.
//
// Возвращаемое значение:
//	Булево - Истина, если требуется повторить предыдущее задание.
//
Функция ТребуетсяПрименениеМаятника(Форма, Гсч, РежимВикториныВход) Экспорт
	РезультатФункции = ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(РежимВикториныВход)
		И ВосхождениеКлиентСервер.МодификаторАктивен(Форма, Справочники.Модификаторы.Маятник)
		И Гсч.СлучайноеЧисло(1, 100) <= 10
		И Форма.БылНеверныйОтвет;
	Возврат РезультатФункции;
КонецФункции		// ТребуетсяПрименениеМаятника()

// Возвращает признак необходимости применить модификатор ПотертыйСапог.
// Модификатор с вероятностью 20% оставляет вопрос в текущем сборнике.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
// Возвращаемое значение:
//	Булево - Истина, если требуется оставить вопрос в текущем сборнике.
//
Функция ТребуетсяПрименениеПотертогоСапога(Форма, Гсч) Экспорт
	РезультатФункции = ВосхождениеКлиентСервер.МодификаторАктивен(Форма, Справочники.Модификаторы.ПотертыйСапог)
		И Гсч.СлучайноеЧисло(1, 100) <= 20
		И Форма.БылВерныйОтвет;
	Возврат РезультатФункции;
КонецФункции		// ТребуетсяПрименениеПотертогоСапога()

// Загружает случайное задание из сборника СборникВход
// в режиме викторины РежимВикториныВход. Возвращает структуру,
// содержащую данные по заданию.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Функция СледующееЗадание_Сервер(Форма, Гсч, СборникВход, РежимВикториныВход = Неопределено) Экспорт
	РезультатФункции = Новый Структура;
	// Модификатор Маятник: повтор предыдущего неверно отвеченного задания.
	Если Форма.ТребуетсяПрименениеМаятника(РежимВикториныВход) Тогда
		РезультатФункции = Форма.ВернутьПредыдущееЗадание();
	Иначе
		ВыбранноеЧисло = Гсч.СлучайноеЧисло(1, 100);
		Если (ВыбранноеЧисло < Форма.ВероятностьПовтораНеправильного) И (Форма.ВопросыКПовторениям.Количество() > 0) Тогда
			РезультатФункции = Форма.ВернутьВопросКПовтору();
		Иначе
			Если РежимВикториныВход = Перечисления.РежимыВикторины.ОдинСборникБезОстановки Тогда
				РезультатФункции = Форма.ПолучитьДанныеЗаданияПоСборнику(СборникВход);
			ИначеЕсли РежимВикториныВход = Перечисления.РежимыВикторины.СлучайныйСборник Тогда
				НовыйСборник = Обработки.ТестированиеЗнаний.ПолучитьСлучайныйСборник(Форма.ВыбранныеСборники, Гсч);
				Форма.Сборник = НовыйСборник;
				РезультатФункции = Форма.ПолучитьДанныеЗаданияПоСборнику(НовыйСборник);
			ИначеЕсли РежимВикториныВход = Перечисления.РежимыВикторины.Восхождение Тогда
				Если Форма.ТребуетсяПрименениеПотертогоСапога() Тогда
					НовыйСборник = Форма.Сборник;
				Иначе
					НовыйСборник = Обработки.ТестированиеЗнаний.ПолучитьСлучайныйСборник(Форма.ВыбранныеСборники, Гсч);
				КонецЕсли;
				Форма.Сборник = НовыйСборник;
				РезультатФункции = Форма.ПолучитьДанныеЗаданияПоСборнику(НовыйСборник);
			Иначе
				РезультатФункции = Форма.ПолучитьДанныеЗаданияПоСборнику(СборникВход);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// Сбрасываем флаги ответа.
	Форма.БылНеверныйОтвет = Ложь;
	Форма.БылВерныйОтвет = Ложь;
	ВосхождениеКлиентСервер.УправлениеВидимостью(Форма);
	Возврат РезультатФункции;
КонецФункции		// СледующееЗадание_Сервер()

#КонецОбласти

#Область СохранениеЗагрузка

//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура СохранитьВосхождение_Сервер(Форма) Экспорт
	// Формируем структуру для сохранения данных восхождения
	ДанныеВосхождения = Новый Структура;
	ДанныеВосхождения.Вставить("ПараметрыИгрока", Форма.ПараметрыИгрока.Выгрузить());
	ДанныеВосхождения.Вставить("КолодаИгрока", Форма.КолодаИгрока.Выгрузить());
	ДанныеВосхождения.Вставить("Модификаторы", Форма.Модификаторы.Выгрузить());
	ДанныеВосхождения.Вставить("НомерЭтапа", Форма.НомерЭтапа);
	ДанныеВосхождения.Вставить("Противник", Форма.Противник);
	ДанныеВосхождения.Вставить("Персонаж", Форма.Персонаж);
	РегистрыСведений.СохраненияВосхождения.СохранитьВосхождениеПользователя(ДанныеВосхождения, Форма.ТекПользователь);
КонецПроцедуры		 // СохранитьВосхождение_Сервер()

// Соуществляет загрузку сохранения из хранилища значений ХранилищеВход
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	ХранилищеВход - ХранилищеЗначений - Хранилище, содержащее данные сохранения.
//
Процедура ЗагрузитьХранилищеСохранения(Форма, ХранилищеВход) Экспорт
	Если ХранилищеВход <> Неопределено Тогда
		СтруктураДанныхСохранения = ХранилищеВход.Получить();
		Если ТипЗнч(СтруктураДанныхСохранения) = Тип("Структура") Тогда
			// Считывание данных.
			НоваяКолодаИгрока		 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхСохранения, "КолодаИгрока", Новый ТаблицаЗначений);
			НовыеПараметрыИгрока	 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхСохранения, "ПараметрыИгрока", Новый ТаблицаЗначений);
			НовыеМодификаторы		 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхСохранения, "Модификаторы", Новый ТаблицаЗначений);
			НовыйНомерЭтапа			 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхСохранения, "НомерЭтапа", 1);
			НовыйПротивник			 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхСохранения, "Противник", Справочники.Противники.ПустаяСсылка());
			НовыйПерсонаж			 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДанныхСохранения, "Персонаж", Справочники.Персонажи.ПустаяСсылка());
			// Очистка таблиц.
			Форма.КолодаИгрока.Очистить();
			Форма.ПараметрыИгрока.Очистить();
			Форма.Модификаторы.Очистить();
			// Загрузка в данные формы.
			Форма.НомерЭтапа = НовыйНомерЭтапа;
			Форма.Противник = НовыйПротивник;
			Форма.Персонаж = НовыйПерсонаж;
			Форма.КолодаИгрока.Загрузить(НоваяКолодаИгрока);
			Форма.ПараметрыИгрока.Загрузить(НовыеПараметрыИгрока);
			Форма.Модификаторы.Загрузить(НовыеМодификаторы);
		Иначе
			Сообщить("Не удалось считать сохранение");
		КонецЕсли;
	Иначе
		Сообщить("Не удалось загрузить сохранение");
	КонецЕсли;
КонецПроцедуры		// ЗагрузитьХранилищеСохранения()

#КонецОбласти

#Область СлужебныеМетоды

// Помещает картинку задания ЗаданиеВход во временное хранилище и 
// возвращает его адрес.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Функция ВернутьАдресКартинки(Форма, ЗаданиеВход) Экспорт
	РезультатФункции = "";
	КартинкаХранилище = ЗаданиеВход.КартинкаЗадания;
	КартинкаЗначение = КартинкаХранилище.Получить();
	Если КартинкаЗначение <> Неопределено Тогда
		РезультатФункции = ПоместитьВоВременноеХранилище(КартинкаЗначение, Форма);
	Иначе
		Форма.Сборник = ЗаданиеВход.Владелец;
		КартинкаХранилище = Форма.Сборник.КартинкаСборника;
		КартинкаЗначение = КартинкаХранилище.Получить();
		Если КартинкаЗначение <> Неопределено Тогда
			РезультатФункции = ПоместитьВоВременноеХранилище(КартинкаЗначение, Форма);
		Иначе
			// Картинка не задана. Не загружаем.
		КонецЕсли;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ВернутьАдресКартинки()

#КонецОбласти
