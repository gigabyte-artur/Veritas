#Область ОтветыВикторины

// Возвращает массив номеров неправильных ответов, которые необходимо
// удалить для подсказки 50/50.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//  Гсч - ГенераторСлучайныхЧисел - генератор случайных чисел формы.
//
Функция ПолучитьМассивНеправильныхОтветовКУдалению(Форма, Гсч, НомерПравильногоОтветаВход, СборникВход) Экспорт
	РезультатФункции = Новый Массив;
	НовыйНомерПравильногоОтвета = ОбщегоНазначенияКлиентСервер.ПреобразоватьНомерПравильногоОтвета(НомерПравильногоОтветаВход, Форма.Сложность);
	Если Форма.Сложность = Перечисления.СложностиСборников.ШестьОтветов Тогда
		РезультатФункции = Обработки.ТестированиеЗнаний.ПолучитьМассивОтветовКУдалениюПоКоличеству(НомерПравильногоОтветаВход, Гсч, 6);
	ИначеЕсли Форма.Сложность = Перечисления.СложностиСборников.ЧетыреОтвета Тогда
		ВремРезультат = Обработки.ТестированиеЗнаний.ПолучитьМассивОтветовКУдалениюПоКоличеству(НомерПравильногоОтветаВход, Гсч, 4);
		Для Каждого ТекВремРезультат Из ВремРезультат Цикл
			НовыйНомер = ОбщегоНазначенияКлиентСервер.ПреобразоватьНомерПравильногоОтвета(ТекВремРезультат, Форма.Сложность);
			РезультатФункции.Добавить(НовыйНомер);
		КонецЦикла;	
	Иначе
		РезультатФункции = Новый Массив;
		ТекстСообщения = НСтр("ru = 'Неизвестный вариант сложности: %Сложность%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Сложность%", Строка(Форма.Сложность));
		Сообщить(ТекстСообщения);
	КонецЕсли;	
	Возврат РезультатФункции;
КонецФункции		// ПолучитьМассивНеправильныхОтветовКУдалению()

// загружает в элемент на форме ЭлементВход ответ номер НомерОтветаВход из масива МассивОтветовВход.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//	МассивОтветовВход - Массив - Массив, содержащий ответы на текущее задание.
//	НомерОтветаВход - Число - Номер текущего ответа.
//	ЭлементВход - ЭлементФормы - Элемент, куда будет загружен ответ.
//
Процедура ЗагрузитьОтветВЭлемент(Форма, МассивОтветовВход, НомерОтветаВход, ЭлементВход) Экспорт
	НовыйОтвет = "";
	ЗаголовокЭлемента = "";
	Если МассивОтветовВход.Количество() > НомерОтветаВход Тогда
		НовыйОтвет = СокрЛП(МассивОтветовВход[НомерОтветаВход]);
		//ЗаголовокЭлемента = Строка(НомерОтветаВход + 1) + ": " + НовыйОтвет;
		ЗаголовокЭлемента = НовыйОтвет;
	Иначе
		НовыйОтвет = "---";
		ЗаголовокЭлемента = "---";
	КонецЕсли;
	ЭлементВход.Заголовок = ЗаголовокЭлемента;
	НоваяСтрока = Форма.НомераОтветов.Добавить();
	НоваяСтрока.НомерОтвета = НомерОтветаВход + 1;
	НоваяСтрока.ТекстОтвета = НовыйОтвет;
КонецПроцедуры

// Отображает на форме задание и запоминает правильный ответ.
//
// Параметры:
//  Форма - Форма - форма обработки ТестированиеЗнаний, данные которой используются.
//
Процедура ЗагрузитьЗадание(Форма, ЗаданиеВход) Экспорт
	// Отображение текста вопроса.
	Форма.ВыбранноеЗадание = ЗаданиеВход;
	ЕстьПовторяющиеся = Истина;
	Счетчик = 0;
	Пока (ЕстьПовторяющиеся) И (Счетчик < 100) Цикл
		СтруктураВариантовОтветов = ВосхождениеСервер.ПолучитьВариантыОтветов(Форма.Сборник, Форма.РежимВикторины, ЗаданиеВход);	
		МассивОтветов = СтруктураВариантовОтветов.МассивОтветов;
		ЕстьПовторяющиеся = Обработки.ТестированиеЗнаний.ОпределитьПовторяющиесяОтветы(МассивОтветов);
		Счетчик = Счетчик + 1;
	КонецЦикла;
	Если МассивОтветов.Количество() > 0 Тогда
		Форма.НомерПравильногоОтвета = СтруктураВариантовОтветов.НомерПравильного;
		Если ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины) Тогда
			Форма.Сложность = Перечисления.СложностиСборников.ЧетыреОтвета;
		Иначе	
			Форма.Сложность = Форма.Сборник.Сложность;
		КонецЕсли;
		Форма.НомераОтветов.Очистить();
		Если Форма.Сложность = Перечисления.СложностиСборников.ШестьОтветов Тогда
			Форма.ЗагрузитьОтветВЭлемент(МассивОтветов, 5, Форма.Элементы.ВыбратьВариант6);
			Форма.ЗагрузитьОтветВЭлемент(МассивОтветов, 2, Форма.Элементы.ВыбратьВариант3);	
			Форма.ЗагрузитьОтветВЭлемент(МассивОтветов, 4, Форма.Элементы.ВыбратьВариант5);
			Форма.ЗагрузитьОтветВЭлемент(МассивОтветов, 3, Форма.Элементы.ВыбратьВариант4);
			Форма.ЗагрузитьОтветВЭлемент(МассивОтветов, 1, Форма.Элементы.ВыбратьВариант2);
			Форма.ЗагрузитьОтветВЭлемент(МассивОтветов, 0, Форма.Элементы.ВыбратьВариант1);
		ИначеЕсли Форма.Сложность = Перечисления.СложностиСборников.ЧетыреОтвета Тогда
			Форма.ЗагрузитьОтветВЭлемент(МассивОтветов, 3, Форма.Элементы.ВыбратьВариант5);
			Форма.ЗагрузитьОтветВЭлемент(МассивОтветов, 2, Форма.Элементы.ВыбратьВариант4);
			Форма.ЗагрузитьОтветВЭлемент(МассивОтветов, 1, Форма.Элементы.ВыбратьВариант2);
			Форма.ЗагрузитьОтветВЭлемент(МассивОтветов, 0, Форма.Элементы.ВыбратьВариант1);
		Иначе
			// Неизвестный вариант. Пропускаем.
		КонецЕсли;
		Форма.ПравильныйОтвет = МассивОтветов[Форма.НомерПравильногоОтвета-1];
		Форма.ПрименитьМодификаторыПриСобытии(ВосхождениеКлиентСервер.ПредставлениеСобытияФормы_ПриЗагрузкеЗадания());
		Форма.СохранитьВосхождение_Сервер();
	Иначе
		Сообщить("Не удалось загрузить ответы");
	КонецЕсли;
КонецПроцедуры

