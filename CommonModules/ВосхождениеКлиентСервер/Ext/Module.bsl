#Область ДействияПротивника

// Возвращает коэффициент сложности действий противника в зависимости от текущего этапа восхождения.
// Этапы 1–10: 0.75, этапы 11–20: 1.0, этапы 21–30: 1.25.
//
// Параметры:
//  НомерЭтапа - Число - номер текущего этапа восхождения.
//
// Возвращаемое значение:
//  Число — коэффициент сложности.
//
Функция ПолучитьКоэффициентСложностиПротивника(НомерЭтапа) Экспорт
	РезультатФункции = 0;
	Если НомерЭтапа <= 10 Тогда
		РезультатФункции = 0.75;
	ИначеЕсли НомерЭтапа <= 20 Тогда
		РезультатФункции = 1.0;
	Иначе
		РезультатФункции = 1.25;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПолучитьКоэффициентСложностиПротивника()

#КонецОбласти

#Область ЖурналБоя

// Добавляет запись в журнал боя.
//
// Параметры:
//  Форма - Форма - форма, в таблицу ЖурналБоя которой добавляется запись.
//  СобытиеВход - Строка - Описание события.
//  ОбъектВход - СправочникСсылка.Карты, ПеречислениеСсылка.ВариантыДействийПротивников - Связанный объект.
//  КоличествоВход - Число - Количество (по умолчанию 1).
//  Период - Дата - Дата и время события (по умолчанию ТекущаяДата()).
//
Процедура ДобавитьЗаписьВЖурналБоя(Форма, СобытиеВход, ОбъектВход, КоличествоВход = 1, Период = Неопределено) Экспорт
	// Инициализация.
	Если Период = Неопределено Тогда
		Период = ТекущаяДата();
	КонецЕсли;
	// Добавление строки.
	НоваяСтрока = Форма.ЖурналБоя.Добавить();
	НоваяСтрока.СобытиеБоя		 = СобытиеВход;
	НоваяСтрока.СвязанныйОбъект	 = ОбъектВход;
	НоваяСтрока.Количество		 = КоличествоВход;
	НоваяСтрока.Период			 = Период;
	// Сортировка.
	Форма.ЖурналБоя.Сортировать("Период убыв");
КонецПроцедуры

// Добавляет в журла боя информацию о том, что был применен модификатор МодификаторВход.
//
// Параметры:
//	Форма - Форма - форма, в таблицу ЖурналБоя которой добавляется запись.
//	МодификаторВход - СправочникСсылка.Модификаторы - Модификатор, который был применен.
//	КоличествоВход - Число - Размер эффекта модификатора.
//
Процедура ДобавитьДействиеМодификатораВЖурналБоя(Форма, МодификаторВход, КоличествоВход) Экспорт
	СобытиеПримененМодификатор = ПредопределенноеЗначение("Перечисление.СобытияБоя.ПримененМодификатор");
	ДобавитьЗаписьВЖурналБоя(Форма, СобытиеПримененМодификатор, МодификаторВход, КоличествоВход);
КонецПроцедуры		// ДобавитьДействиеМодификатораВЖурналБоя()

#КонецОбласти

#Область Бой

// Возвращает структуру данных наносимого противнику урона.
//
// Параметры:
//	КоличествоУронаВход - Число - количество урона, которое требуется нанести.
//	ЗначениеЩитаВход - Число - Текущее значение щита противника.
//
// Возвращаемое значение:
//	Структура - Структура, содержащая урон по щиту противника, урон по здоровью и новое значение здоровья.
//
Функция РассчитатьСтруктуруУронаПротивнику(КоличествоУронаВход, ЗначениеЩитаВход) Экспорт
	РезультатФункции = Новый Структура;
	ОстаточныйУрон = КоличествоУронаВход;
	НовоеЗначениеЩита = ЗначениеЩитаВход;
	УронПоЩиту = 0;
	// Проверка урона по щиту.
	Если ЗначениеЩитаВход > 0 Тогда
		Если ЗначениеЩитаВход >= КоличествоУронаВход Тогда
			ОстаточныйУрон = 0;
			НовоеЗначениеЩита = ЗначениеЩитаВход - КоличествоУронаВход;
			УронПоЩиту = КоличествоУронаВход;
		Иначе
			ОстаточныйУрон = КоличествоУронаВход - ЗначениеЩитаВход;
			НовоеЗначениеЩита = 0;
			УронПоЩиту = ЗначениеЩитаВход;
		КонецЕсли;
	Иначе
		// Щита нет, весь урон наносится по здоровью.
	КонецЕсли;
	РезультатФункции.Вставить("УронПоЩиту",			 УронПоЩиту);
	РезультатФункции.Вставить("УронПоЗдоровью",		 ОстаточныйУрон);
	РезультатФункции.Вставить("НовоеЗначениеЩита",	 НовоеЗначениеЩита);
	Возврат РезультатФункции;
КонецФункции		 // РассчитатьСтруктуруУронаПротивнику()

// Устанавливает текущее здоровье игрока в реквизит формы и обновляет цвет текста HUD.
// Цвет текста HUD_ТекстЗдоровьяИгрока плавно меняется по RGB:
// 0% здоровья — мягкий красный (255,64,64), 50% — мягкий оранжевый (255,165,64), 100% — мягкий зелёный (64,200,64).
//
// Параметры:
//  Форма - Форма - форма, реквизит ТекущееЗдоровьеИгрока которой обновляется.
//  КоличествоЗдоровьяВход - Число - новое значение здоровья игрока.
//
Процедура УстановитьТекущееЗдоровьеИгрока(Форма, КоличествоЗдоровьяВход) Экспорт
	Форма.ТекущееЗдоровьеИгрока = КоличествоЗдоровьяВход;
	Если Форма.МаксимальноеЗдоровьеИгрока > 0 Тогда
		Процент = (Форма.ТекущееЗдоровьеИгрока / Форма.МаксимальноеЗдоровьеИгрока) * 100;
		Если Процент <= 50 Тогда
			Красный = 255;
			Зеленый = Цел(64 + (Процент / 50) * 101);
			Синий = 64;
		Иначе
			Красный = Цел(255 - ((Процент - 50) / 50) * 191);
			Зеленый = Цел(165 + ((Процент - 50) / 50) * 35);
			Синий = 64;
		КонецЕсли;
		Форма.Элементы.HUD_ТекстЗдоровьяИгрока.ЦветТекста = Новый Цвет(Красный, Зеленый, Синий);
	Иначе
		// Максимальное здоровье не задано — цвет не обновляем.
	КонецЕсли;
КонецПроцедуры		// УстановитьТекущееЗдоровьеИгрока()

#КонецОбласти

#Область Интерфейс

// Управляет видимостью элементов на форме.
//
// Параметры:
//  Форма - Форма - форма, видимость элементов которой настраивается.
//
Процедура УправлениеВидимостью(Форма) Экспорт
	// Инициализация.
	СложностьШестьОтветов = ПредопределенноеЗначение("Перечисление.СложностиСборников.ШестьОтветов");
	СложностьЧетыреОтвета = ПредопределенноеЗначение("Перечисление.СложностиСборников.ЧетыреОтвета");
	ЭлементыФормы = Форма.Элементы;
	// Для режима Восхождение принудительно устанавливаем 4 ответа.
	Форма.Сложность = СложностьШестьОтветов;
	Если ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины) Тогда
		Форма.Сложность = СложностьЧетыреОтвета;
	Иначе
		Форма.Сложность = Форма.Сборник.Сложность;
	КонецЕсли;
	// Количество ответов.
	Если (НЕ ЗначениеЗаполнено(Форма.Сложность)) ИЛИ (Форма.Сложность = СложностьШестьОтветов) Тогда
		ЭлементыФормы.ВыбратьВариант3.Видимость = Истина;
		ЭлементыФормы.ВыбратьВариант6.Видимость = Истина;
	ИначеЕсли (Форма.Сложность = СложностьЧетыреОтвета) Тогда
		ЭлементыФормы.ВыбратьВариант3.Видимость = Ложь;
		ЭлементыФормы.ВыбратьВариант6.Видимость = Ложь;	
	Иначе
		ЭлементыФормы.ВыбратьВариант3.Видимость = Ложь;
		ЭлементыФормы.ВыбратьВариант6.Видимость = Ложь;
	КонецЕсли;	
	// Не показывать пустой вопрос.
	ВыбранноеЗадание = Форма.ВыбранноеЗадание;
	ТекстВыбранногоЗадания = СокрЛП(ВыбранноеЗадание.ТекстВопросаЗадания);
	ПустоеЗадание = (ТекстВыбранногоЗадания = "" ИЛИ ТекстВыбранногоЗадания = "-");
	ЭлементыФормы.ЗаданиеТекстВопросаЗадания.Видимость = НЕ ПустоеЗадание;
	ЭлементыФормы.УбратьНевернуюПоловину.Доступность = НЕ Форма.НеверныеВариантыУбраны;
	// Скрывать подсказки для режима Восхождение.
	ЭтоРежимВосхождение = ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(Форма.РежимВикторины);
	ЭлементыФормы.ГруппаПодменюПодсказки.Видимость = НЕ (ЭтоРежимВосхождение);
	// Отображение HUD и зон боя только в режиме Восхождение.
	ЭлементыФормы.HUD_Верх.Видимость = ЭтоРежимВосхождение;
	ЭлементыФормы.Рука_Карт.Видимость = ЭтоРежимВосхождение;
	// Отображение элемента СледующееДействиеПротивника только в режиме Восхождение (через HUD).
	ЭлементыФормы.HUD_ТекстНамерения.Видимость = ЭтоРежимВосхождение;
	// Отображение группы ГруппаРезультаты только когда не выбран режим Восхождение.
	ЭлементыФормы.ГруппаРезультаты.Видимость = НЕ ЭтоРежимВосхождение;
КонецПроцедуры		// УправлениеВидимостью()

#КонецОбласти

#Область ПараметрыИгрока

// Получает значение параметра игрока из таблицы ПараметрыИгрока по виду параметра.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  ВидПараметраВход - ПеречислениеСсылка.ВидыПараметровИгроков - вид параметра для поиска.
//
// Возвращаемое значение:
//  Число - значение параметра игрока, или 0 если параметр не найден.
//
Функция ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраВход) Экспорт
	РезультатФункции = 0;
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ВидПараметра", ВидПараметраВход);
	НайденныеСтроки = Форма.ПараметрыИгрока.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		РезультатФункции = НайденныеСтроки[0].ЗначениеПараметра;
	Иначе
		РезультатФункции = 0;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПолучитьЗначениеПараметраИгрока()

// Получает значение параметра противника из таблицы ПараметрыПротивника по виду параметра.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//  ВидПараметраВход - ПеречислениеСсылка.ВидыПараметровИгроков - вид параметра для поиска.
//
// Возвращаемое значение:
//  Число - значение параметра противника, или 0 если параметр не найден.
//
Функция ПолучитьЗначениеПараметраПротивника(Форма, ВидПараметраВход) Экспорт
	РезультатФункции = 0;
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ВидПараметра", ВидПараметраВход);
	НайденныеСтроки = Форма.ПараметрыПротивника.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		РезультатФункции = НайденныеСтроки[0].ЗначениеПараметра;
	Иначе
		РезультатФункции = 0;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПолучитьЗначениеПараметраПротивника()

// Возвращает максимальное здоровье игрока.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//
// Возвращаемое значение:
//  Число - максимальное здоровье игрока.
//
Функция ПолучитьМаксимальноеЗдоровьеИгрока(Форма) Экспорт
	ВидПараметраМаксимальноеЗдоровье = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.МаксимальноеЗдоровье");
	РезультатФункции = ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраМаксимальноеЗдоровье);
	Возврат РезультатФункции;
КонецФункции		// ПолучитьМаксимальноеЗдоровьеИгрока()

// Возвращает признак наличия проклятия у игрока.
// Проверяет таблицу ПараметрыИгрока на наличие параметра Проклятие со значением больше 0.
//
// Параметры:
//  Форма - Форма - форма, с данными которой работает метод.
//
// Возвращаемое значение:
//  Булево - Истина, если проклятие активно, Ложь в противном случае.
//
Функция ЕстьПроклятиеУИгрока(Форма) Экспорт
	ВидПараметраПроклятие = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Проклятие");
	ЗначениеПроклятия = ПолучитьЗначениеПараметраИгрока(Форма, ВидПараметраПроклятие);
	РезультатФункции = ЗначениеПроклятия > 0;
	Возврат РезультатФункции;
КонецФункции		// ЕстьПроклятиеУИгрока()

#КонецОбласти
