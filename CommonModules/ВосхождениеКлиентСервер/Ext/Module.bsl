#Область Модификаторы

// Возвращает признак активности модификатора МодификаторВход в таблице Модификаторы.
//
// Параметры:
//  Форма - Форма - форма, в таблице Модификаторы которой выполняется поиск.
//  МодификаторВход - СправочникСсылка.Модификаторы - модификатор для проверки.
//
// Возвращаемое значение:
//  Булево - Истина, если модификатор активен, Ложь в противном случае.
//
Функция МодификаторАктивен(Форма, МодификаторВход) Экспорт
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Модификатор", МодификаторВход);
	НайденныеСтроки = Форма.Модификаторы.НайтиСтроки(СтруктураПоиска);
	РезультатФункции = НайденныеСтроки.Количество() > 0;
	Возврат РезультатФункции;
КонецФункции		// МодификаторАктивен()

#КонецОбласти

#Область ПараметрыИгры

// Устанавливает значение параметра игры. Если параметр с таким видом уже существует — обновляет.
//
// Параметры:
//  Форма - Форма - форма, в таблице ПараметрыИгры которой устанавливается значение.
//  ВидПараметраВход - ПеречислениеСсылка.ВидыПараметровИгроков - вид параметра.
//  ЗначениеВход - Число - значение параметра.
//
Процедура УстановитьПараметрИгры(Форма, ВидПараметраВход, ЗначениеВход) Экспорт
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ВидПараметра", ВидПараметраВход);
	НайденныеСтроки = Форма.ПараметрыИгры.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		НайденныеСтроки[0].ЗначениеПараметра = ЗначениеВход;
	Иначе
		НоваяСтрока = Форма.ПараметрыИгры.Добавить();
		НоваяСтрока.ВидПараметра = ВидПараметраВход;
		НоваяСтрока.ЗначениеПараметра = ЗначениеВход;
	КонецЕсли;
КонецПроцедуры		// УстановитьПараметрИгры()

#КонецОбласти

#Область Карты

// Перемещает карту с указанным ИдентификаторКарты из стопки-источника в стопку-приёмник.
//
// Параметры:
//  ИдентификаторКарты - УникальныйИдентификатор - идентификатор карты для перемещения.
//  СтопкаИсточникИмя - Строка - имя таблицы формы, из которой будет удалена карта.
//  СтопкаПриемникИмя - Строка - имя таблицы формы, в которую будет добавлена копия карты.
//  Форма - Форма - форма, в таблицах которой выполняется перемещение.
//
// Возвращаемое значение:
//  Булево - Истина, если карта была перемещена.
//
Функция ПереместиКартуИзСтопки(ИдентификаторКарты, СтопкаИсточникИмя, СтопкаПриемникИмя, Форма) Экспорт
	РезультатФункции = Ложь;
	СтруктураПоиска = Новый Структура("ИдентификаторКарты", ИдентификаторКарты);
	НайденныеСтроки = Форма[СтопкаИсточникИмя].НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		СтрокаКарты = НайденныеСтроки[0];
		НоваяСтрока = Форма[СтопкаПриемникИмя].Добавить();
		НоваяСтрока.Карта = СтрокаКарты.Карта;
		НоваяСтрока.ИдентификаторКарты = СтрокаКарты.ИдентификаторКарты;
		Форма[СтопкаИсточникИмя].Удалить(СтрокаКарты);
		РезультатФункции = Истина;
	Иначе
		// Карта не найдена в стопке-источнике. Перемещение не выполняется.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПереместиКартуИзСтопки()

#КонецОбласти

#Область ОтветыВикторины

// Блокирует команды с неверными ответами по номерам массива МассивНеверных.
//
// Параметры:
//  МассивНеверных - Массив - номера неверных вариантов ответа.
//  Форма - Форма - форма, команды которой блокируются.
//
Процедура УбратьНеверныеОтветы(МассивНеверных, Форма) Экспорт
	Если МассивНеверных.Найти(1) <> Неопределено Тогда
		Форма.Элементы.ВыбратьВариант1.Доступность = Ложь;
	КонецЕсли;
	Если МассивНеверных.Найти(2) <> Неопределено Тогда
		Форма.Элементы.ВыбратьВариант2.Доступность = Ложь;
	КонецЕсли;
	Если МассивНеверных.Найти(3) <> Неопределено Тогда
		Форма.Элементы.ВыбратьВариант3.Доступность = Ложь;
	КонецЕсли;
	Если МассивНеверных.Найти(4) <> Неопределено Тогда
		Форма.Элементы.ВыбратьВариант4.Доступность = Ложь;
	КонецЕсли;
	Если МассивНеверных.Найти(5) <> Неопределено Тогда
		Форма.Элементы.ВыбратьВариант5.Доступность = Ложь;
	КонецЕсли;
	Если МассивНеверных.Найти(6) <> Неопределено Тогда
		Форма.Элементы.ВыбратьВариант6.Доступность = Ложь;
	КонецЕсли;
КонецПроцедуры		// УбратьНеверныеОтветы()

