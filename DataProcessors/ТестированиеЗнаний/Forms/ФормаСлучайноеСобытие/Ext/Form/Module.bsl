&НаКлиенте
Перем ПодтвержденоЗакрытиеФормы;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Инициализация.
	СлучайноеСобытие = Справочники.СлучайныеСобытия.ПустаяСсылка();
	// Получение переданного события.
	Если Параметры.Свойство("СлучайноеСобытие") Тогда
		ПереданноеСобытие = Параметры.СлучайноеСобытие;
		Если ЗначениеЗаполнено(ПереданноеСобытие) Тогда
			СлучайноеСобытие = ПереданноеСобытие;
		Иначе
			// Переданная ссылка пустая. Реквизит остаётся пустым.
		КонецЕсли;
	Иначе
		// Параметр не передан. Форма отображается пустой.
	КонецЕсли;
	// Загрузка данных события на форму.
	ДанныеСобытия = ПрочитатьДанныеСобытия(СлучайноеСобытие);
	ЗаголовокСобытия = ДанныеСобытия.Заголовок;
	ОписаниеСобытия = ДанныеСобытия.Описание;
	ЗаполнитьКнопкиВариантов(ДанныеСобытия.Варианты);
КонецПроцедуры

// Возвращает данные события из справочника СлучайныеСобытия для отображения на форме.
//
// Параметры:
//  СобытиеВход - СправочникСсылка.СлучайныеСобытия - событие, данные которого требуется загрузить.
//
// Возвращаемое значение:
//  Структура - данные события:
//   * Заголовок - Строка - наименование события.
//   * Описание  - Строка - описание события.
//   * Варианты  - Массив - варианты выбора; элементы - структуры с ключами НомерВарианта, ОписаниеВарианта.
//
&НаСервереБезКонтекста
Функция ПрочитатьДанныеСобытия(СобытиеВход)
	// Инициализация.
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("Заголовок", "");
	РезультатФункции.Вставить("Описание", "");
	РезультатФункции.Вставить("Варианты", Новый Массив);
	Если ЗначениеЗаполнено(СобытиеВход) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
			|	СлучайныеСобытия.Наименование КАК Наименование,
			|	СлучайныеСобытия.Описание КАК Описание,
			|	ЕСТЬNULL(ВариантыВыбора.НомерВарианта, 0) КАК НомерВарианта,
			|	ВариантыВыбора.ОписаниеВарианта КАК ОписаниеВарианта
			|ИЗ
			|	Справочник.СлучайныеСобытия КАК СлучайныеСобытия
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СлучайныеСобытия.ВариантыВыбора КАК ВариантыВыбора
			|		ПО СлучайныеСобытия.Ссылка = ВариантыВыбора.Ссылка
			|ГДЕ
			|	СлучайныеСобытия.Ссылка = &Событие
			|УПОРЯДОЧИТЬ ПО
			|	НомерВарианта";
		Запрос.УстановитьПараметр("Событие", СобытиеВход);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		ЭтоПерваяСтрока = Истина;
		Пока Выборка.Следующий() Цикл
			Если ЭтоПерваяСтрока Тогда
				РезультатФункции.Заголовок = Выборка.Наименование;
				РезультатФункции.Описание = Выборка.Описание;
				ЭтоПерваяСтрока = Ложь;
			Иначе
				// Поля события уже прочитаны из первой строки. Повторно не заполняем.
			КонецЕсли;
			ЭтоЕстьВариант = (Выборка.НомерВарианта > 0);
			Если ЭтоЕстьВариант Тогда
				НовыйВариант = Новый Структура;
				НовыйВариант.Вставить("НомерВарианта", Выборка.НомерВарианта);
				НовыйВариант.Вставить("ОписаниеВарианта", Выборка.ОписаниеВарианта);
				РезультатФункции.Варианты.Добавить(НовыйВариант);
			Иначе
				// У события нет варианта выбора с таким номером. Строка пропускается.
			КонецЕсли;
		КонецЦикла;
	Иначе
		// Ссылка на событие не заполнена. Данные остаются пустыми.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ПрочитатьДанныеСобытия()

// Размещает варианты выбора события на кнопках формы Вариант1 - Вариант6.
// Незаполненные кнопки скрываются.
//
// Параметры:
//  ВариантыВход - Массив - варианты выбора; элементы - структуры с ключами НомерВарианта, ОписаниеВарианта.
//
&НаСервере
Процедура ЗаполнитьКнопкиВариантов(ВариантыВход)
	// Инициализация.
	МаксимальноеКоличествоВариантов = 6;
	// Скрытие всех кнопок вариантов.
	Для НомерКнопки = 1 По МаксимальноеКоличествоВариантов Цикл
		ЭлементКнопки = Элементы.Найти("Вариант" + Строка(НомерКнопки));
		Если ЭлементКнопки <> Неопределено Тогда
			ЭлементКнопки.Видимость = Ложь;
		Иначе
			// Кнопка варианта отсутствует на форме. Пропускаем.
		КонецЕсли;
	КонецЦикла;
	// Показ кнопок для заполненных вариантов.
	Для Каждого ТекВариант Из ВариантыВход Цикл
		НомерВарианта = ТекВариант.НомерВарианта;
		ЭтоДопустимыйНомер = (НомерВарианта >= 1) И (НомерВарианта <= МаксимальноеКоличествоВариантов);
		Если ЭтоДопустимыйНомер Тогда
			ЭлементКнопки = Элементы.Найти("Вариант" + Строка(НомерВарианта));
			Если ЭлементКнопки <> Неопределено Тогда
				ЭлементКнопки.Заголовок = ТекВариант.ОписаниеВарианта;
				ЭлементКнопки.Видимость = Истина;
			Иначе
				// Кнопка варианта отсутствует на форме. Пропускаем.
			КонецЕсли;
		Иначе
			// Номер варианта вне диапазона кнопок. Пропускаем.
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры		// ЗаполнитьКнопкиВариантов()

// Передаёт вызывающей форме выбранный вариант случайного события.
//
// Параметры:
//  НомерВариантаВход - Число - номер выбранного варианта события.
//
&НаКлиенте
Процедура ВыбратьВариант(НомерВариантаВход)
	// Инициализация.
	РезультатВыбора = Новый Структура;
	РезультатВыбора.Вставить("СлучайноеСобытие", СлучайноеСобытие);
	РезультатВыбора.Вставить("НомерВарианта", НомерВариантаВход);
	// Возврат выбора вызывающей форме.
	ПодтвержденоЗакрытиеФормы = Истина;
	Закрыть(РезультатВыбора);
КонецПроцедуры		// ВыбратьВариант()

&НаКлиенте
Процедура Вариант1(Команда)
	ВыбратьВариант(1);
КонецПроцедуры		// Вариант1()

&НаКлиенте
Процедура Вариант2(Команда)
	ВыбратьВариант(2);
КонецПроцедуры		// Вариант2()

&НаКлиенте
Процедура Вариант3(Команда)
	ВыбратьВариант(3);
КонецПроцедуры		// Вариант3()

&НаКлиенте
Процедура Вариант4(Команда)
	ВыбратьВариант(4);
КонецПроцедуры		// Вариант4()

&НаКлиенте
Процедура Вариант5(Команда)
	ВыбратьВариант(5);
КонецПроцедуры		// Вариант5()

&НаКлиенте
Процедура Вариант6(Команда)
	ВыбратьВариант(6);
КонецПроцедуры		// Вариант6()

// Блокирует закрытие формы, пока вариант события не выбран.
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если Не ЗавершениеРаботы И Не ПодтвержденоЗакрытиеФормы Тогда
		Отказ = Истина;
	Иначе
		// Закрытие формы разрешено. Отказ не устанавливается.
	КонецЕсли;
КонецПроцедуры

ПодтвержденоЗакрытиеФормы = Ложь;
