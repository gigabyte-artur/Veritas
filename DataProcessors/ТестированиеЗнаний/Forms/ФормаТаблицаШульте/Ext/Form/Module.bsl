// Обрабатывает нажатие на кнопку опции.
//
// Параметры:
//  НомерЯчейкиВход - Число - номер ячейки (от 1 до 25).
//
&НаКлиенте
Процедура ОбработатьНажатиеОпции(НомерЯчейкиВход)
	Если НЕ ТаймерЗапущен Тогда
		ПодключитьОбработчикОжидания("ТикТаймера", 1, Истина);
		ТаймерЗапущен = Истина;
	Иначе
		// Таймер уже запущен.
	КонецЕсли;
	РезультатНажатия = ОбработатьНажатиеНаСервере(НомерЯчейкиВход);
	Если РезультатНажатия.ЗавершитьИгру Тогда
		ЗавершитьИгру(РезультатНажатия.Победа);
	Иначе
		// Игра продолжается.
	КонецЕсли;
КонецПроцедуры

// Выполняет логику нажатия на ячейку на сервере и возвращает результат для отображения.
//
// Параметры:
//  НомерЯчейкиВход - Число - номер ячейки (от 1 до 25).
//
// Возвращаемое значение:
//  Структура - поля: ЗавершитьИгру, Победа.
//
&НаСервере
Функция ОбработатьНажатиеНаСервере(Знач НомерЯчейкиВход)
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("ЗавершитьИгру", Ложь);
	РезультатФункции.Вставить("Победа", Ложь);
	ЧислоВЯчейке = Поле[НомерЯчейкиВход - 1].Число;
	Если ЧислоВЯчейке = СледующееЧисло Тогда
		// Число найдено. Деактивируем ячейку и переходим к следующему числу.
		ДеактивироватьОпцию(НомерЯчейкиВход);
		СледующееЧисло = СледующееЧисло + 1;
		Если СледующееЧисло > ВсегоЧисел Тогда
			РезультатФункции.ЗавершитьИгру = Истина;
			РезультатФункции.Победа = Истина;
		Иначе
			// Игра продолжается.
		КонецЕсли;
	Иначе
		// Нажато неверное число. Учитываем ошибку.
		СделаноОшибок = СделаноОшибок + 1;
		ОбновитьСчетчики();
		Если СделаноОшибок > ДопустимоОшибок Тогда
			РезультатФункции.ЗавершитьИгру = Истина;
			РезультатФункции.Победа = Ложь;
		Иначе
			// Ошибка допустима. Игра продолжается.
		КонецЕсли;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции

// Завершает мини-игру и возвращает результат владельцу формы.
//
// Параметры:
//  ЭтоПобеда - Булево - Истина, если игра завершена победой.
//
&НаКлиенте
Процедура ЗавершитьИгру(ЭтоПобеда)
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("Победа", ЭтоПобеда);
	ПодтвержденоЗакрытиеФормы = Истина;
	Закрыть(СтруктураРезультата);
КонецПроцедуры

// Обрабатывает команду "Сдаться": запрашивает подтверждение и при согласии завершает этап поражением.
//
&НаКлиенте
Процедура Сдаться(Команда)
	ТекстВопроса = НСтр("ru = 'Сдаться и завершить этап поражением?'");
	ПоказатьВопрос(Новый ОписаниеОповещения("СдатьсяЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

// Обрабатывает ответ на вопрос о сдаче.
//
// Параметры:
//  Ответ                   - КодВозвратаДиалога - выбранный вариант ответа.
//  ДополнительныеПараметры - Произвольный - дополнительные параметры оповещения.
//
&НаКлиенте
Процедура СдатьсяЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗавершитьИгру(Ложь);
	Иначе
		// Игрок отказался сдаваться. Продолжаем игру.
	КонецЕсли;
КонецПроцедуры

// Блокирует закрытие формы, пока игра не завершена.
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если Не ЗавершениеРаботы И Не ПодтвержденоЗакрытиеФормы Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

ПодтвержденоЗакрытиеФормы = Ложь;
