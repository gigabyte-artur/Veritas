&НаСервере
Перем Гсч;

&НаКлиенте
Перем ПодтвержденоЗакрытиеФормы;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Инициализация.
	Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	ВсегоЧисел = 25;
	ДопустимоОшибок = 2;
	СледующееЧисло = 1;
	СделаноОшибок = 0;
	ОсталосьВремени = 50;
	// Подготовка игрового поля.
	СформироватьПолеИгры();
	ОбновитьОтображение();
	ОбновитьСчетчики();
КонецПроцедуры

// Заполняет поле числами от 1 до 25 и перемешивает их случайным образом.
//
&НаСервере
Процедура СформироватьПолеИгры()
	МассивЧисел = Новый Массив;
	Для Сч = 1 По ВсегоЧисел Цикл
		МассивЧисел.Добавить(Сч);
	КонецЦикла;
	МассивЧисел = ОбщегоНазначенияКлиентСервер.СмешатьМассив(МассивЧисел, Гсч);
	Поле.Очистить();
	Для Сч = 1 По ВсегоЧисел Цикл
		НоваяСтрока = Поле.Добавить();
		НоваяСтрока.НомерЯчейки = Сч;
		НоваяСтрока.Число = МассивЧисел[Сч - 1];
	КонецЦикла;
КонецПроцедуры

// Возвращает элемент кнопки опции по номеру ячейки.
//
// Параметры:
//  НомерЯчейкиВход - Число - номер ячейки (от 1 до 25).
//
// Возвращаемое значение:
//  ЭлементФормы - элемент кнопки опции.
//
&НаСервере
Функция ПолучитьЭлементОпции(НомерЯчейкиВход)
	ИмяЭлемента = "Опция" + Строка(НомерЯчейкиВход);
	Возврат Элементы[ИмяЭлемента];
КонецФункции

// Обновляет заголовки кнопок поля числами из таблицы.
//
&НаСервере
Процедура ОбновитьОтображение()
	Для НомерЯчейки = 1 По ВсегоЧисел Цикл
		ЧислоВЯчейке = Поле[НомерЯчейки - 1].Число;
		ЭлементОпции = ПолучитьЭлементОпции(НомерЯчейки);
		ЭлементОпции.Заголовок = Строка(ЧислоВЯчейке);
	КонецЦикла;
КонецПроцедуры

// Обновляет текстовые реквизиты счётчиков времени и ошибок.
//
&НаСервере
Процедура ОбновитьСчетчики()
	ТекстВремени = "Время: " + Строка(ОсталосьВремени) + " с";
	ТекстОшибок = "Ошибки: " + Строка(СделаноОшибок) + "/" + Строка(ДопустимоОшибок);
КонецПроцедуры

// Деактивирует кнопку найденной опции и заменяет её заголовок на пробел.
//
// Параметры:
//  НомерЯчейкиВход - Число - номер ячейки (от 1 до 25).
//
&НаСервере
Процедура ДеактивироватьОпцию(НомерЯчейкиВход)
	ЭлементОпции = ПолучитьЭлементОпции(НомерЯчейкиВход);
	ЭлементОпции.Доступность = Ложь;
	ЭлементОпции.Заголовок = " ";
КонецПроцедуры

// Запускает таймер отсчёта времени при открытии формы.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)

КонецПроцедуры

// Выполняет один шаг таймера: уменьшает оставшееся время на 1 секунду.
// При достижении нуля завершает игру поражением.
//
&НаКлиенте
Процедура ТикТаймера()
	ОсталосьВремени = ОсталосьВремени - 1;
	ТекстВремени = "Время: " + Строка(ОсталосьВремени) + " с";
	Если ОсталосьВремени <= 0 Тогда
		ЗавершитьИгру(Ложь);
	Иначе
		ПодключитьОбработчикОжидания("ТикТаймера", 1, Истина);
	КонецЕсли;
КонецПроцедуры

