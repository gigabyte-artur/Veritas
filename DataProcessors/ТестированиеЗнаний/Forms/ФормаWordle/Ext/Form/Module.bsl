&НаСервере
Перем Гсч;

&НаКлиенте
Перем ПодтвержденоЗакрытиеФормы;

// Заменяет букву "ё" на "е" в слове для единообразия сравнения.
// Словари содержат слова как с "ё", так и с "е" (например, "актёр" и "актер"),
// поэтому перед сверкой слово приводится к единому написанию.
//
// Параметры:
//  СловоВход - Строка - слово для нормализации.
//
// Возвращаемое значение:
//  Строка - слово, в котором все буквы "ё" заменены на "е".
//
&НаКлиентеНаСервереБезКонтекста
Функция НормализоватьСлово(СловоВход)
	Возврат СтрЗаменить(СловоВход, "ё", "е");
КонецФункции // НормализоватьСлово()

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Инициализация.
	Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	ЗагрузитьСловарьПроверки();
	НомерТекущейСтроки = 1;
	// Загрузка загаданного слова и подготовка отображения строк.
	ЗагаданноеСлово = ПолучитьСлучайноеСлово();
	ОбновитьОтображениеСтрок();
КонецПроцедуры

// Возвращает случайное слово из общего макета СловарьМалый.
//
// Возвращаемое значение:
//  Строка - случайное слово из словаря. Пустая строка, если словарь пуст.
//
&НаСервере
Функция ПолучитьСлучайноеСлово()
	РезультатФункции = "";
	МакетСловаря = ПолучитьОбщийМакет("СловарьМалый");
	КоличествоСлов = МакетСловаря.ВысотаТаблицы;
	Если КоличествоСлов = 0 Тогда
		Возврат РезультатФункции;
	Иначе
		// Словарь не пуст. Выбираем случайную строку.
	КонецЕсли;
	НомерСлучайнойСтроки = Гсч.СлучайноеЧисло(1, КоличествоСлов);
	ТекстЯчейки = МакетСловаря.Область("R" + Строка(НомерСлучайнойСтроки) + "C1").Текст;
	РезультатФункции = НормализоватьСлово(ТекстЯчейки);
	Возврат РезультатФункции;
КонецФункции // ПолучитьСлучайноеСлово()

// Загружает словарь СловарьБольшой в список СловарьПроверки для быстрой проверки слов.
//
&НаСервере
Процедура ЗагрузитьСловарьПроверки()
	МакетСловаря = ПолучитьОбщийМакет("СловарьБольшой");
	Для НомерСтроки = 1 По МакетСловаря.ВысотаТаблицы Цикл
		ТекстЯчейки = МакетСловаря.Область("R" + Формат(НомерСтроки, "ЧГ=") + "C1").Текст;
		СловарьПроверки.Добавить(НормализоватьСлово(ТекстЯчейки));
	КонецЦикла;
КонецПроцедуры // ЗагрузитьСловарьПроверки()

// Обновляет отображение строк игрового поля.
// В активной строке видны поля ввода, в прошедших - декорации с буквами, в будущих - декорации с пробелом.
//
&НаСервере
Процедура ОбновитьОтображениеСтрок()
	Для НомерСтроки = 1 По 6 Цикл
		Для НомерКолонки = 1 По 5 Цикл
			ИмяПоля = "Поле" + Строка(НомерСтроки) + Строка(НомерКолонки);
			ИмяДекорации = "Декорация" + Строка(НомерСтроки) + Строка(НомерКолонки);
			Если НомерСтроки = НомерТекущейСтроки Тогда
				Элементы[ИмяПоля].Видимость = Истина;
				Элементы[ИмяДекорации].Видимость = Ложь;
			ИначеЕсли НомерСтроки < НомерТекущейСтроки Тогда
				Элементы[ИмяПоля].Видимость = Ложь;
				Элементы[ИмяДекорации].Видимость = Истина;
			Иначе
				Элементы[ИмяПоля].Видимость = Ложь;
				Элементы[ИмяДекорации].Заголовок = " ";
				Элементы[ИмяДекорации].Видимость = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры // ОбновитьОтображениеСтрок()

// Читает пять букв указанной строки в массив.
//
// Параметры:
//  НомерСтрокиВход - Число - номер строки (от 1 до 6).
//
// Возвращаемое значение:
//  Массив - пять значений полей строки (индекс 0 соответствует первой колонке).
//
&НаКлиенте
Функция ПрочитатьБуквыСтроки(НомерСтрокиВход)
	РезультатФункции = Новый Массив(5);
	Если НомерСтрокиВход = 1 Тогда
		РезультатФункции[0] = Поле11;
		РезультатФункции[1] = Поле12;
		РезультатФункции[2] = Поле13;
		РезультатФункции[3] = Поле14;
		РезультатФункции[4] = Поле15;
	ИначеЕсли НомерСтрокиВход = 2 Тогда
		РезультатФункции[0] = Поле21;
		РезультатФункции[1] = Поле22;
		РезультатФункции[2] = Поле23;
		РезультатФункции[3] = Поле24;
		РезультатФункции[4] = Поле25;
	ИначеЕсли НомерСтрокиВход = 3 Тогда
		РезультатФункции[0] = Поле31;
		РезультатФункции[1] = Поле32;
		РезультатФункции[2] = Поле33;
		РезультатФункции[3] = Поле34;
		РезультатФункции[4] = Поле35;
	ИначеЕсли НомерСтрокиВход = 4 Тогда
		РезультатФункции[0] = Поле41;
		РезультатФункции[1] = Поле42;
		РезультатФункции[2] = Поле43;
		РезультатФункции[3] = Поле44;
		РезультатФункции[4] = Поле45;
	ИначеЕсли НомерСтрокиВход = 5 Тогда
		РезультатФункции[0] = Поле51;
		РезультатФункции[1] = Поле52;
		РезультатФункции[2] = Поле53;
		РезультатФункции[3] = Поле54;
		РезультатФункции[4] = Поле55;
	Иначе
		РезультатФункции[0] = Поле61;
		РезультатФункции[1] = Поле62;
		РезультатФункции[2] = Поле63;
		РезультатФункции[3] = Поле64;
		РезультатФункции[4] = Поле65;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции // ПрочитатьБуквыСтроки()

// Записывает пять букв из массива в поля указанной строки.
//
// Параметры:
//  НомерСтрокиВход - Число - номер строки (от 1 до 6).
//  БуквыВход - Массив - пять значений (индекс 0 соответствует первой колонке).
//
&НаКлиенте
Процедура ЗаписатьБуквыСтроки(НомерСтрокиВход, БуквыВход)
	Если НомерСтрокиВход = 1 Тогда
		Поле11 = БуквыВход[0];
		Поле12 = БуквыВход[1];
		Поле13 = БуквыВход[2];
		Поле14 = БуквыВход[3];
		Поле15 = БуквыВход[4];
	ИначеЕсли НомерСтрокиВход = 2 Тогда
		Поле21 = БуквыВход[0];
		Поле22 = БуквыВход[1];
		Поле23 = БуквыВход[2];
		Поле24 = БуквыВход[3];
		Поле25 = БуквыВход[4];
	ИначеЕсли НомерСтрокиВход = 3 Тогда
		Поле31 = БуквыВход[0];
		Поле32 = БуквыВход[1];
		Поле33 = БуквыВход[2];
		Поле34 = БуквыВход[3];
		Поле35 = БуквыВход[4];
	ИначеЕсли НомерСтрокиВход = 4 Тогда
		Поле41 = БуквыВход[0];
		Поле42 = БуквыВход[1];
		Поле43 = БуквыВход[2];
		Поле44 = БуквыВход[3];
		Поле45 = БуквыВход[4];
	ИначеЕсли НомерСтрокиВход = 5 Тогда
		Поле51 = БуквыВход[0];
		Поле52 = БуквыВход[1];
		Поле53 = БуквыВход[2];
		Поле54 = БуквыВход[3];
		Поле55 = БуквыВход[4];
	Иначе
		Поле61 = БуквыВход[0];
		Поле62 = БуквыВход[1];
		Поле63 = БуквыВход[2];
		Поле64 = БуквыВход[3];
		Поле65 = БуквыВход[4];
	КонецЕсли;
КонецПроцедуры // ЗаписатьБуквыСтроки()

// Собирает введённое слово из полей указанной строки.
//
// Параметры:
//  НомерСтрокиВход - Число - номер строки (от 1 до 6).
//
// Возвращаемое значение:
//  Строка - слово из пяти букв в нижнем регистре. Пустая строка, если заполнены не все поля.
//
&НаКлиенте
Функция ПрочитатьСловоСтроки(НомерСтрокиВход)
	РезультатФункции = "";
	Буквы = ПрочитатьБуквыСтроки(НомерСтрокиВход);
	Для Каждого Буква Из Буквы Цикл
		РезультатФункции = РезультатФункции + Буква;
	КонецЦикла;
	Возврат НормализоватьСлово(НРег(РезультатФункции));
КонецФункции // ПрочитатьСловоСтроки()

// Проверяет, входит ли слово в словарь СловарьБольшой.
//
// Параметры:
//  СловоВход - Строка - проверяемое слово в нижнем регистре.
//
// Возвращаемое значение:
//  Булево - Истина, если слово есть в словаре.
//
&НаСервере
Функция СловоВходитВСловарь(Знач СловоВход)
	РезультатФункции = (СловарьПроверки.НайтиПоЗначению(СловоВход) <> Неопределено);
	Возврат РезультатФункции;
КонецФункции // СловоВходитВСловарь()

// Подсвечивает декорации текущей строки по результатам сверки с загаданным словом
// и фиксирует строку: показывает декорации с буквами, скрывает поля ввода.
//
// Параметры:
//  СловоВход - Строка - введённое слово в нижнем регистре.
//
&НаКлиенте
Процедура ПодсветитьБуквы(СловоВход)
	Для НомерКолонки = 1 По 5 Цикл
		Буква = Сред(СловоВход, НомерКолонки, 1);
		БукваЗагаданная = Сред(ЗагаданноеСлово, НомерКолонки, 1);
		ИмяПоля = "Поле" + Строка(НомерТекущейСтроки) + Строка(НомерКолонки);
		ИмяДекорации = "Декорация" + Строка(НомерТекущейСтроки) + Строка(НомерКолонки);
		Элементы[ИмяДекорации].Заголовок = Буква;
		Если Буква = БукваЗагаданная Тогда
			Элементы[ИмяДекорации].ЦветФона = WebЦвета.СветлоЗеленый;
		ИначеЕсли СтрНайти(ЗагаданноеСлово, Буква) > 0 Тогда
			Элементы[ИмяДекорации].ЦветФона = WebЦвета.СветлоЗолотистый;
		Иначе
			Элементы[ИмяДекорации].ЦветФона = Новый Цвет();
		КонецЕсли;
		// Замена поля ввода на декорацию с буквой.
		Элементы[ИмяДекорации].Видимость = Истина;
		Элементы[ИмяПоля].Видимость = Ложь;
	КонецЦикла;
КонецПроцедуры // ПодсветитьБуквы()

// Переходит к следующей строке и обновляет отображение строк.
//
&НаКлиенте
Процедура ПерейтиКСледующейСтроке()
	Если НомерТекущейСтроки < 6 Тогда
		НомерТекущейСтроки = НомерТекущейСтроки + 1;
		ОбновитьОтображениеСтрок();
	Иначе
		// Достигнута последняя строка. Перехода нет.
	КонецЕсли;
КонецПроцедуры // ПерейтиКСледующейСтроке()

&НаКлиенте
Процедура Стереть(Команда)
	// Инициализация.
	Буквы = ПрочитатьБуквыСтроки(НомерТекущейСтроки);
	Для НомерКолонки = 5 По 1 Цикл
		Если Буквы[НомерКолонки - 1] <> "" Тогда
			Буквы[НомерКолонки - 1] = "";
			ЗаписатьБуквыСтроки(НомерТекущейСтроки, Буквы);
			Прервать;
		Иначе
			// Поле пусто. Ищем левее.
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры // Стереть()

&НаКлиенте
Процедура Далее(Команда)
	// Инициализация.
	ВведенноеСлово = ПрочитатьСловоСтроки(НомерТекущейСтроки);
	Если СтрДлина(ВведенноеСлово) < 5 Тогда
		Сообщить("Заполните все 5 букв.");
	Иначе
		Если СловоВходитВСловарь(ВведенноеСлово) Тогда
			ПодсветитьБуквы(ВведенноеСлово);
			Если ВведенноеСлово = ЗагаданноеСлово Тогда
				ЗавершитьИгру(Истина);
			ИначеЕсли НомерТекущейСтроки >= 6 Тогда
				ЗавершитьИгру(Ложь);
			Иначе
				ПерейтиКСледующейСтроке();
			КонецЕсли;
		Иначе
			Сообщить("Слово не найдено в словаре. Попробуйте другое слово.");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры // Далее()

// Завершает мини-игру: показывает итоговое сообщение и возвращает результат владельцу формы.
//
// Параметры:
//  ЭтоПобеда - Булево - Истина, если игра завершена победой.
//
&НаКлиенте
Процедура ЗавершитьИгру(ЭтоПобеда)
	// Инициализация.
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("Победа", ЭтоПобеда);
	Если ЭтоПобеда Тогда
		ТекстСообщения = НСтр("ru = 'Поздравляем! Вы победили!'");
	Иначе
		ТекстСообщения = НСтр("ru = 'Вы проиграли. Загаданное слово: '") + ЗагаданноеСлово;
	КонецЕсли;
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьИгруПослеСообщения", ЭтотОбъект, СтруктураРезультата);
	ПоказатьПредупреждение(ОписаниеОповещения, ТекстСообщения);
КонецПроцедуры // ЗавершитьИгру()

// Закрывает форму с результатом после показа итогового сообщения.
//
// Параметры:
//  ДополнительныеПараметры - Структура - результат игры (ключ "Победа").
//
&НаКлиенте
Процедура ЗавершитьИгруПослеСообщения(ДополнительныеПараметры) Экспорт
	ПодтвержденоЗакрытиеФормы = Истина;
	Закрыть(ДополнительныеПараметры);
КонецПроцедуры // ЗавершитьИгруПослеСообщения()

// Обрабатывает команду "Сдаться": запрашивает подтверждение и при согласии завершает этап поражением.
//
&НаКлиенте
Процедура Сдаться(Команда)
	ТекстВопроса = НСтр("ru = 'Сдаться и завершить этап поражением?'");
	ПоказатьВопрос(Новый ОписаниеОповещения("СдатьсяЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры // Сдаться()

// Обрабатывает ответ на вопрос о сдаче.
//
// Параметры:
//  Ответ                   - КодВозвратаДиалога - выбранный вариант ответа.
//  ДополнительныеПараметры - Произвольный - дополнительные параметры оповещения.
//
&НаКлиенте
Процедура СдатьсяЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗавершитьИгру(Ложь);
	Иначе
		// Игрок отказался сдаваться. Продолжаем игру.
	КонецЕсли;
КонецПроцедуры // СдатьсяЗавершение()

// Блокирует закрытие формы, пока игра не завершена.
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если Не ЗавершениеРаботы И Не ПодтвержденоЗакрытиеФормы Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры // ПередЗакрытием()

ПодтвержденоЗакрытиеФормы = Ложь;
