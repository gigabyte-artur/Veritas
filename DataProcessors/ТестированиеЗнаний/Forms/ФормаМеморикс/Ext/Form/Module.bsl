&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Инициализация.
	Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	ВсегоПар = 6;
	МаксимумХодов = 18;
	СделаноХодов = 0;
	НайденоПар = 0;
	ЕстьБлокировкаВвода = Ложь;
	// Подготовка игрового поля.
	СформироватьПолеИгры();
	ИнициализироватьЯчейки();
	ОбновитьСчетчики();
КонецПроцедуры

// Формирует список из 12 картинок (6 пар) и перемешивает его случайным образом.
//
&НаСервере
Процедура СформироватьПолеИгры()
	МассивКартинок = Новый Массив;
	МассивКартинок.Добавить("Битва");
	МассивКартинок.Добавить("Битва");
	МассивКартинок.Добавить("Звезда");
	МассивКартинок.Добавить("Звезда");
	МассивКартинок.Добавить("Модификатор");
	МассивКартинок.Добавить("Модификатор");
	МассивКартинок.Добавить("Костер");
	МассивКартинок.Добавить("Костер");
	МассивКартинок.Добавить("Сердце");
	МассивКартинок.Добавить("Сердце");
	МассивКартинок.Добавить("Щит");
	МассивКартинок.Добавить("Щит");
	КартинкиЯчеек.ЗагрузитьЗначения(ОбщегоНазначенияКлиентСервер.СмешатьМассив(МассивКартинок, Гсч));
КонецПроцедуры

// Заполняет таблицу состояний ячеек строками с номером ячейки и закрытым состоянием,
// а также сбрасывает картинки всех ячеек.
//
&НаСервере
Процедура ИнициализироватьЯчейки()
	СостоянияЯчеек.Очистить();
	Для Сч = 1 По ВсегоПар * 2 Цикл
		НоваяСтрока = СостоянияЯчеек.Добавить();
		НоваяСтрока.НомерЯчейки = Сч;
		НоваяСтрока.Состояние = ПредставлениеСостояниеЗакрыта();
		УстановитьКартинкуЯчейки(Сч - 1, "");
	КонецЦикла;
КонецПроцедуры

// Обновляет текстовые реквизиты счётчиков ходов и найденных пар.
//
&НаСервере
Процедура ОбновитьСчетчики()
	ТекстХодов = "Ходы: " + Строка(СделаноХодов) + "/" + Строка(МаксимумХодов);
	ТекстПар = "Пары: " + Строка(НайденоПар) + "/" + Строка(ВсегоПар);
КонецПроцедуры

// Возвращает элемент кнопки ячейки по её индексу.
//
// Параметры:
//  Индекс - Число - индекс ячейки (от 0 до 11).
//
// Возвращаемое значение:
//  ЭлементФормы - элемент кнопки ячейки.
//
&НаСервере
Функция ПолучитьЭлементЯчейки(Индекс)
	ИмяЭлемента = "Команда" + Строка(Индекс + 1);
	Возврат Элементы[ИмяЭлемента];
КонецФункции

// Устанавливает картинку ячейки. Пустое имя задаёт пустую картинку (рубашку).
//
// Параметры:
//  Индекс      - Число  - индекс ячейки (от 0 до 11).
//  ИмяКартинки - Строка - имя общей картинки или пустая строка.
//
&НаСервере
Процедура УстановитьКартинкуЯчейки(Индекс, ИмяКартинки)
	ЭлементЯчейки = ПолучитьЭлементЯчейки(Индекс);
	Если ИмяКартинки = "" Тогда
		ЭлементЯчейки.Картинка = Новый Картинка;
	Иначе
		Попытка
			ЭлементЯчейки.Картинка = БиблиотекаКартинок[ИмяКартинки];
		Исключение
			ЭлементЯчейки.Картинка = Новый Картинка;
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Возвращает строки таблицы состояний ячеек с заданным состоянием.
//
// Параметры:
//  СостояниеВход - Строка - состояние ячейки для поиска.
//
// Возвращаемое значение:
//  Массив - массив строк таблицы с заданным состоянием.
//
&НаСервере
Функция НайтиСтрокиЯчеекПоСостоянию(СостояниеВход)
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Состояние", СостояниеВход);
	Возврат СостоянияЯчеек.НайтиСтроки(СтруктураПоиска);
КонецФункции

