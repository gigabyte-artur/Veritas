// Обрабатывает нажатие на ячейку игрового поля.
//
// Параметры:
//  НомерЯчейкиВход - Число - номер ячейки (от 1 до 12).
//
&НаКлиенте
Процедура ОбработатьНажатиеЯчейки(НомерЯчейкиВход)
	РезультатНажатия = ОбработатьНажатиеНаСервере(НомерЯчейкиВход);
	Если РезультатНажатия.ЗавершитьИгру Тогда
		ЗавершитьИгру(РезультатНажатия.Победа);
	ИначеЕсли РезультатНажатия.НужнаПауза Тогда
		ПодключитьОбработчикОжидания("ЗакрытьПаруПослеПаузы", 0.6, Истина);
	Иначе
		// Открыта первая ячейка пары. Ожидаем выбор второй.
	КонецЕсли;
КонецПроцедуры

// Выполняет логику нажатия на ячейку на сервере и возвращает результат для отображения.
//
// Параметры:
//  НомерЯчейкиВход - Число - номер ячейки (от 1 до 12).
//
// Возвращаемое значение:
//  Структура - поля: НужнаПауза, ЗавершитьИгру, Победа.
//
&НаСервере
Функция ОбработатьНажатиеНаСервере(Знач НомерЯчейкиВход)
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("НужнаПауза", Ложь);
	РезультатФункции.Вставить("ЗавершитьИгру", Ложь);
	РезультатФункции.Вставить("Победа", Ложь);
	Если ЕстьБлокировкаВвода Тогда
		Возврат РезультатФункции;
	Иначе
		// Ввод не заблокирован. Продолжаем обработку нажатия.
	КонецЕсли;
	Индекс = НомерЯчейкиВход - 1;
	СостояниеЯчейки = СостоянияЯчеек[Индекс].Состояние;
	Если СостояниеЯчейки = ПредставлениеСостояниеОткрыта() Или СостояниеЯчейки = ПредставлениеСостояниеНайдена() Тогда
		Возврат РезультатФункции;
	Иначе
		// Ячейка закрыта. Открываем её.
	КонецЕсли;
	СостоянияЯчеек[Индекс].Состояние = ПредставлениеСостояниеОткрыта();
	УстановитьКартинкуЯчейки(Индекс, КартинкиЯчеек[Индекс].Значение);
	ОткрытыеСтроки = НайтиСтрокиЯчеекПоСостоянию(ПредставлениеСостояниеОткрыта());
	Если ОткрытыеСтроки.Количество() < 2 Тогда
		// Открыта первая ячейка пары. Ожидаем выбор второй.
	Иначе
		// Открыты две ячейки. Сравниваем пару.
		ПерваяСтрока = ОткрытыеСтроки[0];
		ВтораяСтрока = ОткрытыеСтроки[1];
		СделаноХодов = СделаноХодов + 1;
		ОбновитьСчетчики();
		ИндексПервой = ПерваяСтрока.НомерЯчейки - 1;
		ИндексВторой = ВтораяСтрока.НомерЯчейки - 1;
		Если КартинкиЯчеек[ИндексПервой].Значение = КартинкиЯчеек[ИндексВторой].Значение Тогда
			// Пара совпала.
			ПерваяСтрока.Состояние = ПредставлениеСостояниеНайдена();
			ВтораяСтрока.Состояние = ПредставлениеСостояниеНайдена();
			НайденоПар = НайденоПар + 1;
			ОбновитьСчетчики();
			Если НайденоПар = ВсегоПар Тогда
				РезультатФункции.ЗавершитьИгру = Истина;
				РезультатФункции.Победа = Истина;
			КонецЕсли;
		Иначе
			// Пара не совпала. Блокируем ввод и ждём паузу для закрытия.
			ЕстьБлокировкаВвода = Истина;
			РезультатФункции.НужнаПауза = Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции

// Закрывает две несовпавшие ячейки после паузы и завершает игру при поражении.
//
&НаКлиенте
Процедура ЗакрытьПаруПослеПаузы() Экспорт
	ЭтоПоражение = ЗакрытьПаруНаСервере();
	Если ЭтоПоражение Тогда
		ЗавершитьИгру(Ложь);
	КонецЕсли;
КонецПроцедуры

// Закрывает все открытые ячейки на сервере и проверяет условие поражения.
// Открытые ячейки определяются по таблице состояний, поэтому найденные пары не затрагиваются.
//
// Возвращаемое значение:
//  Булево - Истина, если наступило поражение.
//
&НаСервере
Функция ЗакрытьПаруНаСервере()
	ОткрытыеСтроки = НайтиСтрокиЯчеекПоСостоянию(ПредставлениеСостояниеОткрыта());
	Для Каждого СтрокаЯчейки Из ОткрытыеСтроки Цикл
		СтрокаЯчейки.Состояние = ПредставлениеСостояниеЗакрыта();
		УстановитьКартинкуЯчейки(СтрокаЯчейки.НомерЯчейки - 1, "");
	КонецЦикла;
	ЕстьБлокировкаВвода = Ложь;
	РезультатФункции = (СделаноХодов >= МаксимумХодов) И (НайденоПар < ВсегоПар);
	Возврат РезультатФункции;
КонецФункции

// Завершает мини-игру и возвращает результат владельцу формы.
//
// Параметры:
//  ЭтоПобеда - Булево - Истина, если игра завершена победой.
//
&НаКлиенте
Процедура ЗавершитьИгру(ЭтоПобеда)
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("Победа", ЭтоПобеда);
	Закрыть(СтруктураРезультата);
КонецПроцедуры
