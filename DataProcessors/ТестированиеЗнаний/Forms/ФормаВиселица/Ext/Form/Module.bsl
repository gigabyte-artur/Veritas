&НаСервере
Перем Гсч;

&НаКлиенте
Перем ИграЗавершена;

&НаКлиенте
Перем ПодтвержденоЗакрытиеФормы;

// Инициализирует игру: выбирает загаданное слово и готовит игровое поле.
//
// Параметры:
//  Отказ                - Булево - признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - признак стандартной обработки события.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Инициализация.
	Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	Попытки = 0;
	ВыбранныеБуквы = "";
	ЗагаданноеСлово = ПолучитьСлучайноеСлово();
	ТекущееСлово = СформироватьТекущееСлово(ЗагаданноеСлово, ВыбранныеБуквы);
	// Отображение счётчика попыток.
	Элементы.ДекорацияПопытки.Заголовок = СформироватьТекстПопыток(Попытки);
КонецПроцедуры // ПриСозданииНаСервере()

// Выбирает случайное слово допустимой длины из общего макета СловарьОбщий.
//
// Возвращаемое значение:
//  Строка - загаданное слово в нижнем регистре. Пустая строка, если подходящих слов нет.
//
&НаСервере
Функция ПолучитьСлучайноеСлово()
	// Инициализация.
	РезультатФункции = "";
	МинимальнаяДлина = ПолучитьМинимальнуюДлинуСлова();
	МаксимальнаяДлина = ПолучитьМаксимальнуюДлинуСлова();
	МакетСловаря = ПолучитьОбщийМакет("СловарьОбщий");
	ПодходящиеСлова = Новый Массив;
	// Отбор слов подходящей длины.
	Для НомерСтроки = 1 По МакетСловаря.ВысотаТаблицы Цикл
		ТекстЯчейки = МакетСловаря.Область("R" + Формат(НомерСтроки, "ЧН=0; ЧГ=") + "C1").Текст;
		ДлинаСлова = СтрДлина(ТекстЯчейки);
		Если ДлинаСлова >= МинимальнаяДлина И ДлинаСлова <= МаксимальнаяДлина Тогда
			ТекстЯчейки = НРег(ТекстЯчейки);
			ТекстЯчейки = СокрЛП(ТекстЯчейки);
			ПодходящиеСлова.Добавить(ТекстЯчейки);
		Иначе
			// Слово не подходит по длине. Пропускаем.
		КонецЕсли;
	КонецЦикла;
	// Случайный выбор слова.
	Если ПодходящиеСлова.Количество() > 0 Тогда
		НомерСлучайногоСлова = Гсч.СлучайноеЧисло(1, ПодходящиеСлова.Количество());
		РезультатФункции = ПодходящиеСлова[НомерСлучайногоСлова - 1];
	Иначе
		// Подходящих слов нет. Остаётся пустая строка.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции // ПолучитьСлучайноеСлово()

// Обрабатывает выбор буквы алфавита.
//
// Параметры:
//  Элемент - ДекорацияФормы - декорация выбранной буквы.
//
&НаКлиенте
Процедура БукваАлфавитаНажатие(Элемент)
	// Инициализация.
	Буква = ВРег(Элемент.Заголовок);
	// Проверка возможности хода.
	Если ИграЗавершена Тогда
		// Игра завершена. Ход невозможен.
		Возврат;
	Иначе
		// Игра продолжается.
	КонецЕсли;
	Если СтрНайти(ВыбранныеБуквы, Буква) > 0 Тогда
		// Буква уже называлась. Повторный ход игнорируется.
		Возврат;
	Иначе
		// Буква называется впервые.
	КонецЕсли;
	// Фиксация названной буквы и подсветка декорации.
	ВыбранныеБуквы = ВыбранныеБуквы + Буква;
	Если СтрНайти(ЗагаданноеСлово, НРег(Буква)) > 0 Тогда
		// Буква есть в слове.
		Элемент.ЦветФона = WebЦвета.СветлоЗеленый;
	Иначе
		// Буквы нет в слове. Увеличиваем счётчик ошибок.
		Попытки = Попытки + 1;
		Элемент.ЦветФона = WebЦвета.СветлоСерый;
	КонецЕсли;
	// Обновление игрового поля.
	ТекущееСлово = СформироватьТекущееСлово(ЗагаданноеСлово, ВыбранныеБуквы);
	Элементы.ДекорацияПопытки.Заголовок = СформироватьТекстПопыток(Попытки);
	// Проверка завершения игры.
	ПроверитьЗавершениеИгры();
КонецПроцедуры // БукваАлфавитаНажатие()

// Проверяет условия завершения игры после очередного хода.
//
&НаКлиенте
Процедура ПроверитьЗавершениеИгры()
	// Инициализация.
	ПредельноеКоличествоОшибок = ПолучитьПредельноеКоличествоОшибок();
	ЭтоСловоРазгадано = ЗначениеЗаполнено(ЗагаданноеСлово) И (СтрНайти(ТекущееСлово, "_") = 0);
	Если ЭтоСловоРазгадано Тогда
		ЗавершитьИгру(Истина);
	ИначеЕсли Попытки >= ПредельноеКоличествоОшибок Тогда
		ЗавершитьИгру(Ложь);
	Иначе
		// Игра продолжается.
	КонецЕсли;
КонецПроцедуры // ПроверитьЗавершениеИгры()

// Завершает игру и передаёт результат владельцу формы.
//
// Параметры:
//  ЭтоПобеда - Булево - Истина, если игрок угадал слово.
//
&НаКлиенте
Процедура ЗавершитьИгру(ЭтоПобеда)
	// Инициализация.
	ИграЗавершена = Истина;
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("Победа", ЭтоПобеда);
	// Подготовка итогового сообщения.
	Если ЭтоПобеда Тогда
		ТекстСообщения = НСтр("ru = 'Поздравляем! Вы победили!'");
	Иначе
		ТекущееСлово = ВРег(ЗагаданноеСлово);
		ТекстСообщения = НСтр("ru = 'Вы проиграли. Загаданное слово: '") + ВРег(ЗагаданноеСлово);
	КонецЕсли;
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьИгруПослеСообщения", ЭтотОбъект, СтруктураРезультата);
	ПоказатьПредупреждение(ОписаниеОповещения, ТекстСообщения);
КонецПроцедуры // ЗавершитьИгру()

// Закрывает форму с результатом после показа итогового сообщения.
//
// Параметры:
//  ДополнительныеПараметры - Структура - результат игры (ключ "Победа").
//
&НаКлиенте
Процедура ЗавершитьИгруПослеСообщения(ДополнительныеПараметры) Экспорт
	ПодтвержденоЗакрытиеФормы = Истина;
	Закрыть(ДополнительныеПараметры);
КонецПроцедуры // ЗавершитьИгруПослеСообщения()

// Обрабатывает команду "Сдаться": запрашивает подтверждение.
//
// Параметры:
//  Команда - КомандаФормы - команда формы.
//
&НаКлиенте
Процедура Сдаться(Команда)
	// Инициализация.
	ТекстВопроса = НСтр("ru = 'Сдаться и завершить игру поражением?'");
	Если ИграЗавершена Тогда
		// Игра уже завершена. Запрос не требуется.
		Возврат;
	Иначе
		// Игра продолжается. Запрашиваем подтверждение.
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("СдатьсяЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры // Сдаться()

// Обрабатывает ответ на вопрос о сдаче.
//
// Параметры:
//  Ответ                   - КодВозвратаДиалога - выбранный вариант ответа.
//  ДополнительныеПараметры - Произвольный - дополнительные параметры оповещения.
//
&НаКлиенте
Процедура СдатьсяЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗавершитьИгру(Ложь);
	Иначе
		// Игрок отказался сдаваться. Игра продолжается.
	КонецЕсли;
КонецПроцедуры // СдатьсяЗавершение()

// Блокирует закрытие формы, пока игра не завершена.
//
// Параметры:
//  Отказ                - Булево - признак отказа от закрытия формы.
//  ЗавершениеРаботы     - Булево - признак завершения работы программы.
//  ТекстПредупреждения  - Строка - текст предупреждения.
//  СтандартнаяОбработка - Булево - признак стандартной обработки события.
//
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если Не ЗавершениеРаботы И Не ПодтвержденоЗакрытиеФормы Тогда
		Отказ = Истина;
	Иначе
		// Закрытие разрешено.
	КонецЕсли;
КонецПроцедуры // ПередЗакрытием()

// Формирует отображаемую строку загаданного слова.
//
// Параметры:
//  ЗагаданноеСловоВход - Строка - загаданное слово в нижнем регистре.
//  ВыбранныеБуквыВход  - Строка - названные игроком буквы.
//
// Возвращаемое значение:
//  Строка - слово, в котором угаданные буквы открыты, остальные заменены подчёркиванием.
//
&НаКлиентеНаСервереБезКонтекста
Функция СформироватьТекущееСлово(ЗагаданноеСловоВход, ВыбранныеБуквыВход)
	// Инициализация.
	РезультатФункции = "";
	// Формирование строки по буквам загаданного слова.
	Для НомерБуквы = 1 По СтрДлина(ЗагаданноеСловоВход) Цикл
		БукваСлова = Сред(ЗагаданноеСловоВход, НомерБуквы, 1);
		Если СтрНайти(ВыбранныеБуквыВход, ВРег(БукваСлова)) > 0 Тогда
			РезультатФункции = РезультатФункции + ВРег(БукваСлова) + " ";
		Иначе
			РезультатФункции = РезультатФункции + "_" + " ";
		КонецЕсли;
	КонецЦикла;
	Возврат РезультатФункции;
КонецФункции // СформироватьТекущееСлово()

// Формирует текст счётчика попыток.
//
// Параметры:
//  ПопыткиВход - Число - количество совершённых ошибок.
//
// Возвращаемое значение:
//  Строка - текст вида "Попытки: 3 из 10".
//
&НаКлиентеНаСервереБезКонтекста
Функция СформироватьТекстПопыток(ПопыткиВход)
	// Инициализация.
	ПредельноеКоличествоОшибок = ПолучитьПредельноеКоличествоОшибок();
	ТекстСделанныхПопыток = НСтр("ru = 'Попытки: '") + Строка(ПопыткиВход);
	ТекстПределаПопыток = НСтр("ru = ' из '") + Строка(ПредельноеКоличествоОшибок);
	РезультатФункции = ТекстСделанныхПопыток + ТекстПределаПопыток;
	Возврат РезультатФункции;
КонецФункции // СформироватьТекстПопыток()

// Возвращает минимально допустимую длину загаданного слова.
// Ограничение снизу отсекает слишком короткие слова, в которых мало букв для игры.
//
// Возвращаемое значение:
//  Число - минимальное количество букв в загаданном слове.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьМинимальнуюДлинуСлова()
	Возврат 5;
КонецФункции // ПолучитьМинимальнуюДлинуСлова()

// Возвращает максимально допустимую длину загаданного слова.
// Ограничение сверху задано мобильной формой: строка из подчёркиваний и букв должна помещаться по ширине.
//
// Возвращаемое значение:
//  Число - максимальное количество букв в загаданном слове.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьМаксимальнуюДлинуСлова()
	Возврат 10;
КонецФункции // ПолучитьМаксимальнуюДлинуСлова()

// Возвращает количество ошибок, при достижении которого игрок проигрывает.
// Счётчик Попытки увеличивается на каждой ненайденной букве, поэтому проигрыш наступает на последней попытке.
//
// Возвращаемое значение:
//  Число - предельное количество ошибок игрока.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПредельноеКоличествоОшибок()
	Возврат 10;
КонецФункции // ПолучитьПредельноеКоличествоОшибок()

ИграЗавершена = Ложь;
ПодтвержденоЗакрытиеФормы = Ложь;
