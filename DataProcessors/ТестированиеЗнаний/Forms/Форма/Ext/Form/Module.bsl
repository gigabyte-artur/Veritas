КонецПроцедуры		// ОбновитьИнтерфейсБоя()

// Выполняет один шаг анимации плавного уменьшения здоровья противника.
// Вызывается обработчиком ожидания каждые 100 мс.
//
&НаКлиенте
Процедура ШагАнимацииУрона()
	АнимУронТек = АнимУронТек - 1;
	ТекущееЗдоровьеПротивника = АнимУронТек;
	ВосхождениеКлиент.ОбновитьПолосуЗдоровьяПротивникаНаКлиенте(ЭтаФорма);
	Если АнимУронТек <= АнимУронЦель Тогда
		ЗапретИзмененияТекущегоЗдоровьяПротивника = Ложь;
		ВосхождениеКлиент.ОбновитьПолосуЗдоровьяПротивникаНаКлиенте(ЭтаФорма);
	Иначе
		ПодключитьОбработчикОжидания("ШагАнимацииУрона", 0.1, Истина);
	КонецЕсли;
КонецПроцедуры		// ШагАнимацииУрона()

// Выполняет один шаг анимации плавного уменьшения здоровья игрока.
// Вызывается обработчиком ожидания каждые 100 мс.
//
&НаКлиенте
Процедура ШагАнимацииУронаИгрока()
	АнимУронИгрокТек = АнимУронИгрокТек - 1;
	ВосхождениеКлиентСервер.УстановитьТекущееЗдоровьеИгрока(ЭтаФорма, АнимУронИгрокТек);
	ВосхождениеКлиент.ОбновитьПолосуЗдоровьяИгрокаНаКлиенте(ЭтаФорма);
	Если АнимУронИгрокТек <= АнимУронИгрокЦель Тогда
		ЗапретИзмененияТекущегоЗдоровьяИгрока = Ложь;
		ОтобразитьСостояниеИгрока();
	Иначе
		ПодключитьОбработчикОжидания("ШагАнимацииУронаИгрока", 0.1, Истина);
	КонецЕсли;
КонецПроцедуры		// ШагАнимацииУронаИгрока()

// Наносит урон противнику с плавной анимацией уменьшения здоровья.
// Вызывает серверную НанестиУронПротивнику() для расчёта и мгновенной фиксации,
// после чего запускает клиентскую анимацию: -1 каждые 100 мс.
//
// Параметры:
//  КоличествоУрона - Число - количество наносимого урона.
//
// Возвращаемое значение:
//  Структура - результат от серверной НанестиУронПротивнику().
//
&НаКлиенте
Функция ПлавныйУронПротивнику(КоличествоУрона) Экспорт
	// Инициализация.
	ВидПараметраТекущееЗдоровье = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
	ВидПараметраЩит = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Щит");
	ЗапретИзмененияТекущегоЗдоровьяПротивника = Истина;
	// Если анимация уже идёт — прервать и начать заново от текущего положения.
	Попытка
		ОтключитьОбработчикОжидания("ШагАнимацииУрона");
	Исключение
		// Обработчик не был подключён — это нормально.
	КонецПопытки;
	// Запоминаем стартовое значение для анимации.
	АнимУронСтарт = ТекущееЗдоровьеПротивника;
	// Вычисляем целевое здоровье из результата (избегаем лишнего серверного вызова).
	ЗначениеЩита = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(ЭтаФорма, ВидПараметраЩит);
	РезультатУрона = ВосхождениеКлиентСервер.РассчитатьСтруктуруУронаПротивнику(КоличествоУрона, ЗначениеЩита);
	АнимУронЦель = АнимУронСтарт - РезультатУрона.УронПоЗдоровью;
	Если АнимУронЦель < 0 Тогда
		АнимУронЦель = 0;
	КонецЕсли;
	АнимУронТек = АнимУронСтарт;
	// Если стартовое здоровье уже равно целевому — анимация не нужна.
	Если АнимУронСтарт <= АнимУронЦель Тогда
		ВосхождениеКлиент.ОбновитьПолосуЗдоровьяПротивникаНаКлиенте(ЭтаФорма);
		// Вызываем серверную функцию — здоровье фиксируется мгновенно.
		ТекущееЗдоровьеПротивника = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраПротивника(ЭтаФорма, ВидПараметраТекущееЗдоровье);
		ЗапретИзмененияТекущегоЗдоровьяПротивника = Ложь;
		Возврат РезультатУрона;
	КонецЕсли;
	// Запускаем анимацию.
	ПодключитьОбработчикОжидания("ШагАнимацииУрона", 0.1, Истина);
	Возврат РезультатУрона;
КонецФункции		// ПлавныйУронПротивнику()

// Обновляет 3 иконки индикатора серии по значению ЗарядСерии.
//
&НаСервере
Процедура ОбновитьИндикаторСерии() Экспорт
	ВосхождениеБойСервер.ОбновитьИндикаторСерии(ЭтаФорма);
КонецПроцедуры		// ОбновитьИндикаторСерии()

// Обработчик нажатия на кнопки-слоты карт.
// Определяет номер слота из имени элемента и разыгрывает соответствующую карту.
//
&НаКлиенте
Процедура КартаСлот_Нажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ИмяЭлемента = Элемент.Имя;
	НомерСлота = Число(Прав(ИмяЭлемента, СтрДлина(ИмяЭлемента) - 9));
	ИндексКарты = НомерСлота - 1;
	Если ИндексКарты >= 0 И ИндексКарты < РукаИгрока.Количество() Тогда
		ИдентификаторКарты = РукаИгрока[ИндексКарты].ИдентификаторКарты;
		РазыгратьКарту(ИдентификаторКарты);
		ПодключитьОбработчикОжидания("СброситьПодсветкуЗдоровьяИгрока", 1, Истина);
		ПодключитьОбработчикОжидания("СброситьПодсветкуЩитаИгрока", 1, Истина);
		ВосхождениеКлиент.ОбновитьРукуКарт(ЭтаФорма);
		ОбновитьИнтерфейсБоя();
	Иначе
		// Неверный индекс карты.
	КонецЕсли;
КонецПроцедуры		// КартаСлот_Нажатие()

&НаКлиенте
Процедура HUD_ТекстНамеренияНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.Атака") Тогда
		Сообщить("Атака — противник наносит прямой урон игроку.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.НаложитьЩит") Тогда
		Сообщить("Наложить щит — противник накладывает на себя щит, поглощающий урон.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.НаложитьПроклятие") Тогда
		Сообщить("Наложить проклятие — противник накладывает проклятие, наносящее урон каждый ход.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.УдарНаУдачу") Тогда
		Сообщить("Удар на удачу — противник наносит случайный урон: от минимального до очень высокого.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.АктивироватьБомбу") Тогда
		Сообщить("Активировать бомбу — противник активирует бомбу, которая взорвётся через несколько ходов и нанесёт огромный урон.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.УвеличитьСилу") Тогда
		Сообщить("Увеличить силу — противник увеличивает свою силу атаки на несколько ходов.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.НаложитьНеуклюжесть") Тогда
		Сообщить("Наложить неуклюжесть — противник снижает точность атак игрока.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.Лечение") Тогда
		Сообщить("Лечение — противник восстанавливает часть своего здоровья.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.Сон") Тогда
		Сообщить("Сон — противник пропускает ход.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.Вампиризм") Тогда
		Сообщить("Вампиризм — противник крадёт здоровье у игрока и восстанавливает своё.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.УкрастьЗолото") Тогда
		Сообщить("Украсть золото — противник крадёт часть золота игрока.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.СбежатьИзБоя") Тогда
		Сообщить("Сбежать из боя — противник пытается покинуть бой.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.СломатьЩит") Тогда
		Сообщить("Сломать щит — противник разрушает щит игрока, игнорируя защиту.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.Поджечь") Тогда
		Сообщить("Поджечь — противник поджигает игрока, нанося урон каждый ход.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.Отравить") Тогда
		Сообщить("Отравить — противник накладывает яд, наносящий урон каждый ход.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.ЗаблокироватьЛечение") Тогда
		Сообщить("Заблокировать лечение — противник блокирует возможность игрока лечиться.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.НаложитьЛедянойЩит") Тогда
		Сообщить("Наложить ледяной щит — противник накладывает ледяной щит, который поглощает урон и может заморозить атакующего.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.Очищение") Тогда
		Сообщить("Очищение — противник снимает с себя все негативные эффекты.");
	ИначеЕсли СледующееДействиеПротивника = ПредопределенноеЗначение("Перечисление.ВариантыДействийПротивников.Опровержение") Тогда
		Сообщить("Опровержение — противник отражает часть полученного урона обратно в игрока.");
	КонецЕсли;
КонецПроцедуры

