// Применяет урон по здоровью игрока с учётом модификаторов защиты и плавной анимацией.
//
// Параметры:
//  УронВход - Число - урон, прошедший сквозь щит и наносимый по здоровью.
//
&НаКлиенте
Процедура ПрименитьУронПоЗдоровьюИгрока(УронВход) Экспорт
	ВидПараметраТекущееЗдоровье	 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.ТекущееЗдоровье");
	ВидПараметраЯд				 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгроков.Яд");
	МодификаторКожаныеПластины		 = ПредопределенноеЗначение("Справочник.Модификаторы.КожаныеПластины");
	МодификаторКольчуга				 = ПредопределенноеЗначение("Справочник.Модификаторы.Кольчуга");
	МодификаторЧумнойНоситель		 = ПредопределенноеЗначение("Справочник.Модификаторы.ЧумнойНоситель");
	ВидПараметраПолученоУрона			 = ПредопределенноеЗначение("Перечисление.ВидыПараметровИгры.ПолученоУрона");
	НовыйУрон = УронВход;
	ВидПараметра = ВидПараметраТекущееЗдоровье;
	ТекущееЗначение = ВосхождениеКлиентСервер.ПолучитьЗначениеПараметраИгрока(ЭтаФорма, ВидПараметра);
	// Применяем модификатор "Кожаные пластины": уменьшаем урон на 1
	Если ВосхождениеКлиентСервер.МодификаторАктивен(ЭтаФорма, МодификаторКожаныеПластины) Тогда
		НовыйУрон = Макс(0, НовыйУрон - 1);
	Иначе
		// Не требуется изменение урона.
	КонецЕсли;
	// Применяем модификатор "Кольчуга": поглощает 25% от входящего урона
	Если ВосхождениеКлиентСервер.МодификаторАктивен(ЭтаФорма, МодификаторКольчуга) Тогда
		НовыйУрон = Цел(НовыйУрон * 0.75);
	Иначе
		// Кольчуга не активна. Не наносим урон.
	КонецЕсли;
	// Подсветка здоровья при потере здоровья.
	Если НовыйУрон > 0 Тогда
		ПодсветитьЗдоровьеИгрока();
	Иначе
		// Урон полностью поглощён модификаторами.
	КонецЕсли;
	// Модификатор "ЧумнойНоситель": если урон прошёл по здоровью, противник получает 1 Яд
	Если НовыйУрон > 0 И ВосхождениеКлиентСервер.МодификаторАктивен(ЭтаФорма, МодификаторЧумнойНоситель) Тогда
		УвеличитьПараметрПротивника(ВидПараметраЯд, 1);
	КонецЕсли;
	НовоеЗначение = ТекущееЗначение - НовыйУрон;
	Если НовоеЗначение < 0 Тогда
		НовоеЗначение = 0;
	Иначе
		// Значение здоровья корректно, оставляем как есть
	КонецЕсли;
	// Увеличиваем счётчик полученного урона.
	ВосхождениеКлиент.УвеличитьПараметрИгры(ЭтаФорма, ВидПараметраПолученоУрона, НовыйУрон);
	// Подготовка анимации плавного уменьшения здоровья игрока
	Если ТекущееЗначение > НовоеЗначение Тогда
		Попытка
			ОтключитьОбработчикОжидания("ШагАнимацииУронаИгрока");
		Исключение
			// Обработчик не был подключён — это нормально.
		КонецПопытки;
		ЗапретИзмененияТекущегоЗдоровьяИгрока = Истина;
		АнимУронИгрокСтарт = ТекущееЗначение;
		АнимУронИгрокЦель = НовоеЗначение;
		АнимУронИгрокТек = АнимУронИгрокСтарт;
	КонецЕсли;
	УстановитьПараметрИгрока(ВидПараметра, НовоеЗначение);
	// Запуск анимации
	Если ТекущееЗначение > НовоеЗначение Тогда
		// Восстанавливаем реквизит на случай синхронизации платформой
		ВосхождениеКлиентСервер.УстановитьТекущееЗдоровьеИгрока(ЭтаФорма, АнимУронИгрокСтарт);
		ПодключитьОбработчикОжидания("ШагАнимацииУронаИгрока", 0.1, Истина);
	КонецЕсли;
КонецПроцедуры		// ПрименитьУронПоЗдоровьюИгрока()

