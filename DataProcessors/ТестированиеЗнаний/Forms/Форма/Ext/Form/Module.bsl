&НаКлиенте
Процедура ИнформацияОБое(Команда)
	// Инициализация.
	ПараметрыФормыИнфо = Новый Структура;
	// Формирование массива параметров игрока.
	МассивПараметровИгрока = Новый Массив;
	Для Каждого ТекСтрокаПараметрыИгрока Из ПараметрыИгрока Цикл
		СтруктураЭлемент = Новый Структура;
		СтруктураЭлемент.Вставить("ВидПараметра", ТекСтрокаПараметрыИгрока.ВидПараметра);
		СтруктураЭлемент.Вставить("ЗначениеПараметра", ТекСтрокаПараметрыИгрока.ЗначениеПараметра);
		МассивПараметровИгрока.Добавить(СтруктураЭлемент);
	КонецЦикла;
	ПараметрыФормыИнфо.Вставить("ПараметрыИгрока", МассивПараметровИгрока);
	// Формирование массива параметров противника.
	МассивПараметровПротивника = Новый Массив;
	Для Каждого ТекСтрокаПараметрыПротивника Из ПараметрыПротивника Цикл
		СтруктураЭлемент = Новый Структура;
		СтруктураЭлемент.Вставить("ВидПараметра", ТекСтрокаПараметрыПротивника.ВидПараметра);
		СтруктураЭлемент.Вставить("ЗначениеПараметра", ТекСтрокаПараметрыПротивника.ЗначениеПараметра);
		МассивПараметровПротивника.Добавить(СтруктураЭлемент);
	КонецЦикла;
	ПараметрыФормыИнфо.Вставить("ПараметрыПротивника", МассивПараметровПротивника);
	// Формирование массива модификаторов.
	МассивМодификаторов = Новый Массив;
	Для Каждого ТекСтрокаМодификаторы Из Модификаторы Цикл
		СтруктураЭлемент = Новый Структура;
		СтруктураЭлемент.Вставить("Модификатор", ТекСтрокаМодификаторы.Модификатор);
		МассивМодификаторов.Добавить(СтруктураЭлемент);
	КонецЦикла;
	ПараметрыФормыИнфо.Вставить("Модификаторы", МассивМодификаторов);
	// Формирование массива карт из колоды игрока.
	МассивКартКолоды = Новый Массив;
	Для Каждого ТекСтрокаКолодаИгрока Из КолодаИгрока Цикл
		СтруктураЭлемент = Новый Структура;
		СтруктураЭлемент.Вставить("Карта", ТекСтрокаКолодаИгрока.Карта);
		МассивКартКолоды.Добавить(СтруктураЭлемент);
	КонецЦикла;
	ПараметрыФормыИнфо.Вставить("КартыКолоды", МассивКартКолоды);
	ПараметрыФормыИнфо.Вставить("ВсегоЭтапов", ВсегоЭтапов);
	ПараметрыФормыИнфо.Вставить("НомерЭтапа", НомерЭтапа);
	// Формирование массива журнала боя.
	МассивЖурналаБоя = Новый Массив;
	Для Каждого ТекСтрокаЖурналБоя Из ЖурналБоя Цикл
		СтруктураЭлемент = Новый Структура;
		СтруктураЭлемент.Вставить("СобытиеБоя", ТекСтрокаЖурналБоя.СобытиеБоя);
		СтруктураЭлемент.Вставить("СвязанныйОбъект", ТекСтрокаЖурналБоя.СвязанныйОбъект);
		СтруктураЭлемент.Вставить("Количество", ТекСтрокаЖурналБоя.Количество);
		СтруктураЭлемент.Вставить("Период", ТекСтрокаЖурналБоя.Период);
		МассивЖурналаБоя.Добавить(СтруктураЭлемент);
	КонецЦикла;
	ПараметрыФормыИнфо.Вставить("ЖурналБоя", МассивЖурналаБоя);
	ПараметрыФормыИнфо.Вставить("Персонаж", Персонаж);
	ПараметрыФормыИнфо.Вставить("Противник", Противник);
	// Открытие формы информации о бое с блокировкой окна владельца.
	ОткрытьФорму("Обработка.ТестированиеЗнаний.Форма.ФормаИнформацииОБое",
		ПараметрыФормыИнфо, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

