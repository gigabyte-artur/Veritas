&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Инициализация.
	КоличествоВерных = 0;	
	КоличествоЗаданных = 0;
	СерияПравильных = 0;
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	ВидПараметраПолученоУрона = Перечисления.ВидыПараметровИгры.ПолученоУрона;
	ВидПараметраВерныхПодряд = Перечисления.ВидыПараметровИгры.ВерныхОтветовПодряд;
	// Считывание параметров.
	Если ЗначениеЗаполнено(Параметры.Сборник) Тогда
		Сборник = Параметры.Сборник;
	Иначе
		// Параметры не переданы. Не требуется обновлять сборник.
	КонецЕсли;
	ВыбранныеСборники = Параметры.ВыбранныеСборники;
	// Считывание констант.
	КоличествоЗаданийВРаунде = Константы.КоличествоЗаданийВРаунде.Получить();
	Если НЕ ЗначениеЗаполнено(КоличествоЗаданийВРаунде) Тогда
		КоличествоЗаданийВРаунде = 100;
	Иначе
		// Значение установлено.
	КонецЕсли;
	ВероятностьПовтораНеправильного = Константы.ВероятностьПовтораНеправильного.Получить();
	ТихийРежим = Константы.ТихийРежим.Получить();
	// Инициализация игры для режима "Восхождение"
	Если ОбщегоНазначенияКлиентСервер.ЭтоРежимВосхождение(РежимВикторины) Тогда
		ИнициализироватьРежимВосхождение();
		ВосхождениеКлиентСервер.УстановитьПараметрИгры(ЭтаФорма, ВидПараметраПолученоУрона, 0);
		ВосхождениеКлиентСервер.УстановитьПараметрИгры(ЭтаФорма, ВидПараметраВерныхПодряд, 0);
	Иначе
		// Для прочих вариантов не инициализируем.
	КонецЕсли;
	// Управление видимостью.
	ВосхождениеКлиентСервер.УправлениеВидимостью(ЭтаФорма);
КонецПроцедуры

