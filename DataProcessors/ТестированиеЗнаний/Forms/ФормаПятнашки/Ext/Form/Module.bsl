&НаСервере
Перем Гсч;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Инициализация.
	Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	МаксимумХодов = 60;
	СделаноХодов = 0;
	// Подготовка игрового поля.
	ИнициализироватьПоле();
	ПеремешатьПоле();
	ОбновитьОтображение();
	ОбновитьСчетчик();
КонецПроцедуры

// Заполняет поле целевым состоянием: клетки 1-8 содержат плитки 1-8, клетка 9 пустая.
//
&НаСервере
Процедура ИнициализироватьПоле()
	Поле.Очистить();
	Для НомерКлетки = 1 По 9 Цикл
		НоваяСтрока = Поле.Добавить();
		НоваяСтрока.НомерКлетки = НомерКлетки;
		Если НомерКлетки < 9 Тогда
			НоваяСтрока.Плитка = НомерКлетки;
		Иначе
			НоваяСтрока.Плитка = 0;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Перемешивает поле 40 случайными допустимыми ходами из целевого состояния.
// Повторяет перемешивание, если после него поле оказалось собранным.
//
&НаСервере
Процедура ПеремешатьПоле()
	ПовторитьПеремешивание = Истина;
	Пока ПовторитьПеремешивание Цикл
		ИнициализироватьПоле();
		ПредыдущаяКлетка = 0;
		Для СчетчикХодов = 1 По 40 Цикл
			ПустаяКлетка = НайтиПустуюКлетку();
			МассивСоседей = ПолучитьСоседниеКлетки(ПустаяКлетка);
			МассивДопустимыхХодов = Новый Массив;
			Для Каждого ТекСосед Из МассивСоседей Цикл
				Если ТекСосед <> ПредыдущаяКлетка Тогда
					МассивДопустимыхХодов.Добавить(ТекСосед);
				Иначе
					// Обратный ход. Исключаем.
				КонецЕсли;
			КонецЦикла;
			Если МассивДопустимыхХодов.Количество() = 0 Тогда
				МассивДопустимыхХодов = МассивСоседей;
			Иначе
				// Список допустимых ходов сформирован.
			КонецЕсли;
			ИндексХода = Гсч.СлучайноеЧисло(0, МассивДопустимыхХодов.Количество() - 1);
			ВыбраннаяКлетка = МассивДопустимыхХодов[ИндексХода];
			// Сдвиг плитки из выбранной клетки в пустую.
			Плитка = Поле[ВыбраннаяКлетка - 1].Плитка;
			Поле[ПустаяКлетка - 1].Плитка = Плитка;
			Поле[ВыбраннаяКлетка - 1].Плитка = 0;
			ПредыдущаяКлетка = ПустаяКлетка;
		КонецЦикла;
		ПовторитьПеремешивание = ЭтоСобранноеПоле();
	КонецЦикла;
КонецПроцедуры

// Возвращает массив номеров клеток, соседних с заданной по горизонтали или вертикали.
//
// Параметры:
//  НомерКлеткиВход - Число - номер клетки (от 1 до 9).
//
// Возвращаемое значение:
//  Массив - массив номеров соседних клеток.
//
&НаСервереБезКонтекста
Функция ПолучитьСоседниеКлетки(НомерКлеткиВход)
	НомерСтроки = Цел((НомерКлеткиВход - 1) / 3);
	НомерКолонки = (НомерКлеткиВход - 1) % 3;
	МассивСоседей = Новый Массив;
	// Верхняя клетка.
	Если НомерСтроки > 0 Тогда
		МассивСоседей.Добавить((НомерСтроки - 1) * 3 + НомерКолонки + 1);
	Иначе
		// Верхней клетки нет.
	КонецЕсли;
	// Нижняя клетка.
	Если НомерСтроки < 2 Тогда
		МассивСоседей.Добавить((НомерСтроки + 1) * 3 + НомерКолонки + 1);
	Иначе
		// Нижней клетки нет.
	КонецЕсли;
	// Левая клетка.
	Если НомерКолонки > 0 Тогда
		МассивСоседей.Добавить(НомерСтроки * 3 + НомерКолонки);
	Иначе
		// Левой клетки нет.
	КонецЕсли;
	// Правая клетка.
	Если НомерКолонки < 2 Тогда
		МассивСоседей.Добавить(НомерСтроки * 3 + НомерКолонки + 2);
	Иначе
		// Правой клетки нет.
	КонецЕсли;
	Возврат МассивСоседей;
КонецФункции

// Возвращает номер пустой клетки поля.
//
// Возвращаемое значение:
//  Число - номер клетки (от 1 до 9) с пустой плиткой.
//
&НаСервере
Функция НайтиПустуюКлетку()
	РезультатФункции = 0;
	Для Индекс = 0 По 8 Цикл
		Если Поле[Индекс].Плитка = 0 Тогда
			РезультатФункции = Индекс + 1;
			Прервать;
		Иначе
			// Плитка не пустая. Продолжаем поиск.
		КонецЕсли;
	КонецЦикла;
	Возврат РезультатФункции;
КонецФункции

// Проверяет, совпадает ли текущее поле с целевым состоянием.
//
// Возвращаемое значение:
//  Булево - Истина, если поле собрано.
//
&НаСервере
Функция ЭтоСобранноеПоле()
	РезультатФункции = Истина;
	Для Индекс = 0 По 7 Цикл
		Если Поле[Индекс].Плитка <> Индекс + 1 Тогда
			РезультатФункции = Ложь;
			Прервать;
		Иначе
			// Плитка на месте. Продолжаем проверку.
		КонецЕсли;
	КонецЦикла;
	Если РезультатФункции Тогда
		Если Поле[8].Плитка <> 0 Тогда
			РезультатФункции = Ложь;
		Иначе
			// Клетка 9 пустая. Поле собрано.
		КонецЕсли;
	Иначе
		// Поле не собрано.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции

// Возвращает элемент кнопки клетки по номеру клетки.
//
// Параметры:
//  НомерКлеткиВход - Число - номер клетки (от 1 до 9).
//
// Возвращаемое значение:
//  ЭлементФормы - элемент кнопки клетки.
//
&НаСервере
Функция ПолучитьЭлементКлетки(НомерКлеткиВход)
	ИмяЭлемента = "Команда" + Строка(НомерКлеткиВход);
	Возврат Элементы[ИмяЭлемента];
КонецФункции

// Обновляет заголовки кнопок поля: номер плитки или пустая строка для пустой клетки.
//
&НаСервере
Процедура ОбновитьОтображение()
	Для НомерКлетки = 1 По 9 Цикл
		Плитка = Поле[НомерКлетки - 1].Плитка;
		ЭлементКлетки = ПолучитьЭлементКлетки(НомерКлетки);
		Если НЕ ЗначениеЗаполнено(Плитка) Тогда
			ЭлементКлетки.Заголовок = " ";
		Иначе
			ЭлементКлетки.Заголовок = Строка(Плитка);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Обновляет текстовый реквизит счётчика ходов.
//
&НаСервере
Процедура ОбновитьСчетчик()
	ТекстХодов = "Ходы: " + Строка(СделаноХодов) + "/" + Строка(МаксимумХодов);
КонецПроцедуры

&НаКлиенте
Процедура Команда1(Команда)
	ОбработатьНажатиеКлетки(1);
КонецПроцедуры

