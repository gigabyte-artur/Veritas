
&НаКлиенте
Перем ПодтвержденоЗакрытиеФормы;

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	ПодтвержденоЗакрытиеФормы = Истина;
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьЗдоровье(Команда)
	ПодтвержденоЗакрытиеФормы = Истина;
	Закрыть(ВосстановленноеЗдоровье);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ВосстановленноеЗдоровье = Параметры.ВосстановленноеЗдоровье;
	ТекущееЗдоровье = Параметры.ТекущееЗдоровье;
	КартыИгрока.Очистить();
	Для Каждого ТекКарта Из Параметры.КартыИгрока Цикл
		КартыИгрока.Добавить(ТекКарта.Значение);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьКарту(Команда)
	Если КартыИгрока.Количество() <= 5 Тогда
		Сообщить("Нельзя удалить карту: у вас должно быть больше 5 карт.");
		Возврат;
	КонецЕсли;
	СписокКарт = Новый СписокЗначений;
	Для Каждого ТекКарта Из КартыИгрока Цикл
		СписокКарт.Добавить(ТекКарта.Значение);
	КонецЦикла;
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораКартыДляУдаления", ЭтаФорма);
	ПоказатьВыборИзСписка(ОписаниеОповещения, СписокКарт);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКартыДляУдаления(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда
		// Пользователь отменил выбор.
		Возврат;
	КонецЕсли;
	ЗначениеКарты = Результат.Значение;
	Если ТипЗнч(ЗначениеКарты) = Тип("СправочникСсылка.Карты") Тогда
		ПодтвержденоЗакрытиеФормы = Истина;
		Закрыть(ЗначениеКарты);
	КонецЕсли;
КонецПроцедуры

// Блокирует закрытие формы, пока не выбрано действие отдыха.
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если Не ЗавершениеРаботы И Не ПодтвержденоЗакрытиеФормы Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

ПодтвержденоЗакрытиеФормы = Ложь;
