// Обновляет справочник Карты по данным из массива структур, если версия в макете отличается от константы.
//
// Параметры:
//   МассивКарт - Массив - массив структур с данными карт.
//
&НаСервере
Процедура ОбновитьСправочникКарты(МассивКарт)
	// Проверка версии.
	ВерсияИзМакета = ПолучитьВерсиюКартИзМакета();
	ВерсияВКонстанте = Константы.ВерсияКарт.Получить();
	Если ВерсияИзМакета = ВерсияВКонстанте Тогда
		Возврат;
	Иначе
		// Версии отличаются. Продолжаем обновление.
	КонецЕсли;
	Попытка
		// Создаем соответствие для поиска по ключам (ИмяПредопределенныхДанных)
		СоответствиеКарт = Новый Соответствие;
		// Формируем массив ключей для выборки
		МассивКлючей = Новый Массив;
		Для Каждого ДанныеКарты Из МассивКарт Цикл
			МассивКлючей.Добавить(ДанныеКарты.Name);
		КонецЦикла;
		// Выполняем один запрос для получения всех элементов справочника
		Если МассивКлючей.Количество() > 0 Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|Карты.Ссылка КАК Ссылка,
				|Карты.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
				|ИЗ
				|Справочник.Карты КАК Карты
				|ГДЕ
				|Карты.ИмяПредопределенныхДанных В(&МассивКлючей)
				|И НЕ Карты.ПометкаУдаления";
			Запрос.УстановитьПараметр("МассивКлючей", МассивКлючей);
			РезультатЗапроса = Запрос.Выполнить();
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				СоответствиеКарт.Вставить(ВыборкаДетальныеЗаписи.ИмяПредопределенныхДанных, ВыборкаДетальныеЗаписи.Ссылка);
			КонецЦикла;
			// Проходим по массиву карт и обновляем найденные элементы
			Для Каждого ДанныеКарты Из МассивКарт Цикл
				Идентификатор = ДанныеКарты.Name;
				НайденныйЭлемент = СоответствиеКарт.Получить(Идентификатор);
				Если НайденныйЭлемент <> Неопределено Тогда
					НовыйЭлемент = НайденныйЭлемент.ПолучитьОбъект();
					НовыйЭлемент.Наименование	 = ДанныеКарты.Title;
					НовыйЭлемент.Описание		 = ДанныеКарты.Description;
					НовыйЭлемент.Стоимость		 = ДанныеКарты.Cost;
					Попытка
						Если Число(НовыйЭлемент.Код) < 16 Тогда
							НовыйЭлемент.Открыта = Истина;
						КонецЕсли;
					Исключение
						// Код не может быть преобразован к числу — пропускаем.
					КонецПопытки;
					НовыйЭлемент.Записать();
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		// Запись новой версии в константу.
		МенеджерКонстанты = Константы.ВерсияКарт.СоздатьМенеджерЗначения();
		МенеджерКонстанты.Значение = ВерсияИзМакета;
		МенеджерКонстанты.Записать();
	Исключение
		ТекстСообщения = "Ошибка при обновлении карт: " + ОписаниеОшибки();
		Сообщить(ТекстСообщения);
	КонецПопытки;
КонецПроцедуры // ОбновитьСправочникКарты()

// Переключает реквизит Персонаж на предыдущее предопределённое значение справочника Персонажи.
&НаКлиенте
Процедура ПредыдущийПерсонаж(Команда)
	Персонаж = ПолучитьПредыдущегоПерсонажа(Персонаж);
	ОбновитьКартинкуПерсонажа();
КонецПроцедуры

// Обновляет декорацию картинки персонажа по соответствию предопределённого элемента и названия картинки.
&НаКлиенте
Процедура ОбновитьКартинкуПерсонажа()
	СоответствиеКартинок = ПолучитьСоответствиеКартинокПерсонажей();
	ИмяКартинки = СоответствиеКартинок.Получить(Персонаж);
	Если ИмяКартинки <> Неопределено Тогда
		Элементы.ДекорацияКартинкаПерсонаж.Картинка = БиблиотекаКартинок[ИмяКартинки];
	Иначе
		// Для персонажа не задана картинка. Оставляем текущую картинку.
	КонецЕсли;
КонецПроцедуры // ОбновитьКартинкуПерсонажа()

// Возвращает соответствие предопределённых элементов справочника Персонажи и названий общих картинок.
//
// Возвращаемое значение:
//   Соответствие - ключ: СправочникСсылка.Персонажи, значение: Строка - имя общей картинки.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСоответствиеКартинокПерсонажей()
	РезультатФункции = Новый Соответствие;
	РезультатФункции.Вставить(ПредопределенноеЗначение("Справочник.Персонажи.Профессор"), "Персонаж_Профессор");
	РезультатФункции.Вставить(ПредопределенноеЗначение("Справочник.Персонажи.Дуэлянт"), "Персонаж_Дуэлянт");
	РезультатФункции.Вставить(ПредопределенноеЗначение("Справочник.Персонажи.Архивариус"), "Персонаж_Архивариус");
	РезультатФункции.Вставить(ПредопределенноеЗначение("Справочник.Персонажи.Алхимик"), "Персонаж_Алхимик");
	РезультатФункции.Вставить(ПредопределенноеЗначение("Справочник.Персонажи.Софист"), "Персонаж_Софист");
	РезультатФункции.Вставить(ПредопределенноеЗначение("Справочник.Персонажи.Еретик"), "Персонаж_Еретик");
	РезультатФункции.Вставить(ПредопределенноеЗначение("Справочник.Персонажи.Оратор"), "Персонаж_Оратор");
	Возврат РезультатФункции;
КонецФункции // ПолучитьСоответствиеКартинокПерсонажей()

// Возвращает массив предопределённых элементов справочника Персонажи, упорядоченный по коду.
//
// Возвращаемое значение:
//   Массив - массив ссылок СправочникСсылка.Персонажи в порядке возрастания кода.
//
&НаСервереБезКонтекста
Функция ПолучитьСписокПерсонажей()
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Персонажи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Персонажи КАК Персонажи
		|ГДЕ
		|	Персонажи.Предопределенный
		|
		|УПОРЯДОЧИТЬ ПО
		|	Персонажи.Код";
	РезультатЗапроса = Запрос.Выполнить();
	Выгрузка = РезультатЗапроса.Выгрузить();
	РезультатФункции = Выгрузка.ВыгрузитьКолонку("Ссылка");
	Возврат РезультатФункции;
КонецФункции // ПолучитьСписокПерсонажей()

// Возвращает предыдущее предопределённое значение справочника Персонажи по кругу.
//
// Параметры:
//   ПерсонажВход - СправочникСсылка.Персонажи - текущий персонаж.
//
// Возвращаемое значение:
//   СправочникСсылка.Персонажи - предыдущий персонаж. Если ПерсонажВход первый в списке,
//   возвращается последний персонаж справочника.
//
&НаСервереБезКонтекста
Функция ПолучитьПредыдущегоПерсонажа(Знач ПерсонажВход)
	РезультатФункции = ПерсонажВход;
	МассивПерсонажей = ПолучитьСписокПерсонажей();
	ИндексТекущего = МассивПерсонажей.Найти(ПерсонажВход);
	Если ИндексТекущего = 0 Тогда
		РезультатФункции = МассивПерсонажей[МассивПерсонажей.Количество() - 1];
	ИначеЕсли ИндексТекущего > 0 Тогда
		РезультатФункции = МассивПерсонажей[ИндексТекущего - 1];
	Иначе
		// Текущий персонаж не найден среди предопределённых. Оставляем значение без изменений.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции // ПолучитьПредыдущегоПерсонажа()

// Возвращает следующее предопределённое значение справочника Персонажи по кругу.
//
// Параметры:
//   ПерсонажВход - СправочникСсылка.Персонажи - текущий персонаж.
//
// Возвращаемое значение:
//   СправочникСсылка.Персонажи - следующий персонаж. Если ПерсонажВход последний в списке,
//   возвращается первый персонаж справочника.
//
&НаСервереБезКонтекста
Функция ПолучитьСледующегоПерсонажа(Знач ПерсонажВход)
	РезультатФункции = ПерсонажВход;
	МассивПерсонажей = ПолучитьСписокПерсонажей();
	ИндексТекущего = МассивПерсонажей.Найти(ПерсонажВход);
	Если ИндексТекущего = МассивПерсонажей.Количество() - 1 Тогда
		РезультатФункции = МассивПерсонажей[0];
	ИначеЕсли ИндексТекущего >= 0 Тогда
		РезультатФункции = МассивПерсонажей[ИндексТекущего + 1];
	Иначе
		// Текущий персонаж не найден среди предопределённых. Оставляем значение без изменений.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции // ПолучитьСледующегоПерсонажа()

// Переключает реквизит Персонаж на следующее предопределённое значение справочника Персонажи.
&НаКлиенте
Процедура СледующийПерсонаж(Команда)
	Персонаж = ПолучитьСледующегоПерсонажа(Персонаж);
	ОбновитьКартинкуПерсонажа();
КонецПроцедуры

Гсч = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
