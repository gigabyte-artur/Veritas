		Возврат РезультатФункции;
	Иначе
		ПозицияНачала = ПозицияНачала + 9; // Длина "<version>"
		СтрокаВерсии = Сред(СодержимоеЯчейки, ПозицияНачала, ПозицияКонца - ПозицияНачала);
		РезультатФункции = Число(СтрокаВерсии);
	КонецЕсли;
