									НоваяКарта.Вставить("Cost", Число(ДочернийУзел.ТекстовоеСодержимое));
								Иначе
									НоваяКарта.Вставить("Cost", 0);
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
						РезультатФункции.Добавить(НоваяКарта);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		ЧтениеXML.Закрыть();
	КонецЕсли;
