// Возвращает версию карт из общего макета Карты_Предопределенный.
//
// Возвращаемое значение:
//   Число - версия карт из макета. 0 если версия не найдена.
//
&НаСервере
Функция ПолучитьВерсиюКартИзМакета()
	РезультатФункции = 0;
	Макет = ПолучитьОбщийМакет("Карты_Предопределенный");
	СодержимоеЯчейки = Макет.Область("R1C1").Текст;
