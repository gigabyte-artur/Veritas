Перем Гсч;		//Генератор случайных чисел.

// Возвращает случайный доступный сборник.
&НаСервере
Функция ВернутьСлучайныйСборник()
	РезультатФункции = Справочники.Сборники.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Сборники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Сборники КАК Сборники
		|ГДЕ
		|	НЕ Сборники.ПометкаУдаления";
	РезультатЗапроса = Запрос.Выполнить();
	Выгрузка = РезультатЗапроса.Выгрузить();
	МассивСборников = Выгрузка.ВыгрузитьКолонку("Ссылка");
	Если МассивСборников.Количество() Тогда
		МассивСборников = ОбщегоНазначенияКлиентСервер.СмешатьМассив(МассивСборников, Гсч);
		РезультатФункции = МассивСборников[0];
	Иначе
		РезультатФункции = Справочники.Сборники.ПустаяСсылка();
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// ВернутьСлучайныйСборник()

// Возвращает ссылку на текущего пользователя из параметра сеанса.
&НаСервереБезКонтекста
Функция ВернутьТекущегоПользователя()
	РезультатФункции = ПараметрыСеанса.ТекущийПользователь;
	Возврат РезультатФункции;
КонецФункции		// ВернутьТекущегоПользователя()

// Вовзращает массив выбранных сборников на форме.
&НаКлиентеНаСервереБезКонтекста
Функция СчитатьВыбранныеСборники(Форма)
	РезультатФункции = Новый Массив;
	Для Каждого ТекТаблицаСборников Из Форма.ТаблицаСборников Цикл
		Если ТекТаблицаСборников.Использование Тогда
			РезультатФункции.Добавить(ТекТаблицаСборников.Сборник);
		Иначе
			// Пользователь не выбрал сборник. Пропускаем.
		КонецЕсли;
	КонецЦикла;	
	Возврат РезультатФункции;
КонецФункции		 // СчитатьВыбранныеСборники()

// Определяет, что на форме выбран режим Случайного сборника.
&НаКлиентеНаСервереБезКонтекста
Функция ЭтоРежимСлучайныйСборник(Форма)
	РезультатФункции = Ложь;
	ЗначениеРежимСлучайныйСборник = ПредопределенноеЗначение("Перечисление.РежимыВикторины.СлучайныйСборник");
	РезультатФункции = (Форма.РежимВикторины = ЗначениеРежимСлучайныйСборник);
	Возврат РезультатФункции;
КонецФункции		 // ЭтоРежимСлучайныйСборник()

// Определяет, что на форме выбран режим Восхождения.
&НаКлиентеНаСервереБезКонтекста
Функция ЭтоРежимВосхождения(Форма)
	РезультатФункции = Ложь;
	ЗначениеРежимВосхождения = ПредопределенноеЗначение("Перечисление.РежимыВикторины.Восхождение");
	РезультатФункции = (Форма.РежимВикторины = ЗначениеРежимВосхождения);
	Возврат РезультатФункции;
КонецФункции		 // ЭтоРежимВосхождения()
 
// Управляет видимостью элементов на форме.
&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостью(Форма)
	// Вычисление параметров.
	РежимСлучайныйСборник	 = ЭтоРежимСлучайныйСборник(Форма);
	РежимВосхождение		 = ЭтоРежимВосхождения(Форма);
	ОтображатьВыборСборников = (РежимСлучайныйСборник);
	ОтображатьСборник = (НЕ РежимВосхождение);
	// Отображение выбора сборников.
	Форма.Элементы.Сборник.Видимость = ((НЕ ОтображатьВыборСборников) И (ОтображатьСборник));
	Форма.Элементы.ТаблицаСборников.Видимость		 = ОтображатьВыборСборников;
	Форма.Элементы.ГруппаКнопкиСборники.Видимость	 = ОтображатьВыборСборников;
	// Отображение кнопки Применить.
	Форма.Элементы.Применить.Доступность = Истина;
	Если ОтображатьВыборСборников Тогда
		МассивВыбранных = СчитатьВыбранныеСборники(Форма);	
		Если МассивВыбранных.Количество() = 0 Тогда
			Форма.Элементы.Применить.Доступность = Ложь;
		Иначе
			// Проверка пройдена.
		КонецЕсли;
	Иначе
		// Проверка пройдена.
	КонецЕсли;
	// Отображение Персонажа.
	Форма.Элементы.Персонаж.Видимость = РежимВосхождение; 
	Форма.Элементы.ГруппаПерсонаж.Видимость = РежимВосхождение; 
КонецПроцедуры		// УправлениеВидимостью()

// Заполняет таблицу сборников на форме.
&НаСервере
Процедура ЗаполнитьТаблицуСборников()
	ТаблицаСборников.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сборники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Сборники КАК Сборники
		|ГДЕ
		|	НЕ Сборники.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сборники.Наименование";
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока = ТаблицаСборников.Добавить();
		НоваяСтрока.Использование	 = Истина;
		НоваяСтрока.Сборник			 = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
КонецПроцедуры		// ЗаполнитьТаблицуСборников()

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Пользователь.
	#Если МобильноеПриложениеКлиент Тогда
		
	#Иначе
		Пользователь = ВернутьТекущегоПользователя();
	#КонецЕсли
	// Режим викторины.
	РежимВикторины = Перечисления.РежимыВикторины.Восхождение;
	// Сборники.
	Если ЗначениеЗаполнено(Параметры.Сборник) Тогда
		Сборник = Параметры.Сборник;
	Иначе
		Сборник = ВернутьСлучайныйСборник();
	КонецЕсли;
	ЗаполнитьТаблицуСборников();
	// Режим Восхождение.
	Противники = ПрочитатьПротивниковИзМакета();
	ОбновитьСправочникПротивники(Противники);
	Модификаторы = ПрочитатьМодификаторыИзМакета();
	ОбновитьСправочникМодификаторы(Модификаторы);
	Карты = ПрочитатьКартыИзМакета();
	ОбновитьСправочникКарты(Карты);
	Персонаж = Справочники.Персонажи.Профессор;
	// Обновление интерфейса.
	УправлениеВидимостью(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	Если ЗначениеЗаполнено(Пользователь) Тогда
		// Считаем выбранные сборники.
		МассивВыбранных = Новый Массив;
		РежимСлучайныйСборник = ЭтоРежимСлучайныйСборник(ЭтаФорма);
		Если РежимСлучайныйСборник Тогда
			МассивВыбранных = СчитатьВыбранныеСборники(ЭтаФорма);
		Иначе
			МассивВыбранных = Новый Массив;
		КонецЕсли;
		СписокВыбранных = Новый СписокЗначений;
		СписокВыбранных.ЗагрузитьЗначения(МассивВыбранных);
		// Передадим параметры.
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Пользователь", Пользователь);
		СтруктураПараметров.Вставить("РежимВикторины", РежимВикторины);
		СтруктураПараметров.Вставить("Сборник", Сборник);
		СтруктураПараметров.Вставить("ВыбранныеСборники", СписокВыбранных);
		СтруктураПараметров.Вставить("Персонаж", Персонаж);
		// Проверка выбора сборников.
		МожноНачать = ((НЕ РежимСлучайныйСборник) ИЛИ (МассивВыбранных.Количество() > 0));
		Если НЕ МожноНачать Тогда
			ТекстСообщения = НСтр("ru = 'Для продолжения требуется выбрать хотя бы один сборник'");
			Сообщить(ТекстСообщения);
			Возврат;
		КонецЕсли;
		// Проверка выбора персонажа в режиме восхождения.
		РежимВосхождение = ЭтоРежимВосхождения(ЭтаФорма);
		Если РежимВосхождение И НЕ ЗначениеЗаполнено(Персонаж) Тогда
			ТекстСообщения = НСтр("ru = 'Для продолжения требуется выбрать персонажа'");
			Сообщить(ТекстСообщения);
			Возврат;
		КонецЕсли;
		Закрыть(СтруктураПараметров);
	Иначе
		ТекстСообщения = НСтр("ru = 'Пожалуйста, выберите пользователя'");
		Сообщить(ТекстСообщения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСправку(Команда)
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("РазделСправки", "НастройкиВикторины");
	ОткрытьФорму("Обработка.ОтображениеСправки.Форма.Форма", СтруктураПараметров);
КонецПроцедуры

&НаКлиенте
Процедура РежимВикториныПриИзменении(Элемент)
	УправлениеВидимостью(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСборниковИспользованиеПриИзменении(Элемент)
	УправлениеВидимостью(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	Для Каждого ТекТаблицаСборников Из ТаблицаСборников Цикл
		ТекТаблицаСборников.Использование = Ложь;
	КонецЦикла;	
	УправлениеВидимостью(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для Каждого ТекТаблицаСборников Из ТаблицаСборников Цикл
		ТекТаблицаСборников.Использование = Истина;
	КонецЦикла;	
	УправлениеВидимостью(ЭтаФорма);
КонецПроцедуры

// Возвращает массив структур с данными противников из общего макета Противники_Предопределенный.
&НаСервере
Функция ПрочитатьПротивниковИзМакета()
	РезультатФункции = Новый Массив;
	Макет = ПолучитьОбщийМакет("Противники_Предопределенный");
	СодержимоеЯчейки = Макет.Область("R1C1").Текст;
	Если ПустаяСтрока(СодержимоеЯчейки) Тогда
		Возврат РезультатФункции;
	Иначе
		ЧтениеXML = Новый ЧтениеXML;
		ПозицияДекларации = СтрНайти(СодержимоеЯчейки, "?>");
		Если ПозицияДекларации > 0 Тогда
			СтрокаБезДекларации = Сред(СодержимоеЯчейки, ПозицияДекларации + 2);
		Иначе
			СтрокаБезДекларации = СодержимоеЯчейки;
		КонецЕсли;
		СтрокаXML = "<root>" + СтрокаБезДекларации + "</root>";
		ЧтениеXML.УстановитьСтроку(СтрокаXML);
		ПостроительDOM = Новый ПостроительDOM;
		ДокументXML = ПостроительDOM.Прочитать(ЧтениеXML);
		ЭлементRoot = ДокументXML.ЭлементДокумента;
		Для Каждого ЭлементChild Из ЭлементRoot.ДочерниеУзлы Цикл
			Если ЭлементChild.ИмяУзла = "Enemies" Тогда
				Для Каждого ЭлементEnemy Из ЭлементChild.ДочерниеУзлы Цикл
					Если ЭлементEnemy.ИмяУзла = "Enemy" Тогда
						НовыйПротивник = Новый Структура;
						Если ЭлементEnemy.Атрибуты.Количество() > 0 Тогда
							Для Каждого Атрибут Из ЭлементEnemy.Атрибуты Цикл
								Если Атрибут.Имя = "id" Тогда
									НовыйПротивник.Вставить("Id", Атрибут.Значение);
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
						Для Каждого ДочернийУзел Из ЭлементEnemy.ДочерниеУзлы Цикл
							Если ДочернийУзел.ИмяУзла = "Name" Тогда
								НовыйПротивник.Вставить("Name", ДочернийУзел.ТекстовоеСодержимое);
							ИначеЕсли ДочернийУзел.ИмяУзла = "Description" Тогда
								НовыйПротивник.Вставить("Description", ДочернийУзел.ТекстовоеСодержимое);
							ИначеЕсли ДочернийУзел.ИмяУзла = "MaxHealth" Тогда
								НовыйПротивник.Вставить("MaxHealth", Число(ДочернийУзел.ТекстовоеСодержимое));
							ИначеЕсли ДочернийУзел.ИмяУзла = "Difficulty" Тогда
								НовыйПротивник.Вставить("Difficulty", ДочернийУзел.ТекстовоеСодержимое);
							ИначеЕсли ДочернийУзел.ИмяУзла = "ActionCycle" Тогда
								МассивДействий = Новый Массив;
								Для Каждого ЭлементAction Из ДочернийУзел.ДочерниеУзлы Цикл
									Если ЭлементAction.ИмяУзла = "Action" Тогда
										СтруктураДействия = Новый Структура;
										Для Каждого ЭлементДействия Из ЭлементAction.ДочерниеУзлы Цикл
											Если ЭлементДействия.ИмяУзла = "Type" Тогда
												СтруктураДействия.Вставить("Type", ЭлементДействия.ТекстовоеСодержимое);
											ИначеЕсли ЭлементДействия.ИмяУзла = "MinPower" Тогда
												СтруктураДействия.Вставить("MinPower", Число(ЭлементДействия.ТекстовоеСодержимое));
											ИначеЕсли ЭлементДействия.ИмяУзла = "MaxPower" Тогда
												СтруктураДействия.Вставить("MaxPower", Число(ЭлементДействия.ТекстовоеСодержимое));
											КонецЕсли;
										КонецЦикла;
										МассивДействий.Добавить(СтруктураДействия);
									КонецЕсли;
								КонецЦикла;
								НовыйПротивник.Вставить("ActionCycle", МассивДействий);
							КонецЕсли;
						КонецЦикла;
						РезультатФункции.Добавить(НовыйПротивник);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		ЧтениеXML.Закрыть();
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции

// Возвращает версию противников из общего макета Противники_Предопределенный.
//
// Возвращаемое значение:
//   Число - версия противников из макета. 0 если версия не найдена.
//
&НаСервере
Функция ПолучитьВерсиюПротивниковИзМакета()
	РезультатФункции = 0;
	Макет = ПолучитьОбщийМакет("Противники_Предопределенный");
	СодержимоеЯчейки = Макет.Область("R1C1").Текст;
	ПозицияНачала = СтрНайти(СодержимоеЯчейки, "<version>");
	ПозицияКонца = СтрНайти(СодержимоеЯчейки, "</version>");
	Если ПозицияНачала = 0 Или ПозицияКонца = 0 Тогда
		Возврат РезультатФункции;
	Иначе
		ПозицияНачала = ПозицияНачала + 9; // Длина "<version>"
		СтрокаВерсии = Сред(СодержимоеЯчейки, ПозицияНачала, ПозицияКонца - ПозицияНачала);
		РезультатФункции = Число(СтрокаВерсии);
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции // ПолучитьВерсиюПротивниковИзМакета()

// Обновляет справочник Противники по данным из массива структур, если версия в макете отличается от константы.
//
// Параметры:
//   МассивПротивников - Массив - массив структур с данными противников.
//
&НаСервере
Процедура ОбновитьСправочникПротивники(МассивПротивников)
	// Проверка версии.
	ВерсияИзМакета = ПолучитьВерсиюПротивниковИзМакета();
	ВерсияВКонстанте = Константы.ВерсияПротивников.Получить();
	Если ВерсияИзМакета = ВерсияВКонстанте Тогда
		Возврат;
	Иначе
		// Версии отличаются. Продолжаем обновление.
	КонецЕсли;
	Для Каждого ДанныеПротивника Из МассивПротивников Цикл
		Попытка
			НайденныйЭлемент = Справочники.Противники.НайтиПоРеквизиту("ВнешнийID", ДанныеПротивника.Id);
			Если НЕ ЗначениеЗаполнено(НайденныйЭлемент) Тогда
				НовыйЭлемент = Справочники.Противники.СоздатьЭлемент();
				НовыйЭлемент.ВнешнийID	 = ДанныеПротивника.Id;
			Иначе
				НовыйЭлемент			 = НайденныйЭлемент.ПолучитьОбъект();
			КонецЕсли;
			НовыйЭлемент.Наименование = ДанныеПротивника.Name;
			НовыйЭлемент.Описание = ДанныеПротивника.Description;
			НовыйЭлемент.МаксимальноеЗдоровье = ДанныеПротивника.MaxHealth;
			Если ДанныеПротивника.Свойство("Difficulty") Тогда
				НовыйЭлемент.Сложность = Перечисления.СложностиПротивников[ДанныеПротивника.Difficulty];
			КонецЕсли;
			НовыйЭлемент.ДействияЦикла.Очистить();
			Для Каждого ДанныеДействия Из ДанныеПротивника.ActionCycle Цикл
				НовоеДействие = Перечисления.ВариантыДействийПротивников[ДанныеДействия.Type];
				НоваяСтрокаДействия = НовыйЭлемент.ДействияЦикла.Добавить();
				НоваяСтрокаДействия.ДействиеЦикла		 = НовоеДействие;
				НоваяСтрокаДействия.МинимальнаяСила		 = ДанныеДействия.MinPower;
				НоваяСтрокаДействия.МаксимальнаяСила	 = ДанныеДействия.MaxPower;
			КонецЦикла;
			НовыйЭлемент.Записать();
		Исключение
			ОписаниеОповещения = "Ошибка при обновлении противника с Id " + ДанныеПротивника.Id + ": " + ОписаниеОшибки();
			Сообщить(ОписаниеОповещения);
		КонецПопытки;
	КонецЦикла;
	// Запись новой версии в константу.
	МенеджерКонстанты = Константы.ВерсияПротивников.СоздатьМенеджерЗначения();
	МенеджерКонстанты.Значение = ВерсияИзМакета;
	МенеджерКонстанты.Записать();
КонецПроцедуры // ОбновитьСправочникПротивники()

// Возвращает массив структур с данными модификаторов из общего макета Модификаторы_Предопределенный.
&НаСервере
Функция ПрочитатьМодификаторыИзМакета()
	РезультатФункции = Новый Массив;
	Макет = ПолучитьОбщийМакет("Модификаторы_Предопределенный");
	СодержимоеЯчейки = Макет.Область("R1C1").Текст;
	Если ПустаяСтрока(СодержимоеЯчейки) Тогда
		Возврат РезультатФункции;
	Иначе
		ЧтениеXML = Новый ЧтениеXML;
		ПозицияДекларации = СтрНайти(СодержимоеЯчейки, "?>");
		Если ПозицияДекларации > 0 Тогда
			СтрокаБезДекларации = Сред(СодержимоеЯчейки, ПозицияДекларации + 2);
		Иначе
			СтрокаБезДекларации = СодержимоеЯчейки;
		КонецЕсли;
		СтрокаXML = "<root>" + СтрокаБезДекларации + "</root>";
		ЧтениеXML.УстановитьСтроку(СтрокаXML);
		ПостроительDOM = Новый ПостроительDOM;
		ДокументXML = ПостроительDOM.Прочитать(ЧтениеXML);
		ЭлементRoot = ДокументXML.ЭлементДокумента;
		Для Каждого ЭлементChild Из ЭлементRoot.ДочерниеУзлы Цикл
			Если ЭлементChild.ИмяУзла = "modifiers" Тогда
				Для Каждого ЭлементModifier Из ЭлементChild.ДочерниеУзлы Цикл
					Если ЭлементModifier.ИмяУзла = "modifier" Тогда
						НовыйМодификатор = Новый Структура;
						Для Каждого ДочернийУзел Из ЭлементModifier.ДочерниеУзлы Цикл
							Если ДочернийУзел.ИмяУзла = "name" Тогда
								НовыйМодификатор.Вставить("Name", ДочернийУзел.ТекстовоеСодержимое);
							ИначеЕсли ДочернийУзел.ИмяУзла = "title" Тогда
								НовыйМодификатор.Вставить("Title", ДочернийУзел.ТекстовоеСодержимое);
							ИначеЕсли ДочернийУзел.ИмяУзла = "description" Тогда
								НовыйМодификатор.Вставить("Description", ДочернийУзел.ТекстовоеСодержимое);
							ИначеЕсли ДочернийУзел.ИмяУзла = "positive" Тогда
								НовыйМодификатор.Вставить("Positive", ДочернийУзел.ТекстовоеСодержимое = "true");
							ИначеЕсли ДочернийУзел.ИмяУзла = "defaultDuration" Тогда
								Если Не ПустаяСтрока(ДочернийУзел.ТекстовоеСодержимое) Тогда
									НовыйМодификатор.Вставить("DefaultDuration", Число(ДочернийУзел.ТекстовоеСодержимое));
								Иначе
									НовыйМодификатор.Вставить("DefaultDuration", 0);
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
						РезультатФункции.Добавить(НовыйМодификатор);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		ЧтениеXML.Закрыть();
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции

// Возвращает версию модификаторов из общего макета Модификаторы_Предопределенный.
//
// Возвращаемое значение:
//   Число - версия модификаторов из макета. 0 если версия не найдена.
//
&НаСервере
Функция ПолучитьВерсиюМодификаторовИзМакета()
	РезультатФункции = 0;
	Макет = ПолучитьОбщийМакет("Модификаторы_Предопределенный");
	СодержимоеЯчейки = Макет.Область("R1C1").Текст;
	ПозицияНачала = СтрНайти(СодержимоеЯчейки, "<version>");
	ПозицияКонца = СтрНайти(СодержимоеЯчейки, "</version>");
	Если ПозицияНачала = 0 Или ПозицияКонца = 0 Тогда
		Возврат РезультатФункции;
	Иначе
		ПозицияНачала = ПозицияНачала + 9; // Длина "<version>"
		СтрокаВерсии = Сред(СодержимоеЯчейки, ПозицияНачала, ПозицияКонца - ПозицияНачала);
		РезультатФункции = Число(СтрокаВерсии);
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции // ПолучитьВерсиюМодификаторовИзМакета()

// Обновляет справочник Модификаторы по данным из массива структур, если версия в макете отличается от константы.
//
// Параметры:
//   МассивМодификаторовВход - Массив - массив структур с данными модификаторов.
//
&НаСервере
Процедура ОбновитьСправочникМодификаторы(МассивМодификаторовВход)
	// Проверка версии.
	ВерсияИзМакета = ПолучитьВерсиюМодификаторовИзМакета();
	ВерсияВКонстанте = Константы.ВерсияМодификаторов.Получить();
	Если ВерсияИзМакета = ВерсияВКонстанте Тогда
		Возврат;
	Иначе
		// Версии отличаются. Продолжаем обновление.
	КонецЕсли;
	Попытка
		// Создаем соответствие для поиска по ключам (ИмяПредопределенныхДанных)
		СоответствиеМодификаторов = Новый Соответствие;
		// Формируем массив ключей для выборки
		МассивКлючей = Новый Массив;
		Для Каждого ДанныеМодификатора Из МассивМодификаторовВход Цикл
			МассивКлючей.Добавить(ДанныеМодификатора.Name);
		КонецЦикла;
		// Выполняем один запрос для получения всех элементов справочника
		Если МассивКлючей.Количество() > 0 Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|Модификаторы.Ссылка КАК Ссылка,
				|Модификаторы.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
				|ИЗ
				|Справочник.Модификаторы КАК Модификаторы
				|ГДЕ
				|Модификаторы.ИмяПредопределенныхДанных В(&МассивКлючей)
				|И НЕ Модификаторы.ПометкаУдаления";
			Запрос.УстановитьПараметр("МассивКлючей", МассивКлючей);
			РезультатЗапроса = Запрос.Выполнить();
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				СоответствиеМодификаторов.Вставить(ВыборкаДетальныеЗаписи.ИмяПредопределенныхДанных, ВыборкаДетальныеЗаписи.Ссылка);
			КонецЦикла;
			// Проходим по массиву модификаторов и обновляем найденные элементы
			Для Каждого ДанныеМодификатора Из МассивМодификаторовВход Цикл
				ИмяКлюча = ДанныеМодификатора.Name;
				НайденныйЭлемент = СоответствиеМодификаторов.Получить(ИмяКлюча);
				Если НайденныйЭлемент <> Неопределено Тогда
					НовыйЭлемент = НайденныйЭлемент.ПолучитьОбъект();
					НовыйЭлемент.Наименование				 = ДанныеМодификатора.Title;
					НовыйЭлемент.Описание					 = ДанныеМодификатора.Description;
					НовыйЭлемент.Положительный				 = ДанныеМодификатора.Positive;
					НовыйЭлемент.ДлительностьПоУмолчанию	 = ДанныеМодификатора.DefaultDuration;
					Попытка
						Если Число(НовыйЭлемент.Код) < 8 Тогда
							НовыйЭлемент.Открыт = Истина;
						КонецЕсли;
					Исключение
						// Код не может быть преобразован к числу — пропускаем.
					КонецПопытки;
					НовыйЭлемент.Записать();
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		// Запись новой версии в константу.
		МенеджерКонстанты = Константы.ВерсияМодификаторов.СоздатьМенеджерЗначения();
		МенеджерКонстанты.Значение = ВерсияИзМакета;
		МенеджерКонстанты.Записать();
	Исключение
		ТекстСообщения = "Ошибка при обновлении модификаторов: " + ОписаниеОшибки();
		Сообщить(ТекстСообщения);
	КонецПопытки;
КонецПроцедуры // ОбновитьСправочникМодификаторы()

// Возвращает массив структур с данными карт из общего макета Карты_Предопределенный.
&НаСервере
Функция ПрочитатьКартыИзМакета()
	РезультатФункции = Новый Массив;
	Макет = ПолучитьОбщийМакет("Карты_Предопределенный");
	СодержимоеЯчейки = Макет.Область("R1C1").Текст;
	Если ПустаяСтрока(СодержимоеЯчейки) Тогда
		Возврат РезультатФункции;
	Иначе
		ЧтениеXML = Новый ЧтениеXML;
		ПозицияДекларации = СтрНайти(СодержимоеЯчейки, "?>");
		Если ПозицияДекларации > 0 Тогда
			СтрокаБезДекларации = Сред(СодержимоеЯчейки, ПозицияДекларации + 2);
		Иначе
